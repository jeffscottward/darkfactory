import { constants } from "node:fs"
import { afterEach, beforeEach, describe, expect, it, vi } from "vitest"

const mocks = vi.hoisted(() => ({
  lstat: vi.fn(),
  open: vi.fn(),
  opendir: vi.fn(),
  relative: vi.fn(),
}))

vi.mock("node:fs/promises", () => ({
  lstat: mocks.lstat,
  open: mocks.open,
  opendir: mocks.opendir,
}))
vi.mock("node:path", async (importOriginal) =>
  const actual = await importOriginal<typeof import("node:path")>()
  return { ...actual, relative: mocks.relative }
)


import { auditTypeExports } from "./type-exports.civet"

const ROOT = "/virtual"
const WORKSPACE_CONFIG_BYTES = 64 * 1024
const WORKSPACE_DIRECTORIES = 10_000
const WORKSPACE_ENTRIES = 100_000
const WORKSPACE_PACKAGES = 1000
const EXPORT_NODES = 10_000
const TOTAL_EXPORT_NODES = 100_000
const TYPE_TARGETS = 1000
const TOTAL_TYPE_TARGETS = 10_000
const TOTAL_TARGET_LSTATS = 100_000

type Metadata = Readonly<{
  dev: number
  ino: number
  size: number
  isDirectory: () => boolean
  isFile: () => boolean
  isSymbolicLink: () => boolean
}>

type VirtualDirent = Readonly<{
  name: string
  isDirectory: () => boolean
  isFile: () => boolean
  isSymbolicLink: () => boolean
}>

const metadata = (
  kind: "directory" | "file" | "other" | "symlink" = "file",
  overrides: Partial<Metadata> = {},
): Metadata => ({
  dev: 1,
  ino: 1,
  size: 1,
  isDirectory: () => kind === "directory",
  isFile: () => kind === "file",
  isSymbolicLink: () => kind === "symlink",
  ...overrides,
})

const dualMetadata = (): Metadata => metadata("file", {
  isDirectory: () => true,
})

const dirent = (
  name: string,
  kind: "directory" | "file" | "symlink" = "file",
): VirtualDirent => ({
  name,
  isDirectory: () => kind === "directory",
  isFile: () => kind === "file",
  isSymbolicLink: () => kind === "symlink",
})

const asyncDirectory = (entries: Iterable<VirtualDirent>) => ({
  async *[Symbol.asyncIterator]()
    for (const entry of entries) yield entry
})

const fileHandle = (
  source: string,
  opened: Metadata = metadata("file", {
    size: Buffer.byteLength(source, "utf8"),
  }),
) =>
  const bytes = Buffer.from(source)
  return {
    stat: vi.fn(async () => opened),
    read: vi.fn(async (
      buffer: Buffer,
      offset: number,
      length: number,
      position: number,
    ) =>
      const bytesRead = Math.min(length, Math.max(0, bytes.length - position))
      if (bytesRead > 0) bytes.copy(buffer, offset, position, position + bytesRead)
      return { bytesRead, buffer }
    ),
    close: vi.fn(async () => undefined),
  }

const resetFileSystemMocks = (): void =>
  mocks.lstat.mockReset()
  mocks.open.mockReset()
  mocks.opendir.mockReset()
  mocks.relative.mockReset()
  mocks.relative.mockImplementation((from: string, to: string) =>
    const prefix = `${from}/`
    return to.startsWith(prefix) ? to.slice(prefix.length) : to
  )

const installVirtualWorkspace = (
  manifests: readonly (readonly [string, Readonly<Record<string, unknown>>])[],
  options: Readonly<{
    patterns?: readonly string[]
    metadataFactory?: () => Metadata
  }> = {},
): void =>
  resetFileSystemMocks()
  const patterns = options.patterns ?? ["packages/*"]
  const files = new Map<string, string>([[
    `${ROOT}/pnpm-workspace.yaml`,
    `packages:\n${patterns.map((pattern) => `  - ${JSON.stringify(pattern)}`).join("\n")}\n`,
  ]])
  const directories = new Map<string, readonly VirtualDirent[]>([
    [ROOT, [dirent("packages", "directory")]],
    [`${ROOT}/packages`, manifests.map(([name]) => dirent(name, "directory"))],
  ])
  for (const [directory, manifest] of manifests)
    const packageDirectory = `${ROOT}/packages/${directory}`
    directories.set(packageDirectory, [dirent("package.json", "file")])
    files.set(`${packageDirectory}/package.json`, `${JSON.stringify(manifest)}\n`)

  const metadataFactory = options.metadataFactory ?? (() => metadata())
  mocks.lstat.mockImplementation(async () => metadataFactory())
  mocks.open.mockImplementation(async (path: string) =>
    const source = files.get(String(path))
    if (source === undefined) throw new Error(`Unexpected virtual file: ${String(path)}`)
    return fileHandle(source, metadataFactory())
  )
  mocks.opendir.mockImplementation(async (path: string) =>
    asyncDirectory(directories.get(String(path)) ?? [])
  )

const configureWorkspaceConfigRead = (
  source: string,
  before: Metadata,
  opened: Metadata,
  after: Metadata = before,
) =>
  resetFileSystemMocks()
  const handle = fileHandle(source, opened)
  mocks.lstat
    .mockResolvedValueOnce(before)
    .mockResolvedValueOnce(after)
  mocks.open.mockResolvedValueOnce(handle)
  mocks.opendir.mockResolvedValue(asyncDirectory([]))
  return handle

const targetExports = (
  count: number,
  target = "./types/index.d.ts",
): Readonly<Record<string, unknown>> => Object.fromEntries(
  Array.from({ length: count }, (_, index) => [
    `./entry-${index.toString().padStart(4, "0")}`,
    { types: target },
  ]),
)

beforeEach(() =>
  resetFileSystemMocks()
)

afterEach(() =>
  vi.restoreAllMocks()
)

describe("type export filesystem and aggregate boundaries", () =>
  it("rejects an opened workspace config that changes type or crosses its size bound", async () =>
    for (const opened of [
      metadata("other"),
      metadata("file", { size: WORKSPACE_CONFIG_BYTES + 1 }),
    ])
      const handle = configureWorkspaceConfigRead(
        'packages:\n  - "packages/*"\n',
        metadata(),
        opened,
      )
      await expect(auditTypeExports(ROOT)).rejects.toThrow(
        /regular non-symbolic file|exceeds 65536 bytes/i,
      )
      expect(handle.close).toHaveBeenCalledOnce()
  )

  it("rejects a workspace config that grows beyond the read buffer", async () =>
    const handle = configureWorkspaceConfigRead(
      "x".repeat(WORKSPACE_CONFIG_BYTES + 1),
      metadata("file", { size: 1 }),
      metadata("file", { size: 1 }),
    )

    await expect(auditTypeExports(ROOT)).rejects.toThrow(
      `pnpm-workspace.yaml exceeds ${WORKSPACE_CONFIG_BYTES} bytes`,
    )
    expect(handle.read).toHaveBeenCalledOnce()
    expect(handle.close).toHaveBeenCalledOnce()
  )

  it("detects every post-open identity race and always closes the handle", async () =>
    const changedMetadata = [
      metadata("file", { isSymbolicLink: () => true }),
      metadata("other"),
      metadata("file", { dev: 2 }),
      metadata("file", { ino: 2 }),
    ]

    for (const after of changedMetadata)
      const handle = configureWorkspaceConfigRead(
        'packages:\n  - "packages/*"\n',
        metadata(),
        metadata(),
        after,
      )
      await expect(auditTypeExports(ROOT)).rejects.toThrow(
        "pnpm-workspace.yaml changed during audit",
      )
      expect(handle.close).toHaveBeenCalledOnce()
  )

  it("opens bounded files with the supported no-follow flag", async () =>
    installVirtualWorkspace([])

    await expect(auditTypeExports(ROOT)).resolves.toEqual([])
    expect(mocks.open).toHaveBeenCalledWith(
      `${ROOT}/pnpm-workspace.yaml`,
      constants.O_RDONLY | constants.O_NOFOLLOW,
    )
  )

  it("enforces the aggregate workspace directory limit", async () =>
    resetFileSystemMocks()
    const config = 'packages:\n  - "workspaces/*"\n'
    mocks.lstat.mockResolvedValue(metadata())
    mocks.open.mockResolvedValue(fileHandle(config))
    mocks.opendir.mockImplementation(async (path: string) =>
      if (String(path) === ROOT) return asyncDirectory([dirent("workspaces", "directory")])
      if (String(path) === `${ROOT}/workspaces`)
        return asyncDirectory((function* ()
          for (let index = 0; index < WORKSPACE_DIRECTORIES; index += 1)
            yield dirent(`workspace-${index}`, "directory")
        )())
      return asyncDirectory([])
    )

    await expect(auditTypeExports(ROOT)).rejects.toThrow(
      `Workspace directory count exceeds ${WORKSPACE_DIRECTORIES}`,
    )
  , 30_000)

  it("enforces the aggregate workspace entry limit before sorting", async () =>
    resetFileSystemMocks()
    const config = 'packages:\n  - "packages/*"\n'
    mocks.lstat.mockResolvedValue(metadata())
    mocks.open.mockResolvedValue(fileHandle(config))
    mocks.opendir.mockResolvedValue(asyncDirectory((function* ()
      const entry = dirent("entry")
      for (let index = 0; index <= WORKSPACE_ENTRIES; index += 1) yield entry
    )()))

    await expect(auditTypeExports(ROOT)).rejects.toThrow(
      `Workspace directory entries exceed ${WORKSPACE_ENTRIES}`,
    )
  , 30_000)

  it("enforces the aggregate workspace package limit", async () =>
    installVirtualWorkspace(Array.from(
      { length: WORKSPACE_PACKAGES + 1 },
      (_, index) => [
        `package-${index.toString().padStart(4, "0")}`,
        { name: `@fixture/package-${index}`, exports: {} },
      ] as const,
    ))

    await expect(auditTypeExports(ROOT)).rejects.toThrow(
      `Workspace package count exceeds ${WORKSPACE_PACKAGES}`,
    )
  , 30_000)

  it("enforces the aggregate export node limit across individually valid packages", async () =>
    const exports = Array.from({ length: EXPORT_NODES - 1 }, () => null)
    installVirtualWorkspace(Array.from(
      { length: Math.floor(TOTAL_EXPORT_NODES / EXPORT_NODES) + 1 },
      (_, index) => [
        `nodes-${index.toString().padStart(2, "0")}`,
        { name: `@fixture/nodes-${index}`, exports },
      ] as const,
    ))

    await expect(auditTypeExports(ROOT)).rejects.toThrow(
      `Workspace exports exceed ${TOTAL_EXPORT_NODES} total nodes`,
    )
  , 30_000)

  it("enforces the aggregate type-target limit across individually valid packages", async () =>
    const exports = targetExports(TYPE_TARGETS)
    installVirtualWorkspace(Array.from(
      { length: Math.floor(TOTAL_TYPE_TARGETS / TYPE_TARGETS) + 1 },
      (_, index) => [
        `targets-${index.toString().padStart(2, "0")}`,
        { name: `@fixture/targets-${index}`, exports },
      ] as const,
    ))

    await expect(auditTypeExports(ROOT)).rejects.toThrow(
      `Workspace exports exceed ${TOTAL_TYPE_TARGETS} total type targets`,
    )
  , 30_000)

  it("enforces the aggregate target-lstat limit across deep valid targets", async () =>
    const deepTarget = "./a/b/c/d/e/f/g/h/i/j/index.d.ts"
    const exports = targetExports(TYPE_TARGETS, deepTarget)
    installVirtualWorkspace(Array.from(
      { length: TOTAL_TYPE_TARGETS / TYPE_TARGETS },
      (_, index) => [
        `targets-${index.toString().padStart(2, "0")}`,
        { name: `@fixture/targets-${index}`, exports },
      ] as const,
    ), { metadataFactory: dualMetadata })

    await expect(auditTypeExports(ROOT)).rejects.toThrow(
      `Type export audit exceeds ${TOTAL_TARGET_LSTATS} total filesystem checks`,
    )
  , 30_000)

  it("rejects every resolved package-relative escape shape", async () =>
    for (const escaped of ["..", "../outside.d.ts", "/outside.d.ts"])
      installVirtualWorkspace([[
        "escaped",
        {
          name: "@fixture/escaped",
          exports: { ".": { types: "./types/index.d.ts" } },
        },
      ]])
      mocks.relative.mockReturnValueOnce(escaped)

      await expect(auditTypeExports(ROOT)).rejects.toThrow(
        "path traversal is not allowed",
      )
  )

  it("propagates non-ENOENT declaration inspection errors", async () =>
    installVirtualWorkspace([[
      "denied",
      {
        name: "@fixture/denied",
        exports: { ".": { types: "./types/index.d.ts" } },
      },
    ]])
    const denied = Object.assign(new Error("permission denied"), { code: "EACCES" })
    mocks.lstat.mockImplementation(async (path: string) =>
      if (String(path).includes("/types")) throw denied
      return metadata()
    )

    await expect(auditTypeExports(ROOT)).rejects.toBe(denied)

    const rawFailure = "raw declaration inspection failure"
    mocks.lstat.mockImplementation(async (path: string) =>
      if (String(path).includes("/types")) throw rawFailure
      return metadata()
    )
    await expect(auditTypeExports(ROOT)).rejects.toBe(rawFailure)
  )

)
