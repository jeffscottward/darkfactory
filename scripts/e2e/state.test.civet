import { constants } from "node:fs"
import {
  lstat,
  mkdir,
  mkdtemp,
  readFile,
  readdir,
  rm,
  symlink,
  writeFile,
} from "node:fs/promises"
import { tmpdir } from "node:os"
import { join } from "node:path"

import { afterEach, describe, expect, it, vi } from "vitest"

import type { JourneyResult, JourneySuiteReport } from "./runner.civet"
import { persistE2ERunnerState } from "./state.civet"

const result = (
  spec = "tests/e2e/auth.spec.ts",
  diagnostics: readonly string[] = [],
): JourneyResult => Object.freeze({
  spec,
  runId: "safe_state_run",
  playwrightExitCode: 1,
  diagnostics,
  lifecycleStatus: "startup-failed",
  lifecycleStage: "database-migrate",
  lifecycleObservation: "state",
  lifecycleObservationReason: "observed-state",
  processState: "terminated",
  stage: "execute",
  processTreeTerminated: true,
  scan: Object.freeze({
    ok: true,
    scannedEntries: 1,
    findings: [],
    purged: true,
    reason: "private scan reason",
  }),
})

const report = (results: readonly JourneyResult[]): JourneySuiteReport =>
  Object.freeze({
    ok: false,
    mode: "e2e",
    completed: results.length,
    results,
    reason: "private suite reason",
  })

const fixture = async (): Promise<string> =>
  await mkdtemp(join(tmpdir(), "darkfactory-runner-state-"))

const statePath = (root: string): string =>
  join(root, "test-results", "e2e-runner-state.json")

describe("atomic E2E runner state", () =>
  it("atomically overwrites progress and final sanitized result at mode 0600", async () =>
    const root = await fixture()
    try
      persistE2ERunnerState(root, {
        version: 1,
        phase: "progress",
        progress: {
          spec: "tests/e2e/auth.spec.ts",
          runId: "safe_state_run",
          stage: "playwright-finished",
          playwrightOk: false,
          processTreeTerminated: true,
          lifecycleStatus: "startup-failed",
          lifecycleStage: "database-migrate",
          lifecycleObservation: "state",
          lifecycleObservationReason: "observed-state",
        },
      })
      expect(JSON.parse(await readFile(statePath(root), "utf8"))).toMatchObject({
        phase: "progress",
        progress: { stage: "playwright-finished", playwrightOk: false },
      })

      persistE2ERunnerState(root, {
        version: 1,
        phase: "result",
        report: report([result("tests/e2e/auth.spec.ts", [
          "stderr: E2E lifecycle startup failed during database-migrate. private@example.test",
          "stderr: Error: Process from config.webServer was not able to start. Exit code: 1",
          "stderr: ELIFECYCLE Command failed with token=private",
          "private@example.test https://domain.test/?token=private Password123!",
        ])]),
      })
      const content = await readFile(statePath(root), "utf8")
      expect(JSON.parse(content)).toMatchObject({
        version: 1,
        phase: "result",
        report: {
          ok: false,
          completed: 1,
          results: [{
            stage: "execute",
            diagnostics: [
              "E2E lifecycle startup failed during database-migrate",
              "Playwright webServer process failed before tests",
              "Package lifecycle exited nonzero",
            ],
            scan: { ok: true, purged: true, reason: "scan-complete" },
          }],
          reason: "journey-suite-failed",
        },
      })
      expect(content).not.toMatch(
        /private@example|domain\.test|token=|Password123|private scan|private suite/iu,
      )
      expect((await lstat(statePath(root))).mode & 0o777).toBe(0o600)
      expect((await readdir(join(root, "test-results"))).filter((name) =>
        name.endsWith(".tmp")
      )).toEqual([])
    finally
      await rm(root, { force: true, recursive: true })
  )

  it("rejects an unknown runtime progress stage", async () =>
    const root = await fixture()
    try
      expect(() => persistE2ERunnerState(root, {
        version: 1,
        phase: "progress",
        progress: {
          spec: "tests/e2e/auth.spec.ts",
          runId: "safe_state_run",
          stage: "unknown",
        } as never,
      })).toThrow(/progress stage is invalid/i)
    finally
      await rm(root, { force: true, recursive: true })
  )

  it("preserves the finite post-readiness runtime failure enums", async () =>
    const root = await fixture()
    try
      persistE2ERunnerState(root, {
        version: 1,
        phase: "result",
        report: report([Object.freeze({
          ...result(),
          lifecycleStatus: "runtime-failed",
          lifecycleStage: "server-ready",
        })]),
      })
      expect(JSON.parse(await readFile(statePath(root), "utf8"))).toMatchObject({
        phase: "result",
        report: {
          results: [{
            lifecycleStatus: "runtime-failed",
            lifecycleStage: "server-ready",
          }],
        },
      })
    finally
      await rm(root, { force: true, recursive: true })
  )

  it("rejects a malicious fixed-target symlink without touching its referent", async () =>
    const root = await fixture()
    const outside = join(root, "outside.json")
    try
      await mkdir(join(root, "test-results"))
      await writeFile(outside, "outside-safe")
      await symlink(outside, statePath(root))
      expect(() => persistE2ERunnerState(root, {
        version: 1,
        phase: "result",
        report: report([result()]),
      })).toThrow(/target is unsafe/i)
      await expect(readFile(outside, "utf8")).resolves.toBe("outside-safe")
    finally
      await rm(root, { force: true, recursive: true })
  )

  it("rejects an oversized sanitized report and leaves no temporary file", async () =>
    const root = await fixture()
    const results = Array.from({ length: 256 }, (_, index) => result(
      `tests/e2e/${"a".repeat(190)}-${index}.spec.ts`,
    ))
    try
      expect(() => persistE2ERunnerState(root, {
        version: 1,
        phase: "result",
        report: report(results),
      })).toThrow(/fixed bound/i)
      expect((await readdir(join(root, "test-results"))).filter((name) =>
        name.endsWith(".tmp")
      )).toEqual([])
    finally
      await rm(root, { force: true, recursive: true })
  )
)

const stateParentStats = (dev = 1, ino = 2) => ({
  dev,
  ino,
  isDirectory: () => true,
  isSymbolicLink: () => false,
})

const stateTemporaryStats = (mode = 0o600) => ({
  mode,
  isFile: () => true,
})

const missingStateTarget = (): NodeJS.ErrnoException =>
  Object.assign(new Error("missing"), { code: "ENOENT" })

const fakeStateFileSystem = () =>
  const lstatSync = vi.fn()
    .mockReturnValueOnce(stateParentStats())
    .mockImplementationOnce(() =>
      throw missingStateTarget()
    )
    .mockReturnValueOnce(stateParentStats())
  const openSync = vi.fn()
    .mockReturnValueOnce(41)
    .mockReturnValueOnce(42)
  return {
    closeSync: vi.fn(),
    constants: { ...constants, O_NOFOLLOW: undefined },
    fstatSync: vi.fn(() => stateTemporaryStats()),
    fsyncSync: vi.fn(),
    lstatSync,
    mkdirSync: vi.fn(),
    openSync,
    realpathSync: vi.fn((path: string) => path),
    renameSync: vi.fn(),
    rmSync: vi.fn(),
    writeSync: vi.fn((
      _descriptor: number,
      _content: Buffer,
      _offset: number,
      length: number,
    ) => length),
  }

const loadFakeStatePersistence = async (
  filesystem: ReturnType<typeof fakeStateFileSystem>,
) =>
  vi.doUnmock("node:crypto")
  vi.doUnmock("node:fs")
  vi.resetModules()
  vi.doMock("node:crypto", () => ({
    randomUUID: () => "fixed-state-write",
  }))
  vi.doMock("node:fs", () => filesystem)
  return (await import("./state.civet")).persistE2ERunnerState

const createdProgressState = Object.freeze({
  version: 1 as const,
  phase: "progress" as const,
  progress: Object.freeze({
    spec: "tests/e2e/auth.spec.ts",
    runId: "fake_state_run",
    stage: "created" as const,
  }),
})

describe("atomic state filesystem fakes", () =>
  afterEach(() =>
    vi.doUnmock("node:crypto")
    vi.doUnmock("node:fs")
    vi.resetModules()
    vi.restoreAllMocks()
  )

  it("uses portable flags and completes a partial state write", async () =>
    const filesystem = fakeStateFileSystem()
    let writes = 0
    filesystem.writeSync.mockImplementation((
      _descriptor: number,
      _content: Buffer,
      _offset: number,
      length: number,
    ) => writes++ === 0 ? 1 : length)
    const persist = await loadFakeStatePersistence(filesystem)

    expect(() => persist("/workspace", createdProgressState)).not.toThrow()

    expect(filesystem.writeSync).toHaveBeenCalledTimes(2)
    expect(filesystem.openSync).toHaveBeenNthCalledWith(
      1,
      `/workspace/test-results/.e2e-runner-state.${process.pid}-fixed-state-write.tmp`,
      constants.O_CREAT | constants.O_EXCL | constants.O_WRONLY,
      0o600,
    )
    expect(filesystem.openSync).toHaveBeenNthCalledWith(
      2,
      "/workspace/test-results",
      constants.O_RDONLY,
    )
    expect(filesystem.renameSync).toHaveBeenCalledOnce()
    expect(filesystem.fsyncSync).toHaveBeenCalledTimes(2)
    expect(filesystem.closeSync).toHaveBeenCalledTimes(2)
    expect(filesystem.rmSync).not.toHaveBeenCalled()
  )

  it("closes and removes a temporary file with unsafe metadata", async () =>
    const filesystem = fakeStateFileSystem()
    filesystem.fstatSync.mockReturnValue(stateTemporaryStats(0o644))
    const persist = await loadFakeStatePersistence(filesystem)

    expect(() => persist("/workspace", createdProgressState)).toThrow(
      /temporary is unsafe/i,
    )
    expect(filesystem.closeSync).toHaveBeenCalledWith(41)
    expect(filesystem.rmSync).toHaveBeenCalledWith(
      expect.stringContaining(".e2e-runner-state."),
      { force: true },
    )
    expect(filesystem.renameSync).not.toHaveBeenCalled()
  )

  it("preserves a no-progress write error when best-effort close also fails", async () =>
    const filesystem = fakeStateFileSystem()
    filesystem.writeSync.mockReturnValue(0)
    filesystem.closeSync.mockImplementation(() =>
      throw new Error("private close failure")
    )
    const persist = await loadFakeStatePersistence(filesystem)

    expect(() => persist("/workspace", createdProgressState)).toThrow(
      /write made no progress/i,
    )
    expect(filesystem.closeSync).toHaveBeenCalledWith(41)
    expect(filesystem.rmSync).toHaveBeenCalledOnce()
    expect(filesystem.renameSync).not.toHaveBeenCalled()
  )

  it("removes the temporary file when the parent identity changes before publish", async () =>
    const filesystem = fakeStateFileSystem()
    filesystem.lstatSync.mockReset()
      .mockReturnValueOnce(stateParentStats())
      .mockImplementationOnce(() =>
        throw missingStateTarget()
      )
      .mockReturnValueOnce(stateParentStats(9, 9))
    const persist = await loadFakeStatePersistence(filesystem)

    expect(() => persist("/workspace", createdProgressState)).toThrow(
      /parent identity changed/i,
    )
    expect(filesystem.renameSync).not.toHaveBeenCalled()
    expect(filesystem.rmSync).toHaveBeenCalledOnce()
    expect(filesystem.closeSync).toHaveBeenCalledTimes(1)
  )

  it("rethrows a non-existence mkdir failure before touching state paths", async () =>
    const filesystem = fakeStateFileSystem()
    const failure = Object.assign(new Error("private mkdir failure"), {
      code: "EACCES",
    })
    filesystem.mkdirSync.mockImplementation(() =>
      throw failure
    )
    const persist = await loadFakeStatePersistence(filesystem)

    expect(() => persist("/workspace", createdProgressState)).toThrow(failure)
    expect(filesystem.lstatSync).not.toHaveBeenCalled()
    expect(filesystem.openSync).not.toHaveBeenCalled()
    expect(filesystem.rmSync).not.toHaveBeenCalled()
  )

  it("removes an unopened temporary path without attempting descriptor cleanup", async () =>
    const filesystem = fakeStateFileSystem()
    const failure = Object.assign(new Error("private open failure"), {
      code: "EACCES",
    })
    filesystem.openSync.mockReset().mockImplementationOnce(() =>
      throw failure
    )
    const persist = await loadFakeStatePersistence(filesystem)

    expect(() => persist("/workspace", createdProgressState)).toThrow(failure)
    expect(filesystem.closeSync).not.toHaveBeenCalled()
    expect(filesystem.rmSync).toHaveBeenCalledWith(
      `/workspace/test-results/.e2e-runner-state.${process.pid}-fixed-state-write.tmp`,
      { force: true },
    )
    expect(filesystem.renameSync).not.toHaveBeenCalled()
  )

  it("preserves the write failure when best-effort close throws a primitive", async () =>
    const filesystem = fakeStateFileSystem()
    filesystem.writeSync.mockReturnValue(0)
    filesystem.closeSync.mockImplementation(() =>
      throw "private primitive close failure"
    )
    const persist = await loadFakeStatePersistence(filesystem)

    expect(() => persist("/workspace", createdProgressState)).toThrow(
      /write made no progress/i,
    )
    expect(filesystem.closeSync).toHaveBeenCalledWith(41)
    expect(filesystem.rmSync).toHaveBeenCalledOnce()
    expect(filesystem.renameSync).not.toHaveBeenCalled()
  )
)
