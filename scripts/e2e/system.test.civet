import {
  access,
  chmod,
  lstat,
  mkdir,
  mkdtemp,
  open,
  readFile,
  realpath,
  rm,
  symlink,
  writeFile,
} from "node:fs/promises"
import { constants } from "node:fs"
import { tmpdir } from "node:os"
import { join } from "node:path"
import { deflateSync } from "node:zlib"

import { afterEach, describe, expect, it, vi } from "vitest"

import {
  assertOwnedLifecycleRoots,
  createArtifactScannerDependencies,
  createOwnedLifecyclePaths,
  decodeOwnedRunAdoption,
  decodeOwnedRunProof,
  encodeOwnedRunAdoption,
  encodeOwnedRunProof,
  finalizeOwnedLifecycleAfterPlaywright,
  prepareOwnedRun,
  readOwnedLifecycleState,
  type ArtifactScanLimits,
  type OwnedLifecyclePaths,
  type OwnedRunProof,
} from "./system.civet"

const proofFixture = (): OwnedRunProof => Object.freeze({
  version: 1,
  runId: "safe_run",
  nonce: "n".repeat(43),
  artifactProfile: "no-binary",
  e2e: Object.freeze({
    root: Object.freeze({ dev: 11, ino: 12 }),
    marker: Object.freeze({ dev: 13, ino: 14 }),
  }),
  evidence: Object.freeze({
    root: Object.freeze({ dev: 21, ino: 22 }),
    marker: Object.freeze({ dev: 23, ino: 24 }),
  }),
})

const encodeJson = (value: unknown): string =>
  Buffer.from(JSON.stringify(value), "utf8").toString("base64url")

const withOwnedRun = async (
  operation: (root: string, proof: OwnedRunProof) => Promise<void>,
): Promise<void> => {
  const root = await realpath(await mkdtemp(join(tmpdir(), "darkfactory-system-test-")))
  try {
    const proof = await prepareOwnedRun(root, "safe_run", "no-binary")
    await operation(root, proof)
  } finally {
    await rm(root, { force: true, recursive: true })
  }
}

const lifecycle = async (
  root: string,
  proof: OwnedRunProof,
): Promise<Readonly<{
  adoption: ReturnType<typeof decodeOwnedRunAdoption>
  paths: OwnedLifecyclePaths
}>> => {
  const paths = await createOwnedLifecyclePaths(root, proof.runId)
  const adoption = decodeOwnedRunAdoption(
    encodeOwnedRunAdoption(proof),
    proof.runId,
  )
  return Object.freeze({ adoption, paths })
}

const lifecycleStatePath = (paths: OwnedLifecyclePaths): string =>
  join(paths.e2e, "lifecycle-state.json")

const playwrightReportPath = (paths: OwnedLifecyclePaths): string =>
  join(paths.e2e, "playwright-report.json")

const writeLifecycleState = async (
  paths: OwnedLifecyclePaths,
  value: unknown,
): Promise<void> => {
  const path = lifecycleStatePath(paths)
  await rm(path, { force: true, recursive: true })
  await writeFile(path, `${JSON.stringify(value)}\n`, { mode: 0o600 })
  await chmod(path, 0o600)
}

const executedReport = Object.freeze({
  suites: [{ specs: [{ tests: [{ results: [{ status: "passed" }] }] }] }],
})

const scannerPaths = (proof: OwnedRunProof): readonly string[] => Object.freeze([
  `test-results/e2e-runs/${proof.runId}`,
  `test-results/evidence/${proof.runId}`,
])

const limits = (
  overrides: Partial<ArtifactScanLimits> = {},
): ArtifactScanLimits => Object.freeze({
  maxEntries: 100,
  maxEntryBytes: 1_024,
  maxTotalBytes: 16_384,
  maxArchives: 10,
  maxExpandedBytes: 16_384,
  deadlineMs: 10_000,
  ...overrides,
})

const PNG_SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
const PNG_CRC_TABLE = Uint32Array.from({ length: 256 }, (_unused, index) => {
  let value = index
  for (let bit = 0; bit < 8; bit += 1) {
    value = (value & 1) === 1 ? 0xedb88320 ^ (value >>> 1) : value >>> 1
  }
  return value >>> 0
})
const pngCrc32 = (content: Buffer): number => {
  let crc = 0xffffffff
  for (const byte of content) {
    crc = (PNG_CRC_TABLE[(crc ^ byte) & 0xff] ?? 0) ^ (crc >>> 8)
  }
  return (crc ^ 0xffffffff) >>> 0
}
const pngChunk = (type: string, content: Buffer): Buffer => {
  const length = Buffer.alloc(4)
  length.writeUInt32BE(content.byteLength)
  const body = Buffer.concat([Buffer.from(type, "ascii"), content])
  const checksum = Buffer.alloc(4)
  checksum.writeUInt32BE(pngCrc32(body))
  return Buffer.concat([length, body, checksum])
}
const pngFixture = (
  colorType: 0 | 2 | 4 | 6,
  beforeImage: readonly Buffer[] = [],
  afterImage: readonly Buffer[] = [],
): Buffer => {
  const channels = colorType === 0 ? 1 : colorType === 2 ? 3 : colorType === 4 ? 2 : 4
  const header = Buffer.alloc(13)
  header.writeUInt32BE(1, 0)
  header.writeUInt32BE(1, 4)
  header[8] = 8
  header[9] = colorType
  const image = pngChunk("IDAT", deflateSync(Buffer.alloc(1 + channels)))
  return Buffer.concat([
    PNG_SIGNATURE,
    pngChunk("IHDR", header),
    ...beforeImage,
    image,
    ...afterImage,
    pngChunk("IEND", Buffer.alloc(0)),
  ])
}

describe("owned run capability encoding", () => {
  it("round-trips proof and nonce-free adoption capabilities", () => {
    const proof = proofFixture()

    expect(decodeOwnedRunProof(encodeOwnedRunProof(proof))).toEqual(proof)
    const adoption = decodeOwnedRunAdoption(
      encodeOwnedRunAdoption(proof),
      proof.runId,
    )
    expect(adoption).toMatchObject({
      version: 1,
      runId: proof.runId,
      artifactProfile: proof.artifactProfile,
      e2e: proof.e2e,
      evidence: proof.evidence,
    })
    expect(adoption.nonceDigest).toMatch(/^[a-f0-9]{64}$/u)
    expect(JSON.stringify(adoption)).not.toContain(proof.nonce)
    expect(Object.isFrozen(adoption)).toBe(true)
  })

  it.each([
    ["invalid transport characters", "not+base64"],
    ["malformed JSON", Buffer.from("{", "utf8").toString("base64url")],
    ["wrong version", encodeJson({ ...proofFixture(), version: 2 })],
    ["unsafe run identifier", encodeJson({ ...proofFixture(), runId: "../escape" })],
    ["short nonce", encodeJson({ ...proofFixture(), nonce: "short" })],
    ["unknown artifact profile", encodeJson({ ...proofFixture(), artifactProfile: "all-binary" })],
    ["missing evidence identity", encodeJson({ ...proofFixture(), evidence: undefined })],
    ["fractional root identity", encodeJson({
      ...proofFixture(),
      e2e: { ...proofFixture().e2e, root: { dev: 1.5, ino: 2 } },
    })],
    ["missing marker inode", encodeJson({
      ...proofFixture(),
      evidence: {
        ...proofFixture().evidence,
        marker: { dev: 1 },
      },
    })],
  ] as const)("rejects a proof with %s", (_case, encoded) => {
    expect(() => decodeOwnedRunProof(encoded)).toThrow()
  })

  it("rejects mismatched, noncanonical, and overprivileged adoptions", () => {
    const proof = proofFixture()
    const encoded = encodeOwnedRunAdoption(proof)
    const canonical = JSON.parse(
      Buffer.from(encoded, "base64url").toString("utf8"),
    ) as Record<string, unknown>
    const noncanonical = [1, 2, 3]
      .map((count) => `${encoded}${"A".repeat(count)}`)
      .find((candidate) =>
        Buffer.from(candidate, "base64url").toString("base64url") !== candidate
      )
    expect(noncanonical).toBeDefined()
    expect(() => decodeOwnedRunAdoption(
      noncanonical as string,
      proof.runId,
    )).toThrow(/noncanonical/i)

    expect(() => decodeOwnedRunAdoption(`${encoded}=`, proof.runId)).toThrow(
      /adoption encoding/i,
    )
    expect(() => decodeOwnedRunAdoption(encoded, "different_run")).toThrow(
      /invalid owned E2E adoption/i,
    )
    expect(() => decodeOwnedRunAdoption(encodeJson({
      runId: canonical["runId"],
      version: canonical["version"],
      artifactProfile: canonical["artifactProfile"],
      nonceDigest: canonical["nonceDigest"],
      e2e: canonical["e2e"],
      evidence: canonical["evidence"],
    }), proof.runId)).toThrow(/noncanonical/i)
    expect(() => decodeOwnedRunAdoption(encodeJson({
      ...canonical,
      extraCapability: true,
    }), proof.runId)).toThrow(/noncanonical/i)
    expect(() => decodeOwnedRunAdoption(encodeJson({
      ...canonical,
      e2e: {
        ...(canonical["e2e"] as Record<string, unknown>),
        root: { dev: -1, ino: 12 },
      },
    }), proof.runId)).toThrow(/invalid owned E2E adoption/i)
    expect(() => decodeOwnedRunAdoption(encodeJson({
      ...canonical,
      nonceDigest: "A".repeat(64),
    }), proof.runId)).toThrow(/invalid owned E2E adoption/i)
  })

  it("rejects malformed adoption JSON at the canonical transport boundary", () => {
    const proof = proofFixture()

    expect(() => decodeOwnedRunAdoption(
      Buffer.from("{", "utf8").toString("base64url"),
      proof.runId,
    )).toThrow(SyntaxError)
    expect(() => decodeOwnedRunAdoption("A".repeat(2_048), proof.runId)).toThrow(
      SyntaxError,
    )
  })
  it("rejects malformed proof and adoption fields at every identity boundary", () => {
    const proof = proofFixture()
    const invalidProofs = [
      { ...proof, runId: 7 },
      { ...proof, nonce: 7 },
      { ...proof, e2e: undefined },
      { ...proof, e2e: { ...proof.e2e, marker: null } },
      { ...proof, evidence: { ...proof.evidence, root: "not-an-identity" } },
      { ...proof, evidence: { ...proof.evidence, root: { dev: 1 } } },
    ]
    for (const candidate of invalidProofs) {
      expect(() => decodeOwnedRunProof(encodeJson(candidate))).toThrow(
        /invalid owned E2E proof/i,
      )
    }

    const canonical = JSON.parse(
      Buffer.from(encodeOwnedRunAdoption(proof), "base64url").toString("utf8"),
    ) as Record<string, unknown>
    const invalidAdoptions = [
      [{ ...canonical, runId: "../escape" }, "../escape"],
      [{ ...canonical, artifactProfile: "all-binary" }, proof.runId],
      [{ ...canonical, nonceDigest: 7 }, proof.runId],
      [{ ...canonical, e2e: undefined }, proof.runId],
      [{ ...canonical, evidence: undefined }, proof.runId],
      [{
        ...canonical,
        e2e: {
          ...(canonical["e2e"] as Record<string, unknown>),
          marker: null,
        },
      }, proof.runId],
      [{
        ...canonical,
        evidence: {
          ...(canonical["evidence"] as Record<string, unknown>),
          root: { dev: 1.5, ino: 2 },
        },
      }, proof.runId],
      [{
        ...canonical,
        evidence: {
          ...(canonical["evidence"] as Record<string, unknown>),
          marker: { dev: 1, ino: -1 },
        },
      }, proof.runId],
    ] as const
    for (const [candidate, expectedRunId] of invalidAdoptions) {
      expect(() => decodeOwnedRunAdoption(
        encodeJson(candidate),
        expectedRunId,
      )).toThrow(/invalid owned E2E adoption/i)
    }
  })
  it("rejects mismatched lifecycle paths and replaced root capabilities", async () => {
    await withOwnedRun(async (root, proof) => {
      const { adoption, paths } = await lifecycle(root, proof)
      await expect(assertOwnedLifecycleRoots({
        ...paths,
        e2e: `${paths.e2e}-other`,
      }, adoption)).rejects.toThrow(/lifecycle paths are invalid/i)

      await rm(paths.e2e, { force: true, recursive: true })
      await mkdir(paths.e2e)
      await expect(assertOwnedLifecycleRoots(paths, adoption)).rejects.toThrow(
        /root identity or capability changed/i,
      )
    })
  })

  it("classifies a vanished lifecycle root as capability drift", async () => {
    await withOwnedRun(async (root, proof) => {
      const { adoption, paths } = await lifecycle(root, proof)
      await rm(paths.e2e, { force: true, recursive: true })

      await expect(assertOwnedLifecycleRoots(paths, adoption)).rejects.toThrow(
        /root identity or capability changed/i,
      )
    })
  })

  it("rejects a replaced ownership marker capability", async () => {
    await withOwnedRun(async (root, proof) => {
      const { adoption, paths } = await lifecycle(root, proof)
      const marker = join(paths.evidence, ".darkfactory-e2e-owner.json")
      await rm(marker)
      await writeFile(marker, "{}", { mode: 0o600 })

      await expect(assertOwnedLifecycleRoots(paths, adoption)).rejects.toThrow(
        /marker identity or capability changed/i,
      )
    })
  })

  it("removes partial run roots when the second owned root cannot be created", async () => {
    const root = await mkdtemp(join(tmpdir(), "darkfactory-system-partial-"))
    const e2e = join(root, "test-results", "e2e-runs", "safe_run")
    const evidence = join(root, "test-results", "evidence", "safe_run")
    try {
      await mkdir(evidence, { recursive: true })

      await expect(prepareOwnedRun(root, "safe_run", "no-binary")).rejects.toMatchObject({
        code: "EEXIST",
      })
      await expect(access(e2e)).rejects.toMatchObject({ code: "ENOENT" })
      await expect(access(evidence)).rejects.toMatchObject({ code: "ENOENT" })
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })
  it("rejects gzip drift and reads bounded TAR metadata through injected tools", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const gzipPath = join(paths.e2e, "trace.gz")
      await writeFile(gzipPath, Buffer.from([0x1f, 0x8b, 0, 0]))

      const gzipCases = [
        [
          "unknown size",
          "compressed uncompressed ratio name\ninvalid\n",
          Buffer.alloc(0),
          /gzip entry size is unknown/i,
        ],
        [
          "changed size",
          "compressed uncompressed ratio name\n4 5 20% artifact\n",
          Buffer.from("four"),
          /gzip size changed/i,
        ],
        [
          "nested payload",
          "compressed uncompressed ratio name\n4 4 0% artifact\n",
          Buffer.from([0x50, 0x4b, 0x03, 0x04]),
          /nested compressed artifacts/i,
        ],
      ] as const
      for (const [_case, metadata, content, message] of gzipCases) {
        const dependencies = await createArtifactScannerDependencies(
          root,
          proof,
          async (file, arguments_) => {
            expect(file).toBe("gzip")
            return arguments_[0] === "-l"
              ? { stdout: Buffer.from(metadata) }
              : { stdout: content }
          },
          limits(),
        )
        await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
          message,
        )
      }

      await rm(gzipPath)
      const tarPath = join(paths.e2e, "trace.tgz")
      await writeFile(tarPath, Buffer.from([0x1f, 0x8b, 0, 0]))
      const tarExecutor = vi.fn(async (file: string, arguments_: readonly string[]) => {
        expect(file).toBe("tar")
        if (arguments_[0] === "-tf") return { stdout: Buffer.from("a.txt\n") }
        if (arguments_[0] === "-tvf") {
          return {
            stdout: Buffer.from(
              "-rw-r--r-- user/group 3 2026-07-25 00:00 a.txt\n",
            ),
          }
        }
        if (arguments_[0] === "-xOf") return { stdout: Buffer.from("ABC") }
        throw new Error("unexpected TAR operation")
      })
      const tarDependencies = await createArtifactScannerDependencies(
        root,
        proof,
        tarExecutor,
        limits(),
      )
      const entries = await tarDependencies.collectEntries(scannerPaths(proof))
      expect(entries.find((entry) =>
        entry.path.endsWith("trace.tgz#contents")
      )?.content).toBe("a.txt\nABC")

      const tooManyMembers = await createArtifactScannerDependencies(
        root,
        proof,
        async (_file, arguments_) => arguments_[0] === "-tf"
          ? {
              stdout: Buffer.from(
                `${Array.from({ length: 101 }, (_unused, index) => `entry-${index}`).join("\n")}\n`,
              ),
            }
          : { stdout: Buffer.alloc(0) },
        limits(),
      )
      await expect(tooManyMembers.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /archive member count exceeds/i,
      )
    })
  })
  it("leaves both roots in place when pre-quarantine validation fails", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const dependencies = await createArtifactScannerDependencies(root, proof)
      await writeFile(
        join(paths.evidence, ".darkfactory-e2e-owner.json"),
        "{}",
        { mode: 0o600 },
      )

      await expect(dependencies.purgeOwnedRun(proof.runId)).rejects.toThrow(
        /marker capability mismatch/i,
      )
      await expect(access(paths.e2e)).resolves.toBeUndefined()
      await expect(access(paths.evidence)).resolves.toBeUndefined()
    })
  })
})

describe("owned lifecycle filesystem contracts", () => {
  it.each([
    ["an unsafe run identifier", "../escape", "no-binary"],
    ["an empty run identifier", "", "no-binary"],
    ["an unknown artifact profile", "safe_run", "all-binary"],
  ] as const)("rejects %s before creating owned roots", async (_case, runId, profile) => {
    const root = await mkdtemp(join(tmpdir(), "darkfactory-system-invalid-"))
    try {
      await expect(prepareOwnedRun(
        root,
        runId,
        profile as "no-binary",
      )).rejects.toThrow(/invalid E2E (?:run identifier|artifact profile)/i)
      await expect(access(join(root, "test-results"))).rejects.toMatchObject({
        code: "ENOENT",
      })
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("creates authenticated roots and reports a missing lifecycle state", async () => {
    await withOwnedRun(async (root, proof) => {
      const { adoption, paths } = await lifecycle(root, proof)

      await expect(assertOwnedLifecycleRoots(paths, adoption)).resolves.toBeUndefined()
      await expect(readOwnedLifecycleState(paths, adoption)).resolves.toBeUndefined()
      expect(paths).toEqual({
        repository: root,
        e2e: join(root, "test-results", "e2e-runs", proof.runId),
        evidence: join(root, "test-results", "evidence", proof.runId),
      })
      await expect(createOwnedLifecyclePaths(root, "../escape")).rejects.toThrow(
        /run identity is invalid/i,
      )
    })
  })

  it("rejects redirected directory ancestry", async () => {
    const root = await mkdtemp(join(tmpdir(), "darkfactory-system-symlink-"))
    try {
      const outside = join(root, "outside")
      await mkdir(outside)
      await symlink(outside, join(root, "test-results"))

      await expect(prepareOwnedRun(root, "safe_run", "no-binary")).rejects.toThrow(
        /directory ancestry is unsafe/i,
      )
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("detects marker capability drift after adoption", async () => {
    await withOwnedRun(async (root, proof) => {
      const { adoption, paths } = await lifecycle(root, proof)
      const markerPath = join(paths.e2e, ".darkfactory-e2e-owner.json")
      const { authenticStats, driftedContent } = await (async () => {
        const marker = await open(markerPath, "r+")
        try {
          const authenticContent = await marker.readFile({ encoding: "utf8" })
          const authenticStats = await marker.stat()
          const replacement = adoption.nonceDigest.endsWith("0") ? "1" : "0"
          const driftedContent = authenticContent.replace(
            adoption.nonceDigest,
            `${adoption.nonceDigest.slice(0, -1)}${replacement}`,
          )
          const driftedBytes = Buffer.from(driftedContent, "utf8")

          expect(authenticContent).toBe(JSON.stringify(adoption))
          expect(JSON.parse(driftedContent)).toBeDefined()
          expect(driftedContent).not.toBe(authenticContent)
          expect(driftedBytes.byteLength).toBe(
            Buffer.byteLength(authenticContent, "utf8"),
          )

          const { bytesWritten } = await marker.write(
            driftedBytes,
            0,
            driftedBytes.byteLength,
            0,
          )
          expect(bytesWritten).toBe(driftedBytes.byteLength)
          await marker.sync()
          return { authenticStats, driftedContent }
        } finally {
          await marker.close()
        }
      })()

      expect(await readFile(markerPath, "utf8")).toBe(driftedContent)
      const driftedStats = await lstat(markerPath)
      expect(driftedStats.dev).toBe(authenticStats.dev)
      expect(driftedStats.ino).toBe(authenticStats.ino)
      expect(driftedStats.size).toBe(authenticStats.size)
      expect(authenticStats.isFile()).toBe(true)
      expect(driftedStats.isFile()).toBe(authenticStats.isFile())
      expect(driftedStats.mode).toBe(authenticStats.mode)

      await expect(assertOwnedLifecycleRoots(paths, adoption)).rejects.toThrow(
        /^Owned lifecycle marker identity or capability changed$/u,
      )
    })
  })

  it("accepts canonical lifecycle states and rejects malformed state files", async () => {
    await withOwnedRun(async (root, proof) => {
      const { adoption, paths } = await lifecycle(root, proof)
      const valid = { version: 1, status: "stopped", stage: "server-ready" }
      await writeLifecycleState(paths, valid)
      await expect(readOwnedLifecycleState(paths, adoption)).resolves.toEqual(valid)

      const invalidStates = [
        "{",
        "{}\n",
        '{"version":2,"status":"stopped","stage":"server-ready"}\n',
        '{"version":1,"status":"unknown","stage":"server-ready"}\n',
        '{"version":1,"status":"stopped","stage":"unknown"}\n',
        '{"version":1,"status":"starting","stage":"server-ready"}\n',
        '{"version":1,"status":"ready","stage":"module-loading"}\n',
        '{"version":1,"status":"runtime-failed","stage":"database-seed"}\n',
        '{"status":"stopped","version":1,"stage":"server-ready"}\n',
        '{"version":1,"status":"stopped","stage":"server-ready","extra":true}\n',
        '{"version":1,"status":"stopped","stage":"server-ready"}',
      ]
      for (const content of invalidStates) {
        await rm(lifecycleStatePath(paths), { force: true, recursive: true })
        await writeFile(lifecycleStatePath(paths), content, { mode: 0o600 })
        await chmod(lifecycleStatePath(paths), 0o600)
        await expect(readOwnedLifecycleState(paths, adoption)).rejects.toThrow()
      }

      await writeLifecycleState(paths, valid)
      await chmod(lifecycleStatePath(paths), 0o644)
      await expect(readOwnedLifecycleState(paths, adoption)).rejects.toThrow(
        /state file is unsafe/i,
      )

      await rm(lifecycleStatePath(paths), { force: true })
      await mkdir(lifecycleStatePath(paths))
      await expect(readOwnedLifecycleState(paths, adoption)).rejects.toThrow(
        /state file is unsafe/i,
      )
    })
  })
})

describe("Playwright lifecycle finalization", () => {
  it.each([
    [
      "keeps state when the process tree is unproven",
      { version: 1, status: "stopped", stage: "server-spawn" },
      true,
      0,
      false,
      { version: 1, status: "stopped", stage: "server-spawn" },
    ],
    [
      "keeps state when the report is missing",
      { version: 1, status: "stopped", stage: "server-spawn" },
      false,
      0,
      true,
      { version: 1, status: "stopped", stage: "server-spawn" },
    ],
    [
      "keeps state when no journey result executed",
      { version: 1, status: "stopped", stage: "server-spawn" },
      "empty",
      0,
      true,
      { version: 1, status: "stopped", stage: "server-spawn" },
    ],
    ["keeps a missing state missing", undefined, true, 1, true, undefined],
    [
      "keeps a non-stopped state",
      { version: 1, status: "ready", stage: "server-ready" },
      true,
      1,
      true,
      { version: 1, status: "ready", stage: "server-ready" },
    ],
    [
      "keeps a pre-server stopped stage",
      { version: 1, status: "stopped", stage: "database-seed" },
      true,
      0,
      true,
      { version: 1, status: "stopped", stage: "database-seed" },
    ],
    [
      "keeps an already clean server-ready stop",
      { version: 1, status: "stopped", stage: "server-ready" },
      true,
      0,
      true,
      { version: 1, status: "stopped", stage: "server-ready" },
    ],
    [
      "repairs a passing SIGTERM race to server-ready",
      { version: 1, status: "stopped", stage: "server-spawn" },
      true,
      0,
      true,
      { version: 1, status: "stopped", stage: "server-ready" },
    ],
    [
      "maps a failed executed journey to runtime-failed",
      { version: 1, status: "stopped", stage: "server-probed" },
      true,
      1,
      true,
      { version: 1, status: "runtime-failed", stage: "server-probed" },
    ],
  ] as const)("%s", async (
    _case,
    current,
    report,
    exitCode,
    treeTerminated,
    expected,
  ) => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      if (current !== undefined) await writeLifecycleState(paths, current)
      if (report === true) {
        await writeFile(playwrightReportPath(paths), JSON.stringify(executedReport))
      } else if (report === "empty") {
        await writeFile(playwrightReportPath(paths), '{"suites":[]}')
      }

      await expect(finalizeOwnedLifecycleAfterPlaywright({
        encodedAdoption: encodeOwnedRunAdoption(proof),
        exitCode,
        repositoryPath: root,
        runId: proof.runId,
        treeTerminated,
      })).resolves.toEqual(expected)
    })
  })

  it("rejects malformed inputs and propagates an unsafe report", async () => {
    await expect(finalizeOwnedLifecycleAfterPlaywright({
      encodedAdoption: "",
      exitCode: 1.5,
      repositoryPath: "/unused",
      runId: "safe_run",
      treeTerminated: true,
    })).rejects.toThrow(/input is invalid/i)
    await expect(finalizeOwnedLifecycleAfterPlaywright({
      encodedAdoption: "",
      exitCode: 1,
      repositoryPath: "/unused",
      runId: "safe_run",
      treeTerminated: "yes" as never,
    })).rejects.toThrow(/input is invalid/i)

    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeLifecycleState(paths, {
        version: 1,
        status: "stopped",
        stage: "server-spawn",
      })
      await writeFile(playwrightReportPath(paths), "{")

      await expect(finalizeOwnedLifecycleAfterPlaywright({
        encodedAdoption: encodeOwnedRunAdoption(proof),
        exitCode: 1,
        repositoryPath: root,
        runId: proof.runId,
        treeTerminated: true,
      })).rejects.toThrow()
    })
  })
})

describe("artifact scanner system dependencies", () => {
  it.each([
    ["zero entry count", { maxEntries: 0 }],
    ["fractional entry size", { maxEntryBytes: 1.5 }],
    ["zero total size", { maxTotalBytes: 0 }],
    ["zero archive count", { maxArchives: 0 }],
    ["zero expanded size", { maxExpandedBytes: 0 }],
    ["negative deadline", { deadlineMs: -1 }],
    ["excessive deadline", { deadlineMs: 30_001 }],
  ] as const)("rejects limits with %s", async (_case, overrides) => {
    await expect(createArtifactScannerDependencies(
      "/unused",
      proofFixture(),
      undefined,
      limits(overrides),
    )).rejects.toThrow(/scan limits are invalid/i)
  })

  it("rejects an invalid proof and scanner path list", async () => {
    await expect(createArtifactScannerDependencies(
      "/unused",
      { ...proofFixture(), runId: "../escape" },
    )).rejects.toThrow(/invalid owned E2E proof/i)

    await withOwnedRun(async (root, proof) => {
      const dependencies = await createArtifactScannerDependencies(root, proof)
      await expect(dependencies.collectEntries([
        `test-results/evidence/${proof.runId}`,
        `test-results/e2e-runs/${proof.runId}`,
      ])).rejects.toThrow(/paths do not match/i)
      await expect(dependencies.purgeOwnedRun("another_run")).rejects.toThrow(
        /proof does not match run/i,
      )
    })
  })

  it("collects stable text, unsupported bytes, and a strict PNG", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(join(paths.e2e, "note.txt"), "public evidence")
      await writeFile(join(paths.evidence, "control.bin"), Buffer.from([0]))
      await writeFile(join(paths.evidence, "opaque.bin"), Buffer.from([0xff, 0x00]))
      const png = Buffer.from(
        "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR4nGNgYAAAAAMAAbitOmMAAAAASUVORK5CYII=",
        "base64",
      )
      await writeFile(join(paths.evidence, "pixel.png"), png)

      const dependencies = await createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )
      const entries = await dependencies.collectEntries(scannerPaths(proof))
      expect(entries.find((entry) => entry.path.endsWith("note.txt"))).toMatchObject({
        content: "public evidence",
      })
      expect(entries.find((entry) => entry.path.endsWith("opaque.bin"))).toMatchObject({
        binary: "unsupported",
      })
      expect(entries.find((entry) => entry.path.endsWith("control.bin"))).toMatchObject({
        binary: "unsupported",
      })
      expect(entries.find((entry) => entry.path.endsWith("pixel.png"))).toMatchObject({
        binary: "png",
      })
      expect(entries.every((entry) => entry.sha256?.match(/^[a-f0-9]{64}$/u))).toBe(true)

      const corrupt = Buffer.from(png)
      corrupt[corrupt.byteLength - 1] = (corrupt.at(-1) ?? 0) ^ 0xff
      await writeFile(join(paths.evidence, "corrupt.png"), corrupt)
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /PNG chunk checksum is invalid/i,
      )
    })
  })

  it("rejects symlinks, false archive extensions, and unsupported compression", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const dependencies = await createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      await writeFile(join(root, "outside.txt"), "outside")
      await symlink(join(root, "outside.txt"), join(paths.e2e, "linked.txt"))
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /symlinks or redirected ancestry are unsafe/i,
      )
      await rm(join(paths.e2e, "linked.txt"))

      await writeFile(join(paths.e2e, "fake.zip"), "not a zip")
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /extension does not match archive magic/i,
      )
      await rm(join(paths.e2e, "fake.zip"))

      for (const magic of [
        Buffer.from([0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00]),
        Buffer.from("BZh", "ascii"),
        Buffer.from([0x37, 0x7a, 0xbc, 0xaf, 0x27, 0x1c]),
      ]) {
        await writeFile(join(paths.e2e, "compressed.bin"), magic)
        await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
          /unsupported compressed artifact format/i,
        )
      }
    })
  })

  it("forwards bounded gzip operations and returns the expanded entry", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(join(paths.e2e, "trace.gz"), Buffer.from([0x1f, 0x8b, 0, 0]))
      const execute = vi.fn(async (
        file: string,
        arguments_: readonly string[],
        _maxBuffer: number,
        _timeoutMs?: number,
        _signal?: AbortSignal,
      ) => {
        expect(file).toBe("gzip")
        if (arguments_[0] === "-l") {
          return { stdout: Buffer.from("compressed uncompressed ratio name\n4 5 20% artifact\n") }
        }
        if (arguments_[0] === "-cd") return { stdout: Buffer.from("hello") }
        throw new Error("unexpected gzip operation")
      })
      const dependencies = await createArtifactScannerDependencies(
        root,
        proof,
        execute,
        limits(),
      )

      const entries = await dependencies.collectEntries(scannerPaths(proof))
      expect(entries.find((entry) => entry.path.endsWith("trace.gz#uncompressed"))).toMatchObject({
        content: "hello",
      })
      expect(execute.mock.calls.map(([file, arguments_]) => [file, arguments_[0]])).toEqual([
        ["gzip", "-l"],
        ["gzip", "-cd"],
      ])
      expect(execute.mock.calls.every((call) =>
        typeof call[3] === "number" && call[3] > 0 && call[4]?.aborted === false
      )).toBe(true)
    })
  })

  it("validates archive names, metadata, extracted size, and nesting", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(join(paths.e2e, "bundle.zip"), Buffer.from([0x50, 0x4b, 0x03, 0x04]))

      const zipExecutor = (
        names: string,
        metadata: string,
        body: Buffer,
      ) => vi.fn(async (_file: string, arguments_: readonly string[]) => {
        if (arguments_[0] === "-Z1") return { stdout: Buffer.from(names) }
        if (arguments_[0] === "-Z") return { stdout: Buffer.from(metadata) }
        if (arguments_[0] === "-p") return { stdout: body }
        throw new Error("unexpected zip operation")
      })

      const clean = await createArtifactScannerDependencies(
        root,
        proof,
        zipExecutor(
          "a.txt\nnested/b.txt\n",
          "uncompressed size: 1 bytes\nuncompressed size: 2 bytes\n",
          Buffer.from("ABC"),
        ),
        limits(),
      )
      const entries = await clean.collectEntries(scannerPaths(proof))
      expect(entries.find((entry) => entry.path.endsWith("bundle.zip#contents"))?.content).toBe(
        "a.txt\nnested/b.txt\nABC",
      )

      for (const unsafeName of [
        "-option",
        "/absolute.txt",
        "C:\\absolute.txt",
        "../escape.txt",
        "control\u0001.txt",
      ]) {
        const unsafe = await createArtifactScannerDependencies(
          root,
          proof,
          zipExecutor(`${unsafeName}\n`, "", Buffer.alloc(0)),
          limits(),
        )
        await expect(unsafe.collectEntries(scannerPaths(proof))).rejects.toThrow(
          /unsafe archive entry name/i,
        )
      }

      const nestedName = await createArtifactScannerDependencies(
        root,
        proof,
        zipExecutor("inner.tgz\n", "", Buffer.alloc(0)),
        limits(),
      )
      await expect(nestedName.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /nested archives are rejected/i,
      )

      const unknownSize = await createArtifactScannerDependencies(
        root,
        proof,
        zipExecutor("a.txt\n", "", Buffer.from("A")),
        limits(),
      )
      await expect(unknownSize.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /entry size is unknown/i,
      )

      const changedSize = await createArtifactScannerDependencies(
        root,
        proof,
        zipExecutor("a.txt\n", "uncompressed size: 2 bytes\n", Buffer.from("A")),
        limits(),
      )
      await expect(changedSize.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /archive size changed/i,
      )

      const nestedPayload = await createArtifactScannerDependencies(
        root,
        proof,
        zipExecutor(
          "a.txt\n",
          "uncompressed size: 4 bytes\n",
          Buffer.from([0x50, 0x4b, 0x03, 0x04]),
        ),
        limits(),
      )
      await expect(nestedPayload.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /nested compressed artifacts are rejected/i,
      )
    })
  })

  it("enforces deadline, entry, byte, archive, and expansion bounds", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(join(paths.e2e, "one.txt"), "one")

      const expired = await createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits({ deadlineMs: 0 }),
      )
      await expect(expired.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /deadline exceeded/i,
      )

      const countBound = await createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits({ maxEntries: 1 }),
      )
      await expect(countBound.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /entry count exceeds/i,
      )

      await rm(join(paths.e2e, "one.txt"))
      await writeFile(join(paths.e2e, "one.gz"), Buffer.from([0x1f, 0x8b, 0, 0]))
      const oversizedEntry = vi.fn(async (_file: string, arguments_: readonly string[]) =>
        arguments_[0] === "-l"
          ? { stdout: Buffer.from("compressed uncompressed ratio name\n4 513 99% artifact\n") }
          : { stdout: Buffer.alloc(513) }
      )
      const entryBound = await createArtifactScannerDependencies(
        root,
        proof,
        oversizedEntry,
        limits({ maxEntryBytes: 512 }),
      )
      await expect(entryBound.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /artifact exceeds scan size bound/i,
      )

      const totalBound = await createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits({ maxTotalBytes: 1 }),
      )
      await expect(totalBound.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /aggregate scan bound/i,
      )

      await writeFile(join(paths.evidence, "two.gz"), Buffer.from([0x1f, 0x8b, 0, 0]))
      const execute = vi.fn(async (_file: string, arguments_: readonly string[]) =>
        arguments_[0] === "-l"
          ? { stdout: Buffer.from("compressed uncompressed ratio name\n4 5 20% artifact\n") }
          : { stdout: Buffer.from("hello") }
      )
      const archiveBound = await createArtifactScannerDependencies(
        root,
        proof,
        execute,
        limits({ maxArchives: 1 }),
      )
      await expect(archiveBound.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /global archive count exceeds/i,
      )

      const expandedBound = await createArtifactScannerDependencies(
        root,
        proof,
        execute,
        limits({ maxExpandedBytes: 4 }),
      )
      await expect(expandedBound.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /expanded artifacts exceed/i,
      )
    })
  })

  it("purges only the authenticated run roots", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const dependencies = await createArtifactScannerDependencies(root, proof)

      await dependencies.purgeOwnedRun(proof.runId)

      await expect(access(paths.e2e)).rejects.toMatchObject({ code: "ENOENT" })
      await expect(access(paths.evidence)).rejects.toMatchObject({ code: "ENOENT" })
      await expect(access(join(root, "test-results", "e2e-runs"))).resolves.toBeUndefined()
      await expect(access(join(root, "test-results", "evidence"))).resolves.toBeUndefined()
    })
  })
  it("rejects scanner paths that escape after validation", async () => {
    await withOwnedRun(async (root, proof) => {
      const expected = [...scannerPaths(proof)]
      const paths = new Proxy(expected, {
        get: (target, property, receiver) => property === Symbol.iterator
          ? function* () {
              yield "../escape"
              yield target[1] as string
            }
          : Reflect.get(target, property, receiver),
      }) as readonly string[]
      const dependencies = await createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      await expect(dependencies.collectEntries(paths)).rejects.toThrow(
        /escapes or replaces the repository root/i,
      )
    })
  })

  it("reads direct TAR magic with BSD metadata", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const tar = Buffer.alloc(262)
      tar.write("ustar", 257, "ascii")
      await writeFile(join(paths.e2e, "portable.bin"), tar)
      const execute = vi.fn(async (file: string, arguments_: readonly string[]) => {
        expect(file).toBe("tar")
        if (arguments_[0] === "-tf") return { stdout: Buffer.from("a.txt\n") }
        if (arguments_[0] === "-tvf") {
          return {
            stdout: Buffer.from("-rw-r--r-- 1 owner group 3 Jan 01 00:00 a.txt\n"),
          }
        }
        if (arguments_[0] === "-xOf") return { stdout: Buffer.from("ABC") }
        throw new Error("unexpected TAR operation")
      })
      const dependencies = await createArtifactScannerDependencies(
        root,
        proof,
        execute,
        limits(),
      )

      const entries = await dependencies.collectEntries(scannerPaths(proof))

      expect(entries.find((entry) =>
        entry.path.endsWith("portable.bin#contents")
      )?.content).toBe("a.txt\nABC")
      expect(execute).toHaveBeenCalledTimes(3)
    })
  })

  it("rejects TAR metadata that omits the expanded size", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const tar = Buffer.alloc(262)
      tar.write("ustar", 257, "ascii")
      await writeFile(join(paths.e2e, "missing-size.tar"), tar)
      const extract = vi.fn(async () => ({ stdout: Buffer.from("A") }))
      const execute = vi.fn(async (_file: string, arguments_: readonly string[]) => {
        if (arguments_[0] === "-tf") return { stdout: Buffer.from("a.txt\n") }
        if (arguments_[0] === "-tvf") {
          return { stdout: Buffer.from("metadata without an encoded size\n") }
        }
        if (arguments_[0] === "-xOf") return await extract()
        throw new Error("unexpected TAR operation")
      })
      const dependencies = await createArtifactScannerDependencies(
        root,
        proof,
        execute,
        limits(),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /archive entry size is unknown/i,
      )
      expect(extract).not.toHaveBeenCalled()
    })
  })

  it("accepts grayscale and RGB PNGs and rejects strict PNG boundaries", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(join(paths.evidence, "gray.png"), pngFixture(0))
      await writeFile(join(paths.evidence, "rgb.png"), pngFixture(2))
      const generousLimits = limits({
        maxEntryBytes: 11 * 1024 * 1024,
        maxTotalBytes: 12 * 1024 * 1024,
      })
      const dependencies = await createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        generousLimits,
      )

      const entries = await dependencies.collectEntries(scannerPaths(proof))
      expect(entries.find((entry) => entry.path.endsWith("gray.png"))?.binary).toBe("png")
      expect(entries.find((entry) => entry.path.endsWith("rgb.png"))?.binary).toBe("png")

      const unsafePath = join(paths.evidence, "unsafe.png")
      const oversized = Buffer.alloc(10 * 1024 * 1024 + 1)
      PNG_SIGNATURE.copy(oversized)
      await writeFile(unsafePath, oversized)
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /not a permitted PNG/i,
      )

      await writeFile(
        unsafePath,
        pngFixture(2, [pngChunk("PLTE", Buffer.alloc(771))]),
      )
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /palette is invalid/i,
      )

      await writeFile(
        unsafePath,
        pngFixture(2, [pngChunk("PLTE", Buffer.alloc(1))]),
      )
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /palette is invalid/i,
      )

      await writeFile(
        unsafePath,
        pngFixture(2, [], [pngChunk("PLTE", Buffer.alloc(3))]),
      )
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /palette is invalid/i,
      )
    })
  })

  it("treats truncated ZIP magic as an ordinary unsupported artifact", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(join(paths.e2e, "short.bin"), Buffer.from([0x50, 0x4b, 0x03]))
      const dependencies = await createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      const entries = await dependencies.collectEntries(scannerPaths(proof))

      expect(entries.find((entry) => entry.path.endsWith("short.bin"))).toMatchObject({
        binary: "unsupported",
      })
    })
  })

  it("rejects an owned proof whose root identity no longer matches", async () => {
    await withOwnedRun(async (root, proof) => {
      const changedProof: OwnedRunProof = {
        ...proof,
        e2e: {
          ...proof.e2e,
          root: { ...proof.e2e.root, ino: proof.e2e.root.ino + 1 },
        },
      }
      const dependencies = await createArtifactScannerDependencies(
        root,
        changedProof,
        undefined,
        limits(),
      )

      await expect(dependencies.collectEntries(scannerPaths(changedProof))).rejects.toThrow(
        /root identity changed/i,
      )
    })
  })
})

type FileSystemPromises = typeof import("node:fs/promises")

const loadSystemWithFileSystem = async (
  patch: (actual: FileSystemPromises) => Record<string, unknown>,
) => {
  vi.doUnmock("node:fs")
  vi.doUnmock("node:fs/promises")
  vi.resetModules()
  vi.doMock("node:fs", async (importOriginal) => {
    const actual = await importOriginal<typeof import("node:fs")>()
    return {
      ...actual,
      constants: { ...actual.constants, O_NOFOLLOW: undefined },
    }
  })
  vi.doMock("node:fs/promises", async (importOriginal) => {
    const actual = await importOriginal<FileSystemPromises>()
    return { ...actual, ...patch(actual) }
  })
  return await import("./system.civet")
}

describe("artifact system filesystem fakes", () => {
  afterEach(() => {
    vi.doUnmock("node:fs")
    vi.doUnmock("node:child_process")
    vi.doUnmock("node:fs/promises")
    vi.resetModules()
    vi.restoreAllMocks()
  })

  it("converts an archive snapshot cleanup failure to its bounded category", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(
        join(paths.e2e, "snapshot.zip"),
        Buffer.from([0x50, 0x4b, 0x03, 0x04]),
      )
      let snapshotDirectory: string | undefined
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        mkdtemp: async (prefix: string) => {
          snapshotDirectory = await actual.mkdtemp(prefix)
          return snapshotDirectory
        },
        open: async (path: string, flags: number, mode?: number) => {
          if (path.endsWith("/artifact.zip")) {
            throw new Error("private snapshot open failure")
          }
          return await actual.open(path, flags, mode)
        },
        rm: async (
          path: string,
          options: { force?: boolean; recursive?: boolean },
        ) => {
          if (path === snapshotDirectory) {
            throw new Error("private snapshot cleanup failure")
          }
          return await actual.rm(path, options)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      try {
        await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
          /temporary cleanup failed/i,
        )
      } finally {
        if (snapshotDirectory !== undefined) {
          await rm(snapshotDirectory, { force: true, recursive: true })
        }
      }
    })
  })

  it("closes stable-file handles for unsafe metadata and read-time replacement", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const artifactPath = join(paths.e2e, "changing.txt")
      await writeFile(artifactPath, "stable")
      let behavior: "changed" | "unsafe" = "unsafe"
      const closes: ReturnType<typeof vi.fn>[] = []
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        open: async (path: string, flags: number, mode?: number) => {
          if (path !== artifactPath) return await actual.open(path, flags, mode)
          const stats = await actual.lstat(path)
          const close = vi.fn(async () => undefined)
          closes.push(close)
          if (behavior === "unsafe") {
            return {
              close,
              readFile: vi.fn(async () => Buffer.from("stable")),
              stat: vi.fn(async () => ({
                dev: stats.dev,
                ino: stats.ino,
                size: stats.size,
                isFile: () => false,
              })),
            }
          }
          return {
            close,
            readFile: vi.fn(async () => Buffer.from("stable")),
            stat: vi.fn()
              .mockResolvedValueOnce(stats)
              .mockResolvedValueOnce({
                dev: stats.dev,
                ino: stats.ino + 1,
                size: stats.size,
              }),
          }
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /identity or size is unsafe/i,
      )
      behavior = "changed"
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /identity changed while reading/i,
      )
      expect(closes).toHaveLength(2)
      expect(closes.every((close) => close.mock.calls.length === 1)).toBe(true)
    })
  })

  it("ignores vanished entries and counts non-file filesystem nodes", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const vanished = join(paths.e2e, "vanished")
      const special = join(paths.e2e, "special")
      const specialDirectory = {
        [Symbol.asyncIterator]: async function* () {
          yield { name: "vanished" }
          yield { name: "special" }
        },
      }
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        lstat: async (path: string) => {
          if (path === vanished) {
            throw Object.assign(new Error("vanished"), { code: "ENOENT" })
          }
          if (path === special) {
            return {
              dev: 1,
              ino: 2,
              isDirectory: () => false,
              isFile: () => false,
              isSymbolicLink: () => false,
            }
          }
          return await actual.lstat(path)
        },
        opendir: async (path: string) => {
          if (path !== paths.e2e) return await actual.opendir(path)
          return specialDirectory
        },
        realpath: async (path: string) => {
          if (path === special) return special
          return await actual.realpath(path)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      const entries = await dependencies.collectEntries(scannerPaths(proof))
      expect(entries.every((entry) =>
        !entry.path.endsWith("vanished") && !entry.path.endsWith("special")
      )).toBe(true)
    })
  })

  it("reports rollback failure when a quarantined root cannot be restored", async () => {
    await withOwnedRun(async (root, proof) => {
      await lifecycle(root, proof)
      let renameCalls = 0
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        rename: async (from: string, to: string) => {
          renameCalls += 1
          if (renameCalls === 2) throw new Error("private quarantine failure")
          if (renameCalls === 3) throw new Error("private rollback failure")
          await actual.rename(from, to)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
      )

      await expect(dependencies.purgeOwnedRun(proof.runId)).rejects.toThrow(
        /purge rollback failed/i,
      )
    })
  })
  it("detects a directory identity change after iteration", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      let runRootStats = 0
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        lstat: async (path: string) => {
          const stats = await actual.lstat(path)
          if (path !== paths.e2e || ++runRootStats !== 4) return stats
          return {
            dev: stats.dev + 1,
            ino: stats.ino,
            isDirectory: () => true,
            isFile: () => false,
            isSymbolicLink: () => false,
          }
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /directory identity changed while scanning/i,
      )
    })
  })

