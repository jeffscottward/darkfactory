  it("refuses to remove a quarantine whose identity changes after rename", async () => {
    await withOwnedRun(async (root, proof) => {
      const quarantineStats = new Map<string, number>()
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        lstat: async (path: string) => {
          const stats = await actual.lstat(path)
          if (!path.includes("/.purge-")) return stats
          const observations = (quarantineStats.get(path) ?? 0) + 1
          quarantineStats.set(path, observations)
          if (observations === 1) return stats
          return {
            dev: stats.dev,
            ino: stats.ino + 1,
            isSymbolicLink: () => false,
          }
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
      )

      await expect(dependencies.purgeOwnedRun(proof.runId)).rejects.toThrow(
        /quarantine identity changed/i,
      )
      expect(quarantineStats.size).toBe(2)
    })
  })
  it("runs trusted archive commands through the bounded execFile adapter", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(
        join(paths.e2e, "default-executor.gz"),
        Buffer.from([0x1f, 0x8b, 0, 0]),
      )
      type ExecCallback = (error: Error | null, stdout: Buffer) => void
      const execFile = vi.fn((
        _file: string,
        arguments_: readonly string[],
        _options: Record<string, unknown>,
        callback: ExecCallback,
      ) => {
        callback(
          null,
          arguments_[0] === "-l"
            ? Buffer.from(
                "compressed uncompressed ratio name\n4 5 20% artifact\n",
              )
            : Buffer.from("hello"),
        )
        return {}
      })
      vi.doMock("node:child_process", async (importOriginal) => {
        const actual = await importOriginal<typeof import("node:child_process")>()
        return { ...actual, execFile }
      })
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        access: async (path: string, mode?: number) => {
          if (path === "/usr/bin/gzip") return undefined
          return await actual.access(path, mode)
        },
        realpath: async (path: string) => {
          if (path === "/usr/bin/gzip") return path
          return await actual.realpath(path)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      const entries = await dependencies.collectEntries(scannerPaths(proof))
      expect(entries.find((entry) =>
        entry.path.endsWith("default-executor.gz#uncompressed")
      )?.content).toBe("hello")
      expect(execFile).toHaveBeenCalledTimes(2)
      expect(execFile.mock.calls.every((call) => {
        const options = call[2]
        return options["encoding"] === "buffer" &&
          (options["maxBuffer"] as number) > 0 &&
          (options["timeout"] as number) > 0 &&
          options["signal"] instanceof AbortSignal &&
          options["windowsHide"] === true
      })).toBe(true)

      execFile.mockImplementation((
        _file: string,
        _arguments: readonly string[],
        _options: Record<string, unknown>,
        callback: ExecCallback,
      ) => {
        callback(new Error("private archive execution failure"), Buffer.alloc(0))
        return {}
      })
      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        "private archive execution failure",
      )
    })
  })
  it("falls back to the trusted bin archive path", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(
        join(paths.e2e, "fallback.gz"),
        Buffer.from([0x1f, 0x8b, 0, 0]),
      )
      type ExecCallback = (error: Error | null, stdout: Buffer) => void
      const execFile = vi.fn((
        _file: string,
        arguments_: readonly string[],
        _options: Record<string, unknown>,
        callback: ExecCallback,
      ) => {
        callback(
          null,
          arguments_[0] === "-l"
            ? Buffer.from("compressed uncompressed ratio name\n4 5 20% artifact\n")
            : Buffer.from("hello"),
        )
        return {}
      })
      vi.doMock("node:child_process", async (importOriginal) => {
        const actual = await importOriginal<typeof import("node:child_process")>()
        return { ...actual, execFile }
      })
      const candidates: string[] = []
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        access: async (path: string, mode?: number) => path === "/bin/gzip"
          ? undefined
          : await actual.access(path, mode),
        realpath: async (path: string) => {
          if (path === "/usr/bin/gzip") {
            candidates.push(path)
            throw Object.assign(new Error("missing"), { code: "ENOENT" })
          }
          if (path === "/bin/gzip") {
            candidates.push(path)
            return path
          }
          return await actual.realpath(path)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      const entries = await dependencies.collectEntries(scannerPaths(proof))

      expect(entries.find((entry) =>
        entry.path.endsWith("fallback.gz#uncompressed")
      )?.content).toBe("hello")
      expect(candidates).toEqual(["/usr/bin/gzip", "/bin/gzip"])
      expect(execFile.mock.calls.every(([file]) => file === "/bin/gzip")).toBe(true)
    })
  })

  it("fails closed when no trusted archive executable exists", async () => {
