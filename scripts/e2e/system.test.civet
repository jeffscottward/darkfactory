        exitCode: 1,
        repositoryPath: root,
        runId: proof.runId,
        treeTerminated: true,
      })).rejects.toThrow(/finalization was not durable/i)
    })
  })

  it("suppresses temporary lifecycle cleanup faults without masking the write error", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeLifecycleState(paths, {
        version: 1,
        status: "stopped",
        stage: "server-spawn",
      })
      await writeFile(playwrightReportPath(paths), JSON.stringify(executedReport))
      let temporaryPath: string | undefined
      const close = vi.fn()
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        open: async (path: string, flags: number, mode?: number) => {
          const handle = await actual.open(path, flags, mode)
          if (!path.includes(".lifecycle-state.json.parent-")) return handle
          temporaryPath = path
          close.mockImplementation(async () => {
            await handle.close()
            throw new Error("private lifecycle close failure")
          })
          return {
            close,
            sync: () => handle.sync(),
            writeFile: async () => {
              throw new Error("private lifecycle write failure")
            },
          }
        },
        rm: async (
          path: string,
          options: { force?: boolean; recursive?: boolean },
        ) => {
          const result = await actual.rm(path, options)
          if (path === temporaryPath) {
            throw new Error("private lifecycle cleanup failure")
          }
          return result
        },
      }))

      await expect(dynamic.finalizeOwnedLifecycleAfterPlaywright({
        encodedAdoption: dynamic.encodeOwnedRunAdoption(proof),
        exitCode: 1,
        repositoryPath: root,
        runId: proof.runId,
        treeTerminated: true,
      })).rejects.toThrow("private lifecycle write failure")
      expect(close).toHaveBeenCalledTimes(1)
      expect(temporaryPath).toBeDefined()
      await expect(access(temporaryPath as string)).rejects.toMatchObject({
        code: "ENOENT",
      })
    })
  })

  it("rejects lifecycle state replaced while it is being read", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeLifecycleState(paths, {
        version: 1,
        status: "stopped",
        stage: "server-ready",
      })
      const statePath = lifecycleStatePath(paths)
      const close = vi.fn()
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        open: async (path: string, flags: number, mode?: number) => {
          const handle = await actual.open(path, flags, mode)
          if (path !== statePath) return handle
          const before = await handle.stat()
          close.mockImplementation(() => handle.close())
          return {
            close,
            readFile: (options: { encoding: "utf8" }) => handle.readFile(options),
            stat: vi.fn()
              .mockResolvedValueOnce(before)
              .mockResolvedValueOnce({
                dev: before.dev,
                ino: before.ino + 1,
                size: before.size,
              }),
          }
        },
      }))
      const dynamicPaths = await dynamic.createOwnedLifecyclePaths(root, proof.runId)
      const adoption = dynamic.decodeOwnedRunAdoption(
        dynamic.encodeOwnedRunAdoption(proof),
        proof.runId,
      )

      await expect(dynamic.readOwnedLifecycleState(
        dynamicPaths,
        adoption,
      )).rejects.toThrow(/lifecycle state changed while reading/i)
      expect(close).toHaveBeenCalledTimes(1)
    })
  })

  it("reports quarantine identity drift even when rollback rename fails", async () => {
    await withOwnedRun(async (root, proof) => {
      let quarantinePath: string | undefined
      let renameCalls = 0
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        lstat: async (path: string) => {
          const stats = await actual.lstat(path)
          if (path !== quarantinePath) return stats
          return {
            dev: stats.dev,
            ino: stats.ino + 1,
            isSymbolicLink: () => false,
          }
        },
        rename: async (from: string, to: string) => {
          renameCalls += 1
          if (renameCalls === 1) {
            quarantinePath = to
            return await actual.rename(from, to)
          }
          if (renameCalls === 2) throw new Error("private quarantine rollback failure")
          return await actual.rename(from, to)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(root, proof)

      await expect(dependencies.purgeOwnedRun(proof.runId)).rejects.toThrow(
        /root changed during purge/i,
      )
      expect(renameCalls).toBe(2)
      await expect(access(quarantinePath as string)).resolves.toBeUndefined()
    })
  })

  it("fails rollback when a quarantined root changes identity before restoration", async () => {
    await withOwnedRun(async (root, proof) => {
      let firstQuarantine: string | undefined
      let quarantineStats = 0
      let renameCalls = 0
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        lstat: async (path: string) => {
          const stats = await actual.lstat(path)
          if (path !== firstQuarantine) return stats
          quarantineStats += 1
          if (quarantineStats === 1) return stats
          return {
            dev: stats.dev,
            ino: stats.ino + 1,
            isSymbolicLink: () => false,
          }
        },
        rename: async (from: string, to: string) => {
          renameCalls += 1
          if (renameCalls === 1) {
            firstQuarantine = to
            return await actual.rename(from, to)
          }
          if (renameCalls === 2) throw new Error("private second quarantine failure")
          return await actual.rename(from, to)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(root, proof)

      await expect(dependencies.purgeOwnedRun(proof.runId)).rejects.toThrow(
        /purge rollback failed/i,
      )
      expect(quarantineStats).toBe(2)
    })
  })

  it("restores the first quarantine before propagating the second failure", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      let renameCalls = 0
      const failure = new Error("private second quarantine failure")
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        rename: async (from: string, to: string) => {
          renameCalls += 1
          if (renameCalls === 2) throw failure
          return await actual.rename(from, to)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(root, proof)

      await expect(dependencies.purgeOwnedRun(proof.runId)).rejects.toBe(failure)
      expect(renameCalls).toBe(3)
      await expect(access(paths.e2e)).resolves.toBeUndefined()
      await expect(access(paths.evidence)).resolves.toBeUndefined()
    })
  })

  it("propagates artifact lstat errors other than ENOENT", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const deniedPath = join(paths.e2e, "denied.txt")
      await writeFile(deniedPath, "denied")
      const failure = Object.assign(new Error("private artifact access failure"), {
        code: "EACCES",
      })
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        lstat: async (path: string) => {
          if (path === deniedPath) throw failure
          return await actual.lstat(path)
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toBe(failure)
    })
  })

  it("enforces the deadline when accounting begins after a file stat", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const latePath = join(paths.e2e, "late.txt")
      await writeFile(latePath, "late")
      let now = 100
      let advanced = false
      vi.spyOn(Date, "now").mockImplementation(() => now)
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        lstat: async (path: string) => {
          const stats = await actual.lstat(path)
          if (path === latePath) {
            now = 111
            advanced = true
          }
          return stats
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits({ deadlineMs: 10 }),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /deadline exceeded/i,
      )
      expect(advanced).toBe(true)
    })
  })

  it("enforces the deadline before invoking an archive command", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(
        join(paths.e2e, "late.gz"),
        Buffer.from([0x1f, 0x8b, 0, 0]),
      )
      let now = 100
      let snapshotCreated = false
      vi.spyOn(Date, "now").mockImplementation(() => now)
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        mkdtemp: async (prefix: string) => {
          const directory = await actual.mkdtemp(prefix)
          now = 111
          snapshotCreated = true
          return directory
        },
      }))
      const execute = vi.fn(async () => ({ stdout: Buffer.alloc(0) }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        execute,
        limits({ deadlineMs: 10 }),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /deadline exceeded/i,
      )
      expect(snapshotCreated).toBe(true)
      expect(execute).not.toHaveBeenCalled()
    })
  })

  it("enforces the deadline before walking a newly yielded entry", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(join(paths.e2e, "late.txt"), "late")
      let now = 100
      let yieldedLateEntry = false
      vi.spyOn(Date, "now").mockImplementation(() => now)
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        opendir: async (path: string) => {
          const directory = await actual.opendir(path)
          if (path !== paths.e2e) return directory
          return {
            [Symbol.asyncIterator]: async function* () {
              for await (const entry of directory) {
                if (entry.name === "late.txt") {
                  now = 111
                  yieldedLateEntry = true
                }
                yield entry
              }
            },
          }
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits({ deadlineMs: 10 }),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /deadline exceeded/i,
      )
      expect(yieldedLateEntry).toBe(true)
    })
  })

  it("enforces the deadline after the final ownership validation", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      const evidenceMarker = join(paths.evidence, ".darkfactory-e2e-owner.json")
      let now = 100
      let markerReads = 0
      vi.spyOn(Date, "now").mockImplementation(() => now)
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        open: async (path: string, flags: number, mode?: number) => {
          const handle = await actual.open(path, flags, mode)
          if (path !== evidenceMarker) return handle
          markerReads += 1
          if (markerReads !== 3) return handle
          return {
            close: () => handle.close(),
            readFile: async (options: { encoding: "utf8" }) => {
              const content = await handle.readFile(options)
              now = 111
              return content
            },
            stat: () => handle.stat(),
          }
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits({ deadlineMs: 10 }),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /deadline exceeded/i,
      )
      expect(markerReads).toBe(3)
    })
  })
  it("fails closed when the PNG CRC lookup table is unavailable", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(join(paths.evidence, "crc-fault.png"), pngFixture(6))
      vi.spyOn(Uint32Array, "from").mockReturnValue(new Uint32Array(0))
      const dynamic = await loadSystemWithFileSystem(() => ({}))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        undefined,
        limits(),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        /PNG chunk checksum is invalid/i,
      )
    })
  })
})
