  it("closes and removes a snapshot after a write failure", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(
        join(paths.e2e, "write-failure.zip"),
        Buffer.from([0x50, 0x4b, 0x03, 0x04]),
      )
      let snapshotDirectory: string | undefined
      const close = vi.fn()
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        mkdtemp: async (prefix: string) => {
          snapshotDirectory = await actual.mkdtemp(prefix)
          return snapshotDirectory
        },
        open: async (path: string, flags: number, mode?: number) => {
          const handle = await actual.open(path, flags, mode)
          if (!path.endsWith("/artifact.zip")) return handle
          close.mockImplementation(async () => {
            await handle.close()
            throw new Error("private snapshot close failure")
          })
          return {
            close,
            sync: () => handle.sync(),
            writeFile: async () => {
              throw new Error("private snapshot write failure")
            },
          }
        },
      }))
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        vi.fn(async () => ({ stdout: Buffer.alloc(0) })),
        limits(),
      )

      await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
        "private snapshot write failure",
      )
      expect(close).toHaveBeenCalledTimes(1)
      expect(snapshotDirectory).toBeDefined()
      await expect(access(snapshotDirectory as string)).rejects.toMatchObject({
        code: "ENOENT",
      })
    })
  })

  it("classifies cleanup failure after archive extraction", async () => {
    await withOwnedRun(async (root, proof) => {
      const { paths } = await lifecycle(root, proof)
      await writeFile(
        join(paths.e2e, "cleanup.zip"),
        Buffer.from([0x50, 0x4b, 0x03, 0x04]),
      )
      let snapshotDirectory: string | undefined
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        mkdtemp: async (prefix: string) => {
          snapshotDirectory = await actual.mkdtemp(prefix)
          return snapshotDirectory
        },
        rm: async (
          path: string,
          options: { force?: boolean; recursive?: boolean },
        ) => {
          if (path === snapshotDirectory) {
            throw new Error("private post-extraction cleanup failure")
          }
          return await actual.rm(path, options)
        },
      }))
      const execute = vi.fn(async (_file: string, arguments_: readonly string[]) => {
        if (arguments_[0] === "-Z1" || arguments_[0] === "-Z") {
          return { stdout: Buffer.alloc(0) }
        }
        if (arguments_[0] === "-p") return { stdout: Buffer.alloc(0) }
        throw new Error("unexpected ZIP operation")
      })
      const dependencies = await dynamic.createArtifactScannerDependencies(
        root,
        proof,
        execute,
        limits(),
      )

      try {
        await expect(dependencies.collectEntries(scannerPaths(proof))).rejects.toThrow(
          /temporary cleanup failed/i,
        )
      } finally {
        if (snapshotDirectory !== undefined) {
          await rm(snapshotDirectory, { force: true, recursive: true })
        }
      }
    })
  })

