  it("uses platform flag fallbacks and tolerates marker close errors", async () => {
    const root = await realpath(await mkdtemp(join(tmpdir(), "darkfactory-marker-close-")))
    try {
      const adoptionCloses: ReturnType<typeof vi.fn>[] = []
      const dynamic = await loadSystemWithFileSystem((actual) => ({
        open: async (path: string, flags: number, mode?: number) => {
          const handle = await actual.open(path, flags, mode)
          if (
            !path.endsWith("/.darkfactory-e2e-owner.json") ||
            (flags & constants.O_WRONLY) === 0 ||
            (flags & constants.O_CREAT) !== 0
          ) return handle
          const close = vi.fn(async () => {
            await handle.close()
            throw new Error("private adoption close failure")
          })
          adoptionCloses.push(close)
          return {
            close,
            stat: () => handle.stat(),
            sync: () => handle.sync(),
            writeFile: async (content: string, encoding: BufferEncoding) => {
              await handle.writeFile(content, encoding)
            },
          }
        },
      }))

      const proof = await dynamic.prepareOwnedRun(root, "safe_run", "no-binary")
      const paths = await dynamic.createOwnedLifecyclePaths(root, proof.runId)
      const adoption = dynamic.decodeOwnedRunAdoption(
        dynamic.encodeOwnedRunAdoption(proof),
        proof.runId,
      )

      await expect(dynamic.assertOwnedLifecycleRoots(paths, adoption)).resolves.toBeUndefined()
      expect(adoptionCloses).toHaveLength(2)
      expect(adoptionCloses.every((close) => close.mock.calls.length === 1)).toBe(true)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("preserves the adoption error when best-effort root cleanup also fails", async () => {
    const root = await realpath(await mkdtemp(join(tmpdir(), "darkfactory-adoption-fault-")))
    try {
