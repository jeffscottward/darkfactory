      const dynamic = await loadSystemWithFileSystem((actual) => ({
        open: async (path: string, flags: number, mode?: number) => {
          const handle = await actual.open(path, flags, mode)
          if (
            !path.endsWith("/.darkfactory-e2e-owner.json") ||
            (flags & constants.O_WRONLY) === 0 ||
            (flags & constants.O_CREAT) !== 0
          ) return handle
          return {
            close: () => handle.close(),
            stat: async () => {
              const stats = await handle.stat()
              return { dev: stats.dev, ino: stats.ino + 1, mode: stats.mode }
            },
            sync: () => handle.sync(),
            writeFile: async (content: string, encoding: BufferEncoding) => {
              await handle.writeFile(content, encoding)
            },
          }
        },
        rm: async (
