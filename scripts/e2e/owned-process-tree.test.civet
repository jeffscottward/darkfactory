import type { ChildProcess } from "node:child_process"
import { EventEmitter } from "node:events"
import { PassThrough } from "node:stream"

import { afterEach, beforeEach, describe, expect, it, vi } from "vitest"

const childProcess = vi.hoisted(() => ({
  spawn: vi.fn(),
}))

vi.mock("node:child_process", async (importOriginal) => {
  const actual = await importOriginal<typeof import("node:child_process")>()
  return { ...actual, spawn: childProcess.spawn }
})

import {
  ownedProcessTreeExists,
  processExists,
  spawnOwnedProcess,
  terminateOwnedProcessTree,
  terminateOwnedProcessTreeThen,
  type OwnedProcess,
  type TaskkillResult,
  type TaskkillRunner,
} from "./owned-process-tree.civet"

type MutableChild = ChildProcess & {
  exitCode: number | null
  signalCode: NodeJS.Signals | null
  stderr: PassThrough
  stdout: PassThrough
}

const fakeChild = (
  pid = 4_321,
  exitCode: number | null = null,
): MutableChild => Object.assign(new EventEmitter(), {
  exitCode,
  pid,
  signalCode: null,
  stderr: new PassThrough(),
  stdout: new PassThrough(),
}) as MutableChild

const spawnFake = (
  child: MutableChild,
  options: Record<string, unknown> = {},
): OwnedProcess => {
  childProcess.spawn.mockReturnValueOnce(child)
  return spawnOwnedProcess(
    "trusted-command",
    ["--safe", "value"],
    options as never,
  )
}

const errno = (code: string): NodeJS.ErrnoException =>
  Object.assign(new Error(code), { code })

const captureRejection = async (promise: Promise<unknown>): Promise<unknown> =>
  await promise.then(
    () => undefined,
    (error: unknown) => error,
  )

beforeEach(() => {
  childProcess.spawn.mockReset()
})

afterEach(() => {
  vi.useRealTimers()
  vi.restoreAllMocks()
})

describe("owned process spawning and existence", () => {
  it("forces a detached shell-free process with bounded stdio ownership", () => {
    const child = fakeChild()
    const owned = spawnFake(child, {
      cwd: "/workspace",
      detached: false,
      env: { SAFE: "yes" },
      shell: true,
      stdio: "inherit",
      windowsHide: true,
    })

    expect(owned).toBe(child)
    expect(childProcess.spawn).toHaveBeenCalledWith(
      "trusted-command",
      ["--safe", "value"],
      {
        cwd: "/workspace",
        detached: true,
        env: { SAFE: "yes" },
        shell: false,
        stdio: ["ignore", "pipe", "pipe"],
        windowsHide: true,
      },
    )
  })

  it("distinguishes a live PID, a missing PID, and unexpected probe errors", () => {
    const kill = vi.spyOn(process, "kill")
      .mockImplementation((() => true) as typeof process.kill)
    expect(processExists(123)).toBe(true)
    expect(kill).toHaveBeenLastCalledWith(123, 0)

    kill.mockImplementation((() => {
      throw errno("ESRCH")
    }) as typeof process.kill)
    expect(processExists(123)).toBe(false)

    const failure = errno("EPERM")
    kill.mockImplementation((() => {
      throw failure
    }) as typeof process.kill)
    expect(() => processExists(123)).toThrow(failure)
  })

  it("reports a missing child PID without probing the operating system", () => {
    const child = fakeChild()
    Reflect.deleteProperty(child, "pid")
    const kill = vi.spyOn(process, "kill")

    expect(ownedProcessTreeExists(child)).toBe(false)
    expect(kill).not.toHaveBeenCalled()
  })

  it("maps platform-native tree existence outcomes", () => {
    const child = fakeChild()
    if (process.platform === "win32") {
      expect(ownedProcessTreeExists(child)).toBe(true)
      child.exitCode = 0
      expect(ownedProcessTreeExists(child)).toBe(false)
      return
    }

    const kill = vi.spyOn(process, "kill")
      .mockImplementation((() => true) as typeof process.kill)
    expect(ownedProcessTreeExists(child)).toBe(true)
    expect(kill).toHaveBeenLastCalledWith(-4_321, 0)

    kill.mockImplementation((() => {
      throw errno("ESRCH")
    }) as typeof process.kill)
    expect(ownedProcessTreeExists(child)).toBe(false)

    kill.mockImplementation((() => {
      throw errno("EPERM")
    }) as typeof process.kill)
    expect(ownedProcessTreeExists(child)).toBe(true)

    const failure = errno("EACCES")
    kill.mockImplementation((() => {
      throw failure
    }) as typeof process.kill)
    expect(() => ownedProcessTreeExists(child)).toThrow(failure)
  })
})

describe("owned process tree termination", () => {
  it("refuses unowned processes and owned processes without a PID", async () => {
    const unowned = fakeChild()
    await expect(terminateOwnedProcessTree(unowned as OwnedProcess)).rejects.toThrow(
      /not spawned as owned/i,
    )

    const noPid = fakeChild()
    Reflect.deleteProperty(noPid, "pid")
    const owned = spawnFake(noPid)
    await expect(terminateOwnedProcessTree(owned, {
      platform: "win32",
    })).rejects.toThrow(/has no PID/i)
  })

  it("returns without signaling an already exited Windows tree", async () => {
    const child = fakeChild(4_321, 0)
    const owned = spawnFake(child)
    const taskkillRunner = vi.fn<TaskkillRunner>()

    await expect(terminateOwnedProcessTree(owned, {
      platform: "win32",
      taskkillRunner,
    })).resolves.toBeUndefined()
    expect(taskkillRunner).not.toHaveBeenCalled()
  })

  it("stops a Windows tree gracefully through the injected taskkill runner", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    const taskkillRunner = vi.fn<TaskkillRunner>(async (_pid, force, signal) => {
      expect(force).toBe(false)
      expect(signal.aborted).toBe(false)
      child.exitCode = 0
      return { exitCode: 0, signal: null }
    })

    await expect(terminateOwnedProcessTree(owned, {
      forceTimeoutMillis: 0,
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
      taskkillTimeoutMillis: 100,
    })).resolves.toBeUndefined()
    expect(taskkillRunner).toHaveBeenCalledTimes(1)
    expect(taskkillRunner).toHaveBeenCalledWith(
      4_321,
      false,
      expect.any(AbortSignal),
    )
  })

  it("escalates a surviving Windows tree from graceful to forced taskkill", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    const forceFlags: boolean[] = []
    const taskkillRunner = vi.fn<TaskkillRunner>(async (_pid, force) => {
      forceFlags.push(force)
      if (force) child.exitCode = 1
      return { exitCode: 0, signal: null }
    })

    await expect(terminateOwnedProcessTree(owned, {
      forceTimeoutMillis: 0,
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
    })).resolves.toBeUndefined()
    expect(forceFlags).toEqual([false, true])
  })

  it("falls back to force after a graceful taskkill error", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    const gracefulFailure = new Error("graceful taskkill unavailable")
    const taskkillRunner = vi.fn<TaskkillRunner>(async (_pid, force) => {
      if (!force) throw gracefulFailure
      child.exitCode = 1
      return { exitCode: 0, signal: null }
    })

    await expect(terminateOwnedProcessTree(owned, {
      forceTimeoutMillis: 0,
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
    })).resolves.toBeUndefined()
    expect(taskkillRunner.mock.calls.map((call) => call[1])).toEqual([false, true])
  })

  it.each([
    ["a nonzero taskkill exit", { exitCode: 7, signal: null }, /code 7/i],
    ["a signaled taskkill exit", { exitCode: null, signal: "SIGTERM" }, /signal SIGTERM/i],
  ] as const)("reports graceful and forced failures from %s", async (
    _case,
    result,
    expectedMessage,
  ) => {
    const child = fakeChild()
    const owned = spawnFake(child)
    const taskkillRunner = vi.fn<TaskkillRunner>(async () => result as TaskkillResult)

    const error = await captureRejection(terminateOwnedProcessTree(owned, {
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
    }))
    expect(error).toBeInstanceOf(AggregateError)
    expect((error as AggregateError).message).toMatch(/failed to terminate/i)
    expect((error as AggregateError).errors).toHaveLength(2)
    expect((error as AggregateError).errors[0]).toEqual(
      expect.objectContaining({ message: expect.stringMatching(expectedMessage) }),
    )
    expect((error as AggregateError).errors[1]).toEqual(
      expect.objectContaining({ message: expect.stringMatching(expectedMessage) }),
    )
  })

  it("reports only the force error when graceful signaling succeeded", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    const forceFailure = new Error("forced taskkill unavailable")
    const taskkillRunner = vi.fn<TaskkillRunner>(async (_pid, force) => {
      if (force) throw forceFailure
      return { exitCode: 0, signal: null }
    })

    const error = await captureRejection(terminateOwnedProcessTree(owned, {
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
    }))
    expect(error).toBeInstanceOf(AggregateError)
    expect((error as AggregateError).errors).toEqual([forceFailure])
  })

  it("fails when a tree still exists after forced termination", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    const taskkillRunner = vi.fn<TaskkillRunner>(async () => ({
      exitCode: 0,
      signal: null,
    }))

    await expect(terminateOwnedProcessTree(owned, {
      forceTimeoutMillis: 0,
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
    })).rejects.toThrow(/did not exit after SIGKILL/i)
    expect(taskkillRunner.mock.calls.map((call) => call[1])).toEqual([false, true])
  })

  it("aborts and bounds both hanging taskkill attempts", async () => {
    vi.useFakeTimers()
    const child = fakeChild()
    const owned = spawnFake(child)
    const signals: AbortSignal[] = []
    const taskkillRunner = vi.fn<TaskkillRunner>((_pid, _force, signal) => {
      signals.push(signal)
      return new Promise<TaskkillResult>(() => undefined)
    })

    const termination = terminateOwnedProcessTree(owned, {
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
      taskkillTimeoutMillis: 10,
    })
    const captured = captureRejection(termination)
    await vi.runAllTimersAsync()
    const error = await captured

    expect(error).toBeInstanceOf(AggregateError)
    expect((error as AggregateError).errors).toHaveLength(2)
    expect((error as AggregateError).errors.every((entry) =>
      entry instanceof Error && /taskkill timed out/u.test(entry.message)
    )).toBe(true)
    expect(signals).toHaveLength(2)
    expect(signals.every((signal) => signal.aborted)).toBe(true)
  })

  it("uses the shell-free default taskkill runner and forces after its error event", async () => {
    const child = fakeChild()
    childProcess.spawn.mockReturnValueOnce(child)
    childProcess.spawn.mockImplementation((command, arguments_) => {
      expect(command).toBe("taskkill")
      const taskkill = new EventEmitter()
      const force = (arguments_ as string[]).includes("/F")
      queueMicrotask(() => {
        if (!force) {
          taskkill.emit("error", new Error("graceful taskkill failed"))
          return
        }
        child.exitCode = 1
        taskkill.emit("exit", 0, null)
      })
      return taskkill as never
    })
    const owned = spawnOwnedProcess("trusted-command", [], {})

    await expect(terminateOwnedProcessTree(owned, {
      forceTimeoutMillis: 0,
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillTimeoutMillis: 100,
    })).resolves.toBeUndefined()

    expect(childProcess.spawn.mock.calls.slice(1)).toEqual([
      ["taskkill", ["/PID", "4321", "/T"], {
        shell: false,
        signal: expect.any(AbortSignal),
        stdio: "ignore",
        windowsHide: true,
      }],
      ["taskkill", ["/PID", "4321", "/T", "/F"], {
        shell: false,
        signal: expect.any(AbortSignal),
        stdio: "ignore",
        windowsHide: true,
      }],
    ])
  })

  it("signals a POSIX process group and treats ESRCH as a completed exit", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    let alive = true
    const delivered: Array<number | NodeJS.Signals> = []
    vi.spyOn(process, "kill").mockImplementation(((pid: number, signal?: number | NodeJS.Signals) => {
      expect(pid).toBe(-4_321)
      if (signal === 0) {
        if (alive) return true
        throw errno("ESRCH")
      }
      delivered.push(signal ?? 0)
      alive = false
      return true
    }) as typeof process.kill)

    await expect(terminateOwnedProcessTree(owned, {
      gracefulTimeoutMillis: 0,
      platform: "darwin",
    })).resolves.toBeUndefined()
    expect(delivered).toEqual(["SIGTERM"])

    const vanished = fakeChild(5_678)
    const vanishedOwned = spawnFake(vanished)
    let probes = 0
    vi.mocked(process.kill).mockImplementation(((pid: number, signal?: number | NodeJS.Signals) => {
      expect(pid).toBe(-5_678)
      if (signal === 0 && probes++ === 0) return true
      throw errno("ESRCH")
    }) as typeof process.kill)
    await expect(terminateOwnedProcessTree(vanishedOwned, {
      gracefulTimeoutMillis: 0,
      platform: "linux",
    })).resolves.toBeUndefined()
  })

  it("aggregates unexpected POSIX graceful and forced signal failures", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    vi.spyOn(process, "kill").mockImplementation(((_pid: number, signal?: number | NodeJS.Signals) => {
      if (signal === 0) return true
      throw signal === "SIGTERM" ? errno("EPERM") : errno("EACCES")
    }) as typeof process.kill)

    const error = await captureRejection(terminateOwnedProcessTree(owned, {
      gracefulTimeoutMillis: 0,
      platform: "linux",
    }))
    expect(error).toBeInstanceOf(AggregateError)
    expect((error as AggregateError).errors).toEqual([
      expect.objectContaining({ code: "EPERM" }),
      expect.objectContaining({ code: "EACCES" }),
    ])
  })

  it("shares one in-flight termination across concurrent callers", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    let release!: () => void
    const taskkillRunner = vi.fn<TaskkillRunner>(() =>
      new Promise<TaskkillResult>((resolve) => {
        release = () => {
          child.exitCode = 0
          resolve({ exitCode: 0, signal: null })
        }
      })
    )

    const first = terminateOwnedProcessTree(owned, {
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
    })
    const second = terminateOwnedProcessTree(owned, {
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
    })
    expect(taskkillRunner).toHaveBeenCalledTimes(1)
    release()

    await expect(Promise.all([first, second])).resolves.toEqual([
      undefined,
      undefined,
    ])
    expect(taskkillRunner).toHaveBeenCalledTimes(1)
  })

  it("runs cleanup only after termination and propagates cleanup errors", async () => {
    const child = fakeChild()
    const owned = spawnFake(child)
    const order: string[] = []
    const taskkillRunner = vi.fn<TaskkillRunner>(async () => {
      order.push("terminated")
      child.exitCode = 0
      return { exitCode: 0, signal: null }
    })
    const cleanupFailure = new Error("cleanup failed")
    const cleanup = vi.fn(async () => {
      order.push("cleanup")
      throw cleanupFailure
    })

    await expect(terminateOwnedProcessTreeThen(owned, cleanup, {
      gracefulTimeoutMillis: 0,
      platform: "win32",
      taskkillRunner,
    })).rejects.toThrow(cleanupFailure)
    expect(order).toEqual(["terminated", "cleanup"])

    const refusedCleanup = vi.fn(async () => undefined)
    await expect(terminateOwnedProcessTreeThen(
      fakeChild() as OwnedProcess,
      refusedCleanup,
    )).rejects.toThrow(/not spawned as owned/i)
    expect(refusedCleanup).not.toHaveBeenCalled()
  })
})
