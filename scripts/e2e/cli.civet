export type CliStreams = Readonly<{
  writeOutput: (value: string) => void
  writeError: (value: string) => void
}>
export type JourneyCliDependencies = Readonly<
  Partial<Pick<
    JourneyDependencies,
    | "createHmacKey"
    | "createRunId"
    | "listSpecs"
    | "prepareRun"
    | "runPlaywright"
    | "scanArtifacts"
  >> & {
    persistState?: (state: E2ERunnerState) => void
    resolveNodeExecutable?: (repositoryPath: string) => Promise<string>
  }
>
export const serializeJourneyProgress = (progress: JourneyProgress): string => {
  const rendered = JSON.stringify(progress)
  if (Buffer.byteLength(rendered, "utf8") > 1_024) {
    throw new Error("E2E progress event exceeded its fixed bound")
  }
  return `${rendered}\n`
}
export const serializeJourneyFailureSummary = (
  report: JourneySuiteReport,
  failureCategory?: ArtifactScannerFailureCategory,
): string => {
  const failed = [...report.results].reverse().find((result) =>
    result.playwrightExitCode !== 0 || !result.scan.ok
  ) ?? report.results.at(-1)
  if (failed === undefined) return "Error: E2E runner failed before result\n"
  const category = failureCategory !== undefined &&
    SCANNER_FAILURE_CATEGORIES.has(failureCategory)
    ? ` scanFailureCategory=${failureCategory}`
    : ""
  return "Error: E2E runner failed " +
    `stage=${failed.stage} process=${failed.processState} ` +
    `lifecycleStatus=${failed.lifecycleStatus} ` +
    `lifecycleStage=${failed.lifecycleStage} ` +
    `lifecycleObservation=${failed.lifecycleObservation} ` +
    `lifecycleObservationReason=${failed.lifecycleObservationReason} ` +
    `playwrightOk=${failed.playwrightExitCode === 0} ` +
    `treeTerminated=${failed.processTreeTerminated} ` +
    `scanOk=${failed.scan.ok} purged=${failed.scan.purged}${category}\n`
}

const INHERITED_PLAYWRIGHT_KEYS = [
  "CI", "COLORTERM", "FORCE_COLOR", "HOME", "LANG", "LC_ALL", "LOGNAME",
  "NODE_EXTRA_CA_CERTS", "NO_COLOR", "PORTLESS_PORT", "SHELL", "TEMP", "TERM",
  "TMP", "TMPDIR", "USER",
] as const
const E2E_NODE_EXECUTABLE_KEY = "_DARKFACTORY_E2E_NODE_EXECUTABLE"
const E2E_PNPM_SCRIPT_KEY = "_DARKFACTORY_E2E_PNPM_SCRIPT"
const BLANK_PROVIDER_ENVIRONMENT = Object.freeze({
  GROQ_API_KEY: "",
  GROQ_MODEL: "",
  RESEND_API_KEY: "",
  POSTHOG_KEY: "",
  POSTHOG_HOST: "",
  OTEL_ENABLED: "false",
  OTEL_EXPORTER_OTLP_ENDPOINT: "",
  R2_ACCOUNT_ID: "",
  R2_ACCESS_KEY_ID: "",
  R2_SECRET_ACCESS_KEY: "",
  ERROR_TRACKING_DSN: "",
})
const FIXED_EXECUTABLE_DIRECTORIES = Object.freeze([
  dirname(process.execPath),
  "/opt/homebrew/bin",
  "/usr/local/bin",
  "/usr/bin",
  "/bin",
])
const safeExecutableDirectory = (candidate: string): string => {
  if (!isAbsolute(candidate) || candidate.includes(delimiter)) {
    throw new Error("Trusted executable directory is unsafe")
  }
  return candidate
}
const assertExecutableFile = async (candidate: string): Promise<void> => {
  if (!(await stat(candidate)).isFile()) {
    throw new Error("Trusted executable target is not a regular file")
  }
  await access(candidate, constants.X_OK)
}

const pathIsOutsideRepository = (
  repositoryRoot: string,
  candidate: string,
): boolean => {
  const relation = relative(repositoryRoot, candidate)
  return relation === ".." || relation.startsWith(`..${sep}`)
}
type TrustedExecutable = Readonly<{
  command: string
}>
type TrustedParentPathExecutable = TrustedExecutable & Readonly<{
  pathDirectory: string
}>
type ExecutableSearch = "fixed" | "parent-path"
const UNPROVEN_SCANNER_REPORT: ArtifactScanReport = Object.freeze({
  ok: false,
  scannedEntries: 0,
  findings: [],
  purged: false,
  reason: "External scanner process-tree termination was not proven",
  failureCategory: "internal",
})
const resolveTrustedExecutable = async (
  name: string,
  repositoryPath: string,
  search: ExecutableSearch,
): Promise<TrustedParentPathExecutable> => {
  const root = await realpath(repositoryPath)
  const directories = search === "parent-path"
    ? (process.env["PATH"] ?? "")
      .split(delimiter)
      .filter((directory) => directory.length > 0 && isAbsolute(directory))
    : FIXED_EXECUTABLE_DIRECTORIES
  for (const directory of directories) {
    try {
      const candidateDirectory = resolve(directory)
      const canonicalDirectory = await realpath(candidateDirectory)
      safeExecutableDirectory(canonicalDirectory)
      if (!pathIsOutsideRepository(root, canonicalDirectory)) continue
      if (!(await stat(canonicalDirectory)).isDirectory()) continue
      await access(canonicalDirectory, constants.X_OK)
      const candidate = resolve(canonicalDirectory, name)
      const canonical = await realpath(candidate)
      if (!pathIsOutsideRepository(root, canonical)) continue
      await assertExecutableFile(canonical)
      return Object.freeze({
        command: canonical,
        pathDirectory: canonicalDirectory,
      })
    } catch {
      continue
    }
  }
  throw new Error(`Trusted ${name} executable is unavailable`)
}
export const resolveTrustedPnpmExecutable = async (
  repositoryPath: string,
): Promise<TrustedParentPathExecutable> =>
  await resolveTrustedExecutable("pnpm", repositoryPath, "parent-path")
export const resolveTrustedParentNodeExecutable = async (
  repositoryPath: string,
): Promise<TrustedParentPathExecutable> =>
  await resolveTrustedExecutable("node", repositoryPath, "parent-path")
export const resolveTrustedNodeExecutable = async (
  repositoryPath: string,
): Promise<TrustedExecutable> => {
  const resolved = await resolveTrustedExecutable(
    "node",
    repositoryPath,
    "fixed",
  )
  return Object.freeze({ command: resolved.command })
}
const isMissingExecutable = (error: unknown): boolean =>
  typeof error === "object" &&
  error !== null &&
  "code" in error &&
  error.code === "ENOENT"
const resolveOptionalSiblingExecutable = async (
  sourceDirectory: string,
  name: "node" | "pnpm",
): Promise<string | undefined> => {
  let canonical: string | undefined
  try {
    canonical = await realpath(resolve(sourceDirectory, name))
  } catch (error) {
    if (!isMissingExecutable(error)) throw error
  }
  return canonical
}
const assertTrustedPlaywrightExecutablePair = async (
  pnpm: TrustedParentPathExecutable,
  node: TrustedParentPathExecutable,
): Promise<void> => {
  const siblingNode = await resolveOptionalSiblingExecutable(
    pnpm.pathDirectory,
    "node",
  )
  const siblingPnpm = await resolveOptionalSiblingExecutable(
    node.pathDirectory,
    "pnpm",
  )
  const effectiveNode = siblingNode ?? node.command
  const effectivePnpm = siblingPnpm ?? pnpm.command
  await assertExecutableFile(effectiveNode)
  await assertExecutableFile(effectivePnpm)
  if (
    effectiveNode !== node.command ||
    effectivePnpm !== pnpm.command
  ) throw new Error("Trusted executable directory contains a conflicting sibling")
}
export const discoverJourneySpecs = async (
  repositoryPath: string,
): Promise<readonly string[]> => {
  const entries = await readdir(join(repositoryPath, "tests", "e2e"), {
    withFileTypes: true,
  })
  const candidates = entries.filter((entry) => entry.name.endsWith(".spec.ts"))
  if (candidates.some((entry) => !entry.isFile())) {
    throw new Error("E2E journey candidates must be regular files")
  }
  return Object.freeze(candidates
    .map((entry) => `tests/e2e/${entry.name}`)
    .sort())
}


const createPlaywrightEnvironmentWithTrustedDirectories = (
  source: NodeJS.ProcessEnv,
) => (
  isolated: Readonly<Record<string, string>>,
) => (
  trustedExecutableDirectories: readonly string[] = [],
): NodeJS.ProcessEnv => {
  const executableDirectories = [...new Set([
    ...trustedExecutableDirectories.map(safeExecutableDirectory),
    ...FIXED_EXECUTABLE_DIRECTORIES,
  ])]
  const environment: NodeJS.ProcessEnv = {
    ...BLANK_PROVIDER_ENVIRONMENT,
    APP_ENV: "test",
    DATABASE_URL: source["DATABASE_URL"] ?? "",
    ...isolated,
    PATH: executableDirectories.join(delimiter),
  }
  delete environment["NODE_OPTIONS"]
  delete environment["DEBUG"]
  for (const key of INHERITED_PLAYWRIGHT_KEYS) {
    const value = source[key]
    if (value !== undefined) environment[key] = value
  }
  return environment
}
export const createPlaywrightEnvironment = (
  source: NodeJS.ProcessEnv,
  isolated: Readonly<Record<string, string>>,
): NodeJS.ProcessEnv =>
  createPlaywrightEnvironmentWithTrustedDirectories(source)(isolated)()
type LifecycleObservation = Readonly<{
  lifecycleStatus: JourneyLifecycleStatus
  lifecycleStage: JourneyLifecycleStage
  lifecycleObservation: JourneyLifecycleObservation
  lifecycleObservationReason: JourneyLifecycleObservationReason
}>
const unavailableLifecycle = (
  lifecycleObservation: "invalid" | "missing",
  lifecycleObservationReason: JourneyLifecycleObservationReason,
): LifecycleObservation => Object.freeze({
  lifecycleStatus: "unavailable",
  lifecycleStage: "unavailable",
  lifecycleObservation,
  lifecycleObservationReason,
})

export const observeE2ELifecycle = async (
  environment: Readonly<Record<string, string>>,
  repositoryPath = process.cwd(),
): Promise<LifecycleObservation> => {
  const runId = environment["E2E_RUN_ID"]
  const encodedAdoption = environment["E2E_RUN_ADOPTION"]
  if (runId === undefined || encodedAdoption === undefined) {
    return unavailableLifecycle("missing", "inputs-missing")
  }
  let paths: OwnedLifecyclePaths
  try {
    paths = await createOwnedLifecyclePaths(repositoryPath, runId)
  } catch {
    return unavailableLifecycle("invalid", "paths-failed")
  }
  let adoption: OwnedRunAdoption
  try {
    adoption = decodeOwnedRunAdoption(encodedAdoption, runId)
    await assertOwnedLifecycleRoots(paths, adoption)
  } catch {
    return unavailableLifecycle("invalid", "adoption-invalid")
  }
  let state: Awaited<ReturnType<typeof readOwnedLifecycleState>>
  try {
    state = await readOwnedLifecycleState(paths, adoption)
  } catch {
    return unavailableLifecycle("invalid", "state-invalid")
  }
  if (state === undefined) {
    return unavailableLifecycle("missing", "state-missing")
  }
  return Object.freeze({
    lifecycleStatus: state.status as JourneyLifecycleStatus,
    lifecycleStage: state.stage as JourneyLifecycleStage,
    lifecycleObservation: "state",
    lifecycleObservationReason: "observed-state",
  })
}
const lifecycleProvesNestedServerTermination = (
  lifecycle: LifecycleObservation,
): boolean =>
  lifecycle.lifecycleStatus === "stopped" &&
    lifecycle.lifecycleObservation === "state" &&
    lifecycle.lifecycleObservationReason === "observed-state"
type FinalizedLifecycleObservation = Readonly<{
  finalizationFailed: boolean
  nestedServerTerminated: boolean
  lifecycle: LifecycleObservation
}>

export const finalizeAndObserveE2ELifecycle = async (
  environment: Readonly<Record<string, string>>,
  processResult: Readonly<{ exitCode: number; treeTerminated: boolean }>,
  repositoryPath = process.cwd(),
): Promise<FinalizedLifecycleObservation> => {
  const preFinalizationLifecycle =
    await observeE2ELifecycle(environment, repositoryPath)
  const nestedServerTerminated =
    lifecycleProvesNestedServerTermination(preFinalizationLifecycle)
  // Keep the authenticated pre-finalization proof immutable across status remapping.
  const finalizationFailed = processResult.treeTerminated
    ? await Promise.resolve().then(
        () => finalizeOwnedLifecycleAfterPlaywright({
          encodedAdoption: environment["E2E_RUN_ADOPTION"] ?? "",
          exitCode: processResult.exitCode,
          repositoryPath,
          runId: environment["E2E_RUN_ID"] ?? "",
          treeTerminated: processResult.treeTerminated,
        }),
      ).then(
        () => false,
        () => true,
      )
    : false
  return Object.freeze({
    finalizationFailed,
    nestedServerTerminated,
    lifecycle: processResult.treeTerminated
      ? await observeE2ELifecycle(environment, repositoryPath)
      : preFinalizationLifecycle,
  })
}


const ANSI_ESCAPE = /\u001B\[[0-?]*[ -/]*[@-~]/gu
const WEB_SERVER_LIFECYCLE_FAILURE =
  /^(?:\[WebServer\]\s*)?Error:\s*E2E lifecycle (startup|cleanup) failed during (validation|owner-lock|artifact-isolation|module-loading|database-create|database-migrate|database-reset|database-seed|server-spawn|server-probed|server-ready)\.( Resources retained\.)?$/u

export const observeWebServerLifecycleFailure = (
  stdout: string,
  stderr: string,
): LifecycleObservation | undefined => {
  const matches: LifecycleObservation[] = []
  for (const line of `${stdout}\n${stderr}`.split(/\r?\n/u)) {
    const match = WEB_SERVER_LIFECYCLE_FAILURE.exec(
      line.replace(ANSI_ESCAPE, "").trim(),
    )
    if (match === null) continue
    const retainsResources = match[3] === " Resources retained."
    if (
      (match[1] === "startup" && retainsResources) ||
      (match[1] === "cleanup" && !retainsResources)
    ) continue
    const status = match[1] === "startup"
      ? "startup-failed"
      : "cleanup-failed"
    const stage = match[2] as JourneyLifecycleStage
    matches.push(Object.freeze({
      lifecycleStatus: status,
      lifecycleStage: stage,
      lifecycleObservation: "stderr",
      lifecycleObservationReason: "observed-stderr",
    }))
  }
  return matches.length === 1 ? matches[0] : undefined
}
export const resolveLifecycleObservation = (
  recorded: LifecycleObservation,
  stdout: string,
  stderr: string,
): LifecycleObservation =>
  recorded.lifecycleObservation === "missing"
    ? observeWebServerLifecycleFailure(stdout, stderr) ?? recorded
    : recorded


const scannerEnvironment = (): NodeJS.ProcessEnv => ({
  PATH: `${dirname(process.execPath)}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin`,
  TMPDIR: process.env["TMPDIR"],
})

export const createArtifactScannerInvocation = (
  repositoryPath: string,
  nodeExecutable: string,
  {
    runId,
    ownership,
    reportNonce,
    purgeOwned,
  }: Readonly<{
    runId: string
    ownership: string
    reportNonce: string
    purgeOwned: boolean
  }>,
) => {
  const arguments_ = [
    "--experimental-strip-types",
    "--import",
    "./tests/e2e/helpers/register-civet-loader.mjs",
    "./scripts/e2e/scan-artifacts.civet",
    "--run-id",
    runId,
    "--ownership",
    ownership,
    "--report-nonce",
    reportNonce,
  ]
  if (purgeOwned) arguments_.push("--purge-owned")
  return Object.freeze({
    command: nodeExecutable,
    arguments: Object.freeze(arguments_),
    options: Object.freeze({
      cwd: repositoryPath,
      env: scannerEnvironment(),
      maxOutputBytes: 1024 * 1024,
      timeoutMillis: 45_000,
    }),
  })
}

const MAX_PROCESS_OUTPUT_BYTES = 16 * 1024
const REDACTED_SENSITIVE_PROCESS_OUTPUT =
  "[REDACTED SENSITIVE PROCESS OUTPUT]\n"
const REDACTED_OVERSIZED_PROCESS_OUTPUT =
  "[REDACTED OVERSIZED PROCESS OUTPUT]\n"
const OSC_ESCAPE =
  /\u001b\][^\u0007\u001b]*(?:\u0007|\u001b\\)/gu
const UNTRUSTED_TERMINAL_CONTROL = /\u001b|[\u0080-\u009f]|\p{Cf}/u
const REMOVABLE_C0 =
  /[\u0000-\u0009\u000b\u000c\u000e-\u001a\u001c-\u001f\u007f]/gu
const PROCESS_OUTPUT_LINES = /[^\n]*\n|[^\n]+$/gu
const COMPACT_PROCESS_BOUNDARY = /["',}\];&]/u
const SENSITIVE_PROCESS_STRUCTURES = [
  /Browser(?:Auth|Reset)[A-Za-z0-9!@#$%^&*_-]{4,}/giu,
  /(?:bearer|basic)\s+(?!\[REDACTED\])[A-Za-z0-9._~+\/=-]{4,}/giu,
  /\/api\/auth\/(?:reset-password|verify-email)(?:\/|[?&](?:amp;)?token=)(?!\[REDACTED\])[^/?&#\s<"']{4,}/giu,
  /https?:\/\/[^\s"'<>]+\/(?:reset-password|verify-email)[^\s"'<>]*[?&](?:amp;)?token=(?!\[REDACTED\])[^&\s"'<>]{4,}/giu,
  /\/(?:reset-password|verify-email)\?(?:token=|[^#\s"'<>]{0,16384}&(?:amp;)?token=)(?!\[REDACTED\])[^&#\s"'<>]{4,}/giu,
  /["']?authorization["']?\s*[:=]\s*["']?(?:(?:bearer|basic)\s+)?(?!\[REDACTED\])[^"',}\s]{6,}/giu,
  /["']?name["']?\s*[:=]\s*["']authorization["'][\s\S]{0,16384}?["']?value["']?\s*[:=]\s*["']?(?:(?:bearer|basic)\s+)?(?!\[REDACTED\])[^"',}\s]{4,}/giu,
  /["']?value["']?\s*[:=]\s*["']?(?:(?:bearer|basic)\s+)?(?!\[REDACTED\])[^"',}\s]{4,}["'][\s\S]{0,16384}?["']?name["']?\s*[:=]\s*["']authorization["']/giu,
  /(?:__Secure-)?better-auth\.session[_-]?token[\s\S]{0,16384}?["']?value["']?\s*[:=]\s*["']?(?!\[REDACTED\])[^"',;\s}]{4,}/giu,
  /["']?value["']?\s*[:=]\s*["']?(?!\[REDACTED\])[^"',;\s}]{4,}["'][\s\S]{0,16384}?["']?name["']?\s*[:=]\s*["']?(?:__Secure-)?better-auth\.session[_-]?token["']?/giu,
  /["']?session(?:[_-]?token)?["']?\s*[:=]\s*["']?(?!\[REDACTED\])[^"',}\s]{6,}/giu,
  /["']?session["']?\s*[:=]\s*\{[\s\S]{0,16384}?["']?(?:token|value)["']?\s*[:=]\s*["']?(?!\[REDACTED\])[^"',}\s]{6,}/giu,
  /(?:hmac[_-]?key|(?:access[_-]?)?token|access[_-]?key|api[_-]?key|client[_-]?secret)\s*["']?\s*[:=]\s*["']?(?!\[REDACTED\])[A-Za-z0-9._~+\/=-]{16,}/giu,
  /(?:cookie|set-cookie)\s*[:=][^\r\n]*better-auth\.session[_-]?token=[^;\s"']{4,}/giu,
  /["']?(?:database_url|password|private[_-]?key|api[_-]?key|secret)["']?\s*[:=]\s*["']?(?!\[REDACTED\])[^"',}\s]{6,}/giu,
  /postgres(?:ql)?:\/\/[^\s"'<>]+/giu,
  /-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)/gu,
] as const

type ProcessOutputRange = SensitiveTextRange

const processOutputIsOversized = (value: string): boolean =>
  value.length > MAX_PROCESS_OUTPUT_BYTES ||
    Buffer.byteLength(value, "utf8") > MAX_PROCESS_OUTPUT_BYTES

const normalizeTerminalControls = (value: string): string | undefined =>
  const withoutSequences = value
    .replace(/\r\n?/gu, "\n")
    .replace(OSC_ESCAPE, "")
    .replace(ANSI_ESCAPE, "")
  if UNTRUSTED_TERMINAL_CONTROL.test(withoutSequences) return undefined
  return withoutSequences.replace(REMOVABLE_C0, "")

const directSensitiveProcessRanges = (
  value: string,
): readonly ProcessOutputRange[] =>
  const ranges: ProcessOutputRange[] = []
  for pattern of SENSITIVE_PROCESS_STRUCTURES
    for match of value.matchAll(pattern)
      const start = match.index
      const matched = match[0] ?? ""
      if start === undefined || matched.length === 0
        return [{ start: 0, end: value.length }]
      ranges.push({ start, end: start + matched.length })
  return ranges

const sensitiveProcessRanges = (value: string): readonly ProcessOutputRange[] =>
  const directRanges = [...directSensitiveProcessRanges(value)]
    .sort((left, right) => left.start - right.start || left.end - right.end)
  const ranges = [...directRanges]
  const appendCompactGap = (gapStart: number, gapEnd: number): void =>
    if gapStart >= gapEnd return
    const compacted = compactSensitiveTextRange(value, gapStart, gapEnd)
    if compacted === undefined return

    for range of directSensitiveProcessRanges(compacted.inspection)
      const start = compacted.sourceOffsets[range.start]
      const last = compacted.sourceOffsets[range.end - 1]
      if start === undefined || last === undefined
        ranges.push({ start: gapStart, end: gapEnd })
        return
      const end = last + 1
      const endsAtGap = end === gapEnd
      if (
        !endsAtGap &&
        !COMPACT_PROCESS_BOUNDARY.test(value.charAt(end))
      )
        ranges.push({ start: gapStart, end: gapEnd })
        return
      ranges.push({ start, end })

  let gapStart = 0
  for directRange of directRanges
    if directRange.start > gapStart
      appendCompactGap(gapStart, directRange.start)
    gapStart = Math.max(gapStart, directRange.end)
  appendCompactGap(gapStart, value.length)
  ranges.sort((left, right) => left.start - right.start || left.end - right.end)
  return ranges


function redactVisibleProcessValues(value: string): string {
  let redacted = value.replace(
    /Browser(?:Auth|Reset)[A-Za-z0-9!@#$%^&*_-]+/giu,
    "[REDACTED]",
  )
  redacted = redacted.replace(
    /(\/api\/auth\/(?:reset-password|verify-email)(?:\/|[?&](?:amp;)?token=))[^/?&#\s<"']+/giu,
    "$1[REDACTED]",
  )
  redacted = redacted.replace(
    /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/giu,
    "[REDACTED EMAIL]",
  )
  return redacted.replace(
    /https?:\/\/[^\s"'<>]+/giu,
    "[REDACTED URL]",
  )
}

function redactProcessOutputUnsafe(
  value: string,
  knownSensitiveValues: readonly string[],
): string {
  if processOutputIsOversized(value)
    return REDACTED_OVERSIZED_PROCESS_OUTPUT
  const normalized = normalizeTerminalControls(value)
  if normalized === undefined return REDACTED_SENSITIVE_PROCESS_OUTPUT

  let knownValuesRedacted = normalized
  const inspectedKnownValues: string[] = []
  const normalizedKnownValues: string[] = []
  for secret of knownSensitiveValues
    if secret.length === 0 continue
    const normalizedSecret = normalizeTerminalControls(secret)
    if (
      normalizedSecret === undefined ||
      normalizedSecret.length === 0 ||
      processOutputIsOversized(normalizedSecret)
    ) return REDACTED_SENSITIVE_PROCESS_OUTPUT
    const inspectedSecret = inspectSensitiveText(normalizedSecret)
    inspectedKnownValues.push(inspectedSecret)
    if normalizedSecret.length >= MINIMUM_PRECISE_KNOWN_VALUE_LENGTH
      normalizedKnownValues.push(normalizedSecret)

  const literalKnownValues = [...new Set(normalizedKnownValues)]
    .sort((left, right) => right.length - left.length)
  for secret of literalKnownValues
    knownValuesRedacted = knownValuesRedacted.replaceAll(
      secret,
      "[REDACTED]",
    )
  if processOutputIsOversized(knownValuesRedacted)
    return REDACTED_OVERSIZED_PROCESS_OUTPUT

  const inspection = inspectSensitiveText(knownValuesRedacted)
  const knownRanges = knownSensitiveTextRanges(
    inspection,
    inspectedKnownValues,
  )
  if knownRanges === undefined return REDACTED_SENSITIVE_PROCESS_OUTPUT

  const ranges = Array.from(sensitiveProcessRanges(inspection))
    .concat(knownRanges)
  ranges.sort((left, right) => left.start - right.start || left.end - right.end)
  let structurallyRedacted = knownValuesRedacted
  if ranges.length > 0
    const lines = knownValuesRedacted.match(PROCESS_OUTPUT_LINES) ?? []
    const inspectionLines = inspection.match(PROCESS_OUTPUT_LINES) ?? []
    if lines.length !== inspectionLines.length
      structurallyRedacted = REDACTED_SENSITIVE_PROCESS_OUTPUT
    else
      const redactedLines: string[] = []
      let inspectionOffset = 0
      let rangeIndex = 0
      let previousLineWasSensitive = false
      for (let index = 0; index < lines.length; index += 1)
        const line = lines[index]!
        const inspectionLine = inspectionLines[index]!
        const lineEnd = inspectionOffset + inspectionLine.length
        while (
          ranges[rangeIndex] !== undefined &&
          ranges[rangeIndex]!.end <= inspectionOffset
        )
          rangeIndex += 1
        const range = ranges[rangeIndex]
        const sensitive = range !== undefined &&
          range.start < lineEnd &&
          range.end > inspectionOffset
        if sensitive
          if !previousLineWasSensitive
            redactedLines.push(REDACTED_SENSITIVE_PROCESS_OUTPUT)
        else
          redactedLines.push(line)
        previousLineWasSensitive = sensitive
        inspectionOffset = lineEnd
      structurallyRedacted = redactedLines.join("")

  const rendered = redactVisibleProcessValues(structurallyRedacted)
  return processOutputIsOversized(rendered)
    ? REDACTED_OVERSIZED_PROCESS_OUTPUT
    : rendered
}

export function redactProcessOutput(
  value: string,
  knownSensitiveValues: readonly string[] = [],
): string {
  try {
    return redactProcessOutputUnsafe(value, knownSensitiveValues)
  } catch {
    return REDACTED_SENSITIVE_PROCESS_OUTPUT
  }
}
const boundedDiagnosticLines = (value: string, channel: "stderr" | "stdout"): string[] =>
  value
    .split(/\r?\n/gu)
    .map((line) => line.trim())
    .filter((line) => line.length > 0)
    .slice(-4)
    .map((line) => `${channel}: ${line.slice(0, 400)}`)

export const collectProcessDiagnostics = (
  stdout: string,
  stderr: string,
  knownSensitiveValues: readonly string[] = [],
): readonly string[] => Object.freeze([
  ...boundedDiagnosticLines(
    redactProcessOutput(stdout, knownSensitiveValues),
    "stdout",
  ),
  ...boundedDiagnosticLines(
    redactProcessOutput(stderr, knownSensitiveValues),
    "stderr",
  ),
])
const decodeDatabaseUrlComponent = (value: string): string =>
  try
    return decodeURIComponent(value)
  catch
    return value

const databaseUrlSensitiveValues = (value: string): readonly string[] => {
  if (value.length === 0) return []
  let url: URL
  try {
    url = new URL(value)
  } catch {
    return Object.freeze([value])
  }
  return Object.freeze([...new Set([
    value,
    url.username,
    url.password,
    decodeDatabaseUrlComponent(url.username),
    decodeDatabaseUrlComponent(url.password),
  ])])
}



const SCANNER_REPORT_KIND = "darkfactory-artifact-scanner-report"
const SCANNER_REPORT_NONCE = /^[A-Za-z0-9_-]{43}$/u

export const runArtifactScannerCli = async (
  arguments_: readonly string[],
  repositoryPath: string,
  streams: CliStreams,
): Promise<number> => {
  const purgeOwned =
    arguments_.length === 7 && arguments_[6] === "--purge-owned"
  const reportNonce = arguments_[5] ?? ""
  if (
    arguments_[0] !== "--run-id" ||
    arguments_[2] !== "--ownership" ||
    arguments_[4] !== "--report-nonce" ||
    !SCANNER_REPORT_NONCE.test(reportNonce) ||
    (arguments_.length !== 6 && !purgeOwned)
  ) {
    streams.writeError(
      "Usage: scan-artifacts --run-id <safe-run-id> --ownership <proof> " +
        "--report-nonce <nonce> [--purge-owned]\n",
    )
    return 2
  }
  let report: ArtifactScanReport = Object.freeze({
    ok: false,
    scannedEntries: 0,
    findings: [],
    purged: false,
    reason: "Owned E2E artifact scanner initialization failed safely",
    failureCategory: "internal",
  })
  try {
    const proof = decodeOwnedRunProof(arguments_[3] ?? "")
    if (proof.runId !== arguments_[1]) throw new Error("Owned proof run mismatch")
    const runId = proof.runId
    const dependencies = await createArtifactScannerDependencies(repositoryPath, proof)
    report = await scanArtifactPaths(
      runId,
      [
        `test-results/e2e-runs/${runId}`,
        `test-results/evidence/${runId}`,
      ],
      dependencies,
      purgeOwned,
    )
  } catch (error) {
    report = Object.freeze({
      ...report,
      failureCategory: classifyArtifactScannerFailure(error),
    })
  }
  const rendered = `${JSON.stringify({
    kind: SCANNER_REPORT_KIND,
    version: 1,
    reportNonce,
    report,
  })}\n`
  if (report.ok) streams.writeOutput(rendered)
  else streams.writeError(rendered)
  return report.ok ? 0 : 1
}

const SCANNER_MAX_ENTRIES = 20_000
const SCANNER_MAX_FINDINGS = 10_000
const SCANNER_CATEGORIES = new Set([
  "authorization-header",
  "browser-password",
  "session-cookie",
  "secret-assignment",
  "token-url",
])
const SCANNER_FAILURE_CATEGORIES = new Set<string>(
  ARTIFACT_SCANNER_FAILURE_CATEGORIES,
)
const SCANNER_INITIALIZATION_FAILURE_CATEGORIES = new Set<string>([
  "bounds",
  "ownership-path-safety",
  "internal",
])
const SCANNER_REASONS = new Set([
  "E2E run identifier is invalid",
  "Artifacts were clean; failed-run evidence was purged",
  "E2E artifacts passed external secret scanning",
  "Sensitive artifact patterns were detected; owned run evidence was purged",
  "E2E artifact scanning failed and temporary scanner cleanup was incomplete",
  "E2E artifact scanning failed; owned run outputs were purged",
  "E2E artifact scanning and owned-run purge failed safely",
  "Owned E2E artifact scanner initialization failed safely",
])

const recordValue = (value: unknown): Record<string, unknown> | undefined =>
  value !== null && typeof value === "object" && !Array.isArray(value)
    ? value as Record<string, unknown>
    : undefined
const hasExactKeys = (
  value: Record<string, unknown>,
  keys: readonly string[],
): boolean =>
  JSON.stringify(Object.keys(value).sort()) === JSON.stringify([...keys].sort())
const compareScannerFindings = (
  left: Readonly<{ category: string; path: string }>,
  right: Readonly<{ category: string; path: string }>,
): number =>
  left.path < right.path
    ? -1
    : left.path > right.path
      ? 1
      : left.category.localeCompare(right.category)

const parseScannerCandidate = (
  value: string,
  expectedNonce: string,
): ArtifactScanReport | undefined => {
  try {
    const envelope = recordValue(JSON.parse(value) as unknown)
    if (
      envelope === undefined ||
      !hasExactKeys(envelope, ["kind", "version", "reportNonce", "report"]) ||
      envelope["kind"] !== SCANNER_REPORT_KIND ||
      envelope["version"] !== 1 ||
      envelope["reportNonce"] !== expectedNonce
    ) return undefined
    const parsed = recordValue(envelope["report"])
    if (parsed === undefined) return undefined
    const findings = parsed["findings"]
    const hasFailureCategory = Object.hasOwn(parsed, "failureCategory")
    if (!hasExactKeys(
      parsed,
      hasFailureCategory
        ? ["ok", "scannedEntries", "findings", "purged", "reason", "failureCategory"]
        : ["ok", "scannedEntries", "findings", "purged", "reason"],
    )) return undefined
    const rawFailureCategory = parsed["failureCategory"]
    const failureCategory = typeof rawFailureCategory === "string" &&
      SCANNER_FAILURE_CATEGORIES.has(rawFailureCategory)
      ? rawFailureCategory as ArtifactScannerFailureCategory
      : undefined
    if (
      typeof parsed["ok"] !== "boolean" ||
      !Number.isSafeInteger(parsed["scannedEntries"]) ||
      (parsed["scannedEntries"] as number) < 0 ||
      (parsed["scannedEntries"] as number) > SCANNER_MAX_ENTRIES ||
      !Array.isArray(findings) ||
      findings.length > SCANNER_MAX_FINDINGS ||
      typeof parsed["purged"] !== "boolean" ||
      typeof parsed["reason"] !== "string" ||
      !SCANNER_REASONS.has(parsed["reason"]) ||
      (hasFailureCategory && failureCategory === undefined)
    ) return undefined
    const normalizedFindings: Array<Readonly<{ category: string; path: string }>> = []
    for (const finding of findings) {
      const record = recordValue(finding)
      if (
        record === undefined ||
        !hasExactKeys(record, ["category", "path"]) ||
        typeof record["category"] !== "string" ||
        !SCANNER_CATEGORIES.has(record["category"]) ||
        typeof record["path"] !== "string" ||
        !/^artifact-[a-f0-9]{16}$/u.test(record["path"])
      ) return undefined
      normalizedFindings.push(Object.freeze({
        category: record["category"],
        path: record["path"],
      }))
    }
    for (let index = 1; index < normalizedFindings.length; index += 1) {
      if (compareScannerFindings(
        normalizedFindings[index - 1]!,
        normalizedFindings[index]!,
      ) >= 0) return undefined
    }
    const ok = parsed["ok"] as boolean
    const purged = parsed["purged"] as boolean
    const scannedEntries = parsed["scannedEntries"] as number
    const reason = parsed["reason"] as string
    const combinationValid = ok
      ? scannedEntries > 0 && !hasFailureCategory && normalizedFindings.length === 0 && (
        (purged && reason === "Artifacts were clean; failed-run evidence was purged") ||
        (!purged && reason === "E2E artifacts passed external secret scanning")
      )
      : normalizedFindings.length > 0
        ? failureCategory === "evidence-contamination" &&
          scannedEntries === 0 &&
          purged &&
          reason === "Sensitive artifact patterns were detected; owned run evidence was purged"
        : scannedEntries === 0 && (
          (!hasFailureCategory &&
            !purged &&
            reason === "E2E run identifier is invalid") ||
          (failureCategory !== undefined &&
            SCANNER_INITIALIZATION_FAILURE_CATEGORIES.has(failureCategory) &&
            !purged &&
            reason === "Owned E2E artifact scanner initialization failed safely") ||
          (failureCategory === "cleanup" &&
            !purged &&
            reason === "E2E artifact scanning failed and temporary scanner cleanup was incomplete") ||
          (failureCategory !== undefined &&
            failureCategory !== "cleanup" &&
            purged &&
            reason === "E2E artifact scanning failed; owned run outputs were purged") ||
          (failureCategory === "cleanup" &&
            !purged &&
            reason === "E2E artifact scanning and owned-run purge failed safely")
        )
    if (!combinationValid) return undefined
    return Object.freeze({
      ok,
      scannedEntries,
      findings: Object.freeze(normalizedFindings),
      purged,
      reason,
      ...(failureCategory === undefined ? {} : { failureCategory }),
    }) as ArtifactScanReport
  } catch {
    return undefined
  }
}
export const parseScannerReport = (
  value: string,
  expectedNonce: string,
): ArtifactScanReport | undefined => {
  if (
    !SCANNER_REPORT_NONCE.test(expectedNonce) ||
    Buffer.byteLength(value, "utf8") > 1024 * 1024
  ) return undefined
  const reports: ArtifactScanReport[] = []
  for (const line of value.split(/\r?\n/u)) {
    const candidate = line.trim()
    if (candidate.length === 0) continue
    const parsed = parseScannerCandidate(candidate, expectedNonce)
    if (parsed !== undefined) reports.push(parsed)
    if (reports.length > 1) return undefined
  }
  return reports.length === 1 ? reports[0] : undefined
}
export const parseExternalScannerReport = (
  stdout: string,
  stderr: string,
  expectedNonce: string,
): ArtifactScanReport | undefined =>
  parseScannerReport(`${stdout}\n${stderr}`, expectedNonce)
const purgeAfterScannerFailure = async (
  repositoryPath: string,
  runId: string,
  encodedProof: string,
  failureCategory: ArtifactScannerFailureCategory,
): Promise<ArtifactScanReport> => {
  try {
    const proof = decodeOwnedRunProof(encodedProof)
    const dependencies = await createArtifactScannerDependencies(repositoryPath, proof)
    await dependencies.purgeOwnedRun(runId)
    return Object.freeze({
      ok: false,
      scannedEntries: 0,
      findings: [],
      purged: true,
      reason: "External scanner failed; parent purged owned run outputs",
      failureCategory,
    })
  } catch {
    return Object.freeze({
      ok: false,
      scannedEntries: 0,
      findings: [],
      purged: false,
      reason: "External scanner failed and parent purge could not be proven",
      failureCategory: "cleanup",
    })
  }
}
async function scanArtifactsWithTrustedNode(
  repositoryPath: string,
  node: string,
  request: Readonly<{ runId: string; purgeOwned: boolean; ownership: string }>,
): Promise<ArtifactScanReport> {
  const reportNonce = randomBytes(32).toString("base64url")
  const scanner = createArtifactScannerInvocation(repositoryPath, node, {
    runId: request.runId,
    ownership: request.ownership,
    reportNonce,
    purgeOwned: request.purgeOwned,
  })
  const result = await runOwnedCommand(
    scanner.command,
    scanner.arguments,
    scanner.options,
  )
  if !result.treeTerminated return UNPROVEN_SCANNER_REPORT
  const parsed = parseExternalScannerReport(
    result.stdout,
    result.stderr,
    reportNonce,
  )
  const statusMatches = parsed !== undefined &&
    result.exitCode === (parsed.ok ? 0 : 1)
  const purgeMatches = parsed !== undefined &&
    (!request.purgeOwned || parsed.purged) &&
    (parsed.ok || parsed.purged)
  if parsed !== undefined && statusMatches && purgeMatches return parsed
  return purgeAfterScannerFailure(
    repositoryPath,
    request.runId,
    request.ownership,
    parsed?.failureCategory ?? "internal",
  )
}


type StatePersistenceStatus = Set<null>

const reportStatePersistenceFailure = (
  status: StatePersistenceStatus,
  streams: CliStreams,
): void => {
  if (status.size === 0)
    streams.writeError("Error: E2E runner state persistence failed\n")
  status.add(null)
}

const writeJourneyProgress = (
  status: StatePersistenceStatus,
  persistState: NonNullable<JourneyCliDependencies["persistState"]>,
  streams: CliStreams,
  progress: JourneyProgress,
): void => {
  if (status.size !== 0) return
  try {
    persistState({ version: 1, phase: "progress", progress })
  } catch {
    reportStatePersistenceFailure(status, streams)
    return
  }
  streams.writeError(serializeJourneyProgress(progress))
}
const createProgressWriter = (
  status: StatePersistenceStatus,
  persistState: NonNullable<JourneyCliDependencies["persistState"]>,
  streams: CliStreams,
): NonNullable<JourneyDependencies["reportProgress"]> =>
  writeJourneyProgress.bind(undefined, status, persistState, streams)
const createDefaultJourneyRunId = (): string => randomUUID()

const createDefaultJourneyHmacKey = (): string =>
  randomBytes(32).toString("base64url")

type PrepareRunDependency = NonNullable<JourneyDependencies["prepareRun"]>

const prepareDefaultJourneyRun = async (
  repositoryPath: string,
  runId: Parameters<PrepareRunDependency>[0],
  artifactProfile: Parameters<PrepareRunDependency>[1],
): ReturnType<PrepareRunDependency> => {
  const proof = await prepareOwnedRun(repositoryPath, runId, artifactProfile)
  return Object.freeze({
    adoption: encodeOwnedRunAdoption(proof),
    ownership: encodeOwnedRunProof(proof),
  })
}

type ScanArtifactsDependency = NonNullable<JourneyDependencies["scanArtifacts"]>

const scanDefaultJourneyArtifacts = (
  repositoryPath: string,
  node: string,
  runId: Parameters<ScanArtifactsDependency>[0],
  purgeOwned: Parameters<ScanArtifactsDependency>[1],
  ownership: Parameters<ScanArtifactsDependency>[2],
): ReturnType<ScanArtifactsDependency> =>
  scanArtifactsWithTrustedNode(
    repositoryPath,
    node,
    { runId, purgeOwned, ownership },
  )
const makeDependencies = (
  repositoryPath: string,
  node: string,
  overrides: JourneyCliDependencies,
  reportProgress: NonNullable<JourneyDependencies["reportProgress"]>,
  runPlaywright: JourneyDependencies["runPlaywright"],
): JourneyDependencies => ({
  repositoryPath,
  createRunId: overrides.createRunId ?? createDefaultJourneyRunId,
  createHmacKey: overrides.createHmacKey ?? createDefaultJourneyHmacKey,
  prepareRun: overrides.prepareRun ??
    prepareDefaultJourneyRun.bind(undefined, repositoryPath),
  reportProgress,
  runPlaywright,
  listSpecs: overrides.listSpecs ??
    discoverJourneySpecs.bind(undefined, repositoryPath),
  scanArtifacts: overrides.scanArtifacts ??
    scanDefaultJourneyArtifacts.bind(undefined, repositoryPath, node),
})

const runBoundedJourneySuite = (
  mode: E2eMode,
  dependencies: JourneyDependencies,
): Promise<JourneySuiteReport> =>
  runJourneySuite(mode, dependencies).then(
    (result) => result,
    () => Object.freeze({
      ok: false,
      mode,
      completed: 0,
      results: [],
      reason: "Serialized E2E runner failed before returning a bounded report",
    }),
  )
const finalizeJourneyCliReport = (
  report: JourneySuiteReport,
  status: StatePersistenceStatus,
  persistState: NonNullable<JourneyCliDependencies["persistState"]>,
  streams: CliStreams,
): number => {
  const rawFailureCategory = [...report.results].reverse().find((result) =>
    result.playwrightExitCode !== 0 || !result.scan.ok
  )?.scan.failureCategory
  const safeFailureCategory =
    typeof rawFailureCategory === "string" &&
    SCANNER_FAILURE_CATEGORIES.has(rawFailureCategory)
      ? rawFailureCategory as ArtifactScannerFailureCategory
      : undefined
  let safeReport: JourneySuiteReport
  try {
    safeReport = sanitizeE2ERunnerReport(report)
  } catch {
    reportStatePersistenceFailure(status, streams)
    return 1
  }
  if (status.size === 0) {
    try {
      persistState({ version: 1, phase: "result", report: safeReport })
    } catch {
      reportStatePersistenceFailure(status, streams)
    }
  }
  if (status.size !== 0) return 1
  const rendered = `${JSON.stringify(safeReport)}\n`
  if (safeReport.ok) streams.writeOutput(rendered)
  else {
    streams.writeError(serializeJourneyFailureSummary(safeReport, safeFailureCategory))
    streams.writeError(rendered)
  }
  return report.ok ? 0 : 1
}






const runDefaultPlaywright = async (
  repositoryPath: string,
  playwrightPnpm: TrustedParentPathExecutable,
  playwrightNode: TrustedParentPathExecutable,
  streams: CliStreams,
  playwrightArguments: readonly string[],
  isolatedEnvironment: Readonly<Record<string, string>>,
): ReturnType<JourneyDependencies["runPlaywright"]> => {
  if (playwrightArguments[0] !== "pnpm") {
    throw new Error("Playwright arguments must begin with pnpm")
  }
  const pnpmArguments = playwrightArguments.slice(1)
  const trustedExecutableDirectories = [
    playwrightNode.pathDirectory,
    playwrightPnpm.pathDirectory,
  ]
  const environmentForSource =
    createPlaywrightEnvironmentWithTrustedDirectories(process.env)
  const environmentForIsolation = environmentForSource(isolatedEnvironment)
  const environment = environmentForIsolation(trustedExecutableDirectories)
  environment[E2E_NODE_EXECUTABLE_KEY] = playwrightNode.command
  environment[E2E_PNPM_SCRIPT_KEY] = playwrightPnpm.command
  const knownSecrets = [
    ...databaseUrlSensitiveValues(environment["DATABASE_URL"]!),
    isolatedEnvironment["E2E_EMAIL_PREVIEW_HMAC_KEY"] ?? "",
  ]
  const result = await runOwnedCommand(
    playwrightNode.command,
    [playwrightPnpm.command, ...pnpmArguments],
    {
      cwd: repositoryPath,
      env: environment,
    },
  )
  let reportSanitized = false
  const reportPath = environment["PLAYWRIGHT_JSON_OUTPUT_NAME"]
  if (reportPath !== undefined)
    reportSanitized = await sanitizePlaywrightJsonReport(
      reportPath,
      knownSecrets,
    ).then(
      () => true,
      () => false,
    )
  const finalizedLifecycle = await finalizeAndObserveE2ELifecycle(
    isolatedEnvironment,
    result,
    repositoryPath,
  )
  const lifecycleFinalizationFailed = finalizedLifecycle.finalizationFailed
  const recordedLifecycle = finalizedLifecycle.lifecycle
  const lifecycle = resolveLifecycleObservation(
    recordedLifecycle,
    result.stdout,
    result.stderr,
  )
  const safeStdout = redactProcessOutput(result.stdout, knownSecrets)
  const safeStderr = redactProcessOutput(result.stderr, knownSecrets)
  if (safeStdout) streams.writeOutput(safeStdout)
  if (safeStderr) streams.writeError(safeStderr)
  return {
    diagnostics: [
      ...(result.exitCode === 0 && result.treeTerminated
        ? []
        : collectProcessDiagnostics(result.stdout, result.stderr, knownSecrets)),
      ...(!reportSanitized
        ? ["Owned Playwright JSON report redaction failed safely"]
        : []),
      ...(lifecycleFinalizationFailed
        ? ["Owned Playwright lifecycle finalization failed safely"]
        : []),
    ],
    lifecycleStatus: lifecycle.lifecycleStatus,
    lifecycleStage: lifecycle.lifecycleStage,
    lifecycleObservation: lifecycle.lifecycleObservation,
    lifecycleObservationReason: lifecycle.lifecycleObservationReason,
    exitCode: reportSanitized ? result.exitCode : 1,
    nestedServerTerminated: finalizedLifecycle.nestedServerTerminated,
    treeTerminated: result.treeTerminated,
  }
}

export const runJourneyCli = async (
  arguments_: readonly string[],
  repositoryPath: string,
  streams: CliStreams,
  overrides: JourneyCliDependencies = {},
): Promise<number> => {
  const mode = arguments_[0]
  if (arguments_.length !== 1 || (mode !== "e2e" && mode !== "a11y")) {
    streams.writeError("Usage: e2e-run <e2e|a11y>\n")
    return 2
  }
  let runPlaywright = overrides.runPlaywright
  if (runPlaywright === undefined) {
    let playwrightPnpm: TrustedParentPathExecutable
    let playwrightNode: TrustedParentPathExecutable
    try {
      playwrightPnpm = await resolveTrustedPnpmExecutable(repositoryPath)
    } catch {
      streams.writeError("Trusted pnpm executable is unavailable\n")
      return 1
    }
    try {
      playwrightNode = await resolveTrustedParentNodeExecutable(repositoryPath)
    } catch {
      streams.writeError("Trusted parent-PATH Node executable is unavailable\n")
      return 1
    }
    try {
      await assertTrustedPlaywrightExecutablePair(
        playwrightPnpm,
        playwrightNode,
      )
    } catch {
      streams.writeError(
        "Trusted Playwright pnpm/Node executable pairing is unavailable\n",
      )
      return 1
    }
    runPlaywright = runDefaultPlaywright.bind(
      undefined,
      repositoryPath,
      playwrightPnpm,
      playwrightNode,
      streams,
    )
  }
  let node = ""
  if (overrides.scanArtifacts === undefined) {
    try {
      node = overrides.resolveNodeExecutable === undefined
        ? (await resolveTrustedNodeExecutable(repositoryPath)).command
        : await overrides.resolveNodeExecutable(repositoryPath)
    } catch (_error) {
      streams.writeError("Trusted Node executable is unavailable\n")
      return 1
    }
  }
  const persistState = overrides.persistState ??
    persistE2ERunnerState.bind(undefined, repositoryPath)
  const statePersistenceStatus: StatePersistenceStatus = new Set()
  const progressWriter = createProgressWriter(statePersistenceStatus, persistState, streams)
  const dependencies =
    makeDependencies(repositoryPath, node, overrides, progressWriter, runPlaywright)
  const report = await runBoundedJourneySuite(mode, dependencies)
  return finalizeJourneyCliReport(report, statePersistenceStatus, persistState, streams)
}
