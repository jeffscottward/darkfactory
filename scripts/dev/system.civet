import { execFile, spawn } from "node:child_process"
import { randomUUID } from "node:crypto"
import { constants } from "node:fs"
import {
  access,
  lstat,
  mkdir,
  mkdtemp,
  open,
  readFile,
  realpath,
  rename,
  rm,
} from "node:fs/promises"
import { request as requestHttps } from "node:https"
import { createConnection } from "node:net"
import { homedir } from "node:os"
import { dirname, join, relative, resolve } from "node:path"

import {
  MAX_COMMAND_OUTPUT_BYTES,
  SAFE_PROCESS_ENVIRONMENT_KEYS,
  type CommandOptions,
  type CommandResult,
  type LifecycleFileSystem,
  type ProcessAdapter,
} from "./lifecycle.civet"

const repositoryRoot = await realpath(process.cwd())
const minimalEnvironment = (additions: Readonly<Record<string, string>> = {}): NodeJS.ProcessEnv =>
  const environment: NodeJS.ProcessEnv = {}
  for (const name of SAFE_PROCESS_ENVIRONMENT_KEYS)
    if (process.env[name]) environment[name] = process.env[name]
  return { ...environment, ...additions }

const environmentFor = (
  _command: string,
  _arguments: readonly string[],
  options: CommandOptions,
): NodeJS.ProcessEnv => minimalEnvironment(options.environment)

const readLivePid = async (pm2Home: string): Promise<number | null> =>
  try
    const handle = await open(join(pm2Home, "pm2.pid"), constants.O_RDONLY | constants.O_NOFOLLOW)
    try
      const stats = await handle.stat()
      if (!stats.isFile() || stats.size > 32) return null
      const content = await handle.readFile({ encoding: "utf8" })
      const pid = Number(content.trim())
      if (!Number.isSafeInteger(pid) || pid <= 0) return null
      process.kill(pid, 0)
      return pid
    finally
      await handle.close()
  catch
    return null

const socketIsLive = (path: string): Promise<boolean> => new Promise((resolveSocket) =>
  const socket = createConnection(path)
  const timer = setTimeout(() =>
    socket.destroy(); resolveSocket(false)
  , 500)
  socket.once("connect", () =>
    clearTimeout(timer); socket.destroy(); resolveSocket(true)
  )
  socket.once("error", () =>
    clearTimeout(timer); resolveSocket(false)
  )
)
const pm2DaemonIsLive = async (): Promise<boolean> =>
  const pm2Home = process.env["PM2_HOME"] ?? join(homedir(), ".pm2")
  if (await readLivePid(pm2Home) === null) return false
  return socketIsLive(join(pm2Home, "rpc.sock"))

const isLocalProbeHost = (hostname: string): boolean =>
  const normalized = hostname.toLowerCase()
  return normalized === "localhost" ||
    normalized.endsWith(".localhost") ||
    normalized === "[::1]" ||
    /^127(?:\.\d{1,3}){3}$/.test(normalized)

const localProbeCertificate = async (url: URL): Promise<Buffer | undefined> =>
  if (!isLocalProbeHost(url.hostname)) return undefined
  const path = process.env["NODE_EXTRA_CA_CERTS"] || join(homedir(), ".portless", "ca.pem")
  try
    return await readFile(path)
  catch
    return undefined

const probeHttps = async (value: string): Promise<boolean> =>
  try
    const url = new URL(value)
    if (url.protocol !== "https:") return false
    const ca = await localProbeCertificate(url)
    return await new Promise<boolean>((resolveProbe) =>
      let settled = false
      const finish = (healthy: boolean): void =>
        if (settled) return
        settled = true
        resolveProbe(healthy)
      const request = requestHttps(url, {
        ...(ca === undefined ? {} : { ca }),
        method: "HEAD",
        rejectUnauthorized: true,
        signal: AbortSignal.timeout(5_000),
      }, (response) =>
        response.resume()
        const status = response.statusCode ?? 0
        finish(status >= 200 && status < 400)
      )
      request.once("error", () => finish(false))
      request.end()
    )
  catch
    return false


export const nodeProcessAdapter: ProcessAdapter = Object.freeze({
  workingDirectory: process.cwd(),
  pm2DaemonAvailable: pm2DaemonIsLive,
  probeHttps,
  run: (command, arguments_, options = {}) => new Promise<CommandResult>((resolveCommand) =>
    execFile(command, [...arguments_], {
      encoding: "utf8",
      env: environmentFor(command, arguments_, options),
      maxBuffer: options.maxOutputBytes ?? MAX_COMMAND_OUTPUT_BYTES,
      timeout: options.timeoutMs ?? 15_000,
      windowsHide: true,
    }, (error, stdout, stderr) => resolveCommand(Object.freeze({
      exitCode: typeof error?.code === "number" ? error.code : error ? 1 : 0,
      stdout: String(stdout ?? ""),
      stderr: String(stderr ?? ""),
    })))
  ),
  runInteractive: (command, arguments_, options = {}) => new Promise<CommandResult>((resolveCommand) =>
    const child = spawn(command, [...arguments_], {
      env: minimalEnvironment(options.environment),
      shell: false,
      stdio: "inherit",
      windowsHide: true,
    })
    let settled = false
    const finish = (exitCode: number) =>
      if (settled) return
      settled = true
      clearTimeout(timer)
      resolveCommand(Object.freeze({ exitCode, stdout: "", stderr: "" }))
    const timer = setTimeout(() =>
      child.kill("SIGTERM"); finish(1)
    , options.timeoutMs ?? 120_000)
    child.once("error", () => finish(1))
    child.once("exit", (code) => finish(code ?? 1))
  ),
})

const containedCertificateDirectory = async (directory: string): Promise<string> =>
  try
    const stats = await lstat(directory)
    if (!stats.isDirectory() || stats.isSymbolicLink()) throw new Error("Certificate directory must be regular")
  catch (error)
    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error
    await mkdir(directory, { recursive: false, mode: 0o700 })
  const realDirectory = await realpath(directory)
  const repositoryRelative = relative(repositoryRoot, realDirectory)
  if (repositoryRelative === ".." || repositoryRelative.startsWith(`..${process.platform === "win32" ? "\\" : "/"}`))
    throw new Error("Certificate directory escapes the repository")
  return realDirectory

export const nodeLifecycleFileSystem: LifecycleFileSystem = Object.freeze({
  prepareCertificateOutputs: async (directory, paths) =>
    if (paths.length !== 2) throw new Error("Expected certificate and key outputs")
    const realDirectory = await containedCertificateDirectory(directory)
    const finals = paths.map((path) => resolve(repositoryRoot, path))
    if (finals.some((path) => dirname(path) !== realDirectory)) throw new Error("Unsafe certificate output path")
    for (const path of finals)
      try
        await access(path)
        throw new Error("Certificate output already exists")
      catch (error)
        if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error
    const temporaryDirectory = await mkdtemp(join(realDirectory, `.mkcert-${process.pid}-${randomUUID()}-`))
    const certificatePath = join(temporaryDirectory, "certificate.pem")
    const keyPath = join(temporaryDirectory, "key.pem")
    async function cleanup(): Promise<void>
      await rm(temporaryDirectory, { force: true, recursive: true })
      return undefined
    async function commit(): Promise<void>
      for (const temporary of [certificatePath, keyPath])
        const stats = await lstat(temporary)
        if (!stats.isFile() || stats.isSymbolicLink()) throw new Error("mkcert produced an unsafe output")
      for (const path of finals)
        try
          await access(path)
          throw new Error("Certificate output appeared during generation")
        catch (error)
          if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error
      await rename(certificatePath, finals[0]!)
      await rename(keyPath, finals[1]!)
      await cleanup()
      return undefined
    return Object.freeze({
      certificatePath,
      keyPath,
      cleanup,
      commit,
    })
})
