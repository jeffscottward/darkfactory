import { execFile } from "node:child_process"
import { readFile } from "node:fs/promises"
import { promisify } from "node:util"
import { describe, expect, it } from "vitest"

type Step = {
  uses?: string
  with?: Record<string, unknown>
}
type Job = {
  name: string
  strategy?: { "fail-fast": boolean; matrix: { language: string[] } }
  steps: Step[]
}
type Workflow = { jobs: Record<string, Job> }

const policies = [
  { file: "codeql", job: "analyze", name: "Analyze (${{ matrix.language }})" },
  { file: "dependency-review", job: "dependency-review", name: "Dependency Review" },
  { file: "scorecard", job: "scorecard", name: "Scorecard analysis" },
]
const sources = await Promise.all(policies.map(({ file }) =>
  readFile(new URL(`../../.github/workflows/${file}.yml`, import.meta.url), "utf8")
))
const execFileAsync = promisify(execFile)
const { stdout } = await execFileAsync("bun", [
  "-e",
  "console.log(JSON.stringify(JSON.parse(process.argv[1]).map(source => Bun.YAML.parse(source))))",
  JSON.stringify(sources),
], { timeout: 10_000, maxBuffer: 1024 * 1024 })
const workflows = JSON.parse(stdout) as Workflow[]

// Canonical security-preflight tests own exact opt-ins, positive probes and
// honest not-run outcomes; security-workflows tests own the helper's execution
// and publication gates. Do not emulate weaker Actions string comparisons here.
describe("hosted security capability policy", () =>
  it("preserves security check identities and both independent CodeQL languages", () =>
    policies.forEach((policy, index) =>
      const workflow = workflows[index]!
      expect(Object.keys(workflow.jobs)).toEqual([policy.job])
      expect(workflow.jobs[policy.job]!.name).toBe(policy.name)
    )
    const codeql = workflows[0]!.jobs.analyze!
    expect(codeql.strategy).toEqual({
      "fail-fast": false,
      matrix: { language: ["javascript-typescript", "actions"] },
    })
    const init = codeql.steps.find((step) => step.uses?.startsWith("github/codeql-action/init@"))
    const analyze = codeql.steps.find((step) => step.uses?.startsWith("github/codeql-action/analyze@"))
    expect(init?.with?.languages).toBe("${{ matrix.language }}")
    expect(analyze?.with?.category).toBe("/language:${{ matrix.language }}")
  )

  it("keeps CodeQL analysis and ingestion on the same immutable action release", () =>
    const codeqlActions = workflows.flatMap((workflow) =>
      Object.values(workflow.jobs).flatMap((job) =>
        job.steps.flatMap((step) => step.uses?.startsWith("github/codeql-action/") ? [step.uses] : [])
      )
    ).map((action) => action.split("@"))
    expect(new Set(codeqlActions.map(([action]) => action))).toEqual(new Set([
      "github/codeql-action/init",
      "github/codeql-action/analyze",
      "github/codeql-action/upload-sarif",
    ]))
    const refs = [...new Set(codeqlActions.map(([, ref]) => ref))]
    expect(refs).toHaveLength(1)
    expect(refs[0]).toMatch(/^[a-f\d]{40}$/i)
  )
)
