import {
  chmod,
  link,
  lstat,
  mkdir,
  mkdtemp,
  readFile,
  rename,
  rm,
  rmdir,
  unlink,
  writeFile,
} from "node:fs/promises"
import { dirname, join, relative } from "node:path"

import { GeneratorError } from "./errors.civet"
import {
  assertNoSymlinkPath,
  assertDirectoryChain,
  canonicalWorkspaceRoot,
  captureDirectoryChain,
  hasIdentity,
  identityAt,
  pathExists,
  type PathIdentity,
} from "./path-safety.civet"
import { assertGenerationPlanIntegrity, sha256 } from "./plan.civet"
import type { ApplyResult, GenerationPlan, PlannedFile } from "./types.civet"

export type ApplyGenerationDependencies = Readonly<{
  assertNoSymlinkPath: typeof assertNoSymlinkPath
  hasIdentity: typeof hasIdentity
  identityAt: typeof identityAt
  link: (existingPath: string, newPath: string) => Promise<void>
  lstat: (path: string) => ReturnType<typeof lstat>
  mkdir: (path: string, options?: Parameters<typeof mkdir>[1]) => Promise<unknown>
  pathExists: typeof pathExists
  rm: (path: string, options?: Parameters<typeof rm>[1]) => Promise<void>
  rmdir: (path: string) => Promise<void>
}>
export type ApplyGenerationOptions = Readonly<{
  beforePromotion?: () => Promise<void>
  afterFilePromotion?: (file: PlannedFile, index: number) => Promise<void>
  afterPromotion?: () => Promise<void>
  dependencies?: Readonly<Partial<ApplyGenerationDependencies>>
}>

type AppliedFile = Readonly<{
  file: PlannedFile
  backupPath?: string
  destinationIdentity: PathIdentity
}>

const errorCode = (error: unknown): string | undefined =>
  (error as NodeJS.ErrnoException | undefined)?.code

const removeEmptyOwned = async (
  identity: PathIdentity,
  dependencies: ApplyGenerationDependencies,
): Promise<boolean> =>
  try
    if (!await dependencies.hasIdentity(identity)) return false
    await dependencies.rmdir(identity.path)
    return true
  catch (error)
    return errorCode(error) === "ENOENT"

const createSafeParents = async (
  root: string,
  relativeDirectory: string,
  created: PathIdentity[],
  dependencies: ApplyGenerationDependencies,
): Promise<void> =>
  let current = root
  for (const segment of relativeDirectory.split("/").filter(Boolean))
    current = join(current, segment)
    try
      await dependencies.mkdir(current)
      created.push(await dependencies.identityAt(current))
    catch (error)
      if (errorCode(error) !== "EEXIST") throw error
      const stats = await dependencies.lstat(current)
      if (!stats.isDirectory() || stats.isSymbolicLink())
        throw new GeneratorError("SYMLINK_UNSAFE", "Generated ancestor is not a safe directory")

const hashAt = async (path: string): Promise<string> => sha256(await readFile(path, "utf8"))

const rollbackApplied = async (
  plan: GenerationPlan,
  applied: readonly AppliedFile[],
  parentChains: ReadonlyMap<string, readonly PathIdentity[]>,
  dependencies: ApplyGenerationDependencies,
): Promise<boolean> =>
  let safe = true
  for (const entry of [...applied].reverse())
    const destination = join(plan.targetRoot, ...entry.file.path.split("/"))
    try
      await assertDirectoryChain(parentChains.get(dirname(entry.file.path))!)
      await dependencies.assertNoSymlinkPath(plan.targetRoot, entry.file.path)
      if (!await dependencies.hasIdentity(entry.destinationIdentity) || !await dependencies.pathExists(destination) || await hashAt(destination) !== entry.file.sha256)
        safe = false
        continue
      if (entry.file.operation === "create")
        await unlink(destination)
      else if (entry.backupPath)
        await rename(entry.backupPath, destination)
      else
        safe = false
    catch (_error)
      safe = false
  return safe

export const applyGenerationPlan = async (
  plan: GenerationPlan,
  options: ApplyGenerationOptions = {},
): Promise<ApplyResult> =>
  assertGenerationPlanIntegrity(plan)
  const dependencies: ApplyGenerationDependencies = Object.freeze({
    assertNoSymlinkPath:
      options.dependencies?.assertNoSymlinkPath ?? assertNoSymlinkPath,
    hasIdentity: options.dependencies?.hasIdentity ?? hasIdentity,
    identityAt: options.dependencies?.identityAt ?? identityAt,
    link: options.dependencies?.link ?? link,
    lstat: options.dependencies?.lstat ?? lstat,
    mkdir: options.dependencies?.mkdir ?? mkdir,
    pathExists: options.dependencies?.pathExists ?? pathExists,
    rm: options.dependencies?.rm ?? rm,
    rmdir: options.dependencies?.rmdir ?? rmdir,
  })
  const root = await canonicalWorkspaceRoot(plan.targetRoot)
  if (root !== plan.targetRoot)
    throw new GeneratorError("ANCESTOR_CHANGED", "Target workspace identity changed")

  const createdParents: PathIdentity[] = []
  const applied: AppliedFile[] = []
  const parentChains = new Map<string, readonly PathIdentity[]>()
  let lockIdentity: PathIdentity | undefined
  let tempIdentity: PathIdentity | undefined
  let committed = false
  let cleanupComplete = true
  let failure: unknown
  const tempRoot = await mkdtemp(join(plan.targetRoot, ".generate-feature-"))

  try
    tempIdentity = await dependencies.identityAt(tempRoot)
    await chmod(tempRoot, 0o700)
    await dependencies.assertNoSymlinkPath(plan.targetRoot, ".darkfactory/.generate-feature.lock")
    const lockParentIdentities = await captureDirectoryChain(plan.targetRoot, ".darkfactory")
    await assertDirectoryChain(lockParentIdentities)
    const lockPath = join(plan.targetRoot, ".darkfactory/.generate-feature.lock")
    try
      await dependencies.mkdir(lockPath, { mode: 0o700 })
      lockIdentity = await dependencies.identityAt(lockPath)
    catch (error)
      if (errorCode(error) === "EEXIST")
        throw new GeneratorError("TARGET_COLLISION", "Feature generation is already in progress")
      throw error
    const stagedPaths = new Map<string, string>()
    const backupPaths = new Map<string, string>()

    for (const [index, file] of plan.files.entries())
      await dependencies.assertNoSymlinkPath(plan.targetRoot, file.path)
      const destination = join(plan.targetRoot, ...file.path.split("/"))
      if (file.operation === "create")
        if (await dependencies.pathExists(destination))
          throw new GeneratorError("TARGET_COLLISION", "Feature target collision")
      else
        if (!await dependencies.pathExists(destination) || await hashAt(destination) !== file.previousSha256)
          throw new GeneratorError("TARGET_COLLISION", "Generated registry changed after planning")
        const backupPath = join(tempRoot, `backup-${index}`)
        await writeFile(backupPath, await readFile(destination, "utf8"), { flag: "wx" })
        backupPaths.set(file.path, backupPath)
      const stagedPath = join(tempRoot, `staged-${index}`)
      await writeFile(stagedPath, file.content, { encoding: "utf8", flag: "wx" })
      stagedPaths.set(file.path, stagedPath)

    const ownedRoots = [
      plan.containerRoot,
      `apps/web/src/app/(portal)/${plan.names.pluralKebab}`,
      `packages/api/src/generated/${plan.names.kebab}`,
      `packages/db/src/generated/${plan.names.kebab}`,
    ].sort()
    for (const ownedRoot of ownedRoots)
      const parent = dirname(ownedRoot)
      await createSafeParents(plan.targetRoot, parent, createdParents, dependencies)
      const absoluteRoot = join(plan.targetRoot, ...ownedRoot.split("/"))
      try
        await dependencies.mkdir(absoluteRoot)
        createdParents.push(await dependencies.identityAt(absoluteRoot))
      catch (error)
        if (errorCode(error) === "EEXIST")
          throw new GeneratorError("TARGET_COLLISION", "Feature-owned directory collision")
        throw error

    const parents = [...new Set(plan.files.map((file) => dirname(file.path)))].sort()
    for (const parent of parents)
      await createSafeParents(plan.targetRoot, parent, createdParents, dependencies)
      parentChains.set(parent, await captureDirectoryChain(plan.targetRoot, parent))


    await options.beforePromotion?.()
    for (const [index, file] of plan.files.entries())
      await assertDirectoryChain(parentChains.get(dirname(file.path))!)
      await dependencies.assertNoSymlinkPath(plan.targetRoot, file.path)
      const destination = join(plan.targetRoot, ...file.path.split("/"))
      const stagedPath = stagedPaths.get(file.path)!
      if (file.operation === "create")
        await dependencies.link(stagedPath, destination).catch((error: unknown) =>
          if (errorCode(error) === "EEXIST")
            throw new GeneratorError("TARGET_COLLISION", "Feature target collision")
          throw error
        )
      else
        if (await hashAt(destination) !== file.previousSha256)
          throw new GeneratorError("TARGET_COLLISION", "Generated registry changed during promotion")
        await rename(stagedPath, destination)
      const destinationIdentity = await dependencies.identityAt(destination)
      const backupPath = backupPaths.get(file.path)
      applied.push(Object.freeze({
        file,
        destinationIdentity,
        ...(backupPath === undefined ? {} : { backupPath }),
      }))
      await options.afterFilePromotion?.(file, index)
    await options.afterPromotion?.()
    committed = true
  catch (error)
    failure = error
    cleanupComplete = await rollbackApplied(plan, applied, parentChains, dependencies) && cleanupComplete
  finally
    if (lockIdentity) cleanupComplete = await removeEmptyOwned(lockIdentity, dependencies) && cleanupComplete
    if (!committed)
      for (const identity of [...createdParents].reverse())
        cleanupComplete = await removeEmptyOwned(identity, dependencies) && cleanupComplete
    if (tempIdentity && await dependencies.hasIdentity(tempIdentity))
      await dependencies.rm(tempRoot, { force: true, recursive: true }).catch(() =>
        cleanupComplete = false
      )
    else cleanupComplete = false

  if (failure !== undefined)
    if (!cleanupComplete)
      throw new GeneratorError("ROLLBACK_UNSAFE", "Rollback cleanup was not safe", { cause: failure })
    throw failure

  return Object.freeze({
    capsulePath: join(plan.targetRoot, ...plan.containerRoot.split("/")),
    promotedFiles: Object.freeze(plan.files.map((file) => file.path)),
    cleanup: cleanupComplete ? "complete" as const : "manual-cleanup-required" as const,
  })
