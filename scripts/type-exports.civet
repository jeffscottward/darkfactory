import { constants, type Dirent } from "node:fs"
import { lstat, open, opendir } from "node:fs/promises"
import { dirname, isAbsolute, join, relative, resolve, sep, win32 } from "node:path"
import { fileURLToPath, pathToFileURL } from "node:url"

export type TypeExportTarget = Readonly<{
  packageName: string
  subpath: string
  target: string
}>

export type TypeExportProblem = TypeExportTarget &
  Readonly<{
    reason: string
  }>

export type TypeExportReport = Readonly<{
  targets: readonly TypeExportTarget[]
  problems: readonly TypeExportProblem[]
}>

type WorkspacePackage = Readonly<{
  directory: string
  relativeDirectory: string
  name: string
  exports: unknown
}>

type WorkspacePattern = Readonly<{
  excluded: boolean
  segments: readonly string[]
}>

type AuditBudget = {
  exportNodes: number
  targetLstats: number
  typeTargets: number
}

const PRUNED_DIRECTORIES = new Set([
  ".git",
  "node_modules",
])

const MAX_WORKSPACE_CONFIG_BYTES = 64 * 1024
const MAX_WORKSPACE_PATTERN_LENGTH = 256
const MAX_MANIFEST_BYTES = 1024 * 1024
const MAX_TOTAL_MANIFEST_BYTES = 16 * 1024 * 1024
const MAX_WORKSPACE_DIRECTORIES = 10_000
const MAX_WORKSPACE_ENTRIES = 100_000
const MAX_WORKSPACE_PACKAGES = 1000
const MAX_WORKSPACE_PATTERNS = 100
const MAX_EXPORT_DEPTH = 100
const MAX_EXPORT_KEYS = 10_000
const MAX_EXPORT_NODES = 10_000
const MAX_TOTAL_EXPORT_NODES = 100_000
const MAX_TYPE_TARGETS = 1000
const MAX_TOTAL_TARGET_LSTATS = 100_000
const MAX_TOTAL_TYPE_TARGETS = 10_000

const compareText = (left: string, right: string): number =>
  left < right ? -1 : left > right ? 1 : 0

const compareTargets = (
  left: TypeExportTarget,
  right: TypeExportTarget,
): number =>
  compareText(left.packageName, right.packageName) ||
  compareText(left.subpath, right.subpath) ||
  compareText(left.target, right.target)

const isNodeError = (error: unknown, code: string): boolean =>
  error instanceof Error && "code" in error && error.code === code

const displayValue = (value: string): string =>
  value.replace(/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}]/gu, (character) =>
    const codePoint = character.codePointAt(0)!
    return codePoint <= 0xffff
      ? `\\u${codePoint.toString(16).padStart(4, "0")}`
      : `\\u{${codePoint.toString(16)}}`
  )

const readBoundedRegularFile = async (
  path: string,
  label: string,
  maximumBytes: number,
): Promise<Readonly<{ size: number; source: string }>> =>
  const before = await lstat(path)
  if before.isSymbolicLink() || !before.isFile()
    throw new Error(`${label} must be a regular non-symbolic file`)
  if before.size > maximumBytes
    throw new Error(`${label} exceeds ${maximumBytes} bytes`)

  const noFollowFlag = constants.O_NOFOLLOW
  const handle = await open(path, constants.O_RDONLY | noFollowFlag)
  try
    const opened = await handle.stat()
    if !opened.isFile()
      throw new Error(`${label} must be a regular non-symbolic file`)
    if opened.size > maximumBytes
      throw new Error(`${label} exceeds ${maximumBytes} bytes`)

    const buffer = Buffer.allocUnsafe(maximumBytes + 1)
    let size = 0
    while size < buffer.length
      const result = await handle.read(
        buffer,
        size,
        buffer.length - size,
        size,
      )
      if result.bytesRead === 0 then break
      size += result.bytesRead
    if size > maximumBytes
      throw new Error(`${label} exceeds ${maximumBytes} bytes`)

    const after = await lstat(path)
    const openedAfter = await handle.stat()
    if after.isSymbolicLink() ||
      !after.isFile() ||
      after.dev !== openedAfter.dev ||
      after.ino !== openedAfter.ino
      throw new Error(`${label} changed during audit`)
    return {
      size,
      source: buffer.subarray(0, size).toString("utf8"),
    }
  finally
    await handle.close()

const segmentMatches = (pattern: string, value: string): boolean =>
  let patternIndex = 0
  let valueIndex = 0
  let starIndex = -1
  let starValueIndex = -1

  while valueIndex < value.length
    const patternCharacter = pattern[patternIndex]
    if patternCharacter === "?" || patternCharacter === value[valueIndex]
      patternIndex += 1
      valueIndex += 1
    else if patternCharacter === "*"
      starIndex = patternIndex
      starValueIndex = valueIndex
      patternIndex += 1
    else if starIndex >= 0
      patternIndex = starIndex + 1
      starValueIndex += 1
      valueIndex = starValueIndex
    else
      return false
  while (pattern[patternIndex] === "*") patternIndex += 1
  return patternIndex === pattern.length

const workspacePatternMatches = (
  pattern: WorkspacePattern,
  workspacePath: string,
): boolean =>
  const values = workspacePath.split("/")
  const states = Array.from(
    { length: pattern.segments.length + 1 },
    () => new Uint8Array(values.length + 1),
  )
  states[0]![0] = 1
  for (let patternIndex = 0; patternIndex < pattern.segments.length; patternIndex += 1)
    const patternSegment = pattern.segments[patternIndex]!
    for (let valueIndex = 0; valueIndex <= values.length; valueIndex += 1)
      if states[patternIndex]![valueIndex] === 0 then continue
      if patternSegment === "**"
        states[patternIndex + 1]![valueIndex] = 1
        if valueIndex < values.length
          states[patternIndex]![valueIndex + 1] = 1
      else if valueIndex < values.length &&
        segmentMatches(patternSegment, values[valueIndex]!)
        states[patternIndex + 1]![valueIndex + 1] = 1
  return states[pattern.segments.length]![values.length] === 1

const readWorkspacePatterns = async (
  rootDirectory: string,
): Promise<readonly WorkspacePattern[]> =>
  const workspaceConfigPath = join(rootDirectory, "pnpm-workspace.yaml")
  const workspaceConfig = await readBoundedRegularFile(
    workspaceConfigPath,
    "pnpm-workspace.yaml",
    MAX_WORKSPACE_CONFIG_BYTES,
  )
  const source = workspaceConfig.source
  const patterns: WorkspacePattern[] = []
  let readingPackages = false

  for (const line of source.split(/\r?\n/))
    if !readingPackages
      if /^packages:\s*(?:#.*)?$/.test(line) then readingPackages = true
      continue
    if /^\S/.test(line) then break
    if /^\s*(?:#.*)?$/.test(line) then continue

    const item = line.match(
      /^\s+-\s+(?:\"([^\"]+)\"|'([^']+)'|([^#\s]+))\s*(?:#.*)?$/,
    )
    if item === null
      throw new Error(`Unsupported pnpm workspace package pattern: ${line.trim()}`)
    const configuredPattern = (item[1] ?? item[2] ?? item[3])!
    const excluded = configuredPattern.startsWith("!")
    const pattern = excluded ? configuredPattern.slice(1) : configuredPattern
    const portablePattern = pattern.startsWith("./") ? pattern.slice(2) : pattern
    if configuredPattern.length > MAX_WORKSPACE_PATTERN_LENGTH
      throw new Error(
        `Workspace package pattern exceeds ${MAX_WORKSPACE_PATTERN_LENGTH} characters: ${displayValue(configuredPattern)}`,
      )
    const patternSegments = portablePattern.split("/")
    if /[\[\]{}()]/.test(portablePattern) ||
      patternSegments.some((segment) => segment.includes("**") && segment !== "**")
      throw new Error(
        `Unsupported pnpm workspace glob syntax: ${displayValue(configuredPattern)}`,
      )
    if portablePattern.length === 0 ||
      portablePattern.includes("\\") ||
      isAbsolute(portablePattern) ||
      win32.isAbsolute(portablePattern) ||
      patternSegments.includes("..")
      throw new Error(`Unsafe pnpm workspace package pattern: ${displayValue(configuredPattern)}`)
    patterns.push({ excluded, segments: patternSegments })
    if patterns.length > MAX_WORKSPACE_PATTERNS
      throw new Error(
        `Workspace pattern count exceeds ${MAX_WORKSPACE_PATTERNS}`,
      )

  if patterns.length === 0
    throw new Error("pnpm-workspace.yaml must configure at least one package pattern")
  return patterns

const isWorkspacePath = (
  workspacePath: string,
  patterns: readonly WorkspacePattern[],
): boolean =>
  const included = patterns.some(
    (pattern) => !pattern.excluded && workspacePatternMatches(pattern, workspacePath),
  )
  const excluded = patterns.some(
    (pattern) => pattern.excluded && workspacePatternMatches(pattern, workspacePath),
  )
  return included && !excluded

const readWorkspacePackages = async (
  rootDirectory: string,
): Promise<readonly WorkspacePackage[]> =>
  const patterns = await readWorkspacePatterns(rootDirectory)
  const packages: WorkspacePackage[] = []
  const pending: Array<
    Readonly<{ directory: string; relativeDirectory: string }>
  > = [{ directory: rootDirectory, relativeDirectory: "" }]
  let directoryCount = 0
  let entryCount = 0
  let totalManifestBytes = 0

  while pending.length > 0
    const current = pending.pop()!
    directoryCount += 1
    if directoryCount > MAX_WORKSPACE_DIRECTORIES
      throw new Error(
        `Workspace directory count exceeds ${MAX_WORKSPACE_DIRECTORIES}`,
      )

    const entries: Dirent[] = []
    const directory = await opendir(current.directory)
    for await (const entry of directory)
      entryCount += 1
      if entryCount > MAX_WORKSPACE_ENTRIES
        throw new Error(
          `Workspace directory entries exceed ${MAX_WORKSPACE_ENTRIES}`,
        )
      entries.push(entry)
    entries.sort((left, right) => compareText(left.name, right.name))

    const configuredWorkspace =
      current.relativeDirectory.length > 0 &&
      isWorkspacePath(current.relativeDirectory, patterns)
    const manifestEntry = entries.find((entry) => entry.name === "package.json")
    const currentIsPackage =
      configuredWorkspace && manifestEntry !== undefined && manifestEntry.isFile()
    const unsafeSymlink = entries.find((entry) =>
      if !entry.isSymbolicLink() || PRUNED_DIRECTORIES.has(entry.name)
        return false
      const candidatePath = current.relativeDirectory.length === 0
        ? entry.name
        : `${current.relativeDirectory}/${entry.name}`
      return entry.name === "package.json" ||
        !currentIsPackage ||
        isWorkspacePath(candidatePath, patterns)
    )
    if unsafeSymlink !== undefined
      const symlinkPath = current.relativeDirectory.length === 0
        ? unsafeSymlink.name
        : `${current.relativeDirectory}/${unsafeSymlink.name}`
      throw new Error(
        `Symbolic links are not allowed during workspace discovery: ${displayValue(symlinkPath)}`,
      )

    if configuredWorkspace && manifestEntry !== undefined
      if !manifestEntry.isFile()
        throw new Error(
          `Workspace manifest ${displayValue(current.relativeDirectory)}/package.json must be a regular non-symbolic file`,
        )
      const manifestPath = join(current.directory, manifestEntry.name)
      const manifestLabel =
        `Workspace manifest ${displayValue(current.relativeDirectory)}/package.json`
      const manifestFile = await readBoundedRegularFile(
        manifestPath,
        manifestLabel,
        MAX_MANIFEST_BYTES,
      )
      totalManifestBytes += manifestFile.size
      if totalManifestBytes > MAX_TOTAL_MANIFEST_BYTES
        throw new Error(
          `Workspace manifests exceed ${MAX_TOTAL_MANIFEST_BYTES} total bytes`,
        )
      const manifestSource = manifestFile.source
      let manifest
      try
        manifest = JSON.parse(manifestSource) as Readonly<{
          name?: unknown
          exports?: unknown
        }>
      catch
        throw new Error(
          `Workspace manifest ${displayValue(current.relativeDirectory)}/package.json is invalid JSON`,
        )
      if typeof manifest.name !== "string" || manifest.name.length === 0
        throw new Error(
          `Workspace manifest ${displayValue(current.relativeDirectory)}/package.json must have a package name`,
        )
      packages.push({
        directory: current.directory,
        relativeDirectory: current.relativeDirectory,
        name: manifest.name,
        exports: manifest.exports,
      })
      if packages.length > MAX_WORKSPACE_PACKAGES
        throw new Error(
          `Workspace package count exceeds ${MAX_WORKSPACE_PACKAGES}`,
        )

    for (let index = entries.length - 1; index >= 0; index -= 1)
      const entry = entries[index]!
      if !entry.isDirectory() || PRUNED_DIRECTORIES.has(entry.name) then continue
      const childRelativeDirectory = current.relativeDirectory.length === 0
        ? entry.name
        : `${current.relativeDirectory}/${entry.name}`
      pending.push({
        directory: join(current.directory, entry.name),
        relativeDirectory: childRelativeDirectory,
      })

  packages.sort((left, right) =>
    return compareText(left.name, right.name) ||
      compareText(left.relativeDirectory, right.relativeDirectory)
  )

  const pathsByName = new Map<string, string[]>()
  for (const workspacePackage of packages)
    const paths = pathsByName.get(workspacePackage.name) ?? []
    paths.push(workspacePackage.relativeDirectory)
    pathsByName.set(workspacePackage.name, paths)
  const duplicateNames = [...pathsByName.entries()]
    .filter(([, paths]) => paths.length > 1)
    .sort(([left], [right]) => compareText(left, right))
  if duplicateNames.length > 0
    throw new Error([
      "Duplicate workspace package names:",
      ...duplicateNames.map(([name, paths]) =>
        `- ${displayValue(name)}: ${paths.sort(compareText).map(displayValue).join(", ")}`
      ),
    ].join("\n"))

  return packages

const collectPackageTargets = (
  workspacePackage: WorkspacePackage,
  budget: AuditBudget,
): readonly TypeExportTarget[] =>
  const targets: TypeExportTarget[] = []
  const pending: Array<
    Readonly<{
      depth: number
      subpath: string
      topLevel: boolean
      value: unknown
    }>
  > = [{
    depth: 0,
    subpath: ".",
    topLevel: true,
    value: workspacePackage.exports,
  }]
  const manifestLabel =
    `Workspace manifest ${displayValue(workspacePackage.relativeDirectory)}/package.json exports`
  let keyCount = 0
  let nodeCount = 0

  while pending.length > 0
    const current = pending.pop()!
    nodeCount += 1
    budget.exportNodes += 1
    if budget.exportNodes > MAX_TOTAL_EXPORT_NODES
      throw new Error(
        `Workspace exports exceed ${MAX_TOTAL_EXPORT_NODES} total nodes`,
      )
    if nodeCount > MAX_EXPORT_NODES
      throw new Error(`${manifestLabel} exceed ${MAX_EXPORT_NODES} nodes`)
    if current.depth > MAX_EXPORT_DEPTH
      throw new Error(`${manifestLabel} exceed maximum depth ${MAX_EXPORT_DEPTH}`)

    if Array.isArray(current.value)
      for (let index = current.value.length - 1; index >= 0; index -= 1)
        pending.push({
          depth: current.depth + 1,
          subpath: current.subpath,
          topLevel: false,
          value: current.value[index],
        })
      continue
    if current.value === null || typeof current.value !== "object" then continue

    const conditions = Object.entries(
      current.value as Readonly<Record<string, unknown>>,
    ).sort(([left], [right]) => compareText(left, right))
    keyCount += conditions.length
    if keyCount > MAX_EXPORT_KEYS
      throw new Error(`${manifestLabel} exceed ${MAX_EXPORT_KEYS} keys`)
    for (let index = conditions.length - 1; index >= 0; index -= 1)
      const [condition, nestedValue] = conditions[index]!
      const nestedSubpath = current.topLevel && condition.startsWith(".")
        ? condition
        : current.subpath
      if condition === "types" && typeof nestedValue === "string"
        targets.push({
          packageName: workspacePackage.name,
          subpath: nestedSubpath,
          target: nestedValue,
        })
        budget.typeTargets += 1
        if budget.typeTargets > MAX_TOTAL_TYPE_TARGETS
          throw new Error(
            `Workspace exports exceed ${MAX_TOTAL_TYPE_TARGETS} total type targets`,
          )
        if targets.length > MAX_TYPE_TARGETS
          throw new Error(
            `${manifestLabel} exceed ${MAX_TYPE_TARGETS} type targets`,
          )
      else
        pending.push({
          depth: current.depth + 1,
          subpath: nestedSubpath,
          topLevel: false,
          value: nestedValue,
        })

  return targets

const targetProblemReason = async (
  packageDirectory: string,
  target: string,
  budget: AuditBudget,
): Promise<string | undefined> =>
  if isAbsolute(target) || win32.isAbsolute(target)
    return "absolute path is not allowed"
  if target.includes("\0") then return "NUL bytes are not allowed"

  const portableSegments = target.replaceAll("\\", "/").split("/")
  if portableSegments.includes("..") then return "path traversal is not allowed"
  if !target.startsWith("./") then return 'target must start with "./"'

  const targetPath = resolve(packageDirectory, target)
  const packageRelativePath = relative(packageDirectory, targetPath)
  if packageRelativePath === ".." ||
    packageRelativePath.startsWith(`..${sep}`) ||
    isAbsolute(packageRelativePath)
    return "path traversal is not allowed"

  const segments = packageRelativePath.split(sep).filter(Boolean)
  let currentPath = packageDirectory
  for (const [index, segment] of segments.entries())
    currentPath = join(currentPath, segment)
    let metadata
    budget.targetLstats += 1
    if budget.targetLstats > MAX_TOTAL_TARGET_LSTATS
      throw new Error(
        `Type export audit exceeds ${MAX_TOTAL_TARGET_LSTATS} total filesystem checks`,
      )
    try
      metadata = await lstat(currentPath)
    catch (error)
      if isNodeError(error, "ENOENT")
        return "missing or not a regular file"
      throw error

    if metadata.isSymbolicLink() then return "symbolic links are not allowed"
    const finalSegment = index === segments.length - 1
    if finalSegment
      return metadata.isFile()
        ? undefined
        : "missing or not a regular file"
    if !metadata.isDirectory()
      return "missing or not a regular file"

  return "missing or not a regular file"

export const inspectTypeExports = async (
  rootDirectory: string,
): Promise<TypeExportReport> =>
  const workspacePackages = await readWorkspacePackages(resolve(rootDirectory))
  const budget: AuditBudget = {
    exportNodes: 0,
    targetLstats: 0,
    typeTargets: 0,
  }
  const uniqueTargets = new Map<
    string,
    Readonly<{ directory: string; target: TypeExportTarget }>
  >()

  for (const workspacePackage of workspacePackages)
    for (const target of collectPackageTargets(workspacePackage, budget))
      const key = JSON.stringify([
        workspacePackage.directory,
        target.subpath,
        target.target,
      ])
      uniqueTargets.set(key, {
        directory: workspacePackage.directory,
        target,
      })

  const locatedTargets = [...uniqueTargets.values()].sort((left, right) =>
    compareTargets(left.target, right.target)
  )
  const targets = locatedTargets.map(({ target }) => target)
  const problems: TypeExportProblem[] = []
  for (const locatedTarget of locatedTargets)
    const reason = await targetProblemReason(
      locatedTarget.directory,
      locatedTarget.target.target,
      budget,
    )
    if reason !== undefined
      problems.push({ ...locatedTarget.target, reason })

  return {
    targets,
    problems: problems.sort(compareTargets),
  }

export const formatTypeExportProblems = (
  problems: readonly TypeExportProblem[],
): string => [
  "Type export audit failed:",
  ...problems.map((problem) =>
    `- ${displayValue(problem.packageName)} ${displayValue(problem.subpath)} -> ${displayValue(problem.target)}: ${displayValue(problem.reason)}`
  ),
].join("\n")

export const formatTypeExportTargets = (
  targets: readonly TypeExportTarget[],
): string => [
  `Type export audit passed (${targets.length} targets):`,
  ...targets.map((target) =>
    `- ${displayValue(target.packageName)} ${displayValue(target.subpath)} -> ${displayValue(target.target)}`
  ),
].join("\n")

export const auditTypeExports = async (
  rootDirectory: string,
): Promise<readonly TypeExportTarget[]> =>
  const report = await inspectTypeExports(rootDirectory)
  if report.problems.length > 0
    throw new Error(formatTypeExportProblems(report.problems))
  return report.targets

export type TypeExportEntrypointDependencies = Readonly<{
  invokedPath: string | undefined
  moduleUrl: string
  rootDirectory: string
  inspectTypeExports: (rootDirectory: string) => Promise<TypeExportReport>
  writeOutput: (value: string) => void
  writeError: (value: string) => void
  exitState: { exitCode?: string | number | null | undefined }
}>

const writeEntrypointFailure = (
  dependencies: TypeExportEntrypointDependencies,
  message: string,
): void =>
  try
    dependencies.writeError(`${message}\n`)
  catch
    undefined
  try
    dependencies.exitState.exitCode = 1
  catch
    undefined

export const runTypeExportsEntrypoint = async (
  dependencies: TypeExportEntrypointDependencies,
): Promise<void> =>
  if dependencies.invokedPath === undefined ||
    pathToFileURL(resolve(dependencies.invokedPath)).href !==
      dependencies.moduleUrl
    return

  try
    const report = await dependencies.inspectTypeExports(
      dependencies.rootDirectory,
    )
    if report.problems.length > 0
      writeEntrypointFailure(
        dependencies,
        formatTypeExportProblems(report.problems),
      )
      return
    dependencies.writeOutput(`${formatTypeExportTargets(report.targets)}\n`)
  catch
    writeEntrypointFailure(dependencies, "Type export audit failed safely")

const repositoryRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..")
await runTypeExportsEntrypoint({
  invokedPath: process.argv[1],
  moduleUrl: import.meta.url,
  rootDirectory: repositoryRoot,
  inspectTypeExports,
  writeOutput: process.stdout.write.bind(process.stdout),
  writeError: process.stderr.write.bind(process.stderr),
  exitState: process,
})
