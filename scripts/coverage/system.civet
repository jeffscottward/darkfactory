import { randomUUID } from "node:crypto"
import { constants, lstatSync, realpathSync } from "node:fs"
import { lstat, mkdir, open, realpath, rename, rm } from "node:fs/promises"
import { basename, dirname, isAbsolute, join, relative, resolve, sep, win32 } from "node:path"

import { CoverageSummaryMissingError } from "./coverage.civet"
import type { CoverageFileSystem } from "./coverage.civet"

const INVALID_PATH_MESSAGE =
  "Coverage artifact path must be relative and remain inside the coverage root"
const SYMLINK_PATH_MESSAGE =
  "Coverage artifact paths must not contain symbolic links"
const ROOT_UNAVAILABLE_MESSAGE = "Coverage root is unavailable"
const ROOT_CHANGED_MESSAGE = "Coverage root changed during artifact operation"
const UNTRUSTED_DIRECTORY_MESSAGE =
  "Coverage artifact directories must not be writable by untrusted users"
const MAX_COVERAGE_ARTIFACT_BYTES = 8_388_608
const INVALID_FILE_MESSAGE = "Coverage artifact must be a bounded regular file"

type CanonicalRoot = Readonly<{
  path: string
  device: number
  inode: number
  owner: number
}>

type CoverageArtifactMetadata = Readonly<{
  size: number
  uid: number
  mode: number
  isFile: () => boolean
}>
type CoverageDirectoryMetadata = Readonly<{
  uid: number
  mode: number
  isDirectory: () => boolean
  isSymbolicLink: () => boolean
}>


export type CoverageSystemFileHandle = Readonly<{
  stat: () => Promise<CoverageArtifactMetadata>
  readFile: (encoding: "utf8") => Promise<string>
  writeFile: (content: string, encoding: "utf8") => Promise<void>
  sync: () => Promise<void>
  close: () => Promise<void>
}>

export type CoverageSystemDependencies = Readonly<{
  openFile: (
    path: string,
    flags: string | number,
    mode?: number,
  ) => Promise<CoverageSystemFileHandle>
  removeFile: (
    path: string,
    options: Readonly<{ force: true }>,
  ) => Promise<void>
  inspectRootAncestor?: (path: string) => Promise<CoverageDirectoryMetadata>
  beforeTemporaryOpen?: () => Promise<void>
  beforeRename?: () => Promise<void>
}>

export const nodeCoverageSystemDependencies: CoverageSystemDependencies =
  Object.freeze({
    openFile: open,
    removeFile: rm,
  })

const hasErrorCode = (error: unknown, code: string): boolean =>
  typeof error === "object" &&
  error !== null &&
  "code" in error &&
  (error as NodeJS.ErrnoException).code === code

const initializeCanonicalRoot = (explicitRoot: string): CanonicalRoot => {
  try {
    const path = realpathSync(explicitRoot)
    const status = lstatSync(path)
    if (!status.isDirectory() || status.isSymbolicLink()) {
      throw new Error(ROOT_UNAVAILABLE_MESSAGE)
    }
    return Object.freeze({ path, device: status.dev, inode: status.ino, owner: status.uid })
  } catch {
    throw new Error(ROOT_UNAVAILABLE_MESSAGE)
  }
}

const verifyCanonicalRoot = async (root: CanonicalRoot): Promise<string> => {
  try {
    const status = await lstat(root.path)
    const canonicalPath = await realpath(root.path)
    if (
      !status.isDirectory() ||
      status.isSymbolicLink() ||
      status.dev !== root.device ||
      status.ino !== root.inode ||
      canonicalPath !== root.path
    ) {
      throw new Error(ROOT_CHANGED_MESSAGE)
    }
    return root.path
  } catch {
    throw new Error(ROOT_CHANGED_MESSAGE)
  }
}

const assertRelativePath = (path: string): void => {
  const components = path.split(/[\\/]/)
  if (
    path.length === 0 ||
    path.includes("\0") ||
    isAbsolute(path) ||
    win32.parse(path).root.length > 0 ||
    components.some((component) =>
      component === ".." || component.endsWith(".") || component.endsWith(" ")
    )
  ) {
    throw new Error(INVALID_PATH_MESSAGE)
  }
}

const assertNoSymbolicLinks = async (root: string, target: string): Promise<void> => {
  const components = relative(root, target).split(sep).filter(Boolean)
  let current = root
  for (const component of components) {
    current = join(current, component)
    try {
      if ((await lstat(current)).isSymbolicLink()) {
        throw new Error(SYMLINK_PATH_MESSAGE)
      }
    } catch (error) {
      if (hasErrorCode(error, "ENOENT")) return
      throw error
    }
  }
}

const assertTrustedRootAncestry = async (
  root: string,
  owner: number,
  dependencies: CoverageSystemDependencies,
): Promise<void> => {
  const inspectRootAncestor = dependencies.inspectRootAncestor ?? lstat
  let child = root
  let parent = dirname(child)
  while (child !== parent) {
    try {
      const status = await inspectRootAncestor(parent)
      if (
        !status.isDirectory() ||
        status.isSymbolicLink() ||
        (status.uid !== owner && status.uid !== 0) ||
        ((status.mode & 0o022) !== 0 && (status.mode & 0o1000) === 0)
      ) {
        throw new Error(UNTRUSTED_DIRECTORY_MESSAGE)
      }
    } catch {
      throw new Error(UNTRUSTED_DIRECTORY_MESSAGE)
    }
    child = parent
    parent = dirname(child)
  }
}

// Node has no portable openat/renameat. Trust root-owned canonical ancestors
// and the root owner; reject discretionary write access for other principals.
// Compromise by a trusted owner remains out of scope.
const assertTrustedDirectories = async (
  root: string,
  target: string,
  owner: number,
  dependencies: CoverageSystemDependencies,
): Promise<void> => {
  await assertTrustedRootAncestry(root, owner, dependencies)
  const components = relative(root, dirname(target)).split(sep).filter(Boolean)
  let current = root
  for (let index = -1; index < components.length; index += 1) {
    if (index >= 0) current = join(current, components[index])
    try {
      const status = await lstat(current)
      if (
        !status.isDirectory() ||
        status.isSymbolicLink() ||
        status.uid !== owner ||
        (status.mode & 0o022) !== 0
      ) {
        throw new Error(UNTRUSTED_DIRECTORY_MESSAGE)
      }
    } catch (error) {
      if (hasErrorCode(error, "ENOENT")) return
      throw error
    }
  }
}

const recheckSafePath = async (
  getCanonicalRoot: () => Promise<string>,
  root: string,
  target: string,
  owner: number,
  dependencies: CoverageSystemDependencies,
): Promise<void> => {
  await getCanonicalRoot()
  await assertNoSymbolicLinks(root, target)
  await assertTrustedDirectories(root, target, owner, dependencies)
}

const resolveSafePath = async (
  getCanonicalRoot: () => Promise<string>,
  path: string,
  owner: number,
  dependencies: CoverageSystemDependencies,
): Promise<Readonly<{ root: string; target: string }>> => {
  if (path !== "." && path !== "./") assertRelativePath(path)
  const root = await getCanonicalRoot()
  const target = resolve(root, path)
  if (target === root) throw new Error(INVALID_PATH_MESSAGE)
  await assertNoSymbolicLinks(root, target)
  await assertTrustedDirectories(root, target, owner, dependencies)
  return Object.freeze({ root, target })
}

const readOptional = async (
  getCanonicalRoot: () => Promise<string>,
  path: string,
  owner: number,
  dependencies: CoverageSystemDependencies,
): Promise<string | undefined> => {
  const { root, target } = await resolveSafePath(getCanonicalRoot, path, owner, dependencies)
  await recheckSafePath(getCanonicalRoot, root, target, owner, dependencies)
  let handle
  try {
    handle = await dependencies.openFile(
      target,
      constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK,
    )
  } catch (error) {
    if (hasErrorCode(error, "ENOENT")) return undefined
    if (hasErrorCode(error, "ELOOP")) throw new Error(SYMLINK_PATH_MESSAGE)
    throw error
  }
  try {
    const status = await handle.stat()
    if (
      !status.isFile() ||
      status.size > MAX_COVERAGE_ARTIFACT_BYTES ||
      status.uid !== owner ||
      (status.mode & 0o022) !== 0
    ) {
      throw new Error(INVALID_FILE_MESSAGE)
    }
    return await handle.readFile("utf8")
  } finally {
    await handle.close()
  }
}

export const createCoverageFileSystem = (
  root: string,
  dependencies: CoverageSystemDependencies = nodeCoverageSystemDependencies,
): CoverageFileSystem => {
  const canonicalRoot = initializeCanonicalRoot(resolve(root))
  const getCanonicalRoot = (): Promise<string> => verifyCanonicalRoot(canonicalRoot)

  return Object.freeze({
    readRawSummary: async () => {
      const summary = await readOptional(
        getCanonicalRoot,
        "coverage/coverage-summary.json",
        canonicalRoot.owner,
        dependencies,
      )
      if (summary === undefined) throw new CoverageSummaryMissingError()
      return summary
    },
    readCommitted: (path) => readOptional(getCanonicalRoot, path, canonicalRoot.owner, dependencies),
    writeCommitted: async (path, content) => {
      const { root: resolvedRoot, target } = await resolveSafePath(
        getCanonicalRoot,
        path,
        canonicalRoot.owner,
        dependencies,
      )
      await recheckSafePath(getCanonicalRoot, resolvedRoot, target, canonicalRoot.owner, dependencies)
      await mkdir(dirname(target), { recursive: true, mode: 0o755 })
      await recheckSafePath(getCanonicalRoot, resolvedRoot, target, canonicalRoot.owner, dependencies)
      const temporary = join(
        resolvedRoot,
        `.${basename(target)}.${process.pid}.${randomUUID()}.tmp`,
      )
      let handle
      try {
        await dependencies.beforeTemporaryOpen?.()
        await recheckSafePath(getCanonicalRoot, resolvedRoot, target, canonicalRoot.owner, dependencies)
        handle = await dependencies.openFile(temporary, "wx", 0o644)
        await handle.writeFile(content, "utf8")
        await handle.sync()
        await handle.close()
        handle = undefined
        await recheckSafePath(getCanonicalRoot, resolvedRoot, target, canonicalRoot.owner, dependencies)
        await dependencies.beforeRename?.()
        await recheckSafePath(getCanonicalRoot, resolvedRoot, target, canonicalRoot.owner, dependencies)
        await rename(temporary, target)
      } catch (error) {
        await handle?.close().catch(() => undefined)
        await dependencies.removeFile(temporary, { force: true }).catch(() => undefined)
        throw error
      }
    },
  })
}

export const nodeCoverageFileSystem = createCoverageFileSystem(".")
