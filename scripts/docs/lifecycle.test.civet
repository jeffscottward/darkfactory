    expect(proxyReadiness).toContain('kill -0 "$pid"')
    expect(proxyReadiness).toContain("sleep 0.25")
    expect(proxyReadiness).toContain(
      'tail --bytes=65536 "$portless_log"',
    )
    expect(proxyReadiness).not.toContain("portless proxy stop")
    expectOwnedPortlessSignals(proxyReadiness)
    expect(proxyReadiness).toContain(
      'if owns_portless_process_group "$portless_pid" "$portless_owner"; then\n              kill -TERM',
    )
    expect(proxyReadiness).toContain(
      'if owns_portless_process_group "$portless_pid" "$portless_owner"; then\n                  kill -KILL',
    )
    expect(proxyReadiness).toContain('rm -f "$portless_pid_file"')
    expect(workflow).toContain("scripts/graph/requirements.lock")
    expect(workflow).toContain("--require-hashes")
    expect(workflow).toContain('python-version: "3.12.11"')
    expect(workflow).toMatch(/Set up Python\n\s+if: matrix\.lane == 'graph'/)
    expect(workflow).toMatch(/Install pinned Graphify\n\s+if: matrix\.lane == 'graph'/)
    expect(workflow).toMatch(/Install Playwright browser\n\s+if: matrix\.lane == 'browser'/)
    expect(workflow).toMatch(/Start PostgreSQL integration service\n\s+if: matrix\.lane == 'integration' \|\| matrix\.lane == 'browser'/)
    expect(workflow).toMatch(/Start local HTTPS proxy without system trust\n\s+if: matrix\.lane == 'browser'/)
    expect(workflow).toMatch(/Trust portless CA in Chromium\n\s+if: matrix\.lane == 'browser'/)
    expect(graphCapture).toContain("if: matrix.lane == 'graph'")
    expect(graphCapture).toContain("umask 077")
    expect(graphCapture).toContain(
      "timeout --signal=TERM --kill-after=2s 10s bun -e",
    )
    expect(graphCapture).toContain(
      'import { execFileSync } from "node:child_process";',
    )
    expect(graphCapture).toContain("const githubSha = process.env.GITHUB_SHA;")
    expect(graphCapture).toContain(
      'typeof githubSha !== "string" || !/^[0-9a-fA-F]{40}$/.test(githubSha)',
    )
    expect(graphCapture).toContain(
      'throw new Error("GITHUB_SHA must be an exact 40-character hexadecimal commit ID")',
    )
    expect(graphCapture).toContain(
      '["show", `${githubSha}:.graphify/manifest.json`]',
    )
    expect(graphCapture).toContain('encoding: "utf8"')
    expect(graphCapture).toContain("timeout: 5_000")
    expect(graphCapture).toContain("maxBuffer: 65_536")
    expect(graphCapture).not.toContain('readFileSync(".graphify/manifest.json"')
    expect(graphCapture.indexOf('if (typeof githubSha !== "string"')).toBeLessThan(
      graphCapture.indexOf("execFileSync("),
    )
    expect(graphCapture.indexOf("execFileSync(")).toBeLessThan(
      graphCapture.indexOf("const identity = Object.fromEntries("),
    )
    expect(graphCapture).toContain(`const identityFields = ${graphIdentityFields};`)
    expect(graphCapture).toContain(
      'const stringFields = ["graphifyVersion", "configDigest", "sourceFingerprint"];',
    )
    expect(graphCapture).toContain(
      "Object.keys(identity).length === identityFields.length",
    )
    expect(graphCapture).toContain(
      "identityFields.every((field) => Object.hasOwn(identity, field))",
    )
    expect(graphCapture).toContain(
      'typeof identity[field] === "string" && identity[field].trim().length > 0',
    )
    expect(graphCapture).toContain("Number.isInteger(identity.sourceFileCount)")
    expect(graphCapture).toContain("identity.sourceFileCount > 0")
    expect(graphCapture).toContain("if (!identityIsValid)")
    expect(graphCapture).toContain(
      'throw new Error("Committed Graphify manifest identity is invalid")',
    )
    expect(graphCapture.indexOf("if (!identityIsValid)")).toBeLessThan(
      graphCapture.indexOf("writeFileSync("),
    )
    expect(graphCapture).toContain("process.env.RUNNER_TEMP")
    expect(graphCapture).toContain("graphify-committed-identity.json")
    expect(graphCapture).toContain('{ flag: "wx", mode: 0o600 }')
    expect(graphBuild).toContain("if: matrix.lane == 'graph'")
    expect(graphBuild).toContain("bun run graph:build")
    expect(graphBuild).toContain(
      "timeout --signal=TERM --kill-after=2s 10s bun -e",
    )
    expect(graphBuild).toContain(`const identityFields = ${graphIdentityFields};`)
    expect(graphBuild).toContain("process.env.RUNNER_TEMP")
    expect(graphBuild).toContain("graphify-committed-identity.json")
    expect(graphBuild).toContain(
      "if (!isDeepStrictEqual(rebuiltIdentity, committedIdentity))",
    )
    expect(graphBuild).toContain("throw new Error(")
    expect(graphBuild.indexOf("bun run graph:build")).toBeLessThan(
      graphBuild.indexOf("if (!isDeepStrictEqual(rebuiltIdentity, committedIdentity))"),
    )
    expect(workflow.indexOf(graphCapture)).toBeLessThan(workflow.indexOf(graphBuild))
    expect(workflow.indexOf(graphBuild)).toBeLessThan(workflow.indexOf(verification))
    expect(verification).toContain('run: bun run "verify:${{ matrix.lane }}"')
    expect(`${graphCapture}\n${graphBuild}`).not.toContain("graphDigest")
    expect(workflow).not.toContain("git diff --exit-code -- .graphify/manifest.json")
    expect(workflow).toMatch(/Preserve externally scanned Playwright evidence[\s\S]*matrix\.lane == 'browser' && success\(\)[\s\S]*playwright-report\/[\s\S]*test-results\//)
    expect(workflow.indexOf(proxyStart)).toBeLessThan(
      workflow.indexOf(proxyReadiness),
    )
    expect(workflow.indexOf(proxyReadiness)).toBeLessThan(
      workflow.indexOf(proxyTrust),
    )
    expect(workflow.indexOf(proxyTrust)).toBeLessThan(
      workflow.indexOf(verification),
    )
    expect(workflow.indexOf(proxyTrust)).toBeLessThan(
      workflow.indexOf(browserToolchain),
    )
    expect(workflow.indexOf(browserToolchain)).toBeLessThan(
      workflow.indexOf(verification),
    )
    expect(workflow.indexOf(verification)).toBeLessThan(
      workflow.indexOf(browserEvidence),
    )
    expect(workflow.indexOf(browserEvidence)).toBeLessThan(
      workflow.indexOf(proxyStop),
    )
    expect(workflow.indexOf(proxyStop)).toBeLessThan(
      workflow.indexOf(proxyClosed),
    )
    expect(workflow.indexOf(proxyClosed)).toBeLessThan(
      workflow.indexOf(postgresCleanup),
    )
    expect(workflow).toMatch(/Verify local HTTPS proxy readiness\n\s+if: matrix\.lane == 'browser'/)
    expect(proxyStop).toContain("if: matrix.lane == 'browser' && always()")
    expect(proxyStop).toContain(
      'portless_pid_file="$RUNNER_TEMP/portless-proxy.pid"',
    )
    expect(proxyStop).toContain(
      `IFS=' ' read -r portless_pid portless_owner portless_state_extra <"$portless_pid_file"`,
    )
    expect(proxyStop).not.toContain("portless proxy stop")
    expect(proxyStop).toContain('[[ -z "$portless_state_extra" ]]')
    expectOwnedPortlessSignals(proxyStop)
    expect(proxyStop).toContain(
      'owns_portless_process_group "$portless_pid" "$portless_owner"; then\n            kill -TERM',
    )
    expect(proxyStop).toContain(
      'if owns_portless_process_group "$portless_pid" "$portless_owner"; then\n                kill -KILL',
    )
    expect(proxyStop).toContain(
      'while kill -0 -- "-$1" 2>/dev/null || kill -0 "$1" 2>/dev/null; do sleep 0.25; done',
    )
    expect(proxyStop).toContain(
      'while (echo >"/dev/tcp/127.0.0.1/$1") 2>/dev/null; do sleep 0.25; done',
    )
    expect(proxyStop).toContain('rm -f "$portless_pid_file"')
    expect(proxyClosed).toContain("if: matrix.lane == 'browser' && always()")
    expect(proxyClosed).toContain(
      'portless_log="$RUNNER_TEMP/portless-proxy.log"',
    )
    expect(proxyClosed).toContain(
      'portless_pid_file="$RUNNER_TEMP/portless-proxy.pid"',
    )
    expect(proxyClosed).toContain('[[ -e "$portless_pid_file" ]]')
    expect(proxyClosed).toContain(
      "timeout --signal=TERM --kill-after=1s 5s bash -c",
    )
    expect(
      proxyClosed.match(
        /while \(echo >"\/dev\/tcp\/127\.0\.0\.1\/\$1"\) 2>\/dev\/null; do sleep 0\.25; done/g,
      ),
    ).toHaveLength(2)
    expect(proxyClosed).toContain(
      'tail --bytes=65536 "$portless_log"',
    )
    expect(proxyClosed).not.toContain("portless proxy stop")
    expect(proxyClosed).toContain('rm -f "$portless_pid_file"')
    expect(workflow).toMatch(/Verify local HTTPS proxy closed\n\s+if: matrix\.lane == 'browser' && always\(\)/)
    expect(workflow).toMatch(/Stop PostgreSQL integration service\n\s+if: \(matrix\.lane == 'integration' \|\| matrix\.lane == 'browser'\) && always\(\)/)
    expect(workflow.match(/actions\/upload-artifact@/g)).toHaveLength(1)
    expect(workflow).toContain("persist-credentials: false")
    for (const action of workflow.matchAll(/uses: [^@\n]+@([^\s#]+)/g)) {
      expect(action[1]).toMatch(/^[0-9a-f]{40}$/)
    }
  })

  it("presents the exact health badge set without a separate Scorecard score", () => {
    const healthTable = readme.match(
      /\| Category \| Status \|\n\| --- \| --- \|\n(?<rows>(?:\|.*\|\n){3})/,
    )?.groups?.rows
    const badges = [...(healthTable?.matchAll(
      /\[!\[(?<label>[^\]]+)\]\((?<image>[^)]+)\)\]\((?<target>[^)]+)\)/g,
    ) ?? [])]

    expect(healthTable).toBeDefined()
    expect(badges).toHaveLength(12)
    expect(badges.map((badge) => badge.groups?.label)).not.toContain(
      "OpenSSF Scorecard",
    )
    expect(healthTable).not.toContain("securityscorecards.dev")
    expect(badges.find((badge) =>
      badge.groups?.label === "OpenSSF Best Practices 100%"
    )?.groups).toMatchObject({
      image: "https://img.shields.io/badge/OpenSSF%20Best%20Practices-100%25-2ea44f",
      target: "https://www.bestpractices.dev/projects/13782",
    })
    expect(badges.find((badge) =>
      badge.groups?.label === "Bun 1.3.14"
    )?.groups).toMatchObject({
      image: "https://img.shields.io/badge/Bun-1.3.14-fbf0df",
      target: "https://bun.sh/",
    })
    expect(readme).toContain(
      "they are not a production-readiness, deployment, coverage-completeness, or security certification",
    )
  })

  it("links a truthful versioned Agent Friendly score to exact evidence", () => {
    expect(readme).toContain(
      "[![Agent Friendly Code 98.7/100](https://img.shields.io/badge/Agent%20Friendly%20Code-98.7%2F100-2ea44f)](docs/assessments/agent-friendly-0acd6c2.json)",
    )
    expect(readme).toContain(
      "versioned assessment results linked to their exact evidence",
    )
    expect(agentFriendlyAssessment).toMatchObject({
      projectSource: "https://github.com/hsnice16/agent-friendly-code",
      scorerPath: "skills/agent-friendly/dist/index.js",
      scorerRevision: "3a719e06c4e79d37b60f21c5c7992e0e535e0ff6",
      scorerSource: "https://github.com/hsnice16/agent-friendly-skill",
      assessedRevision: "0acd6c2296a790a49a92c98ee2c9bbf919e9a1ab",
      worktreeClean: true,
      result: { overall: 98.7, warnings: [] },
    })
  })

  it("executes the exact core lane through the pre-push runner", () => {
    const calls: string[][] = []
    const exitCode = runPrePush((scripts) => {
      calls.push([...scripts])
      return 17
    })

    expect(exitCode).toBe(17)
    expect(PRE_PUSH_SCRIPTS).toEqual(["verify:core"])
    expect(calls).toEqual([["verify:core"]])
  })
})
