import { execFile } from "node:child_process"
import { access, readFile } from "node:fs/promises"
import { fileURLToPath } from "node:url"
import { promisify } from "node:util"
import { describe, expect, it } from "vitest"
import { PRE_PUSH_SCRIPTS, runPrePush } from "../hooks/index.civet"

const rootPackage = JSON.parse(await readFile(new URL("../../package.json", import.meta.url), "utf8")) as {
  packageManager: string
  engines: Record<string, string>
  scripts: Record<string, string>
  devDependencies: Record<string, string>
}
const workspace = await readFile(new URL("../../pnpm-workspace.yaml", import.meta.url), "utf8")
const workflow = await readFile(new URL("../../.github/workflows/ci.yml", import.meta.url), "utf8")
const ignoreRules = await readFile(new URL("../../.gitignore", import.meta.url), "utf8")
const readme = await readFile(new URL("../../README.md", import.meta.url), "utf8")
const bunVersion = await readFile(new URL("../../.bun-version", import.meta.url), "utf8")
const nodeVersion = await readFile(new URL("../../.nvmrc", import.meta.url), "utf8")
const makefile = await readFile(new URL("../../Makefile", import.meta.url), "utf8")
const preCommitHook = await readFile(new URL("../../.husky/pre-commit", import.meta.url), "utf8")
const prePushHook = await readFile(new URL("../../.husky/pre-push", import.meta.url), "utf8")
const packageManifests = await Promise.all(
  [
    "apps/web",
    "packages/ai",
    "packages/analytics",
    "packages/api",
    "packages/auth",
    "packages/config",
    "packages/db",
    "packages/email",
    "packages/jobs",
    "packages/observability",
    "packages/shared",
    "packages/state",
    "packages/storage",
    "packages/testkit",
    "packages/ui",
  ].map(async (path) => JSON.parse(
    await readFile(new URL(`../../${path}/package.json`, import.meta.url), "utf8"),
  ) as { name: string; scripts?: Record<string, string> }),
)
const agentFriendlyAssessment = JSON.parse(
  await readFile(
    new URL("../../docs/assessments/agent-friendly-0acd6c2.json", import.meta.url),
    "utf8",
  ),
) as {
  projectSource: string
  scorerPath: string
  scorerRevision: string
  scorerSource: string
  assessedRevision: string
  worktreeClean: boolean
  result: { overall: number; warnings: unknown[] }
}
const projectRoot = fileURLToPath(new URL("../..", import.meta.url))
const execFileAsync = promisify(execFile)
const isIgnored = async (path: string): Promise<boolean> => {
  try {
    await execFileAsync("git", ["check-ignore", "--no-index", "--quiet", path], {
      cwd: projectRoot,
    })
    return true
  } catch (error) {
    if ((error as { code?: number }).code === 1) return false
    throw error
  }
}
const turboConfig = JSON.parse(
  await readFile(new URL("../../turbo.json", import.meta.url), "utf8"),
) as { globalDependencies: string[]; tasks: Record<string, { passThroughEnv?: string[] }> }
const vitestConfig = await readFile(new URL("../../vitest.config.ts", import.meta.url), "utf8")
const packageUnitScripts = await Promise.all(
  ["ai", "analytics", "api", "db", "ui"].map(async (name) => {
    const manifest = JSON.parse(await readFile(
      new URL(`../../packages/${name}/package.json`, import.meta.url),
      "utf8",
    )) as { scripts: Record<string, string> }
    return [name, manifest.scripts["test:unit"]] as const
  }),
)
const EXPECTED_DEV_ENV = [
  "HOST",
  "PORT",
  "NODE_EXTRA_CA_CERTS",
  "PORTLESS_*",
] as const

const runScriptNames = (script: string): readonly string[] =>
  script.split(" && ").map((command) =>
    command.replace(/^bun run /, "")
  )

const EXPECTED_LANES = {
  "verify:core": [
    "format:check",
    "lint",
    "auth:schema:check",
    "openapi:check",
    "typecheck",
    "build",
    "test:unit",
    "test:contract",
    "test:operations",
    "docs:check",
  ],
  "verify:coverage": ["test:coverage", "coverage:check"],
  "verify:integration": ["types", "test:integration"],
  "verify:graph": ["graph:check", "graph:verify"],
  "verify:browser": ["test:e2e", "test:a11y"],
} as const

describe("DF-101/106 lifecycle contract", () => {
  it("keeps Claude policy byte-identical to the canonical agent policy", async () => {
    const [agentsPolicy, claudePolicy] = await Promise.all([
      readFile(new URL("../../AGENTS.md", import.meta.url)),
      readFile(new URL("../../CLAUDE.md", import.meta.url)),
    ])

    expect(claudePolicy.equals(agentsPolicy)).toBe(true)
  })

  it("pins the hybrid runtime without giving Bun package-manager ownership", async () => {
    expect(bunVersion.trim()).toBe("1.3.14")
    expect(nodeVersion.trim()).toBe("22.13.1")
    expect(rootPackage).toMatchObject({
      packageManager: "pnpm@11.16.0",
      engines: {
        bun: "1.3.14",
        node: ">=22.13.0",
        pnpm: "11.16.0",
      },
    })
    expect(workspace).toMatch(/^packages:\n(?:  - .+\n)+/u)
    await expect(access(new URL("../../pnpm-lock.yaml", import.meta.url))).resolves.toBeUndefined()
    await expect(access(new URL("../../bun.lock", import.meta.url))).rejects.toMatchObject({
      code: "ENOENT",
    })
    await expect(access(new URL("../../bun.lockb", import.meta.url))).rejects.toMatchObject({
      code: "ENOENT",
    })
  })

  it("keeps Bun orchestration while isolating measured Node compatibility exceptions", () => {
    const rootScripts = Object.values(rootPackage.scripts)
    expect(rootPackage.scripts["dev:https"]).toBe(
      "bun --preload @danielx/civet/bun-civet scripts/dev.civet start",
    )
    expect(rootPackage.scripts["test:contract"]).toMatch(
      /^corepack pnpm exec vitest /,
    )
    expect(rootPackage.scripts["test:e2e"]).toBe(
      "bun --preload @danielx/civet/bun-civet scripts/e2e/run.civet e2e",
    )
    expect(rootPackage.scripts["test:a11y"]).toBe(
      "bun --preload @danielx/civet/bun-civet scripts/e2e/run.civet a11y",
    )
    expect(rootPackage.scripts["test:coverage"]).toMatch(
      /^bun run types && corepack pnpm exec vitest .* --coverage /,
    )
    expect(rootScripts.some((script) => /(?:^|&& )civet\b/u.test(script))).toBe(false)
    expect(rootScripts.some((script) => /(?:^|&& )(?:vitest|turbo|tsc|biome|husky)\b/u.test(script))).toBe(false)
    for (const script of rootScripts) {
      if (script.includes("vitest")) {
        expect(script).toMatch(/(?:^|&& )corepack pnpm exec vitest /u)
      }
    }
    expect(rootPackage.scripts["deploy:web"]).toBe(
      "corepack pnpm --filter @darkfactory/web exec bunx --no-install vinext-cloudflare deploy",
    )
    expect(rootPackage.scripts["deploy:web:check"]).toBe(
      "corepack pnpm --filter @darkfactory/web exec bunx --no-install vinext-cloudflare deploy --dry-run",
    )
    expect(rootPackage.scripts["deploy:web:preview"]).toBe(
      "corepack pnpm --filter @darkfactory/web exec bunx --no-install vinext-cloudflare deploy --preview",
    )
    expect(rootPackage.scripts["deploy:web:staging"]).toBe(
      "corepack pnpm --filter @darkfactory/web exec bunx --no-install vinext-cloudflare deploy --env staging",
    )
    expect(rootPackage.scripts["deploy:web:staging:check"]).toBe(
      "corepack pnpm --filter @darkfactory/web exec bunx --no-install vinext-cloudflare deploy --dry-run --env staging",
    )

    const byName = new Map(packageManifests.map((manifest) => [manifest.name, manifest]))
    expect(byName.get("@darkfactory/web")?.scripts?.dev).toBe(
      "bunx --no-install vinext dev",
    )
    expect(byName.get("@darkfactory/web")?.scripts?.build).toBe(
      "bunx --no-install vinext build",
    )
    expect(byName.get("@darkfactory/web")?.scripts?.start).toBe(
      "bunx --bun --no-install vite preview",
    )
    expect(byName.get("@darkfactory/auth")?.scripts?.["auth:schema:check"]).toBe(
      "bun scripts/check-auth-schema.ts",
    )
    expect(byName.get("@darkfactory/db")?.scripts?.["db:generate"]).toBe(
      "bun run db:schema && bunx --bun --no-install drizzle-kit generate --config drizzle.config.ts",
    )
    for (const manifest of packageManifests) {
      for (const script of Object.values(manifest.scripts ?? {})) {
        if (script.includes("vitest")) {
          expect(script).toMatch(/(?:^|&& )corepack pnpm exec vitest /u)
        }
        expect(script).not.toMatch(/(?:^|&& )pnpm run\b/u)
        expect(script).not.toMatch(/(?:^|&& )(?:civet|vitest|vinext|drizzle-kit)\b/u)
      }
    }
  })

  it("uses Bun for hooks and setup entrypoints", () => {
    const hookCommand =
      "exec bun --preload @danielx/civet/bun-civet scripts/hooks/"
    expect(preCommitHook).toContain(`${hookCommand}pre-commit.civet`)
    expect(prePushHook).toContain(`${hookCommand}pre-push.civet`)
    expect(makefile).toMatch(/setup:\n\tsh scripts\/install-prerequisites\.sh/u)
  })

  it("exposes every required root command while preserving API aliases", () => {
    for (const name of [
      "test:contract",
      "test:operations",
      "test:a11y",
      "docs:generate",
      "docs:check",
      "openapi:generate",
      "openapi:check",
      "capability:add",
    ]) expect(rootPackage.scripts[name]).toEqual(expect.any(String))
    expect(rootPackage.scripts["openapi:generate"]).toContain("api:openapi:generate")
    expect(rootPackage.scripts["openapi:check"]).toContain("api:openapi:check")
    expect(rootPackage.scripts["api:openapi:generate"]).toContain("@darkfactory/api")
    expect(rootPackage.scripts["api:openapi:check"]).toContain("@darkfactory/api")
  })

  it("forwards only non-secret development process controls", () => {
    expect(turboConfig.tasks.dev?.passThroughEnv).toEqual(EXPECTED_DEV_ENV)
  })

  it("composes the complete lifecycle from exact, unique verification lanes", () => {
    const laneNames = Object.keys(EXPECTED_LANES)
    expect(rootPackage.scripts.ci).toBe("bun run verify")
    expect(turboConfig.globalDependencies).toContain("package.json")
    expect(runScriptNames(rootPackage.scripts.verify)).toEqual(laneNames)
    expect(rootPackage.scripts["test:unit"]).toBe(
      "bunx --no-install turbo run test:unit --concurrency=50%",
    )
    for (const scriptName of ["dev", "build", "types", "typecheck", "test:unit"]) {
      expect(rootPackage.scripts[scriptName]).not.toContain("bunx --bun --no-install turbo")
    }
    expect(rootPackage.scripts["test:contract"]).toContain("--project contract")
    expect(rootPackage.scripts["test:operations"]).toContain("--project operations")
    expect(rootPackage.scripts["test:operations"]).toContain("--project e2e-helpers")
    expect(rootPackage.scripts["test:operations"]).toContain("--maxWorkers=1")
    expect(rootPackage.scripts["test:operations"]).toContain("--no-file-parallelism")
    expect(rootPackage.scripts["test:coverage"]).toMatch(
      /^bun run types && corepack pnpm exec vitest run /,
    )
    expect(vitestConfig).toContain('"**/*contract.test.civet"')
    expect(vitestConfig).toContain('name: "contract"')
    expect(vitestConfig).toContain('name: "operations"')
    expect(vitestConfig).toContain('name: "e2e-helpers"')
    expect(vitestConfig).toContain('"playwright.config.test.ts"')
    expect(vitestConfig).toContain('"tests/e2e/helpers/*.test.civet"')
    expect(vitestConfig).toContain('"tests/e2e/helpers/*.test.ts"')
    for (const [, script] of packageUnitScripts) {
      expect(script).toContain('--exclude "**/*contract.test.civet"')
    }

    const leafScripts: string[] = []
    for (const [lane, expectedScripts] of Object.entries(EXPECTED_LANES)) {
      const observed = runScriptNames(rootPackage.scripts[lane])
      expect(observed).toEqual(expectedScripts)
      leafScripts.push(...observed)
    }
    expect(new Set(leafScripts).size).toBe(leafScripts.length)
    expect(rootPackage.scripts["test:e2e"]).toBe(
      "bun --preload @danielx/civet/bun-civet scripts/e2e/run.civet e2e",
    )
    expect(rootPackage.scripts["test:a11y"]).toBe(
      "bun --preload @danielx/civet/bun-civet scripts/e2e/run.civet a11y",
    )
  })

  it("allowlists exactly the authored coverage sources while ignoring generated output", async () => {
    const authoredCoverageFiles = [
      "scripts/coverage/cli.civet",
      "scripts/coverage/coverage.civet",
      "scripts/coverage/coverage.test.civet",
      "scripts/coverage/system.civet",
    ]
    const coverageExceptions = ignoreRules
      .split(/\r?\n/)
      .filter((rule) => rule.startsWith("!scripts/coverage/"))

    expect(coverageExceptions).toEqual([
      "!scripts/coverage/",
      ...authoredCoverageFiles.map((path) => `!${path}`),
    ])
    expect(ignoreRules.split(/\r?\n/)).toContain("scripts/coverage/**")
    await expect(Promise.all(authoredCoverageFiles.map(isIgnored))).resolves.toEqual([
      false,
      false,
      false,
      false,
    ])
    const ignoredCoveragePaths = [
      "coverage/coverage-summary.json",
      "scripts/coverage/unexpected.civet",
      "scripts/coverage/nested/unexpected.civet",
      ...authoredCoverageFiles.map((path) => `${path}/unexpected.civet`),
    ]
    await expect(Promise.all(ignoredCoveragePaths.map(isIgnored))).resolves.toEqual(
      ignoredCoveragePaths.map(() => true),
    )
  })

  it("runs isolated CI lanes concurrently while preserving only verified browser evidence", () => {
    const workflowStep = (name: string): string => {
      const header = `      - name: ${name}\n`
      expect(workflow.split(header)).toHaveLength(2)
      const start = workflow.indexOf(header)
      const next = workflow.indexOf("\n      - ", start + header.length)
      workflow.slice(start, next === -1 ? undefined : next)
    }
    const proxyStart = workflowStep("Start local HTTPS proxy without system trust")
    const proxyReadiness = workflowStep("Verify local HTTPS proxy readiness")
    const proxyTrust = workflowStep("Trust portless CA in Chromium")
    const browserToolchain = workflowStep("Prepare private browser pnpm toolchain")
    const proxyStop = workflowStep("Stop local HTTPS proxy")
    const proxyClosed = workflowStep("Verify local HTTPS proxy closed")
    const graphCapture = workflowStep("Capture committed Graphify manifest identity")
    const graphBuild = workflowStep("Build Graphify output and compare committed identity")
    const verification = workflowStep("Run verification lane")
    const browserEvidence = workflowStep("Preserve externally scanned Playwright evidence")
    const postgresCleanup = workflowStep("Stop PostgreSQL integration service")
    const graphIdentityFields =
      '["graphifyVersion", "configDigest", "sourceFingerprint", "sourceFileCount"]'
    const expectOwnedPortlessSignals = (step: string): void => {
      expect(step).toContain("owns_portless_process_group() {")
      expect(step).toContain(
        '[[ "$owner" =~ ^darkfactory-ci-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]',
      )
      expect(step).toContain(
        '[[ -r "/proc/$pid/environ" && -r "/proc/$pid/cmdline" && -r "/proc/$pid/stat" ]]',
      )
      expect(step).toContain(
        '[[ "$environment_entry" == "PORTLESS_CI_OWNER=$owner" ]]',
      )
      expect(step).toMatch(
        /local -a expected_command=\(\n\s+timeout\n\s+--signal=TERM\n\s+--kill-after=5s\n\s+20m\n\s+bunx\n\s+--bun\n\s+--no-install\n\s+portless\n\s+proxy\n\s+start\n\s+--foreground\n\s+--skip-trust\n\s+\)/,
      )
      expect(step).toContain(
        '[[ ${#actual_command[@]} -eq ${#expected_command[@]} ]]',
      )
      expect(step).toContain(
        '[[ "${actual_command[$index]}" == "${expected_command[$index]}" ]]',
      )
      expect(step).toContain('process_stat="${process_stat##*) }"')
      expect(step).toContain('[[ "$process_group_id" == "$pid" ]]')
      expect(step).toContain('kill -TERM -- "-$portless_pid"')
      expect(step).toContain('kill -KILL -- "-$portless_pid"')
      expect(step).not.toContain('kill -TERM "$portless_pid"')
      expect(step).not.toContain('kill -KILL "$portless_pid"')
    }
    expect(rootPackage.devDependencies["@axe-core/playwright"]).toBe("catalog:")
    expect(workspace).toContain('"@axe-core/playwright": 4.12.1')
    expect(workflow).toContain("matrix:")
    expect(workflow).toContain("lane: [core, coverage, integration, graph, browser]")
    expect(workflow).toContain("fail-fast: false")
    expect(workflow).toContain('bun run "verify:${{ matrix.lane }}"')
    expect(workflow).toContain(
      "oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6",
    )
    expect(workflow).toContain("bun-version-file: .bun-version")
    expect(workflow).toContain("corepack pnpm install --frozen-lockfile")
    expect(workflow).toContain(
      "bunx --bun --no-install playwright install --with-deps chromium",
    )
    expect(workflow).toMatch(
      /Set up pnpm\n\s+id: pnpm\n\s+uses: pnpm\/action-setup@0ebf47130e4866e96fce0953f49152a61190b271/,
    )
    expect(browserToolchain).toContain("if: matrix.lane == 'browser'")
    expect(browserToolchain).toContain(
      'PNPM_ACTION_BIN_DEST: ${{ steps.pnpm.outputs.bin_dest }}',
    )
    expect(browserToolchain).toContain("PNPM_EXPECTED_VERSION: 11.16.0")
    expect(browserToolchain).toContain(
      'pnpm_global_root_candidate="$(dirname -- "$pnpm_bin_dest")/global/v$pnpm_expected_major"',
    )
    expect(browserToolchain).toContain(
      'for manifest_candidate in "$pnpm_global_root"/*/node_modules/pnpm/package.json; do',
    )
    expect(browserToolchain).toContain(
      'manifest_version="$("$node_target" -e',
    )
    expect(browserToolchain).toContain(
      '[[ "$manifest_version" == "$PNPM_EXPECTED_VERSION" ]] || continue',
    )
    expect(browserToolchain).toContain(
      '[ "${#pnpm_package_targets[@]}" -eq 1 ]',
    )
    expect(browserToolchain).toContain(
      'pnpm_candidate="${pnpm_package_targets[0]}/bin/pnpm.mjs"',
    )
    expect(browserToolchain).toContain(
      'pnpm_version="$("$node_target" "$pnpm_target" --version)"',
    )
    expect(browserToolchain).toContain(
      '[ "$pnpm_version" = "$PNPM_EXPECTED_VERSION" ]',
    )
    expect(browserToolchain).not.toContain(
      '"$PNPM_ACTION_BIN_DEST/pnpm"',
    )
    expect(browserToolchain).toContain("set -euo pipefail")
    expect(browserToolchain).toContain("umask 077")
    expect(browserToolchain).toContain("require_absolute_safe_path() {")
    expect(browserToolchain).toContain("*:* | *$'\\n'*) return 1 ;;")
    expect(browserToolchain).toContain(
      'runner_temp_root="$(realpath -e -- "$RUNNER_TEMP")"',
    )
    expect(browserToolchain).toContain(
      'workspace_root="$(realpath -e -- "$GITHUB_WORKSPACE")"',
    )
    expect(browserToolchain).toContain(
      'node_target="$(realpath -e -- "$node_candidate")"',
    )
    expect(browserToolchain).toContain(
      'pnpm_target="$(realpath -e -- "$pnpm_candidate")"',
    )
    expect(browserToolchain).toContain("require_external_executable() {")
    expect(browserToolchain).toContain('[ -f "$candidate" ]')
    expect(browserToolchain).toContain('[ -x "$candidate" ]')
    expect(browserToolchain).toContain(
      '"$workspace_root" | "$workspace_root"/*) return 1 ;;',
    )
    expect(browserToolchain).toContain(
      '"$workspace_root" | "$workspace_root"/*) exit 1 ;;',
    )
    expect(browserToolchain).toContain(
      'toolchain="$(mktemp -d "$runner_temp_root/darkfactory-browser-toolchain.XXXXXX")"',
    )
    expect(browserToolchain).toContain(
      '"$runner_temp_root"/*) ;;',
    )
    expect(browserToolchain).toContain('[ -O "$toolchain" ]')
    expect(browserToolchain).toContain(
      `[ "$(stat -c '%a' -- "$toolchain")" = "700" ]`,
    )
    expect(browserToolchain).toContain(
      `[ "$(stat -c '%u' -- "$toolchain")" = "$(id -u)" ]`,
    )
    expect(browserToolchain).toContain(
      'ln -s -- "$node_target" "$toolchain/node"',
    )
    expect(browserToolchain).toContain(
      'ln -s -- "$pnpm_target" "$toolchain/pnpm"',
    )
    expect(browserToolchain).toContain('[ -L "$toolchain/node" ]')
    expect(browserToolchain).toContain('[ -L "$toolchain/pnpm" ]')
    expect(browserToolchain).toContain(
      `[ "$(stat -c '%u' -- "$toolchain/node")" = "$(id -u)" ]`,
    )
    expect(browserToolchain).toContain(
      `[ "$(stat -c '%u' -- "$toolchain/pnpm")" = "$(id -u)" ]`,
    )
    expect(browserToolchain).toContain(
      '[ "$(realpath -e -- "$toolchain/node")" = "$node_target" ]',
    )
    expect(browserToolchain).toContain(
      '[ "$(realpath -e -- "$toolchain/pnpm")" = "$pnpm_target" ]',
    )
    expect(browserToolchain).toContain(
      '[ "${#toolchain_entries[@]}" -eq 2 ]',
    )
    expect(browserToolchain).toContain(
      '[ "${toolchain_entries[0]}" = "node" ]',
    )
    expect(browserToolchain).toContain(
      '[ "${toolchain_entries[1]}" = "pnpm" ]',
    )
    expect(browserToolchain).toContain(
      `printf '%s\\n' "$toolchain" >> "$GITHUB_PATH"`,
    )
    expect(browserToolchain).not.toContain("PNPM_HOME")
    expect(proxyStart).toContain("if: matrix.lane == 'browser'")
    expect(proxyStart).toContain("umask 077")
    expect(proxyStart).toContain(
      'portless_log="$RUNNER_TEMP/portless-proxy.log"',
    )
    expect(proxyStart).toContain(
      'portless_pid_file="$RUNNER_TEMP/portless-proxy.pid"',
    )
    expect(proxyStart).toContain(
      'portless_state_dir="$RUNNER_TEMP/darkfactory-portless-$portless_owner"',
    )
    expect(proxyStart).toContain('mkdir "$portless_state_dir"')
    expect(proxyStart).toContain(
      `printf 'PORTLESS_STATE_DIR=%s\\nNODE_EXTRA_CA_CERTS=%s\\n'`,
    )
    expect(proxyStart).toContain(
      '"$portless_state_dir" "$portless_state_dir/ca.pem" >>"$GITHUB_ENV"',
    )
    expect(proxyStart).toContain(
      'IFS= read -r portless_owner <"/proc/sys/kernel/random/uuid"',
    )
    expect(proxyStart).toContain('portless_owner="darkfactory-ci-$portless_owner"')
    expect(proxyStart).toContain('PORTLESS_CI_OWNER="$portless_owner"')
    expect(proxyStart).toContain(
      'PORTLESS_STATE_DIR="$portless_state_dir" \\',
    )
    expect(proxyStart.indexOf("umask 077")).toBeLessThan(
      proxyStart.indexOf('mkdir "$portless_state_dir"'),
    )
    expect(proxyStart.indexOf('mkdir "$portless_state_dir"')).toBeLessThan(
      proxyStart.indexOf('>>"$GITHUB_ENV"'),
    )
    expect(proxyStart.indexOf('>>"$GITHUB_ENV"')).toBeLessThan(
      proxyStart.indexOf('PORTLESS_STATE_DIR="$portless_state_dir" \\'),
    )
    expect(proxyStart).toContain(
      'if ! (set -o noclobber; : >"$portless_log")',
    )
    expect(proxyStart).toContain(
      "timeout --signal=TERM --kill-after=5s 20m",
    )
    expect(proxyStart).toContain(
      "portless proxy start --foreground --skip-trust",
    )
