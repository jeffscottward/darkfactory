    )
    expect(proxyStart).toContain("emergency_portless_cleanup() {")
    expect(proxyStart).toContain('local status="$1"')
    expect(proxyStart).toContain(
      "local emergency_identity_deadline=$((SECONDS + 5))",
    )
    expect(proxyStart).toContain(
      'while kill -0 "$portless_pid" 2>/dev/null; do\n              if owns_portless_process_group "$portless_pid" "$portless_owner"; then\n                emergency_identity_ready=true',
    )
    expect(proxyStart).toContain("sleep 0.1")
    expect(
      proxyStart.match(
        /if ! kill -0 "\$portless_pid" 2>\/dev\/null; then\n\s+wait "\$portless_pid" 2>\/dev\/null \|\| true/g,
      ),
    ).toHaveLength(2)
    expect(proxyStart.indexOf("emergency_portless_cleanup() {")).toBeLessThan(
      proxyStart.indexOf('PORTLESS_CI_OWNER="$portless_owner"'),
