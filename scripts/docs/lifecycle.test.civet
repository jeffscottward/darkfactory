    expect(proxyStart).toContain('rm -f "$portless_pid_file"')
    expect(proxyStart).not.toContain("portless proxy start --skip-trust")
    expect(proxyTrust).toContain(
      'certutil -A -d "sql:$nss_db" -n "$ca_nickname" -t "C,," -i "$NODE_EXTRA_CA_CERTS"',
    )
    expect(proxyTrust).not.toContain('$HOME/.portless/ca.pem')
    expect(proxyReadiness).toContain("if: matrix.lane == 'browser'")
    expect(proxyReadiness).toContain(
      `IFS=' ' read -r portless_pid portless_owner portless_state_extra <"$portless_pid_file"`,
    )
    expect(proxyReadiness).toContain(
      '! owns_portless_process_group "$portless_pid" "$portless_owner"',
