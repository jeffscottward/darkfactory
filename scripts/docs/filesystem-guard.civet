import { randomUUID } from "node:crypto"
import { constants } from "node:fs"
import { link, lstat, mkdir, open, realpath, rename, rm } from "node:fs/promises"
import { dirname, join, relative, resolve, sep } from "node:path"

export type GuardHooks = Readonly<{
  beforePublish?: () => Promise<void>
  afterPublish?: () => Promise<void>
}>
export type GuardedWriteMode = "create" | "upsert"
type Identity = Readonly<{ path: string; dev: number; ino: number }>

const identity = async (path: string): Promise<Identity> => {
  const stats = await lstat(path)
  if (stats.isSymbolicLink()) throw new Error("Filesystem guard rejects symbolic links")
  return Object.freeze({ path, dev: stats.dev, ino: stats.ino })
}
const sameIdentity = (left: Identity, right: Identity): boolean =>
  left.dev === right.dev && left.ino === right.ino

const assertIdentity = async (expected: Identity): Promise<void> => {
  const current = await identity(expected.path)
  if (!sameIdentity(expected, current)) throw new Error("Filesystem identity changed during operation")
}

const containedTarget = (root: string, path: string): string => {
  const target = resolve(root, path)
  const relation = relative(root, target)
  if (relation === ".." || relation.startsWith(`..${sep}`)) throw new Error("Filesystem target escapes repository")
  return target
}

const ancestorPaths = (root: string, parent: string): readonly string[] => {
  const relation = relative(root, parent)
  if (relation === ".." || relation.startsWith(`..${sep}`)) throw new Error("Filesystem parent escapes repository")
  const paths = [root]
  if (relation.length === 0) return paths
  let current = root
  for (const segment of relation.split(sep)) {
    current = join(current, segment)
    paths.push(current)
  }
  return paths
}

const prepareAncestors = async (root: string, parent: string): Promise<readonly Identity[]> => {
  const paths = ancestorPaths(root, parent)
  const snapshots: Identity[] = []
  let firstMissing = paths.length
  for (let index = 0; index < paths.length; index += 1) {
    try {
      const snapshot = await identity(paths[index]!)
      const stats = await lstat(paths[index]!)
      if (!stats.isDirectory()) throw new Error("Filesystem ancestor is not a directory")
      snapshots.push(snapshot)
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error
      firstMissing = index
      break
    }
  }
  for (const snapshot of snapshots) await assertIdentity(snapshot)
  for (let index = firstMissing; index < paths.length; index += 1) {
    for (const snapshot of snapshots) await assertIdentity(snapshot)
    await mkdir(paths[index]!, { mode: 0o700 })
    const created = await identity(paths[index]!)
    const stats = await lstat(paths[index]!)
    if (!stats.isDirectory()) throw new Error("Filesystem ancestor creation failed")
    snapshots.push(created)
  }
  for (const snapshot of snapshots) await assertIdentity(snapshot)
  return Object.freeze(snapshots)
}

const optionalIdentity = async (path: string): Promise<Identity | undefined> => {
  try {
    return await identity(path)
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined
    throw error
  }
}

const removeOwned = async (owned: Identity | undefined): Promise<void> => {
  if (!owned) return
  try {
    if (sameIdentity(owned, await identity(owned.path))) await rm(owned.path, { force: true })
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error
  }
}

const withGlobalLock = async <T>(root: string, task: (assertOwned: () => Promise<void>) => Promise<T>): Promise<T> => {
  const lockPath = join(root, ".darkfactory-operations.lock")
  const handle = await open(
    lockPath,
    constants.O_CREAT | constants.O_EXCL | constants.O_WRONLY | (constants.O_NOFOLLOW ?? 0),
    0o600,
  )
  const stats = await handle.stat()
  const owned = Object.freeze({ path: lockPath, dev: stats.dev, ino: stats.ino })
  const assertOwned = async (): Promise<void> => {
    const current = await identity(lockPath)
    if (!sameIdentity(owned, current)) throw new Error("Operations lock ownership changed")
  }
  try {
    await assertOwned()
    return await task(assertOwned)
  } finally {
    await handle.close()
    await removeOwned(owned).catch(() => undefined)
  }
}

export const guardedWrite = async (
  repositoryPath: string,
  relativePath: string,
  content: string,
  mode: GuardedWriteMode,
  hooks: GuardHooks = {},
): Promise<void> => {
  const root = await realpath(repositoryPath)
  await withGlobalLock(root, async (assertLock) => {
    const target = containedTarget(root, relativePath)
    const parent = dirname(target)
    const ancestors = await prepareAncestors(root, parent)
    const original = await optionalIdentity(target)
    if (original) {
      const stats = await lstat(target)
      if (!stats.isFile() || mode === "create") throw new Error("Filesystem target is occupied")
    }
    const temporary = `${target}.${process.pid}-${randomUUID()}.tmp`
    const backup = `${target}.${process.pid}-${randomUUID()}.bak`
    const handle = await open(
      temporary,
      constants.O_CREAT | constants.O_EXCL | constants.O_WRONLY | (constants.O_NOFOLLOW ?? 0),
      0o600,
    )
    const temporaryStats = await handle.stat()
    const temporaryIdentity = Object.freeze({ path: temporary, dev: temporaryStats.dev, ino: temporaryStats.ino })
    let published: Identity | undefined
    let backupIdentity: Identity | undefined
    try {
      await handle.writeFile(content, "utf8")
      await handle.sync()
      await handle.close()
      await hooks.beforePublish?.()
      await assertLock()
      for (const snapshot of ancestors) await assertIdentity(snapshot)
      const current = await optionalIdentity(target)
      if ((original === undefined) !== (current === undefined) || (original && current && !sameIdentity(original, current))) {
        throw new Error("Filesystem target changed during operation")
      }
      await assertIdentity(temporaryIdentity)
      if (original) {
        await link(target, backup)
        backupIdentity = await identity(backup)
        if (!sameIdentity(original, backupIdentity)) throw new Error("Filesystem backup identity mismatch")
        await rename(temporary, target)
      } else {
        await link(temporary, target)
      }
      published = await identity(target)
      if (!sameIdentity(temporaryIdentity, published)) throw new Error("Filesystem publication identity mismatch")
      for (const snapshot of ancestors) await assertIdentity(snapshot)
      await hooks.afterPublish?.()
      for (const snapshot of ancestors) await assertIdentity(snapshot)
      await assertLock()
      await removeOwned(backupIdentity)
      backupIdentity = undefined
    } catch (error) {
      try {
        for (const snapshot of ancestors) await assertIdentity(snapshot)
        if (published && sameIdentity(published, await identity(target))) {
          if (backupIdentity) {
            await rename(backup, target)
            backupIdentity = undefined
          } else {
            await rm(target, { force: true })
          }
        }
      } catch {
        // Refuse unsafe rollback after ancestor or target ownership changes.
      }
      throw error
    } finally {
      await handle.close().catch(() => undefined)
      await removeOwned(temporaryIdentity).catch(() => undefined)
      await removeOwned(backupIdentity).catch(() => undefined)
    }
  })
}
