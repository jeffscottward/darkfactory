{
  "tsConfig": {
    "rootDir": ".",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
      "lib": ["ES2023", "DOM"],
      "types": ["node"],
      "typeRoots": ["./node_modules/@types"]
    },
    "include": [
      "scripts/doctor.civet",
      "scripts/dev/lifecycle.civet",
      "scripts/doctor/**/*.civet"
    ],
    "exclude": ["scripts/doctor/**/*.test.civet"]
  }
}
