import { afterEach, beforeEach, describe, expect, it, vi } from "vitest"

const mocks = vi.hoisted(() => ({
  readFileSync: vi.fn(),
  spawnSync: vi.fn(),
}))

vi.mock("node:child_process", () => ({ spawnSync: mocks.spawnSync }))
vi.mock("node:fs", () => ({ readFileSync: mocks.readFileSync }))

import {
  PRE_PUSH_SCRIPTS,
  runPreCommit,
  runPrePush,
} from "./index.civet"
const BUN_VERSION = "1.3.14"

const spawnResult = (
  status: number | null,
  stdout = "",
  error?: Error,
) => ({
  status,
  stdout,
  stderr: "",
  pid: 123,
  signal: null,
  ...(error === undefined ? {} : { error }),
})

type SpawnCall = [executable: string, arguments_: string[], options?: unknown]

const spawnCalls = (): SpawnCall[] =>
  const spawnMock = Reflect.get(mocks, "spawnSync") as object
  const mockState = Reflect.get(spawnMock, "mock") as object
  Reflect.get(mockState, "calls") as SpawnCall[]

const preCommitCalls = () =>
  spawnCalls().filter(([executable, arguments_]) =>
    !(executable === "bun" &&
      arguments_.length === 1 &&
      arguments_[0] === "--version")
  )
beforeEach(() =>
  vi.stubGlobal("Bun", { version: BUN_VERSION })
  mocks.readFileSync.mockReturnValue(`${BUN_VERSION}\n`)
  mocks.spawnSync.mockImplementation((executable, arguments_) =>
    executable === "bun" && arguments_[0] === "--version"
      ? spawnResult(0, `${BUN_VERSION}\n`)
      : spawnResult(0)
  )
  undefined
)

afterEach(() =>
  mocks.readFileSync.mockReset()
  mocks.spawnSync.mockReset()
  vi.unstubAllGlobals()
  vi.restoreAllMocks()
)

describe("repository hooks", () =>
  it("runs staged Biome and Markdown scripts with case-insensitive, argument-safe paths", () =>
    mocks.spawnSync
      .mockReturnValueOnce(spawnResult(
        0,
        "src/file with space.TS\0README.MARKDOWN\0component.CIVET\0notes.txt\0",
      ))
      .mockReturnValue(spawnResult(0))

    expect(runPreCommit()).toBe(0)
    expect(preCommitCalls()).toEqual([
      ["git", ["diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"], {
        encoding: "utf8",
        shell: false,
        stdio: ["ignore", "pipe", "inherit"],
      }],
      ["bun", ["run", "format:staged", "--", "./src/file with space.TS"], {
        shell: false,
        stdio: "inherit",
      }],
      ["bun", ["run", "lint:staged", "--", "./src/file with space.TS"], {
        shell: false,
        stdio: "inherit",
      }],
      ["bun", ["run", "lint:markdown:staged", "--", "./README.MARKDOWN"], {
        shell: false,
        stdio: "inherit",
      }],
    ])
  )

  it("leaves an exclusively generated security bootstrap to its exact-byte checker", () =>
    mocks.spawnSync.mockReturnValueOnce(spawnResult(0, "scripts/ci/generated/security-preflight.mjs\0"))
    expect(runPreCommit()).toBe(0)
    expect(preCommitCalls()).toHaveLength(1)
  )

  it("still checks neighboring modules when a generated bootstrap is staged", () =>
    mocks.spawnSync
      .mockReturnValueOnce(spawnResult(0, "scripts/ci/generated/security-preflight.mjs\0scripts/ci/security-preflight.mjs\0scripts/ci/generated/another.mjs\0"))
      .mockReturnValue(spawnResult(0))
    expect(runPreCommit()).toBe(0)
    expect(preCommitCalls().slice(1).map(([, arguments_]) => arguments_)).toEqual([
      ["run", "format:staged", "--", "./scripts/ci/security-preflight.mjs", "./scripts/ci/generated/another.mjs"],
      ["run", "lint:staged", "--", "./scripts/ci/security-preflight.mjs", "./scripts/ci/generated/another.mjs"],
    ])
  )

  it("defers Civet-only changes and silently accepts other irrelevant or empty path records", () =>
    const errorOutput = vi.spyOn(console, "error").mockImplementation(() => undefined)
    mocks.spawnSync.mockReturnValueOnce(spawnResult(0, "src/worker.CIVET\0"))

    expect(runPreCommit()).toBe(0)
    expect(errorOutput).toHaveBeenCalledWith(expect.stringMatching(/Civet validation is deferred/))
    expect(preCommitCalls()).toHaveLength(1)

    mocks.spawnSync.mockReset()
    errorOutput.mockClear()
    mocks.spawnSync.mockReturnValueOnce(spawnResult(0, "notes.txt\0\0"))

    expect(runPreCommit()).toBe(0)
    expect(errorOutput).not.toHaveBeenCalled()
    expect(preCommitCalls()).toHaveLength(1)
  )

  it("maps a failed staged-path lookup without hiding spawn errors or null statuses", () =>
    const errorOutput = vi.spyOn(console, "error").mockImplementation(() => undefined)
    const spawnError = Object.assign(new Error("git executable unavailable"), {
      code: "ENOENT",
    })
    mocks.spawnSync.mockReturnValueOnce(spawnResult(null, "", spawnError))

    expect(runPreCommit()).toBe(1)
    expect(errorOutput.mock.calls).toEqual([
      [
        "[hook] failed (1): \"git\" \"diff\" \"--cached\" \"--name-only\" \"--diff-filter=ACMR\" \"-z\"",
      ],
      ["git executable unavailable"],
    ])
  )

  it("stops at each failed staged command and reports the exact generated command", () =>
    const errorOutput = vi.spyOn(console, "error").mockImplementation(() => undefined)

    mocks.spawnSync
      .mockReturnValueOnce(spawnResult(0, "src/index.ts\0README.md\0"))
      .mockReturnValueOnce(spawnResult(4))
    expect(runPreCommit()).toBe(4)
    expect(preCommitCalls()).toHaveLength(2)
    expect(errorOutput).toHaveBeenLastCalledWith(
      "[hook] failed (4): \"bun\" \"run\" \"format:staged\" \"--\" \"./src/index.ts\"",
    )

    mocks.spawnSync.mockReset()
    errorOutput.mockClear()
    mocks.spawnSync
      .mockReturnValueOnce(spawnResult(0, "src/index.ts\0README.md\0"))
      .mockReturnValueOnce(spawnResult(0))
      .mockReturnValueOnce(spawnResult(5))
    expect(runPreCommit()).toBe(5)
    expect(preCommitCalls()).toHaveLength(3)
    expect(errorOutput).toHaveBeenLastCalledWith(expect.stringContaining("lint:staged"))

    mocks.spawnSync.mockReset()
    errorOutput.mockClear()
    mocks.spawnSync
      .mockReturnValueOnce(spawnResult(0, "README.md\0"))
      .mockReturnValueOnce(spawnResult(6))
    expect(runPreCommit()).toBe(6)
    expect(preCommitCalls()).toHaveLength(2)
    expect(errorOutput).toHaveBeenLastCalledWith(expect.stringContaining("lint:markdown:staged"))
  )

  it("returns success after a Biome-only staged batch reaches the terminal path", () =>
    mocks.spawnSync
      .mockReturnValueOnce(spawnResult(0, "src/index.ts\0"))
      .mockReturnValue(spawnResult(0))

    expect(runPreCommit()).toBe(0)
    expect(preCommitCalls()).toHaveLength(3)
    expect(
      preCommitCalls().slice(1).map(([, arguments_]) => arguments_[1]),
    ).toEqual(["format:staged", "lint:staged"])
  )

  it("runs the immutable pre-push script list through injected and default runners", () =>
    const injected = vi.fn(() => 17)
    expect(runPrePush(injected)).toBe(17)
    expect(injected).toHaveBeenCalledWith(["verify:core"])
    expect(Object.isFrozen(PRE_PUSH_SCRIPTS)).toBe(true)

    mocks.spawnSync
      .mockReturnValueOnce(spawnResult(0, `${BUN_VERSION}\n`))
      .mockReturnValueOnce(spawnResult(0))
    expect(runPrePush()).toBe(0)
    expect(mocks.spawnSync).toHaveBeenCalledWith(
      "bun",
      ["run", "verify:core"],
      { shell: false, stdio: "inherit" },
    )
  )

  it.each([
    ["missing", () => mocks.readFileSync.mockImplementation(() => { throw new Error("missing") })],
    ["malformed", () => mocks.readFileSync.mockReturnValue("not-semver\n")],
    ["wrong", () => mocks.readFileSync.mockReturnValue("9.9.9\n")],
  ] as const)("blocks a %s Bun pin before the core lane", (_name, arrange) =>
    const runner = vi.fn(() => 0)
    arrange()
    expect(runPrePush(runner)).toBe(1)
    expect(runner).not.toHaveBeenCalled()
  )

  it.each([
    ["nonzero exit", spawnResult(9), 9],
    ["spawn error", spawnResult(0, "", new Error("bun unavailable")), 1],
    ["termination signal", { ...spawnResult(null), signal: "SIGTERM" }, 1],
  ] as const)("blocks a PATH-resolved bun %s before the core lane", (_name, result, expected) =>
    const runner = vi.fn(() => 0)
    const errorOutput = vi.spyOn(console, "error").mockImplementation(() => undefined)
    mocks.spawnSync.mockReturnValueOnce(result)
    expect(runPrePush(runner)).toBe(expected)
    expect(runner).not.toHaveBeenCalled()
    expect(errorOutput).toHaveBeenCalled()
  )

  it("blocks a mismatched PATH-resolved bun before the core lane", () =>
    const runner = vi.fn(() => 0)
    mocks.spawnSync.mockReturnValueOnce(spawnResult(0, "9.9.9\n"))
    expect(runPrePush(runner)).toBe(1)
    expect(runner).not.toHaveBeenCalled()
  )

  it("blocks a mismatched executing Bun before the core lane", () =>
    const runner = vi.fn(() => 0)
    vi.stubGlobal("Bun", { version: "9.9.9" })
    expect(runPrePush(runner)).toBe(1)
    expect(runner).not.toHaveBeenCalled()
  )


  it("blocks a missing executing Bun version before the core lane", () =>
    const runner = vi.fn(() => 0)
    vi.stubGlobal("Bun", {})
    expect(runPrePush(runner)).toBe(1)
    expect(runner).not.toHaveBeenCalled()
  )

  it("normalizes non-Error runtime inspection failures", () =>
    const runner = vi.fn(() => 0)
    const errorOutput = vi.spyOn(console, "error").mockImplementation(() => undefined)
    mocks.readFileSync.mockImplementation(() =>
      throw "missing pin"
    )
    expect(runPrePush(runner)).toBe(1)
    expect(runner).not.toHaveBeenCalled()
    expect(errorOutput).toHaveBeenCalledWith(
      "[hook] Bun runtime prerequisite failed: missing pin",
    )
  )

  it("wires both executable entrypoints to their hook runner exit codes", async () =>
    const previousExitCode = process.exitCode
    try
      process.exitCode = undefined
      mocks.spawnSync.mockReturnValueOnce(spawnResult(0, ""))
      await import("./pre-commit.civet")
      expect(process.exitCode).toBe(0)
      expect(mocks.spawnSync).toHaveBeenLastCalledWith(
        "git",
        ["diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"],
        expect.any(Object),
      )

      mocks.spawnSync.mockClear()
      mocks.spawnSync
        .mockReturnValueOnce(spawnResult(0, `${BUN_VERSION}\n`))
        .mockReturnValueOnce(spawnResult(9))
      await import("./pre-push.civet")
      expect(process.exitCode).toBe(9)
      expect(mocks.spawnSync).toHaveBeenCalledWith(
        "bun",
        ["run", "verify:core"],
        { shell: false, stdio: "inherit" },
      )
    finally
      process.exitCode = previousExitCode
  )
)
