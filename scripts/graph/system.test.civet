  it("preserves a foreign snapshot root installed during failed publication", async () => {
    const root = join("scripts", "graph", `system-snapshot-race-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()
    let activeRoot = ""
    let privateParent = ""
    let displaced = ""
    let quarantine = ""
    let replaced = false
    mocks.fileSystem.open.mockImplementation(async (...arguments_) => {
      const handle = await Reflect.apply(mocks.fileSystemActual.open, undefined, arguments_)
      const path = String(arguments_[0])
      if (path.endsWith(`${sep}active`)) {
        activeRoot = path
        privateParent = dirname(path)
        displaced = join(privateParent, "displaced")
      }
      return handle
    })
    mocks.fileSystem.rename.mockImplementation(async (...arguments_) => {
      if (String(arguments_[0]) === activeRoot) quarantine = String(arguments_[1])
      await Reflect.apply(mocks.fileSystemActual.rename, undefined, arguments_)
    })
    mocks.fileSystem.writeFile.mockImplementation(async (...arguments_) => {
      const path = String(arguments_[0])
      if (!replaced && activeRoot && path.startsWith(`${activeRoot}${sep}`)) {
        replaced = true
        await mocks.fileSystemActual.rename(activeRoot, displaced)
        await mocks.fileSystemActual.mkdir(activeRoot)
        await mocks.fileSystemActual.writeFile(join(activeRoot, "foreign.txt"), "foreign")
        throw new Error("snapshot publication failed")
      }
      return Reflect.apply(mocks.fileSystemActual.writeFile, undefined, arguments_)
    })

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig(root)))
        .rejects.toThrow(/snapshot publication failed/i)
      await expect(readFile(join(quarantine, "foreign.txt"), "utf8")).resolves.toBe("foreign")
      await expect(exists(displaced)).resolves.toBe(true)
    } finally {
      await mocks.fileSystemActual.rm(root, { force: true, recursive: true })
      if (privateParent) {
        await mocks.fileSystemActual.rm(privateParent, { force: true, recursive: true })
      }
    }
  })

