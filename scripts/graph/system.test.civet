import { createHash, randomUUID } from "node:crypto"
import { access, link, mkdir, mkdtemp, readFile, rm, symlink, truncate, writeFile } from "node:fs/promises"
import { createServer } from "node:net"
import { tmpdir } from "node:os"
import { join } from "node:path"

import { afterEach, describe, expect, it, vi } from "vitest"

const mocks = vi.hoisted(() => ({
  execFile: vi.fn(),
  fileSystem: {
    lstat: vi.fn(),
    open: vi.fn(),
    readdir: vi.fn(),
    realpath: vi.fn(),
    rm: vi.fn(),
    writeFile: vi.fn(),
  },
  fileSystemActual: {} as Pick<
    typeof import("node:fs/promises"),
    "lstat" | "mkdir" | "open" | "readdir" | "realpath" | "rename" | "rm" | "writeFile"
  >,
  compileCivetSnapshot: vi.fn(),
  resetFileSystem: (): void => undefined,
  resetCompiler: (): void => undefined,
}))
vi.mock("node:child_process", () => ({ execFile: mocks.execFile }))
vi.mock("node:fs/promises", async () => {
  const actual = await vi.importActual<typeof import("node:fs/promises")>("node:fs/promises")
  Object.assign(mocks.fileSystemActual, {
    lstat: actual.lstat,
    mkdir: actual.mkdir,
    open: actual.open,
    readdir: actual.readdir,
    realpath: actual.realpath,
    rename: actual.rename,
    rm: actual.rm,
    writeFile: actual.writeFile,
  })
  const reset = (): void => {
    mocks.fileSystem.lstat.mockReset().mockImplementation(actual.lstat)
    mocks.fileSystem.open.mockReset().mockImplementation(actual.open)
    mocks.fileSystem.readdir.mockReset().mockImplementation(actual.readdir)
    mocks.fileSystem.realpath.mockReset().mockImplementation(actual.realpath)
    mocks.fileSystem.rm.mockReset().mockImplementation(actual.rm)
    mocks.fileSystem.writeFile.mockReset().mockImplementation(actual.writeFile)
  }
  mocks.resetFileSystem = reset
  reset()
  return {
    ...actual,
    lstat: mocks.fileSystem.lstat,
    open: mocks.fileSystem.open,
    readdir: mocks.fileSystem.readdir,
    realpath: mocks.fileSystem.realpath,
    rm: mocks.fileSystem.rm,
    writeFile: mocks.fileSystem.writeFile,
  }
})
vi.mock("./corpus.civet", async () => {
  const actual = await vi.importActual<typeof import("./corpus.civet")>("./corpus.civet")
  const reset = (): void => {
    mocks.compileCivetSnapshot.mockReset().mockImplementation(actual.compileCivetSnapshot)
  }
  mocks.resetCompiler = reset
  reset()
  return { ...actual, compileCivetSnapshot: mocks.compileCivetSnapshot }
})

import { parseGraphConfig } from "./graph.civet"
import {
  createNodeGraphFileSystem,
  graphProcessEnvironment,
  isGraphSourceExcluded,
  nodeGraphFileSystem,
  nodeGraphProcess,
} from "./system.civet"

const SENTINELS = {
  GEMINI_API_KEY: "sentinel-gemini-secret",
  GOOGLE_API_KEY: "sentinel-google-secret",
  GRAPHIFY_GEMINI_MODEL: "sentinel-provider-model",
  DATABASE_URL: "postgres://sentinel-secret",
}

const previous = Object.fromEntries(
  [...Object.keys(SENTINELS), "PYTHONHASHSEED", "GRAPHIFY_MAX_WORKERS", "LC_ALL"].map(
    (name) => [name, process.env[name]],
  ),
)

afterEach(() => {
  mocks.resetFileSystem()
  mocks.resetCompiler()
  vi.clearAllMocks()
  for (const [name, value] of Object.entries(previous)) {
    if (value === undefined) delete process.env[name]
    else process.env[name] = value
  }
})

const exists = async (path: string): Promise<boolean> => {
  try {
    await access(path)
    return true
  } catch {
    return false
  }
}
const snapshotConfig = (
  root: string,
  extensions: readonly string[] = [".ts"],
) => parseGraphConfig(JSON.stringify({
  version: 1,
  graphPath: "graphify-out/graph.json",
  manifestPath: ".graphify/manifest.json",
  source: {
    roots: [root],
    files: ["package.json"],
    extensions,
    excludes: ["node_modules"],
  },
  verificationPath: ["from", "to"],
}))
const configuredSourceConfig = (
  roots: readonly string[],
  files: readonly string[],
) => parseGraphConfig(JSON.stringify({
  version: 1,
  graphPath: "graphify-out/graph.json",
  manifestPath: ".graphify/manifest.json",
  source: {
    roots,
    files,
    extensions: [".ts"],
    excludes: ["node_modules"],
  },
  verificationPath: ["from", "to"],
}))
const isolatedSnapshotFileSystem = () => {
  const namespace = randomUUID()
  return {
    fileSystem: createNodeGraphFileSystem(namespace),
    path: `.graphify/source-snapshot-${createHash("sha256").update(namespace).digest("hex")}`,
  }
}

describe("Graphify source snapshot", () => {
  it("uses a deterministic repo-relative path and removes its owned snapshot", async () => {
    const root = join("scripts", "graph", `system-snapshot-${randomUUID()}`)
    const source = join(root, "source.ts")
    await mkdir(root, { recursive: true })
    await writeFile(source, "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()

    try {
      const snapshot = await isolated.fileSystem.createSourceSnapshot(snapshotConfig(root))
      expect(snapshot.path).toBe(isolated.path)
      await expect(readFile(join(snapshot.path, source), "utf8")).resolves.toBe(
        "export const source = true\n",
      )
      await snapshot.cleanup()
      await expect(exists(snapshot.path)).resolves.toBe(false)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("rejects a symlink in an ancestor of a configured source root", async () => {
    const root = join("scripts", "graph", `system-root-symlink-${randomUUID()}`)
    const outside = await mkdtemp(join(tmpdir(), "darkfactory-graph-outside-"))
    const configuredRoot = join(root, "escape", "nested")
    const absoluteRoot = join(process.cwd(), configuredRoot)
    await mkdir(root, { recursive: true })
    await mkdir(join(outside, "nested"), { recursive: true })
    await writeFile(join(outside, "nested", "outside.ts"), "outside-root-sentinel")
    await symlink(outside, join(root, "escape"))
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [configuredRoot],
        files: ["package.json"],
        extensions: [".ts"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(config))
        .rejects.toThrow(/symbolic link|symlink/i)
      expect(mocks.fileSystem.readdir.mock.calls.some(
        ([path]) => String(path) === absoluteRoot,
      )).toBe(false)
    } finally {
      await rm(root, { force: true, recursive: true })
      await rm(outside, { force: true, recursive: true })
    }
  })

  it("rejects a nested-parent source symlink without reading or snapshotting outside bytes", async () => {
    const root = join("scripts", "graph", `system-file-symlink-${randomUUID()}`)
    const safeRoot = join(root, "safe")
    const outside = await mkdtemp(join(tmpdir(), "darkfactory-graph-outside-"))
    const sentinel = "outside-secret-sentinel"
    const configuredSource = join(root, "escape", "nested", "secret")
    const absoluteSource = join(process.cwd(), configuredSource)
    await mkdir(safeRoot, { recursive: true })
    await mkdir(join(outside, "nested"), { recursive: true })
    await writeFile(join(outside, "nested", "secret"), sentinel)
    await symlink(outside, join(root, "escape"))
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [safeRoot],
        files: [configuredSource],
        extensions: [".ts"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))
    const isolated = isolatedSnapshotFileSystem()

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(config))
        .rejects.toThrow(/symbolic link|symlink/i)
      expect(mocks.fileSystem.open.mock.calls.some(
        (call) => String(call[0]) === absoluteSource,
      )).toBe(false)
      expect(mocks.fileSystem.writeFile.mock.calls.some(
        (call) => String(call[0]).startsWith(isolated.path) && String(call[1]).includes(sentinel),
      )).toBe(false)
      await expect(exists(isolated.path)).resolves.toBe(false)
      await expect(readFile(join(outside, "nested", "secret"), "utf8")).resolves.toBe(sentinel)
    } finally {
      await rm(root, { force: true, recursive: true })
      await rm(outside, { force: true, recursive: true })
      await rm(isolated.path, { force: true, recursive: true })
    }
  })

  it("rejects a source swapped before open without reading the replacement bytes", async () => {
    const root = join("scripts", "graph", `system-open-race-${randomUUID()}`)
    const safeRoot = join(root, "safe")
    const source = join(root, "source.ts")
    const absoluteSource = join(process.cwd(), source)
    const outside = await mkdtemp(join(tmpdir(), "darkfactory-graph-outside-"))
    const outsideSource = join(outside, "secret")
    await mkdir(safeRoot, { recursive: true })
    await writeFile(source, "export const source = true\n")
    await writeFile(outsideSource, "outside-replacement-sentinel")
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [safeRoot],
        files: [source],
        extensions: [".ts"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))
    const isolated = isolatedSnapshotFileSystem()
    const replacement = await mocks.fileSystemActual.open(outsideSource, "r")
    const replacementRead = vi.spyOn(replacement, "read")
    mocks.fileSystem.open.mockImplementation(async (...arguments_) =>
      String(arguments_[0]) === absoluteSource
        ? replacement
        : Reflect.apply(mocks.fileSystemActual.open, undefined, arguments_)
    )

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(config))
        .rejects.toThrow(/source identity changed/i)
      expect(replacementRead).not.toHaveBeenCalled()
      await expect(exists(isolated.path)).resolves.toBe(false)
    } finally {
      await replacement.close().catch(() => undefined)
      await rm(root, { force: true, recursive: true })
      await rm(outside, { force: true, recursive: true })
      await rm(isolated.path, { force: true, recursive: true })
    }
  })

  it("rejects a configured source whose canonical file path escapes the repository", async () => {
    const root = join("scripts", "graph", `system-canonical-${randomUUID()}`)
    const safeRoot = join(root, "safe")
    const source = join(root, "source.ts")
    const absoluteSource = join(process.cwd(), source)
    await mkdir(safeRoot, { recursive: true })
    await writeFile(source, "export const source = true\n")
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [safeRoot],
        files: [source],
        extensions: [".ts"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) =>
      String(arguments_[0]) === absoluteSource
        ? join(process.cwd(), "..")
        : Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    )

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(config))
        .rejects.toThrow(/source path escapes the repository/i)
      expect(mocks.fileSystem.open.mock.calls.some(
        ([path]) => String(path) === absoluteSource,
      )).toBe(false)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("refuses a snapshot path collision without deleting existing content", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const snapshotRoot = isolated.path
    const preserved = join(snapshotRoot, "preserved.txt")
    await mkdir(snapshotRoot, { recursive: true })
    await writeFile(preserved, "preserve")

    try {
      const result = await isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph"))
        .then((snapshot) => snapshot, (error: unknown) => error)
      if (!(result instanceof Error)) await result.cleanup()

      expect(result).toBeInstanceOf(Error)
      await expect(readFile(preserved, "utf8")).resolves.toBe("preserve")
    } finally {
      await rm(snapshotRoot, { force: true, recursive: true })
    }
  })

  it("refuses cleanup after its ownership marker changes and preserves the snapshot", async () => {
    const root = join("scripts", "graph", `system-snapshot-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()
    const snapshot = await isolated.fileSystem.createSourceSnapshot(snapshotConfig(root))
    await writeFile(join(snapshot.path, ".owner"), "different-owner")

    try {
      await expect(snapshot.cleanup()).rejects.toThrow(/owner|ownership/i)
      await expect(exists(join(snapshot.path, root, "source.ts"))).resolves.toBe(true)
    } finally {
      await rm(root, { force: true, recursive: true })
      await rm(snapshot.path, { force: true, recursive: true })
    }
  })
  it("preserves a foreign snapshot root installed during failed publication", async () => {
    const root = join("scripts", "graph", `system-snapshot-race-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()
    const displaced = `${isolated.path}-displaced`
    let replaced = false
    mocks.fileSystem.writeFile.mockImplementation(async (...arguments_) => {
      const path = String(arguments_[0])
      if (!replaced && path.startsWith(isolated.path) && path !== join(isolated.path, ".owner")) {
        replaced = true
        await mocks.fileSystemActual.rename(isolated.path, displaced)
        await mocks.fileSystemActual.mkdir(isolated.path)
        await mocks.fileSystemActual.writeFile(join(isolated.path, "foreign.txt"), "foreign")
        throw new Error("snapshot publication failed")
      }
      return Reflect.apply(mocks.fileSystemActual.writeFile, undefined, arguments_)
    })

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig(root)))
        .rejects.toThrow(/snapshot ownership changed/i)
      await expect(readFile(join(isolated.path, "foreign.txt"), "utf8")).resolves.toBe("foreign")
      await expect(exists(displaced)).resolves.toBe(true)
    } finally {
      await mocks.fileSystemActual.rm(root, { force: true, recursive: true })
      await mocks.fileSystemActual.rm(isolated.path, { force: true, recursive: true })
      await mocks.fileSystemActual.rm(displaced, { force: true, recursive: true })
    }
  })

  it("preserves a replacement root even when it carries the original owner marker", async () => {
    const root = join("scripts", "graph", `system-snapshot-root-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()
    const snapshot = await isolated.fileSystem.createSourceSnapshot(snapshotConfig(root))
    const displaced = `${snapshot.path}-displaced`
    await mocks.fileSystemActual.rename(snapshot.path, displaced)
    await mocks.fileSystemActual.mkdir(snapshot.path)
    await mocks.fileSystemActual.rename(
      join(displaced, ".owner"),
      join(snapshot.path, ".owner"),
    )
    await mocks.fileSystemActual.writeFile(join(snapshot.path, "foreign.txt"), "foreign")

    try {
      await expect(snapshot.cleanup()).rejects.toThrow(/snapshot ownership changed/i)
      await expect(readFile(join(snapshot.path, "foreign.txt"), "utf8")).resolves.toBe("foreign")
      await expect(exists(displaced)).resolves.toBe(true)
    } finally {
      await mocks.fileSystemActual.rm(root, { force: true, recursive: true })
      await mocks.fileSystemActual.rm(snapshot.path, { force: true, recursive: true })
      await mocks.fileSystemActual.rm(displaced, { force: true, recursive: true })
    }
  })

  it("preserves a same-token owner marker installed on a different inode", async () => {
    const root = join("scripts", "graph", `system-snapshot-marker-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()
    const snapshot = await isolated.fileSystem.createSourceSnapshot(snapshotConfig(root))
    const ownerPath = join(snapshot.path, ".owner")
    const owner = await readFile(ownerPath, "utf8")
    await mocks.fileSystemActual.rm(ownerPath)
    await mocks.fileSystemActual.writeFile(ownerPath, owner)

    try {
      await expect(snapshot.cleanup()).rejects.toThrow(/marker ownership changed/i)
      await expect(readFile(ownerPath, "utf8")).resolves.toBe(owner)
    } finally {
      await mocks.fileSystemActual.rm(root, { force: true, recursive: true })
      await mocks.fileSystemActual.rm(snapshot.path, { force: true, recursive: true })
    }
  })
  it("removes its owned root when owner marker creation fails", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const ownerPath = join(isolated.path, ".owner")
    mocks.fileSystem.writeFile.mockImplementation(async (...arguments_) => {
      if (String(arguments_[0]) === ownerPath) throw new Error("owner marker write failed")
      return Reflect.apply(mocks.fileSystemActual.writeFile, undefined, arguments_)
    })

    await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph")))
      .rejects.toThrow(/owner marker write failed/i)
    await expect(exists(isolated.path)).resolves.toBe(false)
  })
})

describe("Graph source containment revalidation", () => {
  it("rejects a canonical escape at an ancestor before root enumeration", async () => {
    const base = join("scripts", "graph", `system-ancestor-escape-${randomUUID()}`)
    const sourceRoot = join(base, "source")
    const absoluteBase = join(process.cwd(), base)
    const absoluteSourceRoot = join(process.cwd(), sourceRoot)
    await mkdir(sourceRoot, { recursive: true })
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) =>
      String(arguments_[0]) === absoluteBase
        ? join(process.cwd(), "..")
        : Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    )

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/source path escapes the repository/i)
      expect(mocks.fileSystem.readdir.mock.calls.some(
        (call) => String(call[0]) === absoluteSourceRoot,
      )).toBe(false)
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a canonical source ancestor that resolves to a regular file", async () => {
    const base = join("scripts", "graph", `system-ancestor-file-${randomUUID()}`)
    const sourceRoot = join(base, "source")
    const canonicalFile = join(base, "canonical-file")
    const absoluteSourceRoot = join(process.cwd(), sourceRoot)
    const absoluteCanonicalFile = join(process.cwd(), canonicalFile)
    await mkdir(sourceRoot, { recursive: true })
    await writeFile(canonicalFile, "not a directory")
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) =>
      String(arguments_[0]) === absoluteSourceRoot
        ? absoluteCanonicalFile
        : Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    )

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/ancestor identity changed/i)
      expect(mocks.fileSystem.readdir).not.toHaveBeenCalled()
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a regular file in a configured source ancestor chain", async () => {
    const base = join("scripts", "graph", `system-ancestor-kind-${randomUUID()}`)
    const regularFile = join(base, "regular")
    const sourceRoot = join(regularFile, "source")
    await mkdir(base, { recursive: true })
    await writeFile(regularFile, "not a directory")

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/ancestor is not a regular directory/i)
      expect(mocks.fileSystem.readdir).not.toHaveBeenCalled()
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a canonical source ancestor with a different directory identity", async () => {
    const base = join("scripts", "graph", `system-ancestor-directory-${randomUUID()}`)
    const sourceRoot = join(base, "source")
    const canonicalDirectory = join(base, "canonical-directory")
    const absoluteSourceRoot = join(process.cwd(), sourceRoot)
    const absoluteCanonicalDirectory = join(process.cwd(), canonicalDirectory)
    await mkdir(sourceRoot, { recursive: true })
    await mkdir(canonicalDirectory)
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) =>
      String(arguments_[0]) === absoluteSourceRoot
        ? absoluteCanonicalDirectory
        : Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    )

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/ancestor identity changed/i)
      expect(mocks.fileSystem.readdir).not.toHaveBeenCalled()
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a canonical ancestor that changes during root validation", async () => {
    const base = join("scripts", "graph", `system-ancestor-retarget-${randomUUID()}`)
    const sourceRoot = join(base, "source")
    const replacement = join(base, "replacement")
    const absoluteSourceRoot = join(process.cwd(), sourceRoot)
    const absoluteReplacement = join(process.cwd(), replacement)
    await mkdir(sourceRoot, { recursive: true })
    await mkdir(replacement)
    let sourceRootResolutions = 0
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) => {
      if (String(arguments_[0]) === absoluteSourceRoot) {
        sourceRootResolutions += 1
        if (sourceRootResolutions >= 3) return absoluteReplacement
      }
      return Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    })

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/ancestor identity changed/i)
      expect(mocks.fileSystem.readdir).not.toHaveBeenCalled()
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects an ancestor replaced by a symlink after root enumeration", async () => {
    const base = join("scripts", "graph", `system-ancestor-symlink-${randomUUID()}`)
    const sourceRoot = join(base, "source")
    const replacement = join(base, "replacement")
    const absoluteSourceRoot = join(process.cwd(), sourceRoot)
    const absoluteReplacement = join(process.cwd(), replacement)
    await mkdir(sourceRoot, { recursive: true })
    await mkdir(replacement)
    mocks.fileSystem.readdir.mockImplementation(async (...arguments_) => {
      const entries = await Reflect.apply(mocks.fileSystemActual.readdir, undefined, arguments_)
      if (String(arguments_[0]) === absoluteSourceRoot) {
        await rm(sourceRoot, { force: true, recursive: true })
        await symlink(absoluteReplacement, sourceRoot, "dir")
      }
      return entries
    })

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/source path contains a symbolic link/i)
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a canonical ancestor escape during root revalidation", async () => {
    const base = join("scripts", "graph", `system-ancestor-revalidation-${randomUUID()}`)
    const sourceRoot = join(base, "source")
    const absoluteSourceRoot = join(process.cwd(), sourceRoot)
    await mkdir(sourceRoot, { recursive: true })
    let sourceRootResolutions = 0
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) => {
      if (String(arguments_[0]) === absoluteSourceRoot) {
        sourceRootResolutions += 1
        if (sourceRootResolutions >= 3) return join(process.cwd(), "..")
      }
      return Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    })

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/source path escapes the repository/i)
      expect(mocks.fileSystem.readdir).not.toHaveBeenCalled()
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a configured root that becomes a regular file during validation", async () => {
    const base = join("scripts", "graph", `system-root-kind-${randomUUID()}`)
    const sourceRoot = join(base, "source")
    const regularFile = join(base, "regular.ts")
    const absoluteSourceRoot = join(process.cwd(), sourceRoot)
    await mkdir(sourceRoot, { recursive: true })
    await writeFile(regularFile, "export {}")
    const regularFileStats = await mocks.fileSystemActual.lstat(regularFile)
    let sourceRootInspections = 0
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      if (String(arguments_[0]) === absoluteSourceRoot) {
        sourceRootInspections += 1
        if (sourceRootInspections === 3) return regularFileStats
      }
      return Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
    })

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/source root is not a regular directory/i)
      expect(mocks.fileSystem.readdir).not.toHaveBeenCalled()
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a configured file whose canonical identity becomes a symlink", async () => {
    const base = join("scripts", "graph", `system-source-canonical-${randomUUID()}`)
    const safeRoot = join(base, "safe")
    const source = join(base, "source.ts")
    const absoluteSource = join(process.cwd(), source)
    await mkdir(safeRoot, { recursive: true })
    await writeFile(source, "export {}")
    let sourceInspections = 0
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      const stats = await Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
      if (String(arguments_[0]) === absoluteSource && ++sourceInspections === 2) {
        return Object.assign(stats, { isSymbolicLink: () => true })
      }
      return stats
    })

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([safeRoot], [source]),
      )).rejects.toThrow(/source identity changed/i)
      expect(mocks.fileSystem.open).not.toHaveBeenCalled()
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a configured source that is itself a symbolic link", async () => {
    const base = join("scripts", "graph", `system-source-symlink-${randomUUID()}`)
    const safeRoot = join(base, "safe")
    const target = join(base, "target.ts")
    const source = join(base, "source.ts")
    const absoluteSource = join(process.cwd(), source)
    await mkdir(safeRoot, { recursive: true })
    await writeFile(target, "export {}")
    await symlink(join(process.cwd(), target), source, "file")

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([safeRoot], [source]),
      )).rejects.toThrow(/source path contains a symbolic link/i)
      expect(mocks.fileSystem.realpath.mock.calls.some(
        (call) => String(call[0]) === absoluteSource,
      )).toBe(false)
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("rejects a configured file whose identity changes after canonical validation", async () => {
    const base = join("scripts", "graph", `system-source-identity-${randomUUID()}`)
    const safeRoot = join(base, "safe")
    const source = join(base, "source.ts")
    const absoluteSource = join(process.cwd(), source)
    await mkdir(safeRoot, { recursive: true })
    await writeFile(source, "export {}")
    let sourceInspections = 0
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      const stats = await Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
      if (String(arguments_[0]) === absoluteSource && ++sourceInspections === 3) {
        return Object.assign(stats, { ino: stats.ino + 1 })
      }
      return stats
    })

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([safeRoot], [source]),
      )).rejects.toThrow(/source identity changed/i)
      expect(mocks.fileSystem.open).not.toHaveBeenCalled()
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })

  it("canonicalizes the repository root while preserving regular explicit files", async () => {
    mocks.fileSystem.readdir.mockResolvedValueOnce([])

    await expect(nodeGraphFileSystem.listSourceFiles(
      configuredSourceConfig(["."], ["package.json"]),
    )).resolves.toEqual(["package.json"])
  })

  it("rejects an opened source whose descriptor identity changes after reading", async () => {
    const base = join("scripts", "graph", `system-descriptor-race-${randomUUID()}`)
    const safeRoot = join(base, "safe")
    const source = join(base, "source.ts")
    const absoluteSource = join(process.cwd(), source)
    await mkdir(safeRoot, { recursive: true })
    await writeFile(source, "export {}")
    const isolated = isolatedSnapshotFileSystem()
    mocks.fileSystem.open.mockImplementation(async (...arguments_) => {
      const handle = await Reflect.apply(mocks.fileSystemActual.open, undefined, arguments_)
      if (String(arguments_[0]) === absoluteSource) {
        const originalStat = handle.stat.bind(handle)
        let descriptorInspections = 0
        Object.defineProperty(handle, "stat", {
          configurable: true,
          value: async () => {
            const stats = await originalStat()
            descriptorInspections += 1
            return descriptorInspections === 2
              ? Object.assign(stats, { ino: stats.ino + 1 })
              : stats
          },
        })
      }
      return handle
    })

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(
        configuredSourceConfig([safeRoot], [source]),
      )).rejects.toThrow(/source identity changed/i)
      await expect(exists(isolated.path)).resolves.toBe(false)
    } finally {
      await rm(base, { force: true, recursive: true })
      await rm(isolated.path, { force: true, recursive: true })
    }
  })

  it("rejects a source whose canonical path changes to a contained hard link while reading", async () => {
    const base = join("scripts", "graph", `system-source-retarget-${randomUUID()}`)
    const safeRoot = join(base, "safe")
    const source = join(base, "source.ts")
    const replacement = join(base, "replacement.ts")
    const absoluteSource = join(process.cwd(), source)
    const absoluteReplacement = join(process.cwd(), replacement)
    await mkdir(safeRoot, { recursive: true })
    await writeFile(source, "export {}")
    await link(source, replacement)
    const isolated = isolatedSnapshotFileSystem()
    let sourceResolutions = 0
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) => {
      if (String(arguments_[0]) === absoluteSource) {
        sourceResolutions += 1
        if (sourceResolutions >= 3) return absoluteReplacement
      }
      return Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    })

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(
        configuredSourceConfig([safeRoot], [source]),
      )).rejects.toThrow(/source identity changed/i)
      await expect(exists(isolated.path)).resolves.toBe(false)
    } finally {
      await rm(base, { force: true, recursive: true })
      await rm(isolated.path, { force: true, recursive: true })
    }
  })

  it("rejects a configured root that becomes a regular file after enumeration", async () => {
    const base = join("scripts", "graph", `system-root-enumeration-${randomUUID()}`)
    const sourceRoot = join(base, "source")
    const regularFile = join(base, "regular")
    const absoluteSourceRoot = join(process.cwd(), sourceRoot)
    await mkdir(sourceRoot, { recursive: true })
    await writeFile(regularFile, "not a directory")
    const regularFileStats = await mocks.fileSystemActual.lstat(regularFile)
    let enumerated = false
    let postEnumerationChecks = 0
    mocks.fileSystem.readdir.mockImplementation(async (...arguments_) => {
      if (String(arguments_[0]) === absoluteSourceRoot) {
        enumerated = true
        return []
      }
      return Reflect.apply(mocks.fileSystemActual.readdir, undefined, arguments_)
    })
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      if (enumerated && String(arguments_[0]) === absoluteSourceRoot) {
        postEnumerationChecks += 1
        if (postEnumerationChecks === 2) return regularFileStats
      }
      return Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
    })

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(
        configuredSourceConfig([sourceRoot], ["package.json"]),
      )).rejects.toThrow(/ancestor identity changed/i)
      expect(postEnumerationChecks).toBe(2)
    } finally {
      await rm(base, { force: true, recursive: true })
    }
  })
})


describe("Graphify generated output reset", () => {
  it("removes only known generated entries and preserves unrelated files", async () => {
    const root = join(".graphify", `system-reset-${randomUUID()}`)
    await mkdir(join(root, "cache"), { recursive: true })
    await Promise.all([
      writeFile(join(root, "graph.json"), "{}"),
      writeFile(join(root, "cache", "stat-index.json"), "{}"),
      writeFile(join(root, ".graphify_analysis.json"), "{}"),
      writeFile(join(root, "manifest.json"), "{}"),
      writeFile(join(root, "keep.txt"), "keep"),
    ])

    try {
      await nodeGraphFileSystem.resetGraphOutput(join(root, "graph.json"))

      await expect(exists(join(root, "graph.json"))).resolves.toBe(false)
      await expect(exists(join(root, "cache"))).resolves.toBe(false)
      await expect(exists(join(root, ".graphify_analysis.json"))).resolves.toBe(false)
      await expect(exists(join(root, "manifest.json"))).resolves.toBe(false)
      await expect(exists(join(root, "keep.txt"))).resolves.toBe(true)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("rejects generated output symlinks without deleting their target", async () => {
    const root = join(".graphify", `system-reset-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "target.txt"), "keep")
    await symlink("target.txt", join(root, "manifest.json"))

    try {
      await expect(
        nodeGraphFileSystem.resetGraphOutput(join(root, "graph.json")),
      ).rejects.toThrow(/unsafe generated path/i)
      await expect(exists(join(root, "target.txt"))).resolves.toBe(true)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })
})

describe("Graphify configured source corpus", () => {
  it("distinguishes root-generated output from authored nested directories", () => {
    const excludes = ["coverage/**", "node_modules", "*.civet.d.ts"]

    expect(isGraphSourceExcluded("coverage/coverage-summary.json", excludes)).toBe(true)
    expect(isGraphSourceExcluded("scripts/coverage/coverage.civet", excludes)).toBe(false)
    expect(isGraphSourceExcluded("packages/api/node_modules/provider/index.js", excludes)).toBe(true)
    expect(isGraphSourceExcluded("packages/api/src/index.civet.d.ts", excludes)).toBe(true)
  })

  it("keeps authored dotfiles but excludes nested framework-generated .next output", async () => {
    const root = join("scripts", "graph", `system-corpus-${randomUUID()}`)
    const generated = join(root, ".next", "types", "routes.d.ts")
    const authored = join(root, ".authored", "source.ts")
    await mkdir(join(root, ".next", "types"), { recursive: true })
    await mkdir(join(root, ".authored"), { recursive: true })
    await Promise.all([
      writeFile(generated, "export type GeneratedRoute = string\n"),
      writeFile(authored, "export const authored = true\n"),
    ])

    try {
      const config = parseGraphConfig(await readFile(".graphify/config.json", "utf8"))
      const sources = await nodeGraphFileSystem.listSourceFiles(config)

      expect(config.source.files).toEqual([
        ".env.schema",
        "package.json",
        "turbo.json",
        "tsconfig.base.json",
        "tsconfig.json",
      ])
      expect(sources).toContain(authored)
      expect(sources).not.toContain(generated)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })
})

describe("Graphify process environment", () => {
  it("never forwards provider or application secrets to extract", () => {
    Object.assign(process.env, SENTINELS)
    process.env.PYTHONHASHSEED = "inherited-nondeterministic-value"
    process.env.GRAPHIFY_MAX_WORKERS = "inherited-nondeterministic-value"

    const environment = graphProcessEnvironment({})

    for (const name of Object.keys(SENTINELS)) expect(environment[name]).toBeUndefined()
    expect(environment.PYTHONHASHSEED).toBeUndefined()
    expect(environment.GRAPHIFY_MAX_WORKERS).toBeUndefined()
  })

  it("never forwards provider or application secrets to path and keeps explicit safe additions", () => {
    Object.assign(process.env, SENTINELS)

    const environment = graphProcessEnvironment({
      GRAPHIFY_QUERY_LOG_DISABLE: "1",
      PYTHONHASHSEED: "0",
      GRAPHIFY_MAX_WORKERS: "1",
      GEMINI_API_KEY: "explicit-sentinel-secret",
      CUSTOM_SECRET: "explicit-custom-secret",
    })

    for (const name of Object.keys(SENTINELS)) expect(environment[name]).toBeUndefined()
    expect(environment.GRAPHIFY_QUERY_LOG_DISABLE).toBe("1")
    expect(environment.PYTHONHASHSEED).toBe("0")
    expect(environment.GRAPHIFY_MAX_WORKERS).toBe("1")
    expect(graphProcessEnvironment({ PYTHONHASHSEED: "1" }).PYTHONHASHSEED).toBeUndefined()
    expect(graphProcessEnvironment({ GRAPHIFY_MAX_WORKERS: "2" }).GRAPHIFY_MAX_WORKERS).toBeUndefined()
    expect(environment.CUSTOM_SECRET).toBeUndefined()
  })
})

describe("Graph node filesystem boundaries", () => {
  it("inspects, bounds, and atomically writes only regular repository files", async () => {
    const root = join("scripts", "graph", `system-files-${randomUUID()}`)
    await mkdir(join(root, "directory"), { recursive: true })
    await mkdir(join(root, "actual-parent"))
    await writeFile(join(root, "source.txt"), "value")
    await symlink("source.txt", join(root, "linked.txt"))
    await symlink("actual-parent", join(root, "linked-parent"))

    try {
      await expect(nodeGraphFileSystem.inspect(join(root, "source.txt"))).resolves.toMatchObject({
        kind: "file",
        size: 5,
      })
      await expect(nodeGraphFileSystem.inspect(join(root, "directory"))).resolves.toMatchObject({
        kind: "directory",
      })
      await expect(nodeGraphFileSystem.inspect(join(root, "linked.txt"))).resolves.toMatchObject({
        kind: "symlink",
      })
      await expect(nodeGraphFileSystem.inspect(join(root, "missing.txt"))).resolves.toEqual({
        kind: "missing",
        size: 0,
      })
      await expect(nodeGraphFileSystem.exists(join(root, "source.txt"))).resolves.toBe(true)
      await expect(nodeGraphFileSystem.exists(join(root, "missing.txt"))).resolves.toBe(false)

      await expect(nodeGraphFileSystem.readText(join(root, "source.txt"), 5)).resolves.toBe("value")
      await expect(nodeGraphFileSystem.readText(join(root, "source.txt"), 4))
        .rejects.toThrow(/read exceeds its bound/i)
      await expect(nodeGraphFileSystem.readText(join(root, "directory"))).rejects.toThrow(/bound/i)
      await expect(nodeGraphFileSystem.readText(join(root, "linked.txt"))).rejects.toThrow()

      await nodeGraphFileSystem.writeText(join(root, "written.txt"), "first")
      await nodeGraphFileSystem.writeText(join(root, "written.txt"), "second")
      await expect(readFile(join(root, "written.txt"), "utf8")).resolves.toBe("second")
      await expect(nodeGraphFileSystem.writeText(join(root, "directory"), "unsafe"))
        .rejects.toThrow(/regular file/i)
      await expect(nodeGraphFileSystem.writeText(join(root, "linked-parent", "file.txt"), "unsafe"))
        .rejects.toThrow(/parent.*regular directory/i)
      await expect(nodeGraphFileSystem.inspect("../outside")).rejects.toThrow(/escapes the repository/i)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("sorts and deduplicates configured sources while excluding symlinks and generated subtrees", async () => {
    const root = join("scripts", "graph", `system-list-${randomUUID()}`)
    await mkdir(join(root, "excluded"), { recursive: true })
    await Promise.all([
      writeFile(join(root, "a.ts"), "export const a = true\n"),
      writeFile(join(root, "b.TS"), "export const b = true\n"),
      writeFile(join(root, "explicit.ts"), "export const explicit = true\n"),
      writeFile(join(root, "ignored.js"), "export const ignored = true\n"),
      writeFile(join(root, "excluded", "generated.ts"), "export const generated = true\n"),
    ])
    await symlink("a.ts", join(root, "linked.ts"))
    const configFor = (roots: readonly string[], files: readonly string[]) => parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots,
        files,
        extensions: [".ts"],
        excludes: [`${root}/excluded/**`],
      },
      verificationPath: ["from", "to"],
    }))

    try {
      const sources = await nodeGraphFileSystem.listSourceFiles(configFor(
        [root],
        [
          join(root, "explicit.ts"),
          join(root, "a.ts"),
          join(root, "excluded", "generated.ts"),
        ],
      ))
      expect(sources).toEqual([
        join(root, "a.ts"),
        join(root, "b.TS"),
        join(root, "explicit.ts"),
      ].sort())
      await expect(nodeGraphFileSystem.listSourceFiles(configFor(
        [join(root, "missing")],
        [join(root, "a.ts")],
      ))).rejects.toThrow(/source root is not a regular directory/i)
      await expect(nodeGraphFileSystem.listSourceFiles(configFor(
        [root],
        [join(root, "excluded")],
      ))).rejects.toThrow(/source file is not regular/i)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("compiles authored Civet snapshots and rewrites discovered workspace aliases", async () => {
    const packageName = `graph-system-${randomUUID()}`
    const root = join("packages", packageName)
    await mkdir(join(root, "src"), { recursive: true })
    await Promise.all([
      writeFile(join(root, "package.json"), JSON.stringify({
        name: `@darkfactory/${packageName}`,
        version: "1.0.0",
        exports: { ".": "./src/index.civet" },
      })),
      writeFile(join(root, "src/index.civet"), "export const value = 1\n"),
      writeFile(
        join(root, "src/consumer.civet"),
        `import { value } from "@darkfactory/${packageName}"\nexport const consumer = value\n`,
      ),
    ])
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [root],
        files: ["package.json"],
        extensions: [".civet", ".json"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))
    const isolated = isolatedSnapshotFileSystem()

    try {
      const snapshot = await isolated.fileSystem.createSourceSnapshot(config)
      try {
        expect(snapshot.path).toBe(isolated.path)
        await expect(readFile(
          join(snapshot.path, root, "src/consumer.tsx"),
          "utf8",
        )).resolves.toContain('from "./index.tsx"')
        await expect(exists(join(snapshot.path, root, "src/consumer.civet"))).resolves.toBe(false)
      } finally {
        await snapshot.cleanup()
      }
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("removes a failed snapshot corpus and diagnoses a missing ownership marker", async () => {
    const invalidPackage = join("packages", `graph-system-invalid-${randomUUID()}`)
    await mkdir(invalidPackage, { recursive: true })
    await writeFile(join(invalidPackage, "package.json"), "{")
    const invalidConfig = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [invalidPackage],
        files: ["package.json"],
        extensions: [".json"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))
    const invalidSnapshot = isolatedSnapshotFileSystem()
    try {
      await expect(invalidSnapshot.fileSystem.createSourceSnapshot(invalidConfig)).rejects.toThrow()
      await expect(exists(invalidSnapshot.path)).resolves.toBe(false)
    } finally {
      await rm(invalidPackage, { force: true, recursive: true })
    }

    const root = join("scripts", "graph", `system-owner-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const missingOwnerSnapshot = isolatedSnapshotFileSystem()
    const snapshot = await missingOwnerSnapshot.fileSystem.createSourceSnapshot(snapshotConfig(root))
    await rm(join(snapshot.path, ".owner"))
    try {
      await expect(snapshot.cleanup()).rejects.toThrow(/ownership marker is missing/i)
      await expect(exists(join(snapshot.path, root, "source.ts"))).resolves.toBe(true)
    } finally {
      await rm(root, { force: true, recursive: true })
      await rm(snapshot.path, { force: true, recursive: true })
    }
  })
  it("classifies special files and rejects content that grows after inspection", async () => {
    const root = join("scripts", "graph", `system-race-${randomUUID()}`)
    const sourcePath = join(root, "source.txt")
    const absoluteSourcePath = join(process.cwd(), sourcePath)
    const socketPath = join(root, "source.socket")
    await mkdir(root, { recursive: true })
    await writeFile(sourcePath, "value")
    const server = createServer()
    await new Promise<void>((resolve, reject) => {
      server.once("error", reject)
      server.listen(socketPath, resolve)
    })
    mocks.fileSystem.open.mockImplementation(async (...arguments_) => {
      const handle = await Reflect.apply(
        mocks.fileSystemActual.open,
        undefined,
        arguments_,
      ) as Awaited<ReturnType<typeof mocks.fileSystemActual.open>>
      if (String(arguments_[0]) === absoluteSourcePath) {
        const originalStat = handle.stat.bind(handle)
        Object.defineProperty(handle, "stat", {
          configurable: true,
          value: async () => {
            const stats = await originalStat()
            return Object.assign(stats, { size: 4 })
          },
        })
      }
      return handle
    })

    try {
      await expect(nodeGraphFileSystem.inspect(socketPath)).resolves.toMatchObject({
        kind: "other",
      })
      await expect(nodeGraphFileSystem.readText(sourcePath, 4))
        .rejects.toThrow(/read exceeds its bound/i)
    } finally {
      await new Promise<void>((resolve, reject) => {
        server.close((error) => error ? reject(error) : resolve())
      })
      await rm(root, { force: true, recursive: true })
    }
  })

  it("rejects a platform-specific canonical parent escape", async () => {
    const root = join("scripts", "graph", `system-parent-${randomUUID()}`)
    const parent = join(root, "parent")
    const absoluteParent = join(process.cwd(), parent)
    await mkdir(parent, { recursive: true })
    const platform = vi.spyOn(process, "platform", "get").mockReturnValue("win32")
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) =>
      String(arguments_[0]) === absoluteParent
        ? join(process.cwd(), "..\\outside")
        : Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    )

    try {
      await expect(nodeGraphFileSystem.writeText(join(parent, "manifest.json"), "{}"))
        .rejects.toThrow(/write target escapes the repository/i)
      await expect(exists(join(parent, "manifest.json"))).resolves.toBe(false)
    } finally {
      platform.mockRestore()
      await rm(root, { force: true, recursive: true })
    }
  })

  it("preserves the write failure when descriptor and temporary cleanup also fail", async () => {
    const root = join("scripts", "graph", `system-write-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    mocks.fileSystem.open.mockImplementation(async (...arguments_) => {
      const handle = await Reflect.apply(
        mocks.fileSystemActual.open,
        undefined,
        arguments_,
      ) as Awaited<ReturnType<typeof mocks.fileSystemActual.open>>
      if (String(arguments_[0]).includes(".graphify-manifest-")) {
        const originalClose = handle.close.bind(handle)
        Object.defineProperties(handle, {
          close: {
            configurable: true,
            value: async () => {
              await originalClose()
              throw new Error("descriptor cleanup failed")
            },
          },
          writeFile: {
            configurable: true,
            value: async () => { throw new Error("manifest write failed") },
          },
        })
      }
      return handle
    })
    mocks.fileSystem.rm.mockImplementation(async (...arguments_) => {
      if (String(arguments_[0]).includes(".graphify-manifest-")) {
        await Reflect.apply(mocks.fileSystemActual.rm, undefined, arguments_)
        throw new Error("temporary cleanup failed")
      }
      return Reflect.apply(mocks.fileSystemActual.rm, undefined, arguments_)
    })

    try {
      await expect(nodeGraphFileSystem.writeText(join(root, "manifest.json"), "{}"))
        .rejects.toThrow(/manifest write failed/i)
      await expect(exists(join(root, "manifest.json"))).resolves.toBe(false)
      await expect(mocks.fileSystemActual.readdir(root)).resolves.toEqual([])
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("rejects a configured source count above the filesystem boundary", async () => {
    const root = join("scripts", "graph", `system-count-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    const entries = Array.from({ length: 20_001 }, (_, index) => ({
      name: `source-${index}.ts`,
      isSymbolicLink: () => false,
      isDirectory: () => false,
      isFile: () => true,
    }))
    mocks.fileSystem.readdir.mockResolvedValueOnce(entries as never)

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(snapshotConfig(root)))
        .rejects.toThrow(/too many files/i)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("rejects a recursive source count above the traversal boundary", async () => {
    const files = Array.from({ length: 20_000 }, (_, index) => ({
      name: `source-${index}.ts`,
      isSymbolicLink: () => false,
      isDirectory: () => false,
      isFile: () => true,
    }))
    const rootEntries = [
      {
        name: "a-child",
        isSymbolicLink: () => false,
        isDirectory: () => true,
        isFile: () => false,
      },
      {
        name: "z.ts",
        isSymbolicLink: () => false,
        isDirectory: () => false,
        isFile: () => true,
      },
    ]
    const canonicalRoot = await mocks.fileSystemActual.realpath(process.cwd())
    const child = join(canonicalRoot, "a-child")
    const rootStats = await mocks.fileSystemActual.lstat(canonicalRoot)
    const childStats = await mocks.fileSystemActual.lstat(join(canonicalRoot, "scripts"))
    const fileStats = await mocks.fileSystemActual.lstat(join(canonicalRoot, "package.json"))
    mocks.fileSystem.readdir.mockImplementation(async (...arguments_) => {
      const path = String(arguments_[0])
      if (path === canonicalRoot) return rootEntries as never
      if (path === child) return files as never
      return Reflect.apply(mocks.fileSystemActual.readdir, undefined, arguments_)
    })
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) =>
      String(arguments_[0])
    )
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      const path = String(arguments_[0])
      if (path === canonicalRoot) return rootStats
      if (path === child) return childStats
      return fileStats
    })

    await expect(nodeGraphFileSystem.listSourceFiles(
      configuredSourceConfig(["."], ["package.json"]),
    )).rejects.toThrow(/too many files/i)
  })

  it("rejects source and compiled file size boundaries before publication", async () => {
    const largeRoot = join("scripts", "graph", `system-large-${randomUUID()}`)
    const largeSource = join(largeRoot, "source.ts")
    await mkdir(largeRoot, { recursive: true })
    await writeFile(largeSource, "")
    await truncate(largeSource, 8_388_609)
    const largeSnapshot = isolatedSnapshotFileSystem()

    try {
      await expect(largeSnapshot.fileSystem.createSourceSnapshot(snapshotConfig(largeRoot)))
        .rejects.toThrow(/source file is too large/i)
      await expect(exists(largeSnapshot.path)).resolves.toBe(false)
    } finally {
      await rm(largeRoot, { force: true, recursive: true })
    }

    const civetRoot = join("scripts", "graph", `system-compile-${randomUUID()}`)
    await mkdir(civetRoot, { recursive: true })
    await writeFile(join(civetRoot, "source.civet"), "export const value = 1")
    const config = snapshotConfig(civetRoot, [".civet"])
    const compiledSnapshot = isolatedSnapshotFileSystem()
    try {
      mocks.compileCivetSnapshot.mockRejectedValueOnce(new Error("compiler unavailable"))
      await expect(compiledSnapshot.fileSystem.createSourceSnapshot(config))
        .rejects.toThrow(/compilation failed.*compiler unavailable/i)

      mocks.compileCivetSnapshot.mockRejectedValueOnce("private compiler failure")
      await expect(compiledSnapshot.fileSystem.createSourceSnapshot(config))
        .rejects.toThrow(/compilation failed.*unknown/i)

      mocks.compileCivetSnapshot.mockResolvedValueOnce({
        path: join(civetRoot, "source.tsx"),
        content: "x".repeat(8_388_609),
      })
      await expect(compiledSnapshot.fileSystem.createSourceSnapshot(config))
        .rejects.toThrow(/compiled source file is too large/i)
      await expect(exists(compiledSnapshot.path)).resolves.toBe(false)
    } finally {
      await rm(civetRoot, { force: true, recursive: true })
    }
  })

  it("rejects a compiled corpus above the aggregate boundary", async () => {
    const root = join("scripts", "graph", `system-total-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await Promise.all(Array.from(
      { length: 17 },
      (_, index) => writeFile(join(root, `source-${index}.civet`), "export {}"),
    ))
    const atFileLimit = "x".repeat(8_388_608)
    mocks.compileCivetSnapshot.mockImplementation(async (path: string) => ({
      path: path.replace(/\.civet$/, ".tsx"),
      content: atFileLimit,
    }))
    mocks.fileSystem.writeFile.mockImplementation(async (...arguments_) =>
      String(arguments_[0]).startsWith(".graphify/source-snapshot") &&
        String(arguments_[0]).endsWith(".tsx")
        ? undefined
        : Reflect.apply(mocks.fileSystemActual.writeFile, undefined, arguments_)
    )
    const isolated = isolatedSnapshotFileSystem()

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig(root, [".civet"])))
        .rejects.toThrow(/source corpus is too large/i)
      await expect(exists(isolated.path)).resolves.toBe(false)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })
})

describe("Graphify inherited process controls", () => {
  it("forwards allowlisted values only when the parent environment defines them", () => {
    process.env.LC_ALL = ""
    expect(graphProcessEnvironment().LC_ALL).toBeUndefined()

    process.env.LC_ALL = "C"
    expect(graphProcessEnvironment().LC_ALL).toBe("C")
    expect(graphProcessEnvironment({ LC_ALL: "attacker-controlled" }).LC_ALL).toBe("C")
  })
})

describe("Graphify Node process adapter", () => {
  it("forwards bounded options through the secret-filtered environment and maps exit outcomes", async () => {
    type ExecError = Error & Readonly<{ code?: string | number }>
    let capturedOptions: Record<string, unknown> | undefined
    mocks.execFile.mockImplementationOnce((
      _command: string,
      _arguments: readonly string[],
      options: Record<string, unknown>,
      callback: (error: ExecError | null, stdout?: string | null, stderr?: string | null) => void,
    ) => {
      capturedOptions = options
      callback(null, "output", "warning")
    })

    await expect(nodeGraphProcess.run("tool", ["--check"], {
      timeoutMs: 25,
      maxOutputBytes: 128,
      environment: {
        PYTHONHASHSEED: "0",
        DATABASE_URL: "must-not-leak",
      },
    })).resolves.toEqual({
      exitCode: 0,
      stdout: "output",
      stderr: "warning",
    })
    expect(capturedOptions).toMatchObject({
      encoding: "utf8",
      maxBuffer: 128,
      timeout: 25,
      windowsHide: true,
      env: expect.objectContaining({ PYTHONHASHSEED: "0" }),
    })
    expect((capturedOptions?.["env"] as NodeJS.ProcessEnv | undefined)?.DATABASE_URL).toBeUndefined()

    mocks.execFile.mockImplementationOnce((
      _command: string,
      _arguments: readonly string[],
      _options: Record<string, unknown>,
      callback: (error: ExecError | null, stdout?: string | null, stderr?: string | null) => void,
    ) => callback(Object.assign(new Error("failed"), { code: 7 }), null, "failed"))
    await expect(nodeGraphProcess.run("tool", ["--fail"])).resolves.toEqual({
      exitCode: 7,
      stdout: "",
      stderr: "failed",
    })

    mocks.execFile.mockImplementationOnce((
      _command: string,
      _arguments: readonly string[],
      _options: Record<string, unknown>,
      callback: (error: ExecError | null, stdout?: string | null, stderr?: string | null) => void,
    ) => callback(Object.assign(new Error("missing"), { code: "ENOENT" })))
    await expect(nodeGraphProcess.run("missing", [])).resolves.toEqual({
      exitCode: 1,
      stdout: "",
      stderr: "",
    })
  })
})
