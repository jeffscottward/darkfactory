import { createHash, randomUUID } from "node:crypto"
import { access, link, lstat, mkdir, mkdtemp, readFile, rm, symlink, truncate, writeFile } from "node:fs/promises"
import { createServer } from "node:net"
import { tmpdir } from "node:os"
import { dirname, join, sep } from "node:path"

import { afterEach, describe, expect, it, vi } from "vitest"

const mocks = vi.hoisted(() => ({
  execFile: vi.fn(),
  fileSystem: {
    lstat: vi.fn(),
    mkdtemp: vi.fn(),
    open: vi.fn(),
    readdir: vi.fn(),
    realpath: vi.fn(),
    rename: vi.fn(),
    rm: vi.fn(),
    writeFile: vi.fn(),
  },
  fileSystemActual: {} as Pick<
    typeof import("node:fs/promises"),
    "lstat" | "mkdir" | "mkdtemp" | "open" | "readdir" | "realpath" | "rename" | "rm" | "writeFile"
  >,
  snapshotPrivateParents: new Set<string>(),
  compileCivetSnapshot: vi.fn(),
  resetFileSystem: (): void => undefined,
  resetCompiler: (): void => undefined,
}))
vi.mock("node:child_process", () => ({ execFile: mocks.execFile }))
vi.mock("node:fs/promises", async () => {
  const actual = await vi.importActual<typeof import("node:fs/promises")>("node:fs/promises")
  Object.assign(mocks.fileSystemActual, {
    lstat: actual.lstat,
    mkdir: actual.mkdir,
    mkdtemp: actual.mkdtemp,
    open: actual.open,
    readdir: actual.readdir,
    realpath: actual.realpath,
    rename: actual.rename,
    rm: actual.rm,
    writeFile: actual.writeFile,
  })
  const reset = (): void => {
    mocks.fileSystem.lstat.mockReset().mockImplementation(actual.lstat)
    mocks.fileSystem.mkdtemp.mockReset().mockImplementation(async (...arguments_) => {
      const parent = await Reflect.apply(actual.mkdtemp, undefined, arguments_)
      mocks.snapshotPrivateParents.add(parent)
      return parent
    })
    mocks.fileSystem.open.mockReset().mockImplementation(actual.open)
    mocks.fileSystem.readdir.mockReset().mockImplementation(actual.readdir)
    mocks.fileSystem.realpath.mockReset().mockImplementation(actual.realpath)
    mocks.fileSystem.rename.mockReset().mockImplementation(actual.rename)
    mocks.fileSystem.rm.mockReset().mockImplementation(actual.rm)
    mocks.fileSystem.writeFile.mockReset().mockImplementation(actual.writeFile)
  }
  mocks.resetFileSystem = reset
  reset()
  return {
    ...actual,
    lstat: mocks.fileSystem.lstat,
    mkdtemp: mocks.fileSystem.mkdtemp,
    open: mocks.fileSystem.open,
    readdir: mocks.fileSystem.readdir,
    realpath: mocks.fileSystem.realpath,
    rename: mocks.fileSystem.rename,
    rm: mocks.fileSystem.rm,
    writeFile: mocks.fileSystem.writeFile,
  }
})
vi.mock("./corpus.civet", async () => {
  const actual = await vi.importActual<typeof import("./corpus.civet")>("./corpus.civet")
  const reset = (): void => {
    mocks.compileCivetSnapshot.mockReset().mockImplementation(actual.compileCivetSnapshot)
  }
  mocks.resetCompiler = reset
  reset()
  return { ...actual, compileCivetSnapshot: mocks.compileCivetSnapshot }
})

import { parseGraphConfig } from "./graph.civet"
import {
  createNodeGraphFileSystem,
  graphProcessEnvironment,
  isGraphSourceExcluded,
  nodeGraphFileSystem,
  nodeGraphProcess,
} from "./system.civet"

const SENTINELS = {
  GEMINI_API_KEY: "sentinel-gemini-secret",
  GOOGLE_API_KEY: "sentinel-google-secret",
  GRAPHIFY_GEMINI_MODEL: "sentinel-provider-model",
  DATABASE_URL: "postgres://sentinel-secret",
}

const previous = Object.fromEntries(
  [...Object.keys(SENTINELS), "PYTHONHASHSEED", "GRAPHIFY_MAX_WORKERS", "LC_ALL"].map(
    (name) => [name, process.env[name]],
  ),
)

afterEach(async () => {
  const privateParents = [...mocks.snapshotPrivateParents]
  mocks.snapshotPrivateParents.clear()
  await Promise.all(privateParents.map((path) =>
    mocks.fileSystemActual.rm(path, { force: true, recursive: true })
  ))
  mocks.resetFileSystem()
  mocks.resetCompiler()
  vi.clearAllMocks()
  for (const [name, value] of Object.entries(previous)) {
    if (value === undefined) delete process.env[name]
    else process.env[name] = value
  }
})

const exists = async (path: string): Promise<boolean> => {
  try {
    await access(path)
    return true
  } catch {
    return false
  }
}
const snapshotConfig = (
  root: string,
  extensions: readonly string[] = [".ts"],
) => parseGraphConfig(JSON.stringify({
  version: 1,
  graphPath: "graphify-out/graph.json",
  manifestPath: ".graphify/manifest.json",
  source: {
    roots: [root],
    files: ["package.json"],
    extensions,
    excludes: ["node_modules"],
  },
  verificationPath: ["from", "to"],
}))
const configuredSourceConfig = (
  roots: readonly string[],
  files: readonly string[],
) => parseGraphConfig(JSON.stringify({
  version: 1,
  graphPath: "graphify-out/graph.json",
  manifestPath: ".graphify/manifest.json",
  source: {
    roots,
    files,
    extensions: [".ts"],
    excludes: ["node_modules"],
  },
  verificationPath: ["from", "to"],
}))
const isolatedSnapshotFileSystem = () => {
  const namespace = randomUUID()
  const snapshotKey =
    `.graphify/source-snapshot-${createHash("sha256").update(namespace).digest("hex")}`
  const temporaryNamePrefix =
    `darkfactory-graph-${createHash("sha256").update(snapshotKey).digest("hex").slice(0, 16)}-`
  return {
    fileSystem: createNodeGraphFileSystem(namespace),
    get privateParents(): ReadonlySet<string> {
      return new Set(
        [...mocks.snapshotPrivateParents].filter((parent) =>
          parent.includes(temporaryNamePrefix)
        ),
      )
    },
    temporaryNamePrefix,
  }
}
const expectPrivateParentsRemoved = async (
  privateParents: ReadonlySet<string>,
  expectedCount = 1,
): Promise<void> => {
  expect(privateParents.size).toBe(expectedCount)
  await expect(Promise.all([...privateParents].map(exists)))
    .resolves.toEqual(Array.from({ length: expectedCount }, () => false))
}
const captureSnapshotQuarantines = (snapshotPath: string): string[] => {
  const quarantines: string[] = []
  mocks.fileSystem.rename.mockImplementation(async (...arguments_) => {
    if (String(arguments_[0]) === snapshotPath) quarantines.push(String(arguments_[1]))
    return Reflect.apply(mocks.fileSystemActual.rename, undefined, arguments_)
  })
  return quarantines
}

describe("Graphify source snapshot", () => {
  it("creates a mode-0700 private temp snapshot and removes its private parent", async () => {
    const root = join("scripts", "graph", `system-snapshot-${randomUUID()}`)
    const source = join(root, "source.ts")
    await mkdir(root, { recursive: true })
    await writeFile(source, "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()
    let privateParent = ""

    try {
      const snapshot = await isolated.fileSystem.createSourceSnapshot(snapshotConfig(root))
      privateParent = dirname(snapshot.path)
      expect(snapshot.path).toBe(join(privateParent, "active"))
      expect(privateParent.startsWith(
        join(await mocks.fileSystemActual.realpath("/tmp"), isolated.temporaryNamePrefix),
      )).toBe(true)
      expect((await lstat(privateParent)).mode & 0o777).toBe(0o700)
      await expect(readFile(join(snapshot.path, source), "utf8")).resolves.toBe(
        "export const source = true\n",
      )
      await snapshot.cleanup()
      await expect(exists(privateParent)).resolves.toBe(false)
    } finally {
      await rm(root, { force: true, recursive: true })
      if (privateParent) await rm(privateParent, { force: true, recursive: true })
    }
  })

  it("rejects a writable non-sticky temporary base before creating a snapshot", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const canonicalTemporaryBase = await mocks.fileSystemActual.realpath("/tmp")
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      const stats = await Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
      return String(arguments_[0]) === canonicalTemporaryBase
        ? Object.assign(stats, {
            mode: (stats.mode | 0o022) & ~0o1000,
            uid: 0,
          })
        : stats
    })

    await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph")))
      .rejects.toThrow(/temporary base is unsafe/i)
    expect(mocks.fileSystem.open).not.toHaveBeenCalled()
  })

  it("rejects an attacker-owned sticky temporary base", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const canonicalTemporaryBase = await mocks.fileSystemActual.realpath("/tmp")
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      const stats = await Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
      return String(arguments_[0]) === canonicalTemporaryBase
        ? Object.assign(stats, {
            mode: stats.mode | 0o022 | 0o1000,
            uid: process.geteuid() + 1,
          })
        : stats
    })

    await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph")))
      .rejects.toThrow(/temporary base is unsafe/i)
    expect(mocks.fileSystem.open).not.toHaveBeenCalled()
  })

  it("fails closed when effective user identity is unavailable", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const descriptor = Object.getOwnPropertyDescriptor(process, "geteuid")
    Object.defineProperty(process, "geteuid", { configurable: true, value: undefined })
    try {
      await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph")))
        .rejects.toThrow(/requires effective user identity/i)
    } finally {
      if (descriptor) Object.defineProperty(process, "geteuid", descriptor)
      else Reflect.deleteProperty(process, "geteuid")
    }
  })

  it("preserves a private parent whose owner differs from the effective user", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const canonicalTemporaryBase = await mocks.fileSystemActual.realpath("/tmp")
    const expectedPrefix = join(canonicalTemporaryBase, isolated.temporaryNamePrefix)
    let privateParent = ""
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      const stats = await Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
      const path = String(arguments_[0])
      if (path.startsWith(expectedPrefix) && dirname(path) === canonicalTemporaryBase) {
        privateParent = path
        return Object.assign(stats, { uid: process.geteuid() + 1 })
      }
      return stats
    })

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph")))
        .rejects.toThrow(/private namespace changed/i)
      await expect(exists(privateParent)).resolves.toBe(true)
    } finally {
      if (privateParent) {
        await mocks.fileSystemActual.rm(privateParent, { force: true, recursive: true })
      }
    }
  })

  it("ignores a hostile TMPDIR and uses the canonical system temp base", async () => {
    const root = join("scripts", "graph", `system-snapshot-tmpdir-${randomUUID()}`)
    const source = join(root, "source.ts")
    const hostile = await mocks.fileSystemActual.mkdtemp(
      join(tmpdir(), "darkfactory-hostile-tmpdir-"),
    )
    const previousTmpdir = process.env.TMPDIR
    await mkdir(root, { recursive: true })
    await writeFile(source, "export const source = true\n")
    process.env.TMPDIR = hostile
    const isolated = isolatedSnapshotFileSystem()
    let privateParent = ""

    try {
      const snapshot = await isolated.fileSystem.createSourceSnapshot(snapshotConfig(root))
      privateParent = dirname(snapshot.path)
      const canonicalTemporaryBase = await mocks.fileSystemActual.realpath("/tmp")
      expect(privateParent.startsWith(
        join(canonicalTemporaryBase, isolated.temporaryNamePrefix),
      )).toBe(true)
      expect(privateParent.startsWith(hostile)).toBe(false)
      expect(mocks.fileSystem.realpath).toHaveBeenCalledWith("/tmp")
      await snapshot.cleanup()
    } finally {
      if (previousTmpdir === undefined) delete process.env.TMPDIR
      else process.env.TMPDIR = previousTmpdir
      await rm(root, { force: true, recursive: true })
      await mocks.fileSystemActual.rm(hostile, { force: true, recursive: true })
      if (privateParent) {
        await mocks.fileSystemActual.rm(privateParent, { force: true, recursive: true })
      }
    }
  })

  it("rejects a writable non-sticky canonical temp ancestor", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const canonicalTemporaryBase = await mocks.fileSystemActual.realpath("/tmp")
    const unsafeAncestor = dirname(canonicalTemporaryBase)
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      const stats = await Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
      return String(arguments_[0]) === unsafeAncestor
        ? Object.assign(stats, {
            mode: (stats.mode | 0o022) & ~0o1000,
            uid: 0,
          })
        : stats
    })

    await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph")))
      .rejects.toThrow(/temporary base is unsafe/i)
    expect(mocks.fileSystem.open).not.toHaveBeenCalled()
    expect(mocks.fileSystem.mkdtemp).not.toHaveBeenCalled()
  })

  it("preserves a private namespace when the pinned temp base path is replaced", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const canonicalTemporaryBase = await mocks.fileSystemActual.realpath("/tmp")
    let baseInspections = 0
    let baseClosed = false
    let privateParent = ""
    mocks.fileSystem.lstat.mockImplementation(async (...arguments_) => {
      const stats = await Reflect.apply(mocks.fileSystemActual.lstat, undefined, arguments_)
      if (String(arguments_[0]) !== canonicalTemporaryBase) return stats
      baseInspections += 1
      return baseInspections >= 4
        ? Object.assign(stats, { ino: stats.ino + 1 })
        : stats
    })
    mocks.fileSystem.mkdtemp.mockImplementation(async (...arguments_) => {
      privateParent = await Reflect.apply(
        mocks.fileSystemActual.mkdtemp,
        undefined,
        arguments_,
      )
      return privateParent
    })
    mocks.fileSystem.open.mockImplementation(async (...arguments_) => {
      const handle = await Reflect.apply(mocks.fileSystemActual.open, undefined, arguments_)
      if (String(arguments_[0]) === canonicalTemporaryBase) {
        const close = handle.close.bind(handle)
        vi.spyOn(handle, "close").mockImplementation(async () => {
          baseClosed = true
          await close()
        })
      }
      return handle
    })

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph")))
        .rejects.toThrow(/temporary base changed/i)
      await expect(exists(privateParent)).resolves.toBe(true)
      expect(baseClosed).toBe(true)
    } finally {
      if (privateParent) {
        await mocks.fileSystemActual.rm(privateParent, { force: true, recursive: true })
      }
    }
  })

  it("closes the pinned temp-base handle when marker creation fails", async () => {
    const isolated = isolatedSnapshotFileSystem()
    const canonicalTemporaryBase = await mocks.fileSystemActual.realpath("/tmp")
    const failure = new Error("owner marker open failed")
    let baseClosed = false
    let privateParent = ""
    mocks.fileSystem.mkdtemp.mockImplementation(async (...arguments_) => {
      privateParent = await Reflect.apply(
        mocks.fileSystemActual.mkdtemp,
        undefined,
        arguments_,
      )
      return privateParent
    })
    mocks.fileSystem.open.mockImplementation(async (...arguments_) => {
      const path = String(arguments_[0])
      if (path.endsWith(`${sep}active${sep}.owner`)) throw failure
      const handle = await Reflect.apply(mocks.fileSystemActual.open, undefined, arguments_)
      if (path === canonicalTemporaryBase) {
        const close = handle.close.bind(handle)
        vi.spyOn(handle, "close").mockImplementation(async () => {
          baseClosed = true
          await close()
        })
      }
      return handle
    })

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(snapshotConfig("scripts/graph")))
        .rejects.toBe(failure)
      expect(baseClosed).toBe(true)
      await expect(exists(privateParent)).resolves.toBe(false)
    } finally {
      if (privateParent) {
        await mocks.fileSystemActual.rm(privateParent, { force: true, recursive: true })
      }
    }
  })

  it("rejects a symlink in an ancestor of a configured source root", async () => {
    const root = join("scripts", "graph", `system-root-symlink-${randomUUID()}`)
    const outside = await mkdtemp(join(tmpdir(), "darkfactory-graph-outside-"))
    const configuredRoot = join(root, "escape", "nested")
    const absoluteRoot = join(process.cwd(), configuredRoot)
    await mkdir(root, { recursive: true })
    await mkdir(join(outside, "nested"), { recursive: true })
    await writeFile(join(outside, "nested", "outside.ts"), "outside-root-sentinel")
    await symlink(outside, join(root, "escape"))
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [configuredRoot],
        files: ["package.json"],
        extensions: [".ts"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(config))
        .rejects.toThrow(/symbolic link|symlink/i)
      expect(mocks.fileSystem.readdir.mock.calls.some(
        ([path]) => String(path) === absoluteRoot,
      )).toBe(false)
    } finally {
      await rm(root, { force: true, recursive: true })
      await rm(outside, { force: true, recursive: true })
    }
  })

  it("rejects a nested-parent source symlink without reading or snapshotting outside bytes", async () => {
    const root = join("scripts", "graph", `system-file-symlink-${randomUUID()}`)
    const safeRoot = join(root, "safe")
    const outside = await mkdtemp(join(tmpdir(), "darkfactory-graph-outside-"))
    const sentinel = "outside-secret-sentinel"
    const configuredSource = join(root, "escape", "nested", "secret")
    const absoluteSource = join(process.cwd(), configuredSource)
    await mkdir(safeRoot, { recursive: true })
    await mkdir(join(outside, "nested"), { recursive: true })
    await writeFile(join(outside, "nested", "secret"), sentinel)
    await symlink(outside, join(root, "escape"))
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [safeRoot],
        files: [configuredSource],
        extensions: [".ts"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))
    const isolated = isolatedSnapshotFileSystem()

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(config))
        .rejects.toThrow(/symbolic link|symlink/i)
      expect(mocks.fileSystem.open.mock.calls.some(
        (call) => String(call[0]) === absoluteSource,
      )).toBe(false)
      expect(mocks.fileSystem.writeFile.mock.calls.some(
        (call) => String(call[0]).includes(isolated.temporaryNamePrefix) && String(call[1]).includes(sentinel),
      )).toBe(false)
      await expectPrivateParentsRemoved(isolated.privateParents)
      await expect(readFile(join(outside, "nested", "secret"), "utf8")).resolves.toBe(sentinel)
    } finally {
      await rm(root, { force: true, recursive: true })
      await rm(outside, { force: true, recursive: true })
    }
  })

  it("rejects a source swapped before open without reading the replacement bytes", async () => {
    const root = join("scripts", "graph", `system-open-race-${randomUUID()}`)
    const safeRoot = join(root, "safe")
    const source = join(root, "source.ts")
    const absoluteSource = join(process.cwd(), source)
    const outside = await mkdtemp(join(tmpdir(), "darkfactory-graph-outside-"))
    const outsideSource = join(outside, "secret")
    await mkdir(safeRoot, { recursive: true })
    await writeFile(source, "export const source = true\n")
    await writeFile(outsideSource, "outside-replacement-sentinel")
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [safeRoot],
        files: [source],
        extensions: [".ts"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))
    const isolated = isolatedSnapshotFileSystem()
    const replacement = await mocks.fileSystemActual.open(outsideSource, "r")
    const replacementRead = vi.spyOn(replacement, "read")
    mocks.fileSystem.open.mockImplementation(async (...arguments_) =>
      String(arguments_[0]) === absoluteSource
        ? replacement
        : Reflect.apply(mocks.fileSystemActual.open, undefined, arguments_)
    )

    try {
      await expect(isolated.fileSystem.createSourceSnapshot(config))
        .rejects.toThrow(/source identity changed/i)
      expect(replacementRead).not.toHaveBeenCalled()
      await expectPrivateParentsRemoved(isolated.privateParents)
    } finally {
      await replacement.close().catch(() => undefined)
      await rm(root, { force: true, recursive: true })
      await rm(outside, { force: true, recursive: true })
    }
  })

  it("rejects a configured source whose canonical file path escapes the repository", async () => {
    const root = join("scripts", "graph", `system-canonical-${randomUUID()}`)
    const safeRoot = join(root, "safe")
    const source = join(root, "source.ts")
    const absoluteSource = join(process.cwd(), source)
    await mkdir(safeRoot, { recursive: true })
    await writeFile(source, "export const source = true\n")
    const config = parseGraphConfig(JSON.stringify({
      version: 1,
      graphPath: "graphify-out/graph.json",
      manifestPath: ".graphify/manifest.json",
      source: {
        roots: [safeRoot],
        files: [source],
        extensions: [".ts"],
        excludes: ["node_modules"],
      },
      verificationPath: ["from", "to"],
    }))
    mocks.fileSystem.realpath.mockImplementation(async (...arguments_) =>
      String(arguments_[0]) === absoluteSource
        ? join(process.cwd(), "..")
        : Reflect.apply(mocks.fileSystemActual.realpath, undefined, arguments_)
    )

    try {
      await expect(nodeGraphFileSystem.listSourceFiles(config))
        .rejects.toThrow(/source path escapes the repository/i)
      expect(mocks.fileSystem.open.mock.calls.some(
        ([path]) => String(path) === absoluteSource,
      )).toBe(false)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("isolates concurrent snapshots in unique private temp parents", async () => {
    const root = join("scripts", "graph", `system-snapshot-concurrent-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()
    const snapshots = await Promise.all([
      isolated.fileSystem.createSourceSnapshot(snapshotConfig(root)),
      isolated.fileSystem.createSourceSnapshot(snapshotConfig(root)),
    ])
    const parents = snapshots.map((snapshot) => dirname(snapshot.path))

    try {
      expect(snapshots[0]?.path).not.toBe(snapshots[1]?.path)
      expect(parents[0]).not.toBe(parents[1])
      const expectedPrefix = join(
        await mocks.fileSystemActual.realpath("/tmp"),
        isolated.temporaryNamePrefix,
      )
      expect(parents.every((path) => path.startsWith(expectedPrefix))).toBe(true)
      await expect(Promise.all(parents.map(async (path) =>
        (await lstat(path)).mode & 0o777
      ))).resolves.toEqual([0o700, 0o700])
      await Promise.all(snapshots.map((snapshot) => snapshot.cleanup()))
      await expect(Promise.all(parents.map(exists))).resolves.toEqual([false, false])
    } finally {
      await rm(root, { force: true, recursive: true })
      await Promise.all(parents.map((path) => rm(path, { force: true, recursive: true })))
    }
  })

  it("refuses cleanup after a same-length ownership token change", async () => {
    const root = join("scripts", "graph", `system-snapshot-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const isolated = isolatedSnapshotFileSystem()
    const snapshot = await isolated.fileSystem.createSourceSnapshot(snapshotConfig(root))
    const privateParent = dirname(snapshot.path)
    const quarantines = captureSnapshotQuarantines(snapshot.path)
    await writeFile(join(snapshot.path, ".owner"), randomUUID())

    try {
      await expect(snapshot.cleanup()).rejects.toThrow(/snapshot ownership changed/i)
      expect(quarantines).toHaveLength(1)
      const quarantine = quarantines[0] as string
      await expect(exists(join(quarantine, root, "source.ts"))).resolves.toBe(true)
      await expect(snapshot.cleanup()).rejects.toThrow(/cleanup already attempted/i)
    } finally {
