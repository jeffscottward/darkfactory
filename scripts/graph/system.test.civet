import { randomUUID } from "node:crypto"
import { access, mkdir, readFile, rm, symlink, writeFile } from "node:fs/promises"
import { join } from "node:path"

import { afterEach, describe, expect, it } from "vitest"

import { parseGraphConfig } from "./graph.civet"
import {
  graphProcessEnvironment,
  isGraphSourceExcluded,
  nodeGraphFileSystem,
} from "./system.civet"

const SENTINELS = {
  GEMINI_API_KEY: "sentinel-gemini-secret",
  GOOGLE_API_KEY: "sentinel-google-secret",
  GRAPHIFY_GEMINI_MODEL: "sentinel-provider-model",
  DATABASE_URL: "postgres://sentinel-secret",
}

const previous = Object.fromEntries(
  [...Object.keys(SENTINELS), "PYTHONHASHSEED", "GRAPHIFY_MAX_WORKERS"].map(
    (name) => [name, process.env[name]],
  ),
)

afterEach(() => {
  for (const [name, value] of Object.entries(previous)) {
    if (value === undefined) delete process.env[name]
    else process.env[name] = value
  }
})

const exists = async (path: string): Promise<boolean> => {
  try {
    await access(path)
    return true
  } catch {
    return false
  }
}
const snapshotConfig = (root: string) => parseGraphConfig(JSON.stringify({
  version: 1,
  graphPath: "graphify-out/graph.json",
  manifestPath: ".graphify/manifest.json",
  source: {
    roots: [root],
    files: ["package.json"],
    extensions: [".ts"],
    excludes: ["node_modules"],
  },
  verificationPath: ["from", "to"],
}))

describe("Graphify source snapshot", () => {
  it("uses a deterministic repo-relative path and removes its owned snapshot", async () => {
    const root = join("scripts", "graph", `system-snapshot-${randomUUID()}`)
    const source = join(root, "source.ts")
    await mkdir(root, { recursive: true })
    await writeFile(source, "export const source = true\n")

    try {
      const snapshot = await nodeGraphFileSystem.createSourceSnapshot(snapshotConfig(root))
      expect(snapshot.path).toBe(".graphify/source-snapshot")
      await expect(readFile(join(snapshot.path, source), "utf8")).resolves.toBe(
        "export const source = true\n",
      )
      await snapshot.cleanup()
      await expect(exists(snapshot.path)).resolves.toBe(false)
    } finally {
      await rm(root, { force: true, recursive: true })
      await rm(".graphify/source-snapshot", { force: true, recursive: true })
    }
  })

  it("refuses a snapshot path collision without deleting existing content", async () => {
    const snapshotRoot = ".graphify/source-snapshot"
    const preserved = join(snapshotRoot, "preserved.txt")
    await mkdir(snapshotRoot, { recursive: true })
    await writeFile(preserved, "preserve")

    try {
      const result = await nodeGraphFileSystem.createSourceSnapshot(snapshotConfig("scripts/graph"))
        .then((snapshot) => snapshot, (error: unknown) => error)
      if (!(result instanceof Error)) await result.cleanup()

      expect(result).toBeInstanceOf(Error)
      await expect(readFile(preserved, "utf8")).resolves.toBe("preserve")
    } finally {
      await rm(snapshotRoot, { force: true, recursive: true })
    }
  })

  it("refuses cleanup after its ownership marker changes and preserves the snapshot", async () => {
    const root = join("scripts", "graph", `system-snapshot-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "source.ts"), "export const source = true\n")
    const snapshot = await nodeGraphFileSystem.createSourceSnapshot(snapshotConfig(root))
    await writeFile(join(snapshot.path, ".owner"), "different-owner")

    try {
      await expect(snapshot.cleanup()).rejects.toThrow(/owner|ownership/i)
      await expect(exists(join(snapshot.path, root, "source.ts"))).resolves.toBe(true)
    } finally {
      await rm(root, { force: true, recursive: true })
      await rm(snapshot.path, { force: true, recursive: true })
    }
  })
})


describe("Graphify generated output reset", () => {
  it("removes only known generated entries and preserves unrelated files", async () => {
    const root = join(".graphify", `system-reset-${randomUUID()}`)
    await mkdir(join(root, "cache"), { recursive: true })
    await Promise.all([
      writeFile(join(root, "graph.json"), "{}"),
      writeFile(join(root, "cache", "stat-index.json"), "{}"),
      writeFile(join(root, ".graphify_analysis.json"), "{}"),
      writeFile(join(root, "manifest.json"), "{}"),
      writeFile(join(root, "keep.txt"), "keep"),
    ])

    try {
      await nodeGraphFileSystem.resetGraphOutput(join(root, "graph.json"))

      await expect(exists(join(root, "graph.json"))).resolves.toBe(false)
      await expect(exists(join(root, "cache"))).resolves.toBe(false)
      await expect(exists(join(root, ".graphify_analysis.json"))).resolves.toBe(false)
      await expect(exists(join(root, "manifest.json"))).resolves.toBe(false)
      await expect(exists(join(root, "keep.txt"))).resolves.toBe(true)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })

  it("rejects generated output symlinks without deleting their target", async () => {
    const root = join(".graphify", `system-reset-${randomUUID()}`)
    await mkdir(root, { recursive: true })
    await writeFile(join(root, "target.txt"), "keep")
    await symlink("target.txt", join(root, "manifest.json"))

    try {
      await expect(
        nodeGraphFileSystem.resetGraphOutput(join(root, "graph.json")),
      ).rejects.toThrow(/unsafe generated path/i)
      await expect(exists(join(root, "target.txt"))).resolves.toBe(true)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })
})

describe("Graphify configured source corpus", () => {
  it("distinguishes root-generated output from authored nested directories", () => {
    const excludes = ["coverage/**", "node_modules", "*.civet.d.ts"]

    expect(isGraphSourceExcluded("coverage/coverage-summary.json", excludes)).toBe(true)
    expect(isGraphSourceExcluded("scripts/coverage/coverage.civet", excludes)).toBe(false)
    expect(isGraphSourceExcluded("packages/api/node_modules/provider/index.js", excludes)).toBe(true)
    expect(isGraphSourceExcluded("packages/api/src/index.civet.d.ts", excludes)).toBe(true)
  })

  it("keeps authored dotfiles but excludes nested framework-generated .next output", async () => {
    const root = join("scripts", "graph", `system-corpus-${randomUUID()}`)
    const generated = join(root, ".next", "types", "routes.d.ts")
    const authored = join(root, ".authored", "source.ts")
    await mkdir(join(root, ".next", "types"), { recursive: true })
    await mkdir(join(root, ".authored"), { recursive: true })
    await Promise.all([
      writeFile(generated, "export type GeneratedRoute = string\n"),
      writeFile(authored, "export const authored = true\n"),
    ])

    try {
      const config = parseGraphConfig(await readFile(".graphify/config.json", "utf8"))
      const sources = await nodeGraphFileSystem.listSourceFiles(config)

      expect(config.source.files).toEqual([
        ".env.schema",
        "package.json",
        "turbo.json",
        "tsconfig.base.json",
        "tsconfig.json",
      ])
      expect(sources).toContain(authored)
      expect(sources).not.toContain(generated)
    } finally {
      await rm(root, { force: true, recursive: true })
    }
  })
})

describe("Graphify process environment", () => {
  it("never forwards provider or application secrets to extract", () => {
    Object.assign(process.env, SENTINELS)
    process.env.PYTHONHASHSEED = "inherited-nondeterministic-value"
    process.env.GRAPHIFY_MAX_WORKERS = "inherited-nondeterministic-value"

    const environment = graphProcessEnvironment({})

    for (const name of Object.keys(SENTINELS)) expect(environment[name]).toBeUndefined()
    expect(environment.PYTHONHASHSEED).toBeUndefined()
    expect(environment.GRAPHIFY_MAX_WORKERS).toBeUndefined()
  })

  it("never forwards provider or application secrets to path and keeps explicit safe additions", () => {
    Object.assign(process.env, SENTINELS)

    const environment = graphProcessEnvironment({
      GRAPHIFY_QUERY_LOG_DISABLE: "1",
      PYTHONHASHSEED: "0",
      GRAPHIFY_MAX_WORKERS: "1",
      GEMINI_API_KEY: "explicit-sentinel-secret",
      CUSTOM_SECRET: "explicit-custom-secret",
    })

    for (const name of Object.keys(SENTINELS)) expect(environment[name]).toBeUndefined()
    expect(environment.GRAPHIFY_QUERY_LOG_DISABLE).toBe("1")
    expect(environment.PYTHONHASHSEED).toBe("0")
    expect(environment.GRAPHIFY_MAX_WORKERS).toBe("1")
    expect(graphProcessEnvironment({ PYTHONHASHSEED: "1" }).PYTHONHASHSEED).toBeUndefined()
    expect(graphProcessEnvironment({ GRAPHIFY_MAX_WORKERS: "2" }).GRAPHIFY_MAX_WORKERS).toBeUndefined()
    expect(environment.CUSTOM_SECRET).toBeUndefined()
  })
})
