# DarkFactory v0.1 public environment contract.
# Secret values belong in ignored environment files or a secret manager.

# --- Application
# @type=enum(development, test, production)
APP_ENV=development
# @type=url(noTrailingSlash=true, matches=/^https:\/\/.*[^\/]$/)
APP_URL=https://darkfactory.localhost
# @type=string(minLength=1)
APP_NAME=DarkFactory

# --- Database
# @type=enum(planetscale, postgres)
DATABASE_PROVIDER=planetscale
# @required @sensitive @type=url
DATABASE_URL=

# --- Authentication
# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=
# Independent key for HMAC contact abuse buckets. Do not reuse authentication secrets.
# @required @sensitive @type=string(minLength=32)
CONTACT_THROTTLE_SECRET=
# @type=url(noTrailingSlash=true, matches=/^https:\/\/.*[^\/]$/)
BETTER_AUTH_URL=https://darkfactory.localhost

# --- AI provider (disabled until both provider values are configured)
# @type=enum(groq)
AI_PROVIDER=groq
# @sensitive @type=string
GROQ_API_KEY=
# @type=string
GROQ_MODEL=

# --- Email provider (preview is the safe local transport)
# @type=enum(resend)
EMAIL_PROVIDER=resend
# @type=enum(preview, resend)
EMAIL_TRANSPORT=preview
# @sensitive @type=string
RESEND_API_KEY=
# @type=string(minLength=1)
EMAIL_FROM=DarkFactory <noreply@domain.test>
# Optional recipient for public contact submissions. Empty disables delivery.
# @type=string(format=email,maxLength=254)
CONTACT_EMAIL_TO=

# --- Analytics provider (disabled until key and host are configured)
# @type=enum(posthog)
ANALYTICS_PROVIDER=posthog
# @sensitive @type=string
POSTHOG_KEY=
# @type=url
POSTHOG_HOST=

# --- Telemetry (instrumentation is core; remote export is optional)
# @type=boolean
OTEL_ENABLED=true
# @type=string(minLength=1)
OTEL_SERVICE_NAME=darkfactory-web
# @sensitive @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Disabled optional capability references
# @type=boolean
STORAGE_ENABLED=false
# @type=enum(r2)
STORAGE_PROVIDER=r2
# @type=string
R2_ACCOUNT_ID=
# @sensitive @type=string
R2_ACCESS_KEY_ID=
# @sensitive @type=string
R2_SECRET_ACCESS_KEY=
# @type=string
R2_BUCKET=

# @type=boolean
DOCS_ENABLED=false
# @type=boolean
DOCS_PUBLIC=false
# @type=boolean
JOBS_ENABLED=false
# @type=enum(celery)
JOBS_ENGINE=celery
# @type=boolean
FLOWER_ENABLED=false
# @type=boolean
UPTIME_KUMA_ENABLED=false
# @type=boolean
ERROR_TRACKING_ENABLED=false
# @type=enum(glitchtip)
ERROR_TRACKING_PROVIDER=glitchtip
# @sensitive @type=url
ERROR_TRACKING_DSN=
# @type=boolean
MEMORI_ENABLED=false
