# DarkFactory v0.1 public environment contract.
# Secret values belong in ignored environment files or a secret manager.

# --- Application
# @sensitive=false @type=enum(development, test, production)
APP_ENV=development
# @sensitive=false @type=url(noTrailingSlash=true, matches=/^https:\/\/.*[^\/]$/)
APP_URL=https://darkfactory.localhost
# @sensitive=false @type=string(minLength=1)
APP_NAME=DarkFactory

# --- Database
# @sensitive=false @type=enum(planetscale, postgres)
DATABASE_PROVIDER=planetscale
# Production web requires a provider-managed pool: current PlanetScale *.pg.psdb.cloud URLs use PgBouncer port 6432 and sslmode=verify-full. Direct port 5432 is rejected. Trusted Hyperdrive request bindings declare their platform separately.
# @required @sensitive @type=url
DATABASE_URL=

# --- Authentication
# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=
# Independent key for HMAC contact abuse buckets. Do not reuse authentication secrets.
# @required @sensitive @type=string(minLength=32)
CONTACT_THROTTLE_SECRET=
# @sensitive=false @type=url(noTrailingSlash=true, matches=/^https:\/\/.*[^\/]$/)
BETTER_AUTH_URL=https://darkfactory.localhost
# Exact owner-to-repository grants for the operator pilot: ownerId=repositoryId pairs separated by commas.
# Required by operator API and worker composition; no wildcards are accepted.
# @sensitive @type=string
# @optional
WORKFLOW_REPOSITORY_GRANTS=
# Approved Docker workflow verification contract. Free-form commands are not accepted.
# @sensitive=false @type=enum(darkfactory-verify-core-v2)
WORKFLOW_VERIFIER_ID=darkfactory-verify-core-v2
#
# Content digest printed by `bun run verifier:image:setup`; production workers require it.
# @sensitive=false @type=string(minLength=71,maxLength=71)
# @optional
WORKFLOW_VERIFIER_IMAGE_DIGEST=

# --- AI provider (disabled until both provider values are configured)
# @sensitive=false @type=enum(groq)
AI_PROVIDER=groq
# @sensitive @type=string
# @optional
GROQ_API_KEY=
# @type=string
# @optional
GROQ_MODEL=

# --- Email provider (preview is the safe local transport)
# @sensitive=false @type=enum(resend, disabled)
EMAIL_PROVIDER=resend
# @sensitive=false @type=enum(preview, resend, disabled)
EMAIL_TRANSPORT=preview
# @sensitive @type=string
# @optional
RESEND_API_KEY=
# @sensitive=false @type=string(minLength=1)
EMAIL_FROM=DarkFactory <noreply@domain.test>
# Optional recipient for public contact submissions. Empty disables delivery.
# @type=string(format=email,maxLength=254)
# @optional
CONTACT_EMAIL_TO=

# --- Analytics provider (disabled until key and host are configured)
# @sensitive=false @type=enum(posthog)
ANALYTICS_PROVIDER=posthog
# @sensitive @type=string
# @optional
POSTHOG_KEY=
# @type=url
# @optional
POSTHOG_HOST=

# --- Telemetry (instrumentation is core; remote export is optional)
# @type=boolean
OTEL_ENABLED=true
# @sensitive=false @type=string(minLength=1)
OTEL_SERVICE_NAME=darkfactory-web
# @sensitive @type=url
# @optional
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Disabled optional capability references
# @type=boolean
STORAGE_ENABLED=false
# @sensitive=false @type=enum(r2)
STORAGE_PROVIDER=r2
# @type=string
# @optional
R2_ACCOUNT_ID=
# @sensitive @type=string
# @optional
R2_ACCESS_KEY_ID=
# @sensitive @type=string
# @optional
R2_SECRET_ACCESS_KEY=
# @type=string
# @optional
R2_BUCKET=

# @type=boolean
DOCS_ENABLED=false
# @type=boolean
DOCS_PUBLIC=false
# @type=boolean
JOBS_ENABLED=false
# @sensitive=false @type=enum(celery)
JOBS_ENGINE=celery
# @sensitive=false @type=string(minLength=1)
# @optional
WORKFLOW_REPOSITORIES_ROOT=
# @sensitive=false @type=string(minLength=1,maxLength=128)
# @optional
WORKFLOW_LEASE_OWNER=
# @sensitive=false @type=string
# @optional
WORKFLOW_POLL_INTERVAL_MS=
# @sensitive=false @type=string
# @optional
WORKFLOW_SHUTDOWN_TIMEOUT_MS=
# @type=boolean
FLOWER_ENABLED=false
# @type=boolean
UPTIME_KUMA_ENABLED=false
# @type=boolean
ERROR_TRACKING_ENABLED=false
# @sensitive=false @type=enum(glitchtip)
ERROR_TRACKING_PROVIDER=glitchtip
# @sensitive @type=url
# @optional
ERROR_TRACKING_DSN=
# @type=boolean
MEMORI_ENABLED=false
