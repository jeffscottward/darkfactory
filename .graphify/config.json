{
  "version": 1,
  "graphPath": "graphify-out/graph.json",
  "manifestPath": ".graphify/manifest.json",
  "source": {
    "roots": ["."],
    "files": [
      ".env.schema",
      "package.json",
      "turbo.json",
      "tsconfig.base.json",
      "tsconfig.json"
    ],
    "extensions": [
      ".bash",
      ".c",
      ".cc",
      ".civet",
      ".cjs",
      ".cpp",
      ".cs",
      ".css",
      ".cts",
      ".fs",
      ".fsx",
      ".go",
      ".gql",
      ".graphql",
      ".h",
      ".hpp",
      ".html",
      ".java",
      ".js",
      ".json",
      ".jsonc",
      ".jsx",
      ".kt",
      ".kts",
      ".mjs",
      ".mts",
      ".php",
      ".proto",
      ".py",
      ".pyi",
      ".rb",
      ".rs",
      ".sh",
      ".sql",
      ".swift",
      ".toml",
      ".ts",
      ".tsx",
      ".zsh"
    ],
    "excludes": [
      ".alchemy",
      ".certs",
      ".drizzle",
      ".git",
      ".graphify",
      ".next",
      ".turbo",
      ".vinext",
      ".wrangler",
      "build",
      "coverage/**",
      "dist",
      "graphify-out",
      "node_modules",
      "playwright-report",
      "test-results",
      "*.civet.d.ts"
    ]
  },
  "verificationPath": [
    "handleOrpcRequest",
    "appContract",
    "createFeatureItemService",
    "FeatureItemRepository",
    "featureItems",
    "createFeatureItemRepository"
  ]
}
