{
  "name": "@darkfactory/root",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, Postgres-first, AI-native application foundation.",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:https": "civet scripts/dev.civet start",
    "dev:status": "civet scripts/dev.civet status",
    "dev:logs": "civet scripts/dev.civet logs",
    "dev:stop": "civet scripts/dev.civet stop",
    "dev:trust": "civet scripts/dev.civet trust",
    "certs:install": "civet scripts/dev.civet certs-install",
    "certs:generate": "civet scripts/dev.civet certs-generate",
    "build": "turbo run build",
    "types": "turbo run types",
    "types:check": "civet scripts/type-exports.civet",
    "typecheck": "corepack pnpm run types && corepack pnpm run types:check && tsc --project tsconfig.json && corepack pnpm run typecheck:database-integration && turbo run typecheck",
    "typecheck:database-integration": "civet --config civet.integration.json --typecheck",
    "lint": "biome lint . && corepack pnpm run lint:markdown",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:staged": "biome format",
    "lint:staged": "biome lint",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:markdown:staged": "markdownlint-cli2",
    "auth:schema:check": "corepack pnpm --filter @darkfactory/auth run auth:schema:check",
    "api:openapi:generate": "corepack pnpm --filter @darkfactory/api run openapi:generate",
    "api:openapi:check": "corepack pnpm --filter @darkfactory/api run openapi:check",
    "test": "corepack pnpm run test:unit && corepack pnpm run test:integration && corepack pnpm run test:e2e",
    "test:unit": "turbo run test:unit --concurrency=50%",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:e2e": "playwright test",
    "verify": "corepack pnpm run format:check && corepack pnpm run lint && corepack pnpm run auth:schema:check && corepack pnpm run api:openapi:check && corepack pnpm run typecheck && corepack pnpm run build && corepack pnpm run test:unit && corepack pnpm run test:integration && corepack pnpm run test:e2e",
    "ci": "corepack pnpm run format:check && corepack pnpm run lint && corepack pnpm run auth:schema:check && corepack pnpm run api:openapi:check && corepack pnpm run typecheck && corepack pnpm run build && corepack pnpm run test:unit && corepack pnpm run test:integration && corepack pnpm run test:e2e",
    "doctor": "civet scripts/doctor.civet",
    "graph:build": "civet scripts/graph.civet build",
    "graph:update": "civet scripts/graph.civet update",
    "graph:check": "civet scripts/graph.civet check",
    "graph:verify": "civet scripts/graph.civet verify",
    "generate:feature": "civet scripts/generate-feature.civet",
    "deploy:web": "corepack pnpm --filter @darkfactory/web exec vinext-cloudflare deploy",
    "deploy:web:check": "corepack pnpm --filter @darkfactory/web exec vinext-cloudflare deploy --dry-run",
    "deploy:web:preview": "corepack pnpm --filter @darkfactory/web exec vinext-cloudflare deploy --preview",
    "prepare": "husky",
    "db:generate": "corepack pnpm --filter @darkfactory/db run db:generate",
    "db:check": "corepack pnpm --filter @darkfactory/db run db:check",
    "db:migrate": "corepack pnpm --filter @darkfactory/db run db:migrate",
    "db:seed": "civet scripts/database/index.civet seed",
    "db:reset": "civet scripts/database/index.civet reset",
    "db:test:up": "docker compose -f infra/docker/postgres.compose.yml up --detach --wait",
    "db:test:down": "docker compose -f infra/docker/postgres.compose.yml down --volumes --remove-orphans"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@danielx/civet": "catalog:",
    "@darkfactory/ai": "workspace:*",
    "@darkfactory/analytics": "workspace:*",
    "@darkfactory/api": "workspace:*",
    "@darkfactory/auth": "workspace:*",
    "@darkfactory/config": "workspace:*",
    "@darkfactory/db": "workspace:*",
    "@darkfactory/email": "workspace:*",
    "@darkfactory/jobs": "workspace:*",
    "@darkfactory/observability": "workspace:*",
    "@darkfactory/shared": "workspace:*",
    "@darkfactory/state": "workspace:*",
    "@darkfactory/storage": "workspace:*",
    "@darkfactory/testkit": "workspace:*",
    "@darkfactory/ui": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint-cli2": "catalog:",
    "portless": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
