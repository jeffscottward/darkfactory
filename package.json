{
  "name": "@darkfactory/root",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, Postgres-first, AI-native application foundation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "homepage": "https://github.com/jeffscottward/darkfactory#readme",
  "bugs": {
    "url": "https://github.com/jeffscottward/darkfactory/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:https": "civet scripts/dev.civet start",
    "dev:status": "civet scripts/dev.civet status",
    "dev:logs": "civet scripts/dev.civet logs",
    "dev:stop": "civet scripts/dev.civet stop",
    "dev:trust": "civet scripts/dev.civet trust",
    "dev:bindings": "civet scripts/dev-bindings.civet",
    "certs:install": "civet scripts/dev.civet certs-install",
    "certs:generate": "civet scripts/dev.civet certs-generate",
    "build": "turbo run build",
    "types": "corepack pnpm --filter @darkfactory/api run types && corepack pnpm --filter @darkfactory/email run types && turbo run types --concurrency=1",
    "types:check": "civet scripts/type-exports.civet",
    "typecheck": "corepack pnpm run types && corepack pnpm run types:check && tsc --project tsconfig.json && civet --config scripts/e2e/civet.typecheck.json --typecheck && corepack pnpm run typecheck:database-integration && turbo run typecheck",
    "typecheck:database-integration": "civet --config civet.integration.json --typecheck",
    "lint": "biome lint . && corepack pnpm run lint:markdown",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:staged": "biome format",
    "lint:staged": "biome lint",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:markdown:staged": "markdownlint-cli2",
    "auth:schema:check": "corepack pnpm --filter @darkfactory/auth run auth:schema:check",
    "api:openapi:generate": "corepack pnpm --filter @darkfactory/api run openapi:generate",
    "api:openapi:check": "corepack pnpm --filter @darkfactory/api run openapi:check",
    "test": "corepack pnpm run test:unit && corepack pnpm run test:contract && corepack pnpm run test:operations && corepack pnpm run test:integration && corepack pnpm run test:e2e && corepack pnpm run test:a11y",
    "test:unit": "turbo run test:unit --concurrency=50%",
    "test:contract": "vitest run --config vitest.config.ts --project contract",
    "test:operations": "vitest run --config vitest.config.ts --project operations --project e2e-helpers --maxWorkers=1 --no-file-parallelism",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:e2e": "civet scripts/e2e/run.civet e2e",
    "test:coverage": "corepack pnpm run types && vitest run --config vitest.config.ts --project unit --project contract --project operations --coverage --maxWorkers=1 --no-file-parallelism",
    "test:a11y": "civet scripts/e2e/run.civet a11y",
    "verify:core": "corepack pnpm run format:check && corepack pnpm run lint && corepack pnpm run auth:schema:check && corepack pnpm run openapi:check && corepack pnpm run typecheck && corepack pnpm run build && corepack pnpm run test:unit && corepack pnpm run test:contract && corepack pnpm run test:operations && corepack pnpm run docs:check",
    "verify:integration": "corepack pnpm run types && corepack pnpm run test:integration",
    "verify:graph": "corepack pnpm run graph:check && corepack pnpm run graph:verify",
    "verify:browser": "corepack pnpm run test:e2e && corepack pnpm run test:a11y",
    "verify": "corepack pnpm run verify:core && corepack pnpm run verify:coverage && corepack pnpm run verify:integration && corepack pnpm run verify:graph && corepack pnpm run verify:browser",
    "ci": "corepack pnpm run verify",
    "coverage:generate": "civet scripts/coverage.civet generate",
    "coverage:check": "civet scripts/coverage.civet check",
    "coverage:update": "corepack pnpm run test:coverage && corepack pnpm run coverage:generate",
    "verify:coverage": "corepack pnpm run test:coverage && corepack pnpm run coverage:check",
    "docs:generate": "civet scripts/docs.civet generate",
    "docs:check": "civet scripts/docs.civet check",
    "openapi:generate": "corepack pnpm run api:openapi:generate",
    "openapi:check": "corepack pnpm run api:openapi:check",
    "capability:add": "civet scripts/capability.civet",
    "doctor": "civet scripts/doctor.civet",
    "graph:build": "civet scripts/graph.civet build",
    "graph:update": "civet scripts/graph.civet update",
    "graph:check": "civet scripts/graph.civet check",
    "graph:verify": "civet scripts/graph.civet verify",
    "generate:feature": "civet scripts/generate-feature.civet",
    "deploy:web": "corepack pnpm --filter @darkfactory/web exec vinext-cloudflare deploy",
    "deploy:web:check": "corepack pnpm --filter @darkfactory/web exec vinext-cloudflare deploy --dry-run",
    "deploy:web:preview": "corepack pnpm --filter @darkfactory/web exec vinext-cloudflare deploy --preview",
    "prepare": "husky",
    "db:generate": "corepack pnpm --filter @darkfactory/db run db:generate",
    "db:check": "corepack pnpm --filter @darkfactory/db run db:check",
    "db:migrate": "corepack pnpm --filter @darkfactory/db run db:migrate",
    "db:seed": "civet scripts/database/index.civet seed",
    "db:reset": "civet scripts/database/index.civet reset",
    "db:test:up": "docker compose -f infra/docker/postgres.compose.yml up --detach --wait",
    "db:test:down": "docker compose -f infra/docker/postgres.compose.yml down --volumes --remove-orphans"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@danielx/civet": "catalog:",
    "@darkfactory/ai": "workspace:*",
    "@darkfactory/analytics": "workspace:*",
    "@darkfactory/api": "workspace:*",
    "@darkfactory/auth": "workspace:*",
    "@darkfactory/config": "workspace:*",
    "@darkfactory/db": "workspace:*",
    "@darkfactory/email": "workspace:*",
    "@darkfactory/jobs": "workspace:*",
    "@darkfactory/observability": "workspace:*",
    "@darkfactory/shared": "workspace:*",
    "@darkfactory/state": "workspace:*",
    "@darkfactory/storage": "workspace:*",
    "@darkfactory/testkit": "workspace:*",
    "@darkfactory/ui": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "markdownlint-cli2": "catalog:",
    "portless": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
