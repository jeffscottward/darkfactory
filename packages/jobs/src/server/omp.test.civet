  it("WP1 emits a byte- and digest-stable artifact that reapplies to a real temp root", async () =>
    await writeFile(scopedFile, "before")
    trackedPaths.add("packages/jobs/representative.civet")
    callbackWith(null, "implemented", "", async (cwd) =>
      await writeFile(
        join(cwd, "packages", "jobs", "representative.civet"),
        "stable-after",
      )
    )
    const implementation = await createOmpCliAdapter({ repositoriesRoot }).execute(requestFor({
      workspaceId: "wp1-artifact-stability",
      effectKind: "implement",
    }))
    const artifact = implementation.implementationArtifact!
    expect(artifact.bytes).toBe(Buffer.byteLength(artifact.content))
    expect(artifact.digest).toBe(createHash("sha256").update(artifact.content).digest("hex"))
    const decoded = decodeOmpImplementationArtifact(
      artifact,
      implementation.change!.changeHash,
    )
    const target = join(repositoriesRoot, "wp1-artifact-target")
    await mkdir(target)
    await applyOmpImplementationArtifact(target, decoded)
    await applyOmpImplementationArtifact(target, decoded)
    expect(await readFile(
      join(target, "packages", "jobs", "representative.civet"),
      "utf8",
    )).toBe("stable-after")
    expect(artifact.digest).toBe(createHash("sha256").update(artifact.content).digest("hex"))
    await implementation.lifecycle!.finalize("unpersisted")
  )

  const WP2errno = (code: string): NodeJS.ErrnoException =>
    Object.assign(new Error(`WP2 ${code}`), { code })
  const WP2differentNonce = (nonce: string): string =>
    `${nonce[0] === "0" ? "1" : "0"}${nonce.slice(1)}`

  const WP2cleanupFor = (
    prepared: Awaited<ReturnType<typeof prepareVerificationWorkspace>>,
  ) => ({
    cwd: "darkfactory",
    recovery: {
      artifact: prepared.implementation.implementationArtifact!,
      changeHash: prepared.implementation.change!.changeHash,
    },
  })

  const WP2prepareRetained = async (
    adapter: ReturnType<typeof createOmpCliAdapter>,
    workspaceId: string,
  ) =>
    const prepared = await prepareVerificationWorkspace(adapter, workspaceId)
    await prepared.implementation.lifecycle!.finalize("persisted")
    return prepared

  it("WP2 preserves lock creation, write, and owner metadata failures", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const worktreesRoot = await realpath(join(tmpdir(), "darkfactory-omp-worktrees"))

    mocks.WP2mkdirDelegate = async (actual, path, ...arguments_) =>
      if String(path).endsWith(".lock") then throw WP2errno("EACCES")
      return await actual(path, ...arguments_)
    await expect(adapter.execute(requestFor({ workspaceId: "wp2-lock-mkdir" })))
      .rejects.toMatchObject({ code: "EACCES" })
    mocks.WP2mkdirDelegate = undefined

    const writeFailureId = "wp2-lock-write"
    const writeFailureKey = createHash("sha256")
      .update(`${repositoryDirectory}\0${writeFailureId}`)
      .digest("hex")
    const writeFailureLock = join(worktreesRoot, `${writeFailureKey}.lock`)
    mocks.WP2writeFileDelegate = async (actual, path, ...arguments_) =>
      if String(path) === join(writeFailureLock, "owner.json")
        throw WP2errno("EIO")
      return await actual(path, ...arguments_)
    await expect(adapter.execute(requestFor({ workspaceId: writeFailureId })))
      .rejects.toMatchObject({ code: "EIO" })
    mocks.WP2writeFileDelegate = undefined
    await expect(access(writeFailureLock)).rejects.toMatchObject({ code: "ENOENT" })

    const unavailableId = "wp2-owner-unavailable"
    const unavailableKey = createHash("sha256")
      .update(`${repositoryDirectory}\0${unavailableId}`)
      .digest("hex")
    const unavailableLock = join(worktreesRoot, `${unavailableKey}.lock`)
    const unavailableOwner = join(unavailableLock, "owner.json")
    await mkdir(unavailableLock)
    await writeFile(unavailableOwner, "{")
    await expect(adapter.execute(requestFor({ workspaceId: unavailableId })))
      .rejects.toThrow("owner metadata unavailable")
    await writeFile(unavailableOwner, JSON.stringify({
      nonce: randomUUID(),
      pid: process.pid,
      createdAt: 1,
    }))
    mocks.WP2readFileDelegate = async (actual, path, ...arguments_) =>
      if String(path) === unavailableOwner then throw WP2errno("EACCES")
      return await actual(path, ...arguments_)
    await expect(adapter.execute(requestFor({ workspaceId: unavailableId })))
      .rejects.toThrow("owner metadata unavailable")
    mocks.WP2readFileDelegate = undefined
    await rm(unavailableLock, { recursive: true, force: true })

    const retained = await WP2prepareRetained(adapter, "wp2-owner-identities")
    const artifact = retained.implementation.implementationArtifact!
    const lockDirectory = `${retained.workspaceDirectory}.lock`
    const ownerPath = join(lockDirectory, "owner.json")
    const invalidOwners = [
      { nonce: WP2differentNonce(artifact.ownerNonce), pid: 999_999_991, createdAt: 1 },
      { nonce: artifact.ownerNonce, pid: 1.5, createdAt: 1 },
      { nonce: artifact.ownerNonce, pid: 0, createdAt: 1 },
      { nonce: artifact.ownerNonce, pid: 999_999_991, createdAt: 1.5 },
      { nonce: artifact.ownerNonce, pid: 999_999_991, createdAt: -1 },
    ] as const
    for (const owner of invalidOwners)
      await mkdir(lockDirectory)
      await writeFile(ownerPath, JSON.stringify(owner))
      await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained)))
        .rejects.toThrow("owner identity changed")
      await rm(lockDirectory, { recursive: true, force: true })
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained))
  )

  it("WP2 validates real ownership markers and reports atomic persistence failures", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const retained = await WP2prepareRetained(adapter, "wp2-marker-matrix")
    const markerPath = `${retained.workspaceDirectory}.owner.json`
    const originalContent = await readFile(markerPath, "utf8")
    const original = JSON.parse(originalContent) as Record<string, unknown>
    const malformedMarkers = [
      ` ${originalContent}`,
      JSON.stringify({ ...original, identity: "wrong" }),
      JSON.stringify({ ...original, sourceCwdDigest: "bad" }),
      JSON.stringify({ ...original, sourceHead: "bad" }),
      JSON.stringify({ ...original, workspaceKey: "bad" }),
      JSON.stringify({ ...original, ownerNonce: "bad" }),
      JSON.stringify({ ...original, artifactDigest: "bad" }),
      JSON.stringify({ ...original, changeHash: "bad" }),
    ]
    for (const content of malformedMarkers)
      await writeFile(markerPath, content)
      await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained)))
        .rejects.toBeInstanceOf(OmpRequestError)

    await writeFile(markerPath, JSON.stringify({
      ...original,
      ownerNonce: WP2differentNonce(String(original["ownerNonce"])),
    }))
    await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained)))
      .rejects.toThrow("ownership identity changed")
    await writeFile(markerPath, originalContent)

    for (const code of ["ENOENT", "EACCES", "EIO"])
      mocks.WP2readFileDelegate = async (actual, path, ...arguments_) =>
        if String(path) === markerPath then throw WP2errno(code)
        return await actual(path, ...arguments_)
      await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained)))
        .rejects.toBeInstanceOf(OmpRequestError)
      mocks.WP2readFileDelegate = undefined
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained))

    await writeFile(scopedFile, "before")
    trackedPaths.add("packages/jobs/representative.civet")
    for (const operation of ["write", "rename"] as const)
      callbackWith(null, "implemented", "", async (cwd) =>
        await writeFile(
          join(cwd, "packages", "jobs", "representative.civet"),
          `wp2-${operation}`,
        )
      )
      if operation === "write"
        mocks.WP2writeFileDelegate = async (actual, path, ...arguments_) =>
          if String(path).includes(".owner.json.") && String(path).endsWith(".tmp")
            throw WP2errno("EIO")
          return await actual(path, ...arguments_)
      else
        mocks.WP2renameDelegate = async (actual, source, ...arguments_) =>
          if String(source).includes(".owner.json.") && String(source).endsWith(".tmp")
            throw WP2errno("EIO")
          return await actual(source, ...arguments_)
      const result = await adapter.execute(requestFor({
        workspaceId: `wp2-marker-${operation}`,
        effectKind: "implement",
      }))
      expect(result).toMatchObject({
        status: "failed",
        change: { changedPaths: ["packages/jobs/representative.civet"] },
        implementationArtifact: null,
      })
      mocks.WP2writeFileDelegate = undefined
      mocks.WP2renameDelegate = undefined
      await result.lifecycle!.finalize("unpersisted")
  )

  it("WP2 detects owner disappearance and deterministic cleanup ownership races", async () =>
    callbackWith(null, "planned")
    const plan = await createOmpCliAdapter({ repositoriesRoot }).execute(requestFor({
      workspaceId: "wp2-owner-disappears",
    }))
    const planWorkspace = (
      sandboxCalls().at(-1)![2] as Readonly<{ cwd: string }>
    ).cwd
    await rm(join(`${planWorkspace}.lock`, "owner.json"))
    await expect(plan.lifecycle!.finalize("persisted"))
      .rejects.toBeInstanceOf(OmpWorkspaceCleanupError)

    const adapter = createOmpCliAdapter({ repositoriesRoot })
    for (const race of ["baseline", "marker"] as const)
      const retained = await WP2prepareRetained(adapter, `wp2-${race}-ownership-race`)
      const cleanup = WP2cleanupFor(retained)
      const worktreesRoot = dirname(retained.workspaceDirectory)
      const lockDirectory = `${retained.workspaceDirectory}.lock`
      const ownerPath = join(lockDirectory, "owner.json")
      const baselinePrefix = `${basename(retained.workspaceDirectory)}.baseline-`
      if race === "marker"
        for (const entry of await readdir(worktreesRoot))
          if entry.startsWith(baselinePrefix)
            await rm(join(worktreesRoot, entry), { force: true })
      let ownerReads = 0
      mocks.WP2readFileDelegate = async (actual, path, ...arguments_) =>
        if String(path) === ownerPath
          ownerReads += 1
          if ownerReads === 2
            return JSON.stringify({
              nonce: WP2differentNonce(
                retained.implementation.implementationArtifact!.ownerNonce,
              ),
              pid: process.pid,
              createdAt: 1,
            })
        return await actual(path, ...arguments_)
      mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
        if String(path) === retained.workspaceDirectory then return
        return await actual(path, ...arguments_)
      await expect(adapter.cleanupRetainedWorkspace(cleanup))
        .rejects.toThrow("cleanup ownership changed")
      mocks.WP2readFileDelegate = undefined
      mocks.WP2rmDelegate = undefined
      await adapter.cleanupRetainedWorkspace(cleanup)
  )

  it("WP2 fails closed across cleanup path, root, git, and filesystem boundaries", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const worktreesRoot = await realpath(join(tmpdir(), "darkfactory-omp-worktrees"))

    const statFailure = await WP2prepareRetained(adapter, "wp2-cleanup-stat-eacces")
    mocks.WP2statDelegate = async (actual, path, ...arguments_) =>
      if String(path) === statFailure.workspaceDirectory then throw WP2errno("EACCES")
      return await actual(path, ...arguments_)
    await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(statFailure)))
      .rejects.toMatchObject({ code: "EACCES" })
    mocks.WP2statDelegate = undefined
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(statFailure))

    const invalidRoot = await WP2prepareRetained(adapter, "wp2-cleanup-root-file")
    mocks.WP2statDelegate = async (actual, path, ...arguments_) =>
      if String(path) === worktreesRoot
        return await actual(join(repositoryDirectory, "package.json"))
      return await actual(path, ...arguments_)
    await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(invalidRoot)))
      .rejects.toThrow("OMP worktree root is insecure")
    mocks.WP2statDelegate = undefined
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(invalidRoot))

    const invalidPath = await WP2prepareRetained(adapter, "wp2-cleanup-canonical-path")
    mocks.WP2realpathDelegate = async (actual, path, ...arguments_) =>
      if String(path) === invalidPath.workspaceDirectory then return worktreesRoot
      return await actual(path, ...arguments_)
    await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(invalidPath)))
      .rejects.toThrow("cleanup path is invalid")
    mocks.WP2realpathDelegate = undefined
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(invalidPath))

    const wrongHead = await WP2prepareRetained(adapter, "wp2-cleanup-head")
    gitResponseOverrides.set(["rev-parse", "HEAD"].join("\0"), "b".repeat(40))
    await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(wrongHead)))
      .rejects.toThrow("cleanup identity changed")
    gitResponseOverrides.delete(["rev-parse", "HEAD"].join("\0"))
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(wrongHead))

    for (const outcome of ["oversized", "EIO"] as const)
      const retained = await WP2prepareRetained(adapter, `wp2-cleanup-readdir-${outcome}`)
      mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
        if String(path) === retained.workspaceDirectory then return
        return await actual(path, ...arguments_)
      mocks.WP2readdirDelegate = async (actual, path, ...arguments_) =>
        if basename(String(path)) === "darkfactory-omp-worktrees"
          if outcome === "EIO" then throw WP2errno("EIO")
          return Array.from({ length: 20_001 }, (_, index) => `entry-${index}`)
        return await actual(path, ...arguments_)
      const rejection = expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained)))
        .rejects
      if outcome === "EIO"
        await rejection.toMatchObject({ code: "EIO" })
      else
        await rejection.toThrow("cleanup root is oversized")
      mocks.WP2readdirDelegate = undefined
      mocks.WP2rmDelegate = undefined
      await adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained))

    for (const denied of ["baseline", "marker"] as const)
      const retained = await WP2prepareRetained(adapter, `wp2-cleanup-${denied}-eacces`)
      const markerPath = `${retained.workspaceDirectory}.owner.json`
      const baselinePrefix = `${basename(retained.workspaceDirectory)}.baseline-`
      mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
        const value = String(path)
        if value === retained.workspaceDirectory then return
        if (
          (denied === "marker" && value === markerPath) ||
          (denied === "baseline" && basename(value).startsWith(baselinePrefix))
        )
          throw WP2errno("EACCES")
        return await actual(path, ...arguments_)
      await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained)))
        .rejects.toMatchObject({ code: "EACCES" })
      mocks.WP2rmDelegate = undefined
      await adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained))

    const pruneFailure = await WP2prepareRetained(adapter, "wp2-cleanup-prune")
    gitResponseOverrides.set(
      ["worktree", "prune"].join("\0"),
      WP2errno("EIO"),
    )
    await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(pruneFailure)))
      .rejects.toBeInstanceOf(OmpRequestError)
    gitResponseOverrides.delete(["worktree", "prune"].join("\0"))
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(pruneFailure))
  )

  it("WP2 releases a vanished cleanup race and rejects mismatched signed recovery", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const vanished = await WP2prepareRetained(adapter, "wp2-cleanup-vanished")
    const vanishedMarker = `${vanished.workspaceDirectory}.owner.json`
    const vanishedLock = `${vanished.workspaceDirectory}.lock`
    const disappearanceCounts = new Map<string, number>()
    mocks.WP2statDelegate = async (actual, path, ...arguments_) =>
      const value = String(path)
      if value === vanished.workspaceDirectory || value === vanishedMarker
        const count = (disappearanceCounts.get(value) ?? 0) + 1
        disappearanceCounts.set(value, count)
        if count > 1 then throw WP2errno("ENOENT")
      return await actual(path, ...arguments_)
    await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(vanished)))
      .resolves.toBeUndefined()
    mocks.WP2statDelegate = undefined
    await expect(access(vanishedLock)).rejects.toMatchObject({ code: "ENOENT" })
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(vanished))

    const retained = await WP2prepareRetained(adapter, "wp2-recovery-identity")
    await expect(adapter.execute(verificationRequestFor(
      retained,
      retained.implementation,
      { workspaceId: "wp2-different-workspace" },
    ))).rejects.toThrow("workspace recovery identity changed")
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained))
  )

  it("WP2 deterministically takes over stale recovery and verifier replay locks", async () =>
    const verificationRunner = vi.fn(async () => verifierRunnerResult())
    const adapter = createOmpCliAdapter({ repositoriesRoot, verificationRunner })
    const retained = await WP2prepareRetained(adapter, "wp2-stale-takeover")
    const artifact = retained.implementation.implementationArtifact!
    const stalePid = 999_999_993
    const mainLock = `${retained.workspaceDirectory}.lock`
    await mkdir(mainLock)
    await writeFile(join(mainLock, "owner.json"), JSON.stringify({
      nonce: artifact.ownerNonce,
      pid: stalePid,
      createdAt: 1,
    }))

    const verifierKey = createHash("sha256")
      .update(`${artifact.workspaceKey}\0${artifact.digest}`)
      .digest("hex")
    const verifierWorkspace = join(
      dirname(retained.workspaceDirectory),
      `${artifact.workspaceKey}.verify-${verifierKey}`,
    )
    await mkdir(verifierWorkspace)
    await writeFile(
      `${verifierWorkspace}.owner.json`,
      await readFile(`${retained.workspaceDirectory}.owner.json`, "utf8"),
    )
    const verifierLock = `${verifierWorkspace}.lock`
    await mkdir(verifierLock)
    await writeFile(join(verifierLock, "owner.json"), JSON.stringify({
      nonce: artifact.ownerNonce,
      pid: stalePid,
      createdAt: 1,
    }))
    const processKill = vi.spyOn(process, "kill").mockImplementation((pid) =>
      if pid === stalePid then throw WP2errno("ESRCH")
      return true
    )
    try
      callbackWith(null, "verification")
      const result = await adapter.execute(verificationRequestFor(retained))
      expect(result).toMatchObject({
        status: "succeeded",
        verification: { status: "succeeded" },
      })
      expect(gitCalls().some((call) =>
        const arguments_ = call[1] as readonly string[]
        return (
          arguments_[0] === "worktree" &&
          arguments_[1] === "remove" &&
          arguments_[3] === verifierWorkspace
        )
      )).toBe(true)
      await result.lifecycle!.finalize("persisted")
    finally
      processKill.mockRestore()
  )

  it("WP2 maps retained release failures to cleanup ownership errors", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const retained = await WP2prepareRetained(adapter, "wp2-retained-release-failure")
    const markerPath = `${retained.workspaceDirectory}.owner.json`
    const originalMarker = await readFile(markerPath, "utf8")
    const changedMarker = {
      ...(JSON.parse(originalMarker) as Record<string, unknown>),
      sourceHead: "b".repeat(40),
    }
    await writeFile(markerPath, JSON.stringify(changedMarker))
    const lockDirectory = `${retained.workspaceDirectory}.lock`
    mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
      if String(path) === lockDirectory then throw WP2errno("EIO")
      return await actual(path, ...arguments_)
    await expect(adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained)))
      .rejects.toBeInstanceOf(OmpWorkspaceCleanupError)
    mocks.WP2rmDelegate = undefined
    await rm(lockDirectory, { recursive: true, force: true })
    await writeFile(markerPath, originalMarker)
    await adapter.cleanupRetainedWorkspace(WP2cleanupFor(retained))

    callbackWith(null, "planned")
    const plan = await adapter.execute(requestFor({
      workspaceId: "wp2-lifecycle-release-failure",
    }))
    const planWorkspace = (
      sandboxCalls().at(-1)![2] as Readonly<{ cwd: string }>
    ).cwd
    mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
      if String(path) === `${planWorkspace}.lock` then throw WP2errno("EIO")
      return await actual(path, ...arguments_)
    await expect(plan.lifecycle!.finalize("persisted"))
      .rejects.toBeInstanceOf(OmpWorkspaceCleanupError)
    mocks.WP2rmDelegate = undefined
  )

  it("WP3 rejects unavailable, denied, and non-file sandbox candidates and control-byte paths", async () =>
    const errnoFor = (code: "ENOENT" | "EACCES"): NodeJS.ErrnoException =>
      Object.assign(new Error(code), { code })
    const sandboxExecutable = "/usr/bin/sandbox-exec"

    for (const [label, code] of [
      ["unavailable", "ENOENT"],
      ["denied", "EACCES"],
    ] as const)
      mocks.WP3accessDelegate = async (actual, path, mode) =>
        if String(path) === sandboxExecutable then throw errnoFor(code)
        return actual(path, mode)
      const platform = vi.spyOn(process, "platform", "get").mockReturnValue("darwin")
      try
        await expect(createProductionOmpCliAdapter({ repositoriesRoot }).execute(requestFor({
          workspaceId: `wp3-sandbox-${label}`,
        }))).rejects.toMatchObject({
          name: "OmpConfigurationError",
          message: "OMP filesystem sandbox is unavailable",
        })
        expect(sandboxCalls()).toHaveLength(0)
      finally
        platform.mockRestore()

    const nonFileCandidate = join(repositoriesRoot, "wp3-sandbox-directory")
    await mkdir(nonFileCandidate)
    await chmod(nonFileCandidate, 0o700)
    mocks.WP3accessDelegate = async (actual, path, mode) =>
      if String(path) === sandboxExecutable then return actual(nonFileCandidate, mode)
      return actual(path, mode)
    mocks.WP3statDelegate = async (actual, path, ...arguments_) =>
      if String(path) === sandboxExecutable
        return actual(nonFileCandidate, ...arguments_)
      return actual(path, ...arguments_)
    const platform = vi.spyOn(process, "platform", "get").mockReturnValue("darwin")
    try
      await expect(createProductionOmpCliAdapter({ repositoriesRoot }).execute(requestFor({
        workspaceId: "wp3-sandbox-non-file",
      }))).rejects.toMatchObject({
        name: "OmpConfigurationError",
        message: "OMP filesystem sandbox is unavailable",
      })
      expect(sandboxCalls()).toHaveLength(0)
    finally
      platform.mockRestore()

    const developerDirectory =
      "/Applications/Xcode-CI.app/Contents/Developer"
    const gitExecutable = join(developerDirectory, "usr", "bin", "git")
    const trustedGitPaths = new Set<string>()
    let trustedGitCandidate = gitExecutable
    while trustedGitCandidate !== "/"
      trustedGitPaths.add(trustedGitCandidate)
      trustedGitCandidate = dirname(trustedGitCandidate)
    mocks.WP3realpathDelegate = async (actual, path, ...arguments_) =>
      const value = String(path)
      if value === "/var/db/xcode_select_link" then return developerDirectory
      if value === developerDirectory || value === gitExecutable then return value
      return actual(path, ...arguments_)
    const validExecutableDirectory = join(repositoriesRoot, "wp3-valid-bin")
    const validExecutable = join(validExecutableDirectory, "omp")
    await mkdir(validExecutableDirectory)
    await writeFile(validExecutable, "#!/bin/sh\nexit 0\n")
    await chmod(validExecutable, 0o700)
    mocks.WP3accessDelegate = async (actual, path, mode) =>
      const value = String(path)
      if value === sandboxExecutable || value === gitExecutable then return
      return actual(path, mode)
    mocks.WP3statDelegate = async (actual, path, ...arguments_) =>
      const value = String(path)
      if value === sandboxExecutable
        return {
          isFile: () => true,
        } as Awaited<ReturnType<typeof stat>>
      if trustedGitPaths.has(value)
        return {
          uid: 0,
          gid: value === "/Applications" ? 80 : 0,
          mode: value === gitExecutable
            ? 0o100755
            : value === "/Applications"
              ? 0o040775
              : 0o040755,
          isFile: () => value === gitExecutable,
          isDirectory: () => value !== gitExecutable,
        } as Awaited<ReturnType<typeof stat>>
      return actual(path, ...arguments_)
    const originalPath = process.env["PATH"]
    process.env["PATH"] = validExecutableDirectory
    const validPlatform = vi.spyOn(process, "platform", "get").mockReturnValue("darwin")
    try
      callbackWith(null, "planned with valid sandbox")
      const validPlan = await createProductionOmpCliAdapter({
        repositoriesRoot,
      }).execute(requestFor({
        workspaceId: "wp3-sandbox-valid-file",
      }))
      expect(validPlan.status).toBe("succeeded")
      expect(sandboxCalls()).toHaveLength(1)
      await validPlan.lifecycle!.finalize("unpersisted")
    finally
      if originalPath === undefined then delete process.env["PATH"]
      else process.env["PATH"] = originalPath
      validPlatform.mockRestore()

    mocks.WP3realpathDelegate = undefined
    mocks.WP3accessDelegate = undefined
    mocks.WP3statDelegate = undefined
    const controlExecutable = join(repositoriesRoot, "wp3-omp\ncontrol")
    await writeFile(controlExecutable, "#!/bin/sh\nexit 0\n")
    await chmod(controlExecutable, 0o700)
    await expect(createOmpCliAdapter({
      repositoriesRoot,
      executable: controlExecutable,
      allowedExecutables: [controlExecutable],
    }).execute(requestFor({
      workspaceId: "wp3-sandbox-control",
    }))).rejects.toBeInstanceOf(OmpRequestError)

    callbackWith(null, "planned after candidate checks")
    const planned = await createOmpCliAdapter({ repositoriesRoot }).execute(requestFor({
      workspaceId: "wp3-plan-after-candidates",
    }))
    expect(planned).toMatchObject({
      status: "succeeded",
      verification: null,
      implementationArtifact: null,
    })
    await planned.lifecycle!.finalize("unpersisted")
  )

  it("WP3 fails closed for unavailable, denied, and non-file Docker candidates", async () =>
    const errnoFor = (code: "ENOENT" | "EACCES"): NodeJS.ErrnoException =>
      Object.assign(new Error(code), { code })
    const dockerCandidates = [
      "/usr/bin/docker",
      "/usr/local/bin/docker",
      "/opt/homebrew/bin/docker",
    ] as const
    const sandboxExecutable = "/usr/bin/sandbox-exec"
    const nonFileCandidate = join(repositoriesRoot, "wp3-docker-directory")
    await mkdir(nonFileCandidate)
    await chmod(nonFileCandidate, 0o700)
    const adapter = createOmpCliAdapter({
      repositoriesRoot,
      verifierId: OMP_VERIFIER_COMMAND_IDENTITY,
      verifierImageDigest: VERIFIER_IMAGE_DIGEST,
    })
    const prepared = await prepareVerificationWorkspace(adapter, "wp3-docker-candidates")
    await prepared.implementation.lifecycle!.finalize("persisted")

    for (const state of ["unavailable", "denied", "non-file"] as const)
      const candidateAccesses: string[] = []
      mocks.WP3accessDelegate = async (actual, path, mode) =>
        const candidate = String(path)
        if candidate === sandboxExecutable then return actual(path, mode)
        if !dockerCandidates.includes(candidate as typeof dockerCandidates[number])
          return actual(path, mode)
        candidateAccesses.push(candidate)
        if state === "non-file" && candidate === dockerCandidates[0]
          return actual(nonFileCandidate, mode)
        const code = state === "denied" && candidate === dockerCandidates[0]
          ? "EACCES"
          : "ENOENT"
        throw errnoFor(code)
      mocks.WP3realpathDelegate = async (actual, path, ...arguments_) =>
        if state === "non-file" && String(path) === dockerCandidates[0]
          return actual(nonFileCandidate, ...arguments_)
        return actual(path, ...arguments_)

      callbackWith(null, `verification with ${state} Docker`)
      const result = await adapter.execute(verificationRequestFor(prepared))
      expect(result).toMatchObject({
        status: "failed",
        verification: null,
      })
      expect(candidateAccesses).toEqual(dockerCandidates)
      await result.lifecycle!.finalize("persisted")

    mocks.WP3accessDelegate = undefined
    mocks.WP3realpathDelegate = undefined
  )

  it("WP3 resolves Docker with and without a request signal and records the configured image", async () =>
    const dockerCandidate = "/usr/bin/docker"
    const resolvedDocker = join(repositoriesRoot, "wp3-docker")
    await writeFile(resolvedDocker, "#!/bin/sh\nexit 0\n")
    await chmod(resolvedDocker, 0o700)
    mocks.WP3accessDelegate = async (actual, path, mode) =>
      if String(path) === dockerCandidate then return actual(resolvedDocker, mode)
      return actual(path, mode)
    mocks.WP3realpathDelegate = async (actual, path, ...arguments_) =>
      if String(path) === dockerCandidate
        return actual(resolvedDocker, ...arguments_)
      return actual(path, ...arguments_)
    const inspectIdentity =
      `${VERIFIER_IMAGE_DIGEST}|${OMP_VERIFIER_CONFIG_DIGEST}|${OMP_VERIFIER_ARGV_IDENTITY}`
    const dockerResponse = (
      stdout = "",
      stderr = "",
      closeCode = 0,
    ): SandboxResponse => ({
      error: null,
      stdout,
      stderr,
      closeCode,
    })
    const adapter = createOmpCliAdapter({
      repositoriesRoot,
      verifierId: OMP_VERIFIER_COMMAND_IDENTITY,
      verifierImageDigest: VERIFIER_IMAGE_DIGEST,
    })

    for (const requestSignal of [undefined, new AbortController().signal] as const)
      const workspaceId = requestSignal === undefined
        ? "wp3-docker-without-signal"
        : "wp3-docker-with-signal"
      const prepared = await prepareVerificationWorkspace(adapter, workspaceId)
      await prepared.implementation.lifecycle!.finalize("persisted")
      callbackWith(null, `verification for ${workspaceId}`)
      sandboxResponses.push(
        dockerResponse(inspectIdentity),
        dockerResponse("tests: docker passed"),
        dockerResponse(),
      )

      const result = await adapter.execute(verificationRequestFor(
        prepared,
        prepared.implementation,
        requestSignal === undefined ? {} : { signal: requestSignal },
      ))

      expect(result).toMatchObject({
        status: "succeeded",
        verification: {
          status: "succeeded",
          commandIdentity: OMP_VERIFIER_COMMAND_IDENTITY,
          imageDigest: VERIFIER_IMAGE_DIGEST,
          configDigest: OMP_VERIFIER_CONFIG_DIGEST,
        },
      })
      const resolvedCalls = sandboxCalls().filter((call) =>
        call[0] === resolvedDocker
      )
      expect(resolvedCalls.at(-3)?.[1]).toContain("image")
      expect(resolvedCalls.at(-2)?.[1]).toContain("run")
      expect(resolvedCalls.at(-1)?.[1]).toContain("container")
      await result.lifecycle!.finalize("persisted")

    mocks.WP3accessDelegate = undefined
    mocks.WP3realpathDelegate = undefined
  )

  it("WP3 distinguishes disappearing and surviving owned process groups with Node errno shapes", async () =>
    const inspect = (pid: number): SandboxResponse => ({
      error: null,
      stdout: "",
      stderr: "",
      pid,
      holdOpen: true,
    })
    const run = (signal: AbortSignal) => runDockerVerifier({
      dockerExecutable: "/usr/bin/docker",
      workspace: repositoryDirectory,
      sessionDirectory: repositoriesRoot,
      imageDigest: VERIFIER_IMAGE_DIGEST,
      signal,
      timeoutMs: 1_000,
      shutdownTimeoutMs: 4,
      maximumOutputBytes: 64,
      redactions: [],
      now: () => 0,
    })
    const errnoFor = (code: "ESRCH" | "EPERM"): NodeJS.ErrnoException =>
      Object.assign(new Error(code), { code })
    const begin = async (pid: number) =>
      sandboxResponses.push(inspect(pid))
      const controller = new AbortController()
      const pending = run(controller.signal)
      await vi.waitFor(() =>
        expect(sandboxCalls().at(-1)?.[1]).toContain("image")
      )
      return { controller, pending }

    const duringLoop = await begin(303_031)
    let killedDuringLoop = false
    const duringLoopKill = vi.spyOn(process, "kill").mockImplementation((
      _pid: number,
      signal?: string | number,
    ) =>
      if signal === "SIGKILL"
        killedDuringLoop = true
        return true
      if signal === 0 && killedDuringLoop then throw errnoFor("ESRCH")
      return true
    )
    const duringLoopTimes = [0, 0, 2, 2, 2]
    const duringLoopNow = vi.spyOn(Date, "now")
      .mockImplementation(() => duringLoopTimes.shift() ?? 4)
    duringLoop.controller.abort()
    await expect(duringLoop.pending).resolves.toMatchObject({ status: "aborted" })
    expect(duringLoopKill).toHaveBeenCalledWith(-303_031, "SIGKILL")
    duringLoopNow.mockRestore()
    duringLoopKill.mockRestore()

    const atDeadline = await begin(303_032)
    let killedAtDeadline = false
    let postKillProbes = 0
    const atDeadlineKill = vi.spyOn(process, "kill").mockImplementation((
      _pid: number,
      signal?: string | number,
    ) =>
      if signal === "SIGKILL"
        killedAtDeadline = true
        return true
      if signal === 0 && killedAtDeadline
        postKillProbes += 1
        if postKillProbes > 1 then throw errnoFor("ESRCH")
      return true
    )
    const atDeadlineTimes = [0, 0, 2, 2, 2, 4]
    const atDeadlineNow = vi.spyOn(Date, "now")
      .mockImplementation(() => atDeadlineTimes.shift() ?? 4)
    atDeadline.controller.abort()
    await expect(atDeadline.pending).resolves.toMatchObject({ status: "aborted" })
    expect(postKillProbes).toBe(2)
    atDeadlineNow.mockRestore()
    atDeadlineKill.mockRestore()

    const surviving = await begin(303_033)
    let killedSurvivor = false
    const survivingKill = vi.spyOn(process, "kill").mockImplementation((
      _pid: number,
      signal?: string | number,
    ) =>
      if signal === "SIGKILL"
        killedSurvivor = true
        return true
      if signal === 0 && killedSurvivor then throw errnoFor("EPERM")
      return true
    )
    const survivingTimes = [0, 0, 2, 2, 2, 4]
    const survivingNow = vi.spyOn(Date, "now")
      .mockImplementation(() => survivingTimes.shift() ?? 4)
    surviving.controller.abort()
    await expect(surviving.pending).rejects.toBeInstanceOf(
      OmpProcessTerminationError,
    )
    expect(survivingKill).toHaveBeenCalledWith(-303_033, "SIGKILL")
    survivingNow.mockRestore()
    survivingKill.mockRestore()
  )
  const WP4errno = (code: NodeJS.ErrnoException["code"]): NodeJS.ErrnoException =>
    Object.assign(new Error(`WP4 ${code} filesystem failure`), { code })
  const WP4terminateNextGitCleanup = (pid: number) =>
    const processKill = vi.spyOn(process, "kill").mockImplementation(() => true)
    const dateNow = vi.spyOn(Date, "now")
      .mockReturnValueOnce(0)
      .mockReturnValue(1_000)
    mocks.execFile.mockImplementationOnce((
      _executable: string,
      _arguments: readonly string[],
      _options: unknown,
      callback: (error: NodeJS.ErrnoException | null) => void,
    ) =>
      const child = Object.assign(new EventEmitter(), {
        pid,
        kill: vi.fn(() => true),
      })
      queueMicrotask(() =>
        callback(Object.assign(new Error("git cleanup failed"), { code: "EIO" }))
      )
      child
    )
    return { processKill, dateNow }


  const WP4verifierWorkspaceFor = (
    artifact: OmpImplementationArtifact,
  ): string =>
    const verifierKey = createHash("sha256")
      .update(`${artifact.workspaceKey}\0${artifact.digest}`)
      .digest("hex")
    return join(
      tmpdir(),
      "darkfactory-omp-worktrees",
      `${artifact.workspaceKey}.verify-${verifierKey}`,
    )

  it("WP4 fails closed when verifier reconstruction reads different reviewed content", async () =>
    const verificationRunner = vi.fn(async () => verifierRunnerResult())
    const adapter = createOmpCliAdapter({ repositoriesRoot, verificationRunner })
    const prepared = await prepareVerificationWorkspace(
      adapter,
      "WP4-reconstruction-drift",
    )
    await prepared.implementation.lifecycle!.finalize("persisted")
    mocks.WP4readFileDelegate = async (actual, path, ...arguments_) =>
      const file = String(path)
      if (
        file.includes(".verify-") &&
        file.endsWith("packages/jobs/representative.civet")
      )
        return Buffer.from("WP4 different reconstructed content")
      return actual(path, ...arguments_)
    callbackWith(null, "verification preflight")

    const result = await adapter.execute(verificationRequestFor(prepared))

    expect(result).toMatchObject({
      status: "failed"
      verification: null
      change: prepared.implementation.change
      implementationArtifact: prepared.implementation.implementationArtifact
    })
    expect(verificationRunner).not.toHaveBeenCalled()
    await result.lifecycle!.finalize("unpersisted")
  )

  it("WP4 fails closed when a verifier control changes before initial manifest comparison", async () =>
    const adapter = createOmpCliAdapter({
      repositoriesRoot
      verifierId: OMP_VERIFIER_COMMAND_IDENTITY
      verifierImageDigest: VERIFIER_IMAGE_DIGEST
    })
