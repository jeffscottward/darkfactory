  it("rejects source identity, revision, dirtiness, missing verification recovery, and ambiguous retained states", async () =>
    const invalidGitResponses = [
      [["rev-parse", "--show-toplevel"], repositoriesRoot]
      [["rev-parse", "--absolute-git-dir"], repositoriesRoot]
      [["rev-parse", "HEAD"], "not-a-revision"]
      [["status", "--porcelain", "--untracked-files=all"], " M dirty"]
    ] as const
    for entry of invalidGitResponses
      const arguments_ = entry[0]
      const response = entry[1]
      gitResponseOverrides.set(arguments_.join("\0"), response)
      await expect(createOmpCliAdapter({ repositoriesRoot }).execute(
        requestFor({ workspaceId: `invalid-${arguments_[1]}` }),
      )).rejects.toBeInstanceOf(OmpRequestError)
      gitResponseOverrides.clear()

    await expect(createOmpCliAdapter({ repositoriesRoot }).execute(requestFor({
      workspaceId: "clean-verify"
      effectKind: "verify"
    }))).rejects.toThrow("OMP implementation artifact is invalid")

    callbackWith(null, "planned")
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const plan = await adapter.execute(requestFor({ workspaceId: "dirty-plan" }))
    await plan.lifecycle!.finalize("unpersisted")
    const workspaceDirectory = (
      sandboxCalls().at(-1)![2] as Readonly<{ cwd: string }>
    ).cwd
    workspaceStatuses.set(workspaceDirectory, " M retained-change")
    await expect(adapter.execute(requestFor({ workspaceId: "dirty-plan" })))
      .rejects.toThrow("OMP workspace state is ambiguous")
  )

