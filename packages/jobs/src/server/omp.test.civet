  it("rejects a retained workspace when its control manifest no longer matches source", async () =>
    const adapter = createOmpCliAdapter({
      repositoriesRoot
      verifierId: OMP_VERIFIER_COMMAND_IDENTITY
      verifierImageDigest: VERIFIER_IMAGE_DIGEST
    })
    const prepared = await prepareVerificationWorkspace(adapter, "manifest-mismatch")
    await prepared.implementation.lifecycle!.finalize("persisted")
    const sourceManifest = await trustedVerifierManifestFor(repositoryDirectory)
    await expect(
      matchesTrustedVerifierManifest(prepared.workspaceDirectory, sourceManifest),
    ).resolves.toBe(true)
    const addedControl = join(
      prepared.workspaceDirectory,
      "apps",
      "web",
      "vite.config.ts",
    )
    await mkdir(dirname(addedControl), { recursive: true })
    await writeFile(addedControl, "export default {}")
    await expect(
      matchesTrustedVerifierManifest(prepared.workspaceDirectory, sourceManifest),
    ).resolves.toBe(false)
    await rm(addedControl)
    callbackWith(null, "model claims checks passed", "", async (cwd) =>
      await writeFile(join(cwd, "package.json"), JSON.stringify({
        description: "tampered during verification"
        scripts: { "verify:core": VERIFY_CORE_SCRIPT }
      }))
    )

    const result = await adapter.execute(verificationRequestFor(prepared))

    expect(result).toMatchObject({ status: "failed", verification: null })
    expect(sandboxCalls()).toHaveLength(2)
    await result.lifecycle!.finalize("unpersisted")
  )

  it("constructs the exact mandatory Docker verifier argv and bomb defenses", async () =>
    const workspace = "/tmp/darkfactory-omp-worktrees/workspace.verify"
    const cidPath = "/tmp/darkfactory-omp/session/verifier.cid"
    const containerName =
      "darkfactory-verifier-00000000-0000-4000-8000-000000000000"
    const arguments_ = dockerVerifierArgumentsFor(
      workspace,
      cidPath,
      VERIFIER_IMAGE_DIGEST,
      containerName,
    )

    expect(arguments_).toEqual([
      "run"
      "--pull=never"
      "--cidfile", cidPath
      "--name", containerName
      `--label=org.darkfactory.verifier.owner=${containerName}`
      "--network=none"
      "--ipc=none"
      "--read-only"
      `--memory=${OMP_VERIFIER_MEMORY}`
      `--memory-swap=${OMP_VERIFIER_MEMORY_SWAP}`
      `--pids-limit=${OMP_VERIFIER_PIDS}`
      `--cpus=${OMP_VERIFIER_CPUS}`
      `--ulimit=fsize=${OMP_VERIFIER_FILE_SIZE}:${OMP_VERIFIER_FILE_SIZE}`
      `--ulimit=nofile=${OMP_VERIFIER_NOFILE}:${OMP_VERIFIER_NOFILE}`
      "--ulimit=cpu=300:300"
      "--cap-drop=ALL"
      "--security-opt=no-new-privileges=true"
      "--user=65532:65532"
      "--init"
      "--stop-timeout=2"
      "--workdir=/workspace"
      `--tmpfs=/tmp:${OMP_VERIFIER_TMP_TMPFS}`
      `--tmpfs=/output:${OMP_VERIFIER_OUTPUT_TMPFS}`
      `--tmpfs=/cache:${OMP_VERIFIER_CACHE_TMPFS}`
      `--mount=type=bind,source=${workspace},target=/workspace,readonly,bind-propagation=rprivate`
      "--env=CI=1"
      "--env=HOME=/tmp/home"
      "--env=NODE_ENV=test"
      "--env=NO_COLOR=1"
      "--env=TMPDIR=/tmp"
      "--env=XDG_CACHE_HOME=/cache"
      "--env=XDG_CONFIG_HOME=/cache/config"
      "--env=XDG_DATA_HOME=/cache/data"
      VERIFIER_IMAGE_DIGEST
      ...OMP_VERIFIER_ARGUMENTS
    ])
    const bombDefenses = {
      fork: `--pids-limit=${OMP_VERIFIER_PIDS}`
      memory: `--memory=${OMP_VERIFIER_MEMORY}`
      cpu: `--cpus=${OMP_VERIFIER_CPUS}`
      disk: `--ulimit=fsize=${OMP_VERIFIER_FILE_SIZE}:${OMP_VERIFIER_FILE_SIZE}`
      inode: `--tmpfs=/output:${OMP_VERIFIER_OUTPUT_TMPFS}`
      network: "--network=none"
      sourceWrite:
        `--mount=type=bind,source=${workspace},target=/workspace,readonly,bind-propagation=rprivate`
      configRewrite: "--read-only"
    }
    for [bomb, defense] of Object.entries(bombDefenses)
      expect(arguments_, bomb).toContain(defense)
    expect(arguments_.join("\0")).not.toContain("verify:core")
    expect(() => createOmpCliAdapter({
      repositoriesRoot
      verifierId: OMP_VERIFIER_COMMAND_IDENTITY
    })).toThrow("OMP verifier image digest is required")
    expect(dockerCleanupBudgetFor(1_000, 900)).toEqual({
      timeoutMs: 50
      shutdownTimeoutMs: 50
    })
    expect(() => dockerCleanupBudgetFor(1_000, 999))
      .toThrow(OmpProcessTerminationError)
    const verifierConfig = await readFile(new URL(
      "../../../../infra/docker/verifier/checks.json",
      import.meta.url,
    ))
    expect(createHash("sha256").update(verifierConfig).digest("hex"))
      .toBe(OMP_VERIFIER_CONFIG_DIGEST)
    expect(createHash("sha256").update(Buffer.concat([
      verifierConfig,
      Buffer.from(" "),
    ])).digest("hex")).not.toBe(OMP_VERIFIER_CONFIG_DIGEST)
    expect(createHash("sha256")
      .update(JSON.stringify(OMP_VERIFIER_ARGUMENTS))
      .digest("hex")).toBe(OMP_VERIFIER_ARGV_IDENTITY)
  )

  it("cleans named Docker containers on pre-create failure, overflow, and cleanup failure", async () =>
    const inspectIdentity =
      `${VERIFIER_IMAGE_DIGEST}|${OMP_VERIFIER_CONFIG_DIGEST}|${OMP_VERIFIER_ARGV_IDENTITY}`
    const run = () => runDockerVerifier({
      dockerExecutable: "/usr/bin/docker"
      workspace: repositoryDirectory
      sessionDirectory: repositoriesRoot
      imageDigest: VERIFIER_IMAGE_DIGEST
      timeoutMs: 1_000
      shutdownTimeoutMs: 100
      maximumOutputBytes: 64
      redactions: ["custom-docker-sentinel"]
      now: Date.now
    })
    const response = (
      stdout = "",
      stderr = "",
      closeCode = 0,
      stdoutChunks?: readonly (string | Buffer)[],
    ): SandboxResponse => ({
      error: null
      stdout
      stderr
      closeCode
      ...(stdoutChunks === undefined ? {} : { stdoutChunks })
    })

    sandboxResponses.push(
      response(inspectIdentity),
      response("", "mount rejected", 125),
      response("", "No such container", 1),
      response(""),
    )
    await expect(run()).resolves.toMatchObject({ status: "failed", exitCode: 125 })
    const failedRunArguments = sandboxCalls()[1]![1] as readonly string[]
    const containerName = failedRunArguments[
      failedRunArguments.indexOf("--name") + 1
    ]!
    expect(sandboxCalls()[2]![1]).toEqual([
      "container", "rm", "--force", "--volumes", containerName
    ])
    expect(sandboxCalls()[3]![1]).toContain(
      `--filter=name=^/${containerName}$`,
    )

    sandboxResponses.push(
      response(inspectIdentity),
      response("", "", 0, ["x".repeat(65)]),
      response(containerName),
    )
    await expect(run()).resolves.toMatchObject({ status: "output-limit" })

    sandboxResponses.push(
      response(inspectIdentity),
      response("{\"status\":\"passed\"}"),
      response("", "removal denied", 1),
      response("c".repeat(64)),
    )
    await expect(run()).rejects.toBeInstanceOf(OmpProcessTerminationError)

    process.env["OPENAI_API_KEY"] = "provider-docker-sentinel"
    const dockerOptions = sandboxCalls()[1]![2] as Readonly<{
      env: NodeJS.ProcessEnv
    }>
    expect(dockerOptions.env["OPENAI_API_KEY"]).toBeUndefined()
    expect(JSON.stringify(failedRunArguments)).not.toContain("custom-docker-sentinel")
  )
  it("shares one shutdown budget across an aborted verifier and container cleanup", async () =>
    const inspectIdentity =
      `${VERIFIER_IMAGE_DIGEST}|${OMP_VERIFIER_CONFIG_DIGEST}|${OMP_VERIFIER_ARGV_IDENTITY}`
    sandboxResponses.push(
      {
        error: null
        stdout: inspectIdentity
        stderr: ""
      },
      {
        error: null
        stdout: ""
        stderr: ""
        pid: 616_161
        holdOpen: true
      },
      {
        error: null
        stdout: ""
        stderr: ""
        pid: 717_171
        holdOpen: true
      },
    )
    const processKill = vi.spyOn(process, "kill").mockImplementation(() => true)
    const controller = new AbortController()
    try
      const pending = runDockerVerifier({
        dockerExecutable: "/usr/bin/docker"
        workspace: repositoryDirectory
        sessionDirectory: repositoriesRoot
        imageDigest: VERIFIER_IMAGE_DIGEST
        signal: controller.signal
        timeoutMs: 1_000
        shutdownTimeoutMs: 100
        maximumOutputBytes: 64
        redactions: []
        now: Date.now
      })
      await vi.waitFor(() => expect(sandboxCalls()).toHaveLength(2))
      const startedAt = Date.now()
      controller.abort()
      await expect(pending).rejects.toBeInstanceOf(OmpProcessTerminationError)
      expect(Date.now() - startedAt).toBeLessThan(175)
      expect(processKill).toHaveBeenCalledWith(-616_161, "SIGTERM")
      expect(processKill).toHaveBeenCalledWith(-717_171, "SIGTERM")
    finally
      processKill.mockRestore()
  )

  it("normalizes combined verifier output and fails closed on verifier exceptions", async () =>
    const combined = createOmpCliAdapter({
      repositoriesRoot
      verifierMaxResultBytes: 64
      verificationRunner: async () => verifierRunnerResult({
        output: {
          stdout: "  checks passed  "
          stderr: "  one warning  "
          stdoutBytes: 17
          stderrBytes: 15
          truncated: false
          redacted: false
        }
      })
    })
    const prepared = await prepareVerificationWorkspace(combined, "combined-verifier")
    await prepared.implementation.lifecycle!.finalize("persisted")
    callbackWith(null, "generic OMP success")
    const combinedResult = await combined.execute(
      verificationRequestFor(prepared),
    )
    expect(combinedResult.verification).toMatchObject({
      status: "succeeded"
      resultSummary: "checks passed\none warning"
      resultBytes: Buffer.byteLength("checks passed\none warning")
    })
    await combinedResult.lifecycle!.finalize("persisted")

    for error of [
      new Error("verifier unavailable")
      new OmpProcessTerminationError()
    ]
      const adapter = createOmpCliAdapter({
        repositoriesRoot
        verificationRunner: async () =>
          throw error
      })
      const workspaceId = error instanceof OmpProcessTerminationError
        ? "verifier-termination-error"
        : "verifier-ordinary-error"
      const retained = await prepareVerificationWorkspace(adapter, workspaceId)
      await retained.implementation.lifecycle!.finalize("persisted")
      callbackWith(null, "generic OMP success")
      if error instanceof OmpProcessTerminationError
        await expect(adapter.execute(verificationRequestFor(retained)))
          .rejects.toBe(error)
      else
        const result = await adapter.execute(verificationRequestFor(retained))
        expect(result).toMatchObject({ status: "failed", verification: null })
        await result.lifecycle!.finalize("persisted")
  )

  it("builds directory, symlink, and deletion implementation artifacts", async () =>
    const cases = [
      {
        workspaceId: "artifact-directory"
        source: undefined
        mutate: async (cwd: string): Promise<void> =>
          await mkdir(join(cwd, "packages", "jobs", "generated"), { recursive: true })
          return
        expected: {
          path: "packages/jobs/generated"
          kind: "directory"
        }
      }
      {
        workspaceId: "artifact-symlink"
        source: "before"
        mutate: async (cwd: string) =>
          const path = join(cwd, "packages", "jobs", "representative.civet")
          await rm(path)
          await symlink("generated-target", path)
        expected: {
          path: "packages/jobs/representative.civet"
          kind: "symlink"
          target: "generated-target"
        }
      }
      {
        workspaceId: "artifact-deleted"
        source: "before"
        mutate: async (cwd: string) =>
          await rm(join(cwd, "packages", "jobs", "representative.civet"))
        expected: {
          path: "packages/jobs/representative.civet"
          kind: "deleted"
        }
      }
    ] as const
    for testCase of cases
      if testCase.source !== undefined
        await writeFile(scopedFile, testCase.source)
        trackedPaths.add("packages/jobs/representative.civet")
      callbackWith(null, "implemented", "", testCase.mutate)
      const result = await createOmpCliAdapter({ repositoriesRoot }).execute(requestFor({
        workspaceId: testCase.workspaceId
        effectKind: "implement"
      }))
      expect(result.status).toBe("succeeded")
      expect(JSON.parse(result.implementationArtifact!.content).entries)
        .toContainEqual(testCase.expected)
      await result.lifecycle!.finalize("persisted")
      await rm(scopedFile, { force: true })
      trackedPaths.clear()
  )

  it("fails artifact creation for an oversized changed file while retaining bounded change evidence", async () =>
    callbackWith(null, "implemented", "", async (cwd) =>
