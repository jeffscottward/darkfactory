        .rejects.toThrow("OMP verifier control manifest contains unsupported data")
    finally
      mocks.WP1lstatDelegate = undefined
  )

  it("WP1 bounds an implementation manifest at 20,001 unique entries", async () =>
    const unsupportedMetadata = await unsupportedMetadataFor(
      join(repositoryDirectory, "package.json"),
    )
    const virtualNames = Array.from({ length: 20_000 }, (_, index) =>
      `wp1-entry-${String(index).padStart(5, "0")}`
    )
    let WP1scopeRoot = ""
    let WP1expanded = false
    mocks.WP1readdirDelegate = async (actual, path, ...arguments_) =>
      if WP1expanded && String(path) === WP1scopeRoot then return virtualNames
      return await actual(path, ...arguments_)
    mocks.WP1lstatDelegate = async (actual, path, ...arguments_) =>
      if WP1expanded && String(path).startsWith(`${WP1scopeRoot}/wp1-entry-`)
        return unsupportedMetadata
      return await actual(path, ...arguments_)
    callbackWith(null, "implemented", "", async (cwd) =>
      WP1scopeRoot = join(cwd, "packages", "jobs")
      WP1expanded = true
      return
    )
    try
      const result = await createOmpCliAdapter({ repositoriesRoot }).execute(requestFor({
        workspaceId: "wp1-manifest-20001",
        effectKind: "implement",
      }))
      expect(result).toMatchObject({
        status: "failed",
        change: null,
        implementationArtifact: null,
      })
