  it("rejects every malformed implementation artifact envelope and entry shape", () =>
    const changeHash = "c".repeat(64)
    const workspaceKey = "d".repeat(64)
    const ownerNonce = "11111111-1111-4111-8111-111111111111"
    const valueFor = (entries: readonly unknown[]): Readonly<Record<string, unknown>> => ({
      version: 1,
      sourceHead: SOURCE_HEAD,
      workspaceKey,
      ownerNonce,
      changeHash,
      entries,
    })
    const artifactForContent = (
      content: string,
      overrides: Readonly<Record<string, unknown>> = {},
    ): OmpImplementationArtifact => ({
      identity: OMP_IMPLEMENTATION_ARTIFACT_IDENTITY,
      bytes: Buffer.byteLength(content),
      digest: createHash("sha256").update(content).digest("hex"),
      content,
      sourceHead: SOURCE_HEAD,
      workspaceKey,
      ownerNonce,
      changeHash,
      ...overrides,
    } as unknown as OmpImplementationArtifact)
    const artifactFor = (
      value: unknown,
      overrides: Readonly<Record<string, unknown>> = {},
    ): OmpImplementationArtifact =>
      const content = JSON.stringify(value)
      if content === undefined then throw new TypeError("artifact value is not serializable")
      return artifactForContent(content, overrides)
    const valid = artifactFor(valueFor([{ path: "a", kind: "deleted" }]))

    const malformedEnvelopes: readonly OmpImplementationArtifact[] = [
      { ...valid, identity: "wrong" } as unknown as OmpImplementationArtifact,
      { ...valid, bytes: 1.5 },
      { ...valid, bytes: 0 },
      { ...valid, bytes: MAX_OMP_IMPLEMENTATION_ARTIFACT_BYTES + 1 },
      { ...valid, bytes: valid.bytes + 1 },
      { ...valid, digest: "invalid" },
      { ...valid, digest: "f".repeat(64) },
      { ...valid, sourceHead: "invalid" },
      { ...valid, workspaceKey: "invalid" },
      { ...valid, ownerNonce: "invalid" },
      { ...valid, changeHash: "invalid" },
    ]
    for (const artifact of malformedEnvelopes)
      expect(() => decodeOmpImplementationArtifact(artifact, changeHash))
        .toThrow(OmpRequestError)
    expect(() => decodeOmpImplementationArtifact(valid, "e".repeat(64)))
      .toThrow(OmpRequestError)

    const malformedDocuments = [
      artifactForContent("{"),
      artifactFor(null),
      artifactFor([]),
      artifactForContent(` ${JSON.stringify(valueFor([{ path: "a", kind: "deleted" }]))}`),
      artifactFor({
        version: 1,
        sourceHead: SOURCE_HEAD,
        workspaceKey,
        ownerNonce,
        changeHash,
        entries: [{ path: "a", kind: "deleted" }],
        extra: true,
      }),
      artifactFor({ ...valueFor([{ path: "a", kind: "deleted" }]), version: 2 }),
      artifactFor({ ...valueFor([{ path: "a", kind: "deleted" }]), sourceHead: "e".repeat(40) }),
      artifactFor({ ...valueFor([{ path: "a", kind: "deleted" }]), workspaceKey: "e".repeat(64) }),
      artifactFor({
        ...valueFor([{ path: "a", kind: "deleted" }]),
        ownerNonce: "22222222-2222-4222-8222-222222222222",
      }),
      artifactFor({ ...valueFor([{ path: "a", kind: "deleted" }]), changeHash: "e".repeat(64) }),
      artifactFor({ ...valueFor([]), entries: "invalid" }),
      artifactFor(valueFor([])),
      artifactFor(valueFor(Array.from({ length: 513 }, () => 0))),
    ]
    for (const artifact of malformedDocuments)
      expect(() => decodeOmpImplementationArtifact(artifact, changeHash))
        .toThrow(OmpRequestError)

    const malformedEntries: readonly (readonly unknown[])[] = [
      [null],
      [[]],
      ["entry"],
      [{ path: 1, kind: "deleted" }],
      [{ path: "../escape", kind: "deleted" }],
      [{ path: ".", kind: "deleted" }],
      [{ path: "a", kind: "deleted" }, { path: "a", kind: "directory" }],
      [{ path: "packages/jobs/node_modules/shadow", kind: "deleted" }],
      [{ path: "a", kind: "unknown" }],
      [{ path: "a", kind: "directory", extra: true }],
      [{ path: "a", kind: "symlink", target: 1 }],
      [{ path: "a", kind: "symlink", target: "" }],
      [{ path: "a", kind: "symlink", target: "x".repeat(4_097) }],
      [{ path: "a", kind: "symlink", target: "bad\0target" }],
      [{ path: "a", kind: "symlink", target: "/absolute" }],
      [{ path: "a/link", kind: "symlink", target: "../../escape" }],
      [{ path: "a", kind: "file", mode: "644", contentBase64: "" }],
      [{ path: "a", kind: "file", mode: 1.5, contentBase64: "" }],
      [{ path: "a", kind: "file", mode: -1, contentBase64: "" }],
      [{ path: "a", kind: "file", mode: 0o1000, contentBase64: "" }],
      [{ path: "a", kind: "file", mode: 0o600, contentBase64: 1 }],
      [{ path: "a", kind: "file", mode: 0o600, contentBase64: "not-base64" }],
      [{ path: "b", kind: "deleted" }, { path: "a", kind: "deleted" }],
      [
        { path: "a", kind: "file", mode: 0o600, contentBase64: "" },
        { path: "a/b", kind: "deleted" },
      ],
      [
        { path: "a", kind: "symlink", target: "target" },
        { path: "a/b", kind: "deleted" },
      ],
    ]
    for (const entries of malformedEntries)
      expect(() => decodeOmpImplementationArtifact(artifactFor(valueFor(entries)), changeHash))
        .toThrow(OmpRequestError)
  )

  it("applies ordered artifact operations and rejects forged filesystem boundaries", async () =>
    const root = join(repositoriesRoot, "artifact-application")
    await mkdir(root)
    await writeFile(join(root, "a"), "replace-directory")
    const artifact: DecodedOmpImplementationArtifact = Object.freeze({
      sourceHead: SOURCE_HEAD,
      workspaceKey: "d".repeat(64),
      ownerNonce: "11111111-1111-4111-8111-111111111111",
      changeHash: "c".repeat(64),
      entries: Object.freeze([
        Object.freeze({ path: "z", kind: "deleted" as const }),
        Object.freeze({ path: "z/child", kind: "deleted" as const }),
        Object.freeze({ path: "a/b", kind: "directory" as const }),
        Object.freeze({ path: "a", kind: "directory" as const }),
        Object.freeze({
          path: "a/b/file",
          kind: "file" as const,
          mode: 0o640,
          contentBase64: Buffer.from("recovered").toString("base64"),
        }),
        Object.freeze({ path: "a/link", kind: "symlink" as const, target: "b/file" }),
        Object.freeze({ path: "missing-link", kind: "symlink" as const, target: "missing/target" }),
        Object.freeze({ path: "self-link", kind: "symlink" as const, target: "." }),
      ]),
    })

    await applyOmpImplementationArtifact(root, artifact)

    expect(await readFile(join(root, "a", "b", "file"), "utf8")).toBe("recovered")
    expect(await readlink(join(root, "a", "link"))).toBe("b/file")
    expect(await readlink(join(root, "missing-link"))).toBe("missing/target")
    expect(await readlink(join(root, "self-link"))).toBe(".")

    const alias = join(repositoriesRoot, "artifact-application-alias")
    await symlink(root, alias)
    await expect(applyOmpImplementationArtifact(alias, artifact)).rejects.toThrow(OmpRequestError)
    const fileRoot = join(repositoriesRoot, "artifact-file-root")
    await writeFile(fileRoot, "not-directory")
    await expect(applyOmpImplementationArtifact(fileRoot, artifact)).rejects.toThrow(OmpRequestError)

    await writeFile(join(root, "intermediate-file"), "blocked")
    await expect(applyOmpImplementationArtifact(root, {
      ...artifact,
      entries: [{
        path: "unsafe-link",
        kind: "symlink",
        target: "intermediate-file/child",
      }],
    })).rejects.toThrow(OmpRequestError)
    await symlink("a", join(root, "intermediate-link"))
    await expect(applyOmpImplementationArtifact(root, {
      ...artifact,
      entries: [{
        path: "unsafe-symlink-target",
        kind: "symlink",
        target: "intermediate-link/b/file",
      }],
    })).rejects.toThrow(OmpRequestError)
  )

  it("rejects forged apply paths before any filesystem mutation", async () =>
    const root = join(repositoriesRoot, "forged-artifact-application")
    const marker = join(root, "marker.txt")
    const outside = join(repositoriesRoot, "outside.txt")
    await mkdir(root)
    await writeFile(marker, "preserved")
    await writeFile(outside, "outside-preserved")
    const artifactFor = (
      entries: readonly unknown[],
    ): DecodedOmpImplementationArtifact => ({
      sourceHead: SOURCE_HEAD,
      workspaceKey: "d".repeat(64),
      ownerNonce: "11111111-1111-4111-8111-111111111111",
      changeHash: "c".repeat(64),
      entries,
    } as unknown as DecodedOmpImplementationArtifact)
    const forgedCases = [
      {
        label: "dot",
        entries: [
          { path: "marker.txt", kind: "deleted" },
          { path: ".", kind: "deleted" },
        ],
      },
      {
        label: "traversal",
        entries: [
          { path: "marker.txt", kind: "deleted" },
          { path: "../outside.txt", kind: "deleted" },
        ],
      },
      {
        label: "dependency",
        entries: [
          { path: "marker.txt", kind: "deleted" },
          { path: "node_modules/forged", kind: "directory" },
        ],
      },
      {
        label: "duplicate",
        entries: [
          { path: "marker.txt", kind: "deleted" },
          { path: "marker.txt", kind: "directory" },
        ],
      },
      {
        label: "invalid-parent",
        entries: [
          { path: "marker.txt", kind: "deleted" },
          { path: "parent", kind: "file", mode: 0o600, contentBase64: "" },
          { path: "parent/child", kind: "deleted" },
        ],
      },
    ] as const

    for (const testCase of forgedCases)
      await expect(applyOmpImplementationArtifact(
        root,
        artifactFor(testCase.entries),
      )).rejects.toThrow("OMP implementation artifact is invalid")
      expect(await readFile(marker, "utf8"), testCase.label).toBe("preserved")
      expect(await readFile(outside, "utf8"), testCase.label)
        .toBe("outside-preserved")
  )

  it("covers symlinked, missing, and escaped verifier manifests", async () =>
    const controlTarget = join(repositoryDirectory, "control-target")
    await writeFile(controlTarget, "control")
    await symlink("control-target", join(repositoryDirectory, "tsconfig.json"))
    const manifest = await trustedVerifierManifestFor(repositoryDirectory)
    expect(manifest.entries).toContainEqual({
      path: "tsconfig.json",
      digest: expect.stringMatching(/^link:[a-f0-9]{64}$/u),
    })
    expect(isVerifierControlPath("")).toBe(false)
    await expect(
      matchesTrustedVerifierManifest(join(repositoryDirectory, "missing"), manifest),
    ).resolves.toBe(false)

    const escapedRoot = join(repositoriesRoot, "escaped-manifest")
    await mkdir(escapedRoot)
    const outsidePackage = join(repositoriesRoot, "outside-package.json")
    await writeFile(outsidePackage, "{}")
    await symlink(outsidePackage, join(escapedRoot, "package.json"))
    await expect(trustedVerifierManifestFor(escapedRoot))
      .rejects.toThrow("OMP verifier manifest is outside source")

    const oversizedRoot = join(repositoriesRoot, "oversized-manifest")
    await mkdir(oversizedRoot)
    await writeFile(join(oversizedRoot, "package.json"), "{}")
    const oversizedControl = await open(join(oversizedRoot, "tsconfig.json"), "w")
    await oversizedControl.truncate(32 * 1_024 * 1_024 + 1)
    await oversizedControl.close()
    await expect(trustedVerifierManifestFor(oversizedRoot))
      .rejects.toThrow("OMP verifier control manifest is oversized")

  )

  it("rejects each malformed Docker verifier identity component", () =>
    const validName = "darkfactory-verifier-11111111-1111-4111-8111-111111111111"
    const validDigest = `sha256:${"a".repeat(64)}`
    const cases = [
      ["workspace", "relative", "/tmp/cid", validDigest, validName],
      ["cid", "/tmp/workspace", "relative", validDigest, validName],
      ["workspace NUL", "/tmp/workspace\0bad", "/tmp/cid", validDigest, validName],
      ["cid NUL", "/tmp/workspace", "/tmp/cid\0bad", validDigest, validName],
      ["digest", "/tmp/workspace", "/tmp/cid", "sha256:bad", validName],
      ["name", "/tmp/workspace", "/tmp/cid", validDigest, "bad"],
    ] as const
    for (const [_label, workspace, cidPath, digest, name] of cases)
      expect(() => dockerVerifierArgumentsFor(workspace, cidPath, digest, name))
        .toThrow(OmpConfigurationError)
  )

