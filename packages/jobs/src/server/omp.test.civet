  it("surfaces process termination failures from error-path worktree disposal", async () =>
    const processKill = vi.spyOn(process, "kill").mockImplementation(() => true)
    let dateNow: { mockRestore: () => void } | undefined
    mocks.spawn.mockImplementationOnce(() =>
      dateNow = vi.spyOn(Date, "now")
        .mockReturnValueOnce(0)
        .mockReturnValue(1_000)
      mocks.execFile.mockImplementationOnce((
        _executable: string,
        _arguments: readonly string[],
        _options: unknown,
        callback: (error: NodeJS.ErrnoException | null) => void,
      ) =>
        const child = Object.assign(new EventEmitter(), {
          pid: 737_373
          kill: vi.fn(() => true)
        })
        queueMicrotask(() =>
          callback(Object.assign(new Error("git cleanup failed"), { code: "EIO" }))
        )
        child
      )
      throw new Error("spawn unavailable")
    )
    try
      await expect(createOmpCliAdapter({ repositoriesRoot }).execute(
        requestFor({ workspaceId: "error-cleanup-termination" }),
      )).rejects.toBeInstanceOf(OmpProcessTerminationError)
    finally
      dateNow?.mockRestore()
      processKill.mockRestore()
  )

  it("fails closed for dangerous repository program configuration", async () =>
