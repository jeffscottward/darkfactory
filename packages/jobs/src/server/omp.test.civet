import { afterEach, beforeEach, describe, expect, it, vi } from "vitest"
import { MAX_WORKFLOW_SCOPE_PATHS } from "@darkfactory/state/workflow"

type WPFilesystemDelegate = (
  actual: (...arguments_: any[]) => any,
  ...arguments_: any[]
) => any

const mocks = vi.hoisted(() => ({
  execFile: vi.fn(),
  spawn: vi.fn(),
  WP1lstatDelegate: undefined as WPFilesystemDelegate | undefined,
  WP1readdirDelegate: undefined as WPFilesystemDelegate | undefined,
  WP2mkdirDelegate: undefined as WPFilesystemDelegate | undefined,
  WP2readFileDelegate: undefined as WPFilesystemDelegate | undefined,
  WP2readdirDelegate: undefined as WPFilesystemDelegate | undefined,
  WP2realpathDelegate: undefined as WPFilesystemDelegate | undefined,
  WP2renameDelegate: undefined as WPFilesystemDelegate | undefined,
  WP2rmDelegate: undefined as WPFilesystemDelegate | undefined,
  WP2statDelegate: undefined as WPFilesystemDelegate | undefined,
  WP2writeFileDelegate: undefined as WPFilesystemDelegate | undefined,
  WP3accessDelegate: undefined as WPFilesystemDelegate | undefined,
  WP3realpathDelegate: undefined as WPFilesystemDelegate | undefined,
  WP3statDelegate: undefined as WPFilesystemDelegate | undefined,
  WP4lstatDelegate: undefined as WPFilesystemDelegate | undefined,
  WP4readFileDelegate: undefined as WPFilesystemDelegate | undefined,
  WP4openDelegate: undefined as WPFilesystemDelegate | undefined,
}))

vi.mock("node:child_process", () => ({
  execFile: mocks.execFile,
  spawn: mocks.spawn,
}))

vi.mock("node:fs/promises", async (importOriginal) =>
  const actual = await importOriginal<typeof import("node:fs/promises")>()
  const delegateFor = (
    delegate: () => WPFilesystemDelegate | undefined,
    implementation: (...arguments_: any[]) => any,
  ) => (...arguments_: any[]) =>
    const selected = delegate()
    if selected === undefined
      return implementation(...arguments_)
    return selected(implementation, ...arguments_)
  return {
    ...actual,
    open: delegateFor(() => mocks.WP4openDelegate, actual.open),
    access: delegateFor(() => mocks.WP3accessDelegate, actual.access),
    lstat: (...arguments_: any[]) =>
      if mocks.WP4lstatDelegate !== undefined
        return mocks.WP4lstatDelegate(actual.lstat, ...arguments_)
      return delegateFor(() => mocks.WP1lstatDelegate, actual.lstat)(...arguments_)
    mkdir: delegateFor(() => mocks.WP2mkdirDelegate, actual.mkdir),
    readFile: (...arguments_: any[]) =>
      if mocks.WP4readFileDelegate !== undefined
        return mocks.WP4readFileDelegate(actual.readFile, ...arguments_)
      return delegateFor(() => mocks.WP2readFileDelegate, actual.readFile)(...arguments_)
    readdir: (...arguments_: any[]) =>
      if mocks.WP1readdirDelegate !== undefined
        return mocks.WP1readdirDelegate(actual.readdir, ...arguments_)
      return delegateFor(() => mocks.WP2readdirDelegate, actual.readdir)(...arguments_)
    realpath: (...arguments_: any[]) =>
      if mocks.WP2realpathDelegate !== undefined
        return mocks.WP2realpathDelegate(actual.realpath, ...arguments_)
      return delegateFor(() => mocks.WP3realpathDelegate, actual.realpath)(...arguments_)
    rename: delegateFor(() => mocks.WP2renameDelegate, actual.rename),
    rm: delegateFor(() => mocks.WP2rmDelegate, actual.rm),
    stat: (...arguments_: any[]) =>
      if mocks.WP2statDelegate !== undefined
        return mocks.WP2statDelegate(actual.stat, ...arguments_)
      return delegateFor(() => mocks.WP3statDelegate, actual.stat)(...arguments_)
    writeFile: delegateFor(() => mocks.WP2writeFileDelegate, actual.writeFile),
  }
)

import {
  MAX_OMP_INSTRUCTION_BYTES,
  OMP_WAYFINDER_SKILLS,
  MAX_OMP_WAYFINDER_MAP_BYTES,
  captureOmpWayfinderTrackerArtifact,
  validateOmpWayfinderTrackerArtifact,
  MAX_OMP_IMPLEMENTATION_ARTIFACT_BYTES,
  OMP_IMPLEMENTATION_ARTIFACT_IDENTITY,
  MAX_OMP_REDACTIONS,
  OmpConfigurationError,
  OmpRequestError,
  OmpProcessTerminationError,
  OmpWorkspaceCleanupError,
  OmpWorkspaceBusyError,
  applyOmpImplementationArtifact,
  createOmpCliAdapter as createProductionOmpCliAdapter,
  ompVerificationDigestFor,
  OMP_VERIFIER_COMMAND_IDENTITY,
  dockerVerifierArgumentsFor,
  dockerCleanupBudgetFor,
  decodeOmpImplementationArtifact,
  runDockerVerifier,
  OMP_VERIFIER_CONFIG_DIGEST,
  OMP_VERIFIER_MEMORY,
  OMP_VERIFIER_MEMORY_SWAP,
  OMP_VERIFIER_CPUS,
  OMP_VERIFIER_PIDS,
  OMP_VERIFIER_FILE_SIZE,
  OMP_VERIFIER_NOFILE,
  isVerifierControlPath,
  matchesTrustedVerifierManifest,
  trustedVerifierManifestFor,
  OMP_VERIFIER_ARGUMENTS,
  OMP_VERIFIER_ARGV_IDENTITY,
  OMP_VERIFIER_OUTPUT_TMPFS,
  OMP_VERIFIER_CACHE_TMPFS,
  OMP_VERIFIER_TMP_TMPFS,
  type OmpCliAdapterOptions,
