    )
    await prepared.implementation.lifecycle!.finalize("persisted")
    const WP4controlEvents: string[] = []
    mocks.WP4lstatDelegate = async (actual, path, ...arguments_) =>
      const file = String(path)
      if (
        WP4controlEvents.length === 0 &&
