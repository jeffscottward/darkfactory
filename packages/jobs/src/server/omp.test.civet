  it("fails closed on an uncorrelated live-owner workspace lock without spawning", async () =>
    const workspaceId = "locked-run"
    const worktreesRoot = await realpath(join(tmpdir(), "darkfactory-omp-worktrees"))
    const workspaceKey = createHash("sha256")
      .update(`${repositoryDirectory}\0${workspaceId}`)
      .digest("hex")
    const lockDirectory = `${join(worktreesRoot, workspaceKey)}.lock`
    const owner = JSON.stringify({
      nonce: randomUUID()
      pid: process.pid
      createdAt: 1
    })
    await mkdir(lockDirectory, { mode: 0o700 })
    await writeFile(join(lockDirectory, "owner.json"), owner, { mode: 0o600 })
    try
      const adapter = createOmpCliAdapter({ repositoriesRoot })
      await expect(adapter.execute(requestFor({ workspaceId })))
        .rejects.toThrow("OMP workspace requires operator cleanup (owner identity changed)")
      expect(gitCalls().filter(
        (call) => (call[1] as readonly string[])[0] === "worktree",
      )).toHaveLength(0)
      expect(sandboxCalls()).toHaveLength(0)
      await expect(readFile(join(lockDirectory, "owner.json"), "utf8"))
        .resolves.toBe(owner)
    finally
      await rm(lockDirectory, { recursive: true, force: true })
  )

