  it("preserves verifier runner termination when verifier lock release fails", async () =>
    const terminationError = new OmpProcessTerminationError()
    let verifierLock = ""
    let lockReleaseAttempts = 0
    const verificationRunner = vi.fn(async ({ cwd }: Readonly<{ cwd: string }>) =>
      verifierLock = `${cwd}.lock`
      mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
        if String(path) === verifierLock
          lockReleaseAttempts += 1
          throw WP2errno("EIO")
        return actual(path, ...arguments_)
      throw terminationError
    )
    const adapter = createOmpCliAdapter({ repositoriesRoot, verificationRunner })
    const prepared = await prepareVerificationWorkspace(
      adapter,
      "WP4-runner-termination-release-failure",
    )
    await prepared.implementation.lifecycle!.finalize("persisted")
    callbackWith(null, "verification")

    try
      await expect(adapter.execute(verificationRequestFor(prepared)))
        .rejects.toBe(terminationError)
    finally
      mocks.WP2rmDelegate = undefined
    expect(verificationRunner).toHaveBeenCalledOnce()
    expect(lockReleaseAttempts).toBe(1)
    await expect(access(verifierLock)).resolves.toBeUndefined()
  )

  it("keeps a retained worktree locked when release no longer owns it", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const prepared = await prepareVerificationWorkspace(
      adapter,
      "final-release-owner-changed",
    )
    const lockDirectory = `${prepared.workspaceDirectory}.lock`
    const ownerPath = join(lockDirectory, "owner.json")
    const originalOwner = JSON.parse(
      await readFile(ownerPath, "utf8"),
    ) as Readonly<{ nonce: string, pid: number, createdAt: number }>
    const changedOwner = {
      ...originalOwner,
      nonce: WP2differentNonce(originalOwner.nonce),
    }
    await writeFile(ownerPath, JSON.stringify(changedOwner))
    let ownerReads = 0
    let lockRemovals = 0
    mocks.WP2readFileDelegate = async (actual, path, ...arguments_) =>
      if String(path) === ownerPath then ownerReads += 1
      return await actual(path, ...arguments_)
    mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
      if String(path) === lockDirectory then lockRemovals += 1
      return await actual(path, ...arguments_)

    await expect(prepared.implementation.lifecycle!.finalize("persisted"))
      .resolves.toBeUndefined()

    mocks.WP2readFileDelegate = undefined
    mocks.WP2rmDelegate = undefined
    expect(ownerReads).toBe(1)
    expect(lockRemovals).toBe(0)
    expect(JSON.parse(await readFile(ownerPath, "utf8"))).toEqual(changedOwner)
    await expect(access(prepared.workspaceDirectory)).resolves.toBeUndefined()
  )

  it("rejects canonical worktree escapes and both workspace identity mismatches", async () =>
    const worktreesRoot = await realpath(join(tmpdir(), "darkfactory-omp-worktrees"))
    const workspaceFor = (workspaceId: string): string =>
      join(
        worktreesRoot,
        createHash("sha256")
          .update(`${repositoryDirectory}\0${workspaceId}`)
          .digest("hex"),
      )

    const escapedId = "final-canonical-worktree-escape"
    const escapedWorkspace = workspaceFor(escapedId)
    const escapedRealpathEvents: string[] = []
    let escapedPhase = "preparation"
    mocks.WP2realpathDelegate = async (actual, path, ...arguments_) =>
      if String(path) === escapedWorkspace
        escapedRealpathEvents.push(`${escapedPhase}:${String(path)}`)
        if escapedPhase === "preparation"
          escapedPhase = "cleanup"
          return repositoryDirectory
      return await actual(path, ...arguments_)
    await expect(createOmpCliAdapter({ repositoriesRoot }).execute(
      requestFor({ workspaceId: escapedId }),
    )).rejects.toThrow("OMP workspace path is invalid")
    mocks.WP2realpathDelegate = undefined
    expect(escapedRealpathEvents).toEqual(expect.arrayContaining([
      `preparation:${escapedWorkspace}`,
      `cleanup:${escapedWorkspace}`,
    ]))
    expect(sandboxCalls()).toHaveLength(0)

    const topLevelId = "final-workspace-top-level-mismatch"
    const topLevelWorkspace = workspaceFor(topLevelId)
    const topLevelRealpathEvents: string[] = []
    let topLevelPhase = "canonical-workspace"
    mocks.WP2realpathDelegate = async (actual, path, ...arguments_) =>
      if String(path) === topLevelWorkspace
        topLevelRealpathEvents.push(`${topLevelPhase}:${String(path)}`)
        if topLevelPhase === "canonical-workspace"
          topLevelPhase = "source-top-level"
        else if topLevelPhase === "source-top-level"
          topLevelPhase = "cleanup"
          return repositoryDirectory
      return await actual(path, ...arguments_)
    await expect(createOmpCliAdapter({ repositoriesRoot }).execute(
      requestFor({ workspaceId: topLevelId }),
    )).rejects.toThrow("OMP workspace source identity changed")
    mocks.WP2realpathDelegate = undefined
    expect(topLevelRealpathEvents).toEqual(expect.arrayContaining([
      `canonical-workspace:${topLevelWorkspace}`,
      `source-top-level:${topLevelWorkspace}`,
      `cleanup:${topLevelWorkspace}`,
    ]))
    expect(sandboxCalls()).toHaveLength(0)

    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const retained = await prepareVerificationWorkspace(
      adapter,
      "final-workspace-head-mismatch",
    )
    await retained.implementation.lifecycle!.finalize("persisted")
    mocks.spawn.mockClear()
    gitResponseOverrides.set(["rev-parse", "HEAD"].join("\0"), "b".repeat(40))
    await expect(adapter.execute(verificationRequestFor(retained)))
      .rejects.toThrow("OMP workspace source identity changed")
    gitResponseOverrides.delete(["rev-parse", "HEAD"].join("\0"))
    expect(sandboxCalls()).toHaveLength(0)
  )

  it("releases preparation ownership without masking the original identity error", async () =>
    const workspaceId = "final-prepare-cleanup-failure"
    const worktreesRoot = await realpath(join(tmpdir(), "darkfactory-omp-worktrees"))
    const workspaceDirectory = join(
      worktreesRoot,
      createHash("sha256")
        .update(`${repositoryDirectory}\0${workspaceId}`)
        .digest("hex"),
    )
    const lockDirectory = `${workspaceDirectory}.lock`
    let workspaceRealpaths = 0
    let cleanupRootReads = 0
    let lockRemovals = 0
    mocks.WP2realpathDelegate = async (actual, path, ...arguments_) =>
      if String(path) === workspaceDirectory
        workspaceRealpaths += 1
        if workspaceRealpaths === 2 then return repositoryDirectory
      return await actual(path, ...arguments_)
    mocks.WP2readdirDelegate = async (actual, path, ...arguments_) =>
      if String(path) === worktreesRoot
        cleanupRootReads += 1
        throw WP2errno("EIO")
      return await actual(path, ...arguments_)
    mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
      if String(path) === lockDirectory then lockRemovals += 1
      return await actual(path, ...arguments_)

    await expect(createOmpCliAdapter({ repositoriesRoot }).execute(
      requestFor({ workspaceId }),
    )).rejects.toThrow("OMP workspace source identity changed")

    mocks.WP2realpathDelegate = undefined
    mocks.WP2readdirDelegate = undefined
    mocks.WP2rmDelegate = undefined
    expect(cleanupRootReads).toBe(1)
    expect(lockRemovals).toBe(1)
    await expect(access(lockDirectory)).rejects.toMatchObject({ code: "ENOENT" })
  )

  it("rethrows process termination from failed worktree preparation after attempting its lock release", async () =>
    const workspaceId = "final-prepare-cleanup-termination"
    const worktreesRoot = await realpath(join(tmpdir(), "darkfactory-omp-worktrees"))
    const workspaceDirectory = join(
      worktreesRoot,
      createHash("sha256")
        .update(`${repositoryDirectory}\0${workspaceId}`)
        .digest("hex"),
    )
    const lockDirectory = `${workspaceDirectory}.lock`
    const realpathEvents: string[] = []
    let phase = "canonical-workspace"
    let termination: ReturnType<typeof WP4terminateNextGitCleanup> | undefined
    let lockReleaseAttempts = 0
    mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
      if String(path) === lockDirectory
        lockReleaseAttempts += 1
        throw WP2errno("EIO")
      return actual(path, ...arguments_)
    mocks.WP2realpathDelegate = async (actual, path, ...arguments_) =>
      if String(path) === workspaceDirectory
        realpathEvents.push(`${phase}:${String(path)}`)
        if phase === "canonical-workspace"
          phase = "source-top-level"
        else if phase === "source-top-level"
          phase = "cleanup"
          termination = WP4terminateNextGitCleanup(858_585)
          return repositoryDirectory
      return await actual(path, ...arguments_)

    try
      await expect(createOmpCliAdapter({ repositoriesRoot }).execute(
        requestFor({ workspaceId }),
      )).rejects.toBeInstanceOf(OmpProcessTerminationError)
    finally
      mocks.WP2realpathDelegate = undefined
      mocks.WP2rmDelegate = undefined
      termination?.dateNow.mockRestore()
      termination?.processKill.mockRestore()
    expect(realpathEvents).toEqual(expect.arrayContaining([
      `canonical-workspace:${workspaceDirectory}`,
      `source-top-level:${workspaceDirectory}`,
    ]))
    expect(sandboxCalls()).toHaveLength(0)
    expect(lockReleaseAttempts).toBe(1)
    await expect(access(lockDirectory)).resolves.toBeUndefined()
  )

  it("rethrows a non-ESRCH process-group signal failure", async () =>
    const controller = new AbortController()
    const pid = 929_292
    sandboxResponses.push({
      error: null,
      stdout: "",
      stderr: "",
      pid,
      holdOpen: true,
    })
    const permissionError = Object.assign(
      new Error("process group signal denied"),
      { code: "EPERM" },
    )
    const processKill = vi.spyOn(process, "kill").mockImplementation(() =>
      throw permissionError
    )
    const pending = runDockerVerifier({
      dockerExecutable: "/usr/bin/docker",
      workspace: repositoryDirectory,
      sessionDirectory: repositoriesRoot,
      imageDigest: VERIFIER_IMAGE_DIGEST,
      signal: controller.signal,
      timeoutMs: 100,
      shutdownTimeoutMs: 20,
      maximumOutputBytes: 64,
      redactions: [],
      now: Date.now,
    })
    await vi.waitFor(() =>
      expect(sandboxCalls().at(-1)?.[1]).toContain("image")
    )
    controller.abort()
    try
      await expect(pending).rejects.toBe(permissionError)
      expect(processKill).toHaveBeenCalledWith(-pid, "SIGTERM")
    finally
      processKill.mockRestore()
      sandboxResponses.length = 0
  )

  it("rejects each recovered implementation mismatch after valid preflight", async () =>
    for mismatch of ["change-hash", "artifact-digest", "artifact-content"] as const
      const adapter = createOmpCliAdapter({
        repositoriesRoot,
        verificationRunner: async () => verifierRunnerResult(),
      })
      const prepared = await prepareVerificationWorkspace(
        adapter,
        `final-recovery-${mismatch}`,
      )
      await prepared.implementation.lifecycle!.finalize("persisted")
      const changeHash = prepared.implementation.change!.changeHash
      const mutableArtifact = {
        ...prepared.implementation.implementationArtifact!,
      }
      expect(() =>
        decodeOmpImplementationArtifact(mutableArtifact, changeHash)
      ).not.toThrow()
      const recoveredFile = join(
        prepared.workspaceDirectory,
        "packages",
        "jobs",
        "representative.civet",
      )
      let boundaryMutations = 0
      let recoveredFileReads = 0
      if mismatch === "change-hash"
        mocks.WP2writeFileDelegate = async (actual, path, ...arguments_) =>
          const result = await actual(path, ...arguments_)
          if String(path) === recoveredFile
            boundaryMutations += 1
            await actual(path, Buffer.from("changed-after-valid-recovery"))
          return result
      else
        mocks.WP4readFileDelegate = async (actual, path, ...arguments_) =>
          const result = await actual(path, ...arguments_)
          if String(path) === recoveredFile
            recoveredFileReads += 1
            if recoveredFileReads === 1
              boundaryMutations += 1
              if mismatch === "artifact-digest"
                mutableArtifact.digest = "f".repeat(64)
              else
                mutableArtifact.content = `${mutableArtifact.content} `
          return result
      const request = requestFor({
        workspaceId: prepared.workspaceId,
        effectKind: "verify",
        recovery: {
          artifact: mutableArtifact,
          changeHash,
        },
      })

      await expect(adapter.execute(request))
        .rejects.toThrow("OMP recovered implementation digest changed")

      mocks.WP2writeFileDelegate = undefined
      mocks.WP4readFileDelegate = undefined
      expect(boundaryMutations).toBe(1)
      if mismatch !== "change-hash" then expect(recoveredFileReads).toBe(1)
  )

