  it("rejects expired retained cleanup deadlines", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const prepared = await prepareVerificationWorkspace(adapter, "expired-cleanup")
    await prepared.implementation.lifecycle!.finalize("persisted")

    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: prepared.implementation.implementationArtifact!,
        changeHash: prepared.implementation.change!.changeHash,
      },
      deadlineAtMs: Date.now() - 1,
    })).rejects.toThrow("OMP workspace cleanup aborted")
    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: prepared.implementation.implementationArtifact!,
        changeHash: prepared.implementation.change!.changeHash,
      },
      deadlineAtMs: 0,
    })).rejects.toThrow("OMP workspace cleanup deadline is invalid")

    const worktreesRoot = join(tmpdir(), "darkfactory-omp-worktrees")
    await chmod(worktreesRoot, 0o755)
    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: prepared.implementation.implementationArtifact!,
        changeHash: prepared.implementation.change!.changeHash,
      },
    })).rejects.toThrow("OMP worktree root is insecure")
    await chmod(worktreesRoot, 0o700)

    await rm(`${prepared.workspaceDirectory}.owner.json`, { force: true })
    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: prepared.implementation.implementationArtifact!,
        changeHash: prepared.implementation.change!.changeHash,
      },
    })).rejects.toThrow("OMP workspace cleanup ownership changed")

    const topLevel = await prepareVerificationWorkspace(adapter, "cleanup-top-level")
    await topLevel.implementation.lifecycle!.finalize("persisted")
    gitResponseOverrides.set(
      ["rev-parse", "--show-toplevel"].join("\0"),
      repositoriesRoot,
    )
    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: topLevel.implementation.implementationArtifact!,
        changeHash: topLevel.implementation.change!.changeHash,
      },
    })).rejects.toThrow("OMP cwd must be a git worktree root")
    gitResponseOverrides.delete(["rev-parse", "--show-toplevel"].join("\0"))

    const gitDirectory = await prepareVerificationWorkspace(adapter, "cleanup-git-directory")
    await gitDirectory.implementation.lifecycle!.finalize("persisted")
    gitResponseOverrides.set(
      ["rev-parse", "--absolute-git-dir"].join("\0"),
      repositoriesRoot,
    )
    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: gitDirectory.implementation.implementationArtifact!,
        changeHash: gitDirectory.implementation.change!.changeHash,
      },
    })).rejects.toThrow("OMP source git directory is invalid")
    gitResponseOverrides.delete(["rev-parse", "--absolute-git-dir"].join("\0"))

    const signaledCleanup = await prepareVerificationWorkspace(adapter, "cleanup-with-signal")
    await signaledCleanup.implementation.lifecycle!.finalize("persisted")
    const cleanupController = new AbortController()
    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: signaledCleanup.implementation.implementationArtifact!,
        changeHash: signaledCleanup.implementation.change!.changeHash,
      },
      signal: cleanupController.signal,
    })).resolves.toBeUndefined()


    const abortedGit = await prepareVerificationWorkspace(adapter, "cleanup-aborted-git")
    await abortedGit.implementation.lifecycle!.finalize("persisted")
    let abortedReads = 0
    const stagedAbortController = new AbortController()
    Object.defineProperty(stagedAbortController.signal, "aborted", {
      configurable: true,
      get: () =>
        abortedReads += 1
        return abortedReads > 1
    })
    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: abortedGit.implementation.implementationArtifact!,
        changeHash: abortedGit.implementation.change!.changeHash,
      },
      signal: stagedAbortController.signal,
    })).rejects.toThrow("OMP git workspace operation aborted")

    await rm(worktreesRoot, { recursive: true, force: true })
    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory",
      recovery: {
        artifact: gitDirectory.implementation.implementationArtifact!,
        changeHash: gitDirectory.implementation.change!.changeHash,
      },
    })).resolves.toBeUndefined()
    await mkdir(worktreesRoot, { mode: 0o700 })
    await chmod(worktreesRoot, 0o700)
  )
  it("covers Docker inspection rejection, abort, cleanup cid, and process-group races", async () =>
    const inspectIdentity =
      `${VERIFIER_IMAGE_DIGEST}|${OMP_VERIFIER_CONFIG_DIGEST}|${OMP_VERIFIER_ARGV_IDENTITY}`
    const run = (signal?: AbortSignal) => runDockerVerifier({
      dockerExecutable: "/usr/bin/docker",
      workspace: repositoryDirectory,
      sessionDirectory: repositoriesRoot,
      imageDigest: VERIFIER_IMAGE_DIGEST,
      ...(signal === undefined ? {} : { signal }),
      timeoutMs: 100,
      shutdownTimeoutMs: 20,
      maximumOutputBytes: 64,
      redactions: [],
      now: Date.now,
    })
    const response = (
      stdout = "",
      stderr = "",
      closeCode = 0,
      mutate?: (cwd: string) => Promise<void>,
    ): SandboxResponse => ({
      error: null,
      stdout,
      stderr,
      closeCode,
      ...(mutate === undefined ? {} : { mutate }),
    })

    sandboxResponses.push(response("", "inspect failed", 1))
    await expect(run()).resolves.toMatchObject({ status: "failed", exitCode: 1 })
    sandboxResponses.length = 0

    sandboxResponses.push(response("wrong-image-identity"))
    await expect(run()).rejects.toThrow("OMP Docker verifier image digest mismatch")
    sandboxResponses.length = 0

    const alreadyAborted = new AbortController()
    alreadyAborted.abort()
    await expect(run(alreadyAborted.signal)).resolves.toMatchObject({
      status: "aborted",
      exitCode: null,
    })
    sandboxResponses.length = 0

    sandboxResponses.push(
      response(inspectIdentity),
      response("passed", "", 0, async () =>
        const arguments_ = sandboxCalls().at(-1)![1] as readonly string[]
        const cidPath = arguments_[arguments_.indexOf("--cidfile") + 1]!
        await writeFile(cidPath, "invalid-cid")
      ),
      response(),
    )
    await expect(run()).rejects.toBeInstanceOf(OmpProcessTerminationError)
    sandboxResponses.length = 0

    sandboxResponses.push(
      response(inspectIdentity),
      response("passed", "", 0, async () =>
        const arguments_ = sandboxCalls().at(-1)![1] as readonly string[]
        const cidPath = arguments_[arguments_.indexOf("--cidfile") + 1]!
        await mkdir(cidPath)
      ),
      response(),
    )
    await expect(run()).rejects.toMatchObject({ code: expect.any(String) })
    sandboxResponses.length = 0

    const abortController = new AbortController()
    sandboxResponses.push({
      error: null,
      stdout: "",
      stderr: "",
      pid: 818_181,
      holdOpen: true,
    })
    const processKill = vi.spyOn(process, "kill").mockImplementation((
      _pid: number,
      signal?: string | number,
    ) =>
      const error = new Error("gone") as NodeJS.ErrnoException
      error.code = "ESRCH"
      throw error
    )
    const pendingAbort = run(abortController.signal)
    await vi.waitFor(() => expect(sandboxCalls().at(-1)?.[1]).toContain("image"))
    abortController.abort()
    await expect(pendingAbort).resolves.toMatchObject({ status: "aborted" })
    processKill.mockRestore()
    sandboxResponses.length = 0

    const permissionController = new AbortController()
    sandboxResponses.push({
      error: null,
      stdout: "",
      stderr: "",
      pid: 919_191,
      holdOpen: true,
    })
    const permissionKill = vi.spyOn(process, "kill").mockImplementation((
      _pid: number,
      signal?: string | number,
    ) =>
      if signal === 0
        const error = new Error("permission denied") as NodeJS.ErrnoException
        error.code = "EPERM"
        throw error
      return true
    )
    const pendingPermission = run(permissionController.signal)
    await vi.waitFor(() => expect(sandboxCalls().at(-1)?.[1]).toContain("image"))
    permissionController.abort()
    await expect(pendingPermission).rejects.toBeInstanceOf(OmpProcessTerminationError)
    permissionKill.mockRestore()
    sandboxResponses.length = 0
  )

  it("fails verification when OMP removes all changes or edits a control input", async () =>
    const verifyMutation = async (
      workspaceId: string,
      mutate: (cwd: string) => Promise<void>,
      expectedChange?: string,
    ): Promise<void> =>
      const adapter = createOmpCliAdapter({
        repositoriesRoot,
        verificationRunner: async () => verifierRunnerResult(),
      })
      const prepared = await prepareVerificationWorkspace(adapter, workspaceId)
      await prepared.implementation.lifecycle!.finalize("persisted")
      callbackWith(null, "verification", "", mutate)

      const result = await adapter.execute(verificationRequestFor(prepared))

      expect(result).toMatchObject({ status: "failed", verification: null })
      if expectedChange !== undefined
        expect(result.change?.changedPaths).toContain(expectedChange)
      await result.lifecycle!.finalize("unpersisted")

    const removeAllChanges = async (workspaceCwd: string): Promise<void> =>
      await writeFile(
        join(workspaceCwd, "packages", "jobs", "representative.civet"),
        "before",
      )
      workspaceStatuses.set(workspaceCwd, "")
    const editControlInput = async (workspaceCwd: string): Promise<void> =>
      await writeFile(
        join(workspaceCwd, "packages", "jobs", "package.json"),
        JSON.stringify({ name: "@darkfactory/jobs", description: "changed" }),
      )
      workspaceStatuses.set(workspaceCwd, " M packages/jobs/package.json")

    await verifyMutation("verification-no-change", removeAllChanges)
    await verifyMutation(
      "verification-control-change",
      editControlInput,
      "packages/jobs/package.json",
    )
  )
  it("rejects unsafe verifier workspace package layouts before injected checks", async () =>
    const verifyRejectedLayout = async (workspaceId: string): Promise<void> =>
      const verificationRunner = vi.fn(async () => verifierRunnerResult())
      const adapter = createOmpCliAdapter({ repositoriesRoot, verificationRunner })
      const prepared = await prepareVerificationWorkspace(adapter, workspaceId)
      await prepared.implementation.lifecycle!.finalize("persisted")
      callbackWith(null, "verification")
      const result = await adapter.execute(verificationRequestFor(prepared))
      expect(result).toMatchObject({ status: "failed", verification: null })
      expect(verificationRunner).not.toHaveBeenCalled()
      await result.lifecycle!.finalize("unpersisted")

    const longDirectory = "x".repeat(129)
    const longManifest = `packages/${longDirectory}/package.json`
    await mkdir(join(repositoryDirectory, "packages", longDirectory))
    await writeFile(
      join(repositoryDirectory, longManifest),
      JSON.stringify({ name: `@darkfactory/${longDirectory}` }),
    )
    trackedPaths.add(longManifest)
    await verifyRejectedLayout("verifier-package-long-name")
    trackedPaths.delete(longManifest)
    await rm(join(repositoryDirectory, "packages", longDirectory), { recursive: true })

    const linkedDirectory = join(repositoryDirectory, "packages", "linked-package")
    await symlink("jobs", linkedDirectory)
    trackedPaths.add("packages/linked-package")
    await verifyRejectedLayout("verifier-package-symlink")
    trackedPaths.delete("packages/linked-package")
    await rm(linkedDirectory)

    const invalidManifest = "packages/invalid-package/package.json"
    await mkdir(dirname(join(repositoryDirectory, invalidManifest)))
    await writeFile(
      join(repositoryDirectory, invalidManifest),
      JSON.stringify({ name: "not-darkfactory" }),
    )
    trackedPaths.add(invalidManifest)
    await verifyRejectedLayout("verifier-package-invalid-manifest")
    trackedPaths.delete(invalidManifest)
    await rm(join(repositoryDirectory, "packages", "invalid-package"), { recursive: true })

    const existingLink = "node_modules/@darkfactory/jobs"
    await mkdir(dirname(join(repositoryDirectory, existingLink)), { recursive: true })
    await writeFile(join(repositoryDirectory, existingLink), "occupied")
    trackedPaths.add(existingLink)
    await verifyRejectedLayout("verifier-package-existing-link")
    trackedPaths.delete(existingLink)
    await rm(join(repositoryDirectory, "node_modules"), { recursive: true })

    const extraManifests = Array.from({ length: 257 }, (_, index) =>
      `packages/extra-${String(index).padStart(3, "0")}/package.json`
    )
    for (const manifestPath of extraManifests)
      await mkdir(dirname(join(repositoryDirectory, manifestPath)))
      const packageName = basename(dirname(manifestPath))
      await writeFile(
        join(repositoryDirectory, manifestPath),
        JSON.stringify({ name: `@darkfactory/${packageName}` }),
      )
      trackedPaths.add(manifestPath)
    await verifyRejectedLayout("verifier-package-count")
    for (const manifestPath of extraManifests)
      trackedPaths.delete(manifestPath)
      await rm(dirname(join(repositoryDirectory, manifestPath)), { recursive: true })
  )

  it("normalizes nullish injected verifier streams", async () =>
    const controller = new AbortController()
    const adapter = createOmpCliAdapter({
      repositoriesRoot,
