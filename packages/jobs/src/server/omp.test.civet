    const result = await adapter.execute(requestFor({ redactions: [secret] }))

    expect(result.status).toBe("output-limit")
    expect(result.output.truncated).toBe(true)
    expect(result.output.redacted).toBe(true)
    expect(result.output.stdout).toContain("[REDACTED]")
    expect(JSON.stringify(result.output)).not.toContain(secret)
