        requestFor({ workspaceId: configName.startsWith("filter") ? "bad-filter" : "bad-diff" }),
      )).rejects.toBeInstanceOf(OmpRequestError)
      repositoryProgramConfigNames.length = 0
    expect(sandboxCalls()).toHaveLength(0)
