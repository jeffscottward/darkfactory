    mocks.WP1lstatDelegate = undefined
  )

  it("WP1 rejects every retained baseline identity and entry mismatch", async () =>
    await writeFile(scopedFile, "before")
    trackedPaths.add("packages/jobs/representative.civet")
    const cases = [
      {
        label: "source-head",
        mutate: (baseline: Record<string, unknown>) => ({
          ...baseline,
          sourceHead: "b".repeat(40),
        }),
      },
      {
        label: "scope-paths",
        mutate: (baseline: Record<string, unknown>) => ({
          ...baseline,
          scopePaths: ["packages"],
        }),
      },
      {
        label: "entries-not-array",
        mutate: (baseline: Record<string, unknown>) => ({ ...baseline, entries: {} }),
      },
      {
        label: "entries-too-many",
        mutate: (baseline: Record<string, unknown>) => ({
          ...baseline,
          entries: Array.from({ length: 20_001 }, (_, index) => [`p${index}`, "d"]),
        }),
      },
      {
        label: "entry-not-array",
        mutate: (baseline: Record<string, unknown>) => ({ ...baseline, entries: [null] }),
      },
      {
        label: "entry-length",
        mutate: (baseline: Record<string, unknown>) => ({ ...baseline, entries: [["p"]] }),
      },
      {
        label: "entry-path",
        mutate: (baseline: Record<string, unknown>) => ({ ...baseline, entries: [[1, "d"]] }),
      },
      {
        label: "entry-digest",
        mutate: (baseline: Record<string, unknown>) => ({ ...baseline, entries: [["p", 1]] }),
      },
    ] as const
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    for (const testCase of cases)
      callbackWith(null, "implemented", "", async (cwd) =>
        await writeFile(
          join(cwd, "packages", "jobs", "representative.civet"),
          `after-${testCase.label}`,
        )
      )
      const implementation = await adapter.execute(requestFor({
        workspaceId: `wp1-baseline-${testCase.label}`,
        effectKind: "implement",
      }))
      await implementation.lifecycle!.finalize("persisted")
      const workspaceDirectory = (
        sandboxCalls().at(-1)![2] as Readonly<{ cwd: string }>
      ).cwd
      const baselineName = (await readdir(dirname(workspaceDirectory))).find((entry) =>
        entry.startsWith(`${basename(workspaceDirectory)}.baseline-`)
      )!
      const baselinePath = join(dirname(workspaceDirectory), baselineName)
      const baseline = JSON.parse(await readFile(baselinePath, "utf8")) as Record<string, unknown>
      await writeFile(baselinePath, JSON.stringify(testCase.mutate(baseline)))
      await expect(adapter.execute(requestFor({
        workspaceId: `wp1-baseline-${testCase.label}`,
        effectKind: "implement",
      }))).rejects.toThrow("OMP implementation baseline is invalid")
  )

  it("WP1 rejects a clean baseline whose serialized manifest exceeds its byte budget", async () =>
    const unsupportedMetadata = await unsupportedMetadataFor(
