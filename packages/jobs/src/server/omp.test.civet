  it("refuses cleanup after the owned workspace lock identity changes", async () =>
    callbackWith(null, "planned")
    const result = await createOmpCliAdapter({ repositoriesRoot }).execute(
      requestFor({ workspaceId: "cleanup-owner-changed" }),
    )
    const workspaceDirectory = (
      sandboxCalls().at(-1)![2] as Readonly<{ cwd: string }>
    ).cwd
    await writeFile(
      join(`${workspaceDirectory}.lock`, "owner.json"),
      JSON.stringify({ nonce: "different-owner", pid: process.pid, createdAt: 1 }),
    )

    await expect(result.lifecycle!.finalize("persisted"))
      .rejects.toBeInstanceOf(OmpWorkspaceCleanupError)
    await expect(access(workspaceDirectory)).resolves.toBeUndefined()
    expect(gitCalls().some((call) =>
      (call[1] as readonly string[])[0] === "worktree" &&
      (call[1] as readonly string[])[1] === "remove"
    )).toBe(false)
  )
