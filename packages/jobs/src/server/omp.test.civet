      )
        WP1manifestLstatCalls += 1
        if WP1manifestLstatCalls === 1
          throw Object.assign(new Error("wp1 disappeared"), { code: "ENOENT" })
      return await actual(path, ...arguments_)
    callbackWith(null, "implemented", "", async (cwd) =>
      await writeFile(join(cwd, "packages", "jobs", "representative.civet"), "present")
