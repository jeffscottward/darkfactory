  it("WP1 applies directory states and preserves filesystem application failures", async () =>
    const root = join(repositoriesRoot, "wp1-artifact-application")
    await mkdir(join(root, "existing"), { recursive: true })
    await writeFile(join(root, "existing", "marker"), "preserved")
    await writeFile(join(root, "replacement"), "replace me")
    const artifactFor = (
      entries: DecodedOmpImplementationArtifact["entries"],
    ): DecodedOmpImplementationArtifact => Object.freeze({
      sourceHead: SOURCE_HEAD,
      workspaceKey: "d".repeat(64),
      ownerNonce: "11111111-1111-4111-8111-111111111111",
      changeHash: "c".repeat(64),
      entries,
    })
    await applyOmpImplementationArtifact(root, artifactFor(Object.freeze([
      Object.freeze({ path: "existing", kind: "directory" as const }),
      Object.freeze({ path: "replacement", kind: "directory" as const }),
      Object.freeze({ path: "created", kind: "directory" as const }),
      Object.freeze({ path: "created/nested", kind: "directory" as const }),
    ])))
    expect(await readFile(join(root, "existing", "marker"), "utf8")).toBe("preserved")
    expect((await lstat(join(root, "replacement"))).isDirectory()).toBe(true)
    expect((await lstat(join(root, "created", "nested"))).isDirectory()).toBe(true)

    await writeFile(join(root, "blocked-parent"), "not a directory")
    await expect(applyOmpImplementationArtifact(root, artifactFor(Object.freeze([
      Object.freeze({ path: "blocked-parent/leaf", kind: "deleted" as const }),
    ])))).rejects.toBeInstanceOf(OmpRequestError)

    const parentFailure = Object.assign(new Error("wp1 parent lstat failed"), { code: "EIO" })
    mocks.WP1lstatDelegate = async (actual, path, ...arguments_) =>
      if String(path) === join(root, "failed-parent") then throw parentFailure
      return await actual(path, ...arguments_)
    await expect(applyOmpImplementationArtifact(root, artifactFor(Object.freeze([
      Object.freeze({
        path: "failed-parent/leaf",
        kind: "file" as const,
        mode: 0o600,
        contentBase64: Buffer.from("unreachable").toString("base64"),
      }),
    ])))).rejects.toBe(parentFailure)

    const destinationFailure = Object.assign(
      new Error("wp1 destination lstat failed"),
      { code: "EACCES" },
    )
    mocks.WP1lstatDelegate = async (actual, path, ...arguments_) =>
      if String(path) === join(root, "failed-directory") then throw destinationFailure
      return await actual(path, ...arguments_)
    await expect(applyOmpImplementationArtifact(root, artifactFor(Object.freeze([
      Object.freeze({ path: "failed-directory", kind: "directory" as const }),
    ])))).rejects.toBe(destinationFailure)
    mocks.WP1lstatDelegate = undefined
  )

  it("WP1 rejects verifier controls whose real path has unsupported metadata", async () =>
    const controlPath = join(repositoryDirectory, "scripts", "wp1.config")
    await mkdir(dirname(controlPath), { recursive: true })
    await writeFile(controlPath, "control")
    const unsupportedMetadata = await unsupportedMetadataFor(controlPath)
    mocks.WP1lstatDelegate = async (actual, path, ...arguments_) =>
