  const verifierRunnerResult = (
    overrides: Partial<OmpVerifierRunnerResult> = {},
  ): OmpVerifierRunnerResult => ({
    status: "succeeded"
    exitCode: 0
    signal: null
    durationMs: 7
    output: {
      stdout: "tests: 12 passed"
      stderr: ""
      stdoutBytes: 16
      stderrBytes: 0
      truncated: false
      redacted: false
    }
    ...overrides
  })

  const prepareVerificationWorkspace = async (
    adapter: ReturnType<typeof createOmpCliAdapter>,
    workspaceId: string,
  ) =>
    await writeFile(scopedFile, "before")
    trackedPaths.add("packages/jobs/representative.civet")
    callbackWith(null, "implemented", "", async (cwd) =>
      await writeFile(
        join(cwd, "packages", "jobs", "representative.civet"),
        `after-${workspaceId}`,
      )
    )
    const implementation = await adapter.execute(requestFor({
      workspaceId
      effectKind: "implement"
    }))
    const workspaceDirectory = (
      sandboxCalls().at(-1)![2] as Readonly<{ cwd: string }>
    ).cwd
    expect(implementation).toMatchObject({
      status: "succeeded"
      implementationArtifact: {
        identity: "workflow-implementation-artifact-v1"
        bytes: expect.any(Number)
        digest: expect.stringMatching(/^[a-f0-9]{64}$/u)
      }
    })
    return { implementation, workspaceDirectory, workspaceId }

  const verificationRequestFor = (
    prepared: Awaited<ReturnType<typeof prepareVerificationWorkspace>>,
    evidence = prepared.implementation,
    overrides: Partial<OmpExecutionRequest> = {},
  ): OmpExecutionRequest =>
    const artifact = evidence.implementationArtifact!
    return requestFor({
      workspaceId: prepared.workspaceId
      effectKind: "verify"
      ...overrides
      recovery: {
        artifact
        changeHash: evidence.change!.changeHash
      }
    })

  it("disposes an unpersisted implementation before retrying the workspace", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const first = await prepareVerificationWorkspace(adapter, "lost-persistence")
    await first.implementation.lifecycle!.finalize("unpersisted")
    await expect(access(first.workspaceDirectory)).rejects.toMatchObject({
      code: "ENOENT"
    })

    const retry = await prepareVerificationWorkspace(adapter, "lost-persistence")
    expect(retry.implementation.status).toBe("succeeded")
    await retry.implementation.lifecycle!.finalize("unpersisted")
  )

  it("cleans a retained implementation idempotently from artifact evidence", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const prepared = await prepareVerificationWorkspace(adapter, "cleanup-replay")
    await prepared.implementation.lifecycle!.finalize("persisted")
    const artifact = prepared.implementation.implementationArtifact!
    const cleanup = {
      cwd: "darkfactory"
      recovery: {
        artifact
        changeHash: prepared.implementation.change!.changeHash
      }
    }

    await adapter.cleanupRetainedWorkspace(cleanup)
    await adapter.cleanupRetainedWorkspace(cleanup)

    await expect(access(prepared.workspaceDirectory)).rejects.toMatchObject({
      code: "ENOENT"
    })
  )

  it("treats a live lock-only cleanup as busy and recovers its stale replay", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const prepared = await prepareVerificationWorkspace(adapter, "lock-only-cleanup")
    await prepared.implementation.lifecycle!.finalize("persisted")
    const artifact = prepared.implementation.implementationArtifact!
    const cleanup = {
      cwd: "darkfactory"
      recovery: {
        artifact
        changeHash: prepared.implementation.change!.changeHash
      }
    }
    await rm(prepared.workspaceDirectory, { recursive: true, force: true })
    await rm(`${prepared.workspaceDirectory}.owner.json`, { force: true })
    const lockDirectory = `${prepared.workspaceDirectory}.lock`
    await mkdir(lockDirectory, { recursive: true })
    const ownerPath = join(lockDirectory, "owner.json")
    await writeFile(ownerPath, JSON.stringify({
      nonce: artifact.ownerNonce
      pid: process.pid
      createdAt: 1
    }))

    await expect(adapter.cleanupRetainedWorkspace(cleanup))
      .rejects.toBeInstanceOf(OmpWorkspaceBusyError)
    await writeFile(ownerPath, JSON.stringify({
      nonce: artifact.ownerNonce
      pid: 999_999_999
      createdAt: 1
    }))
    await adapter.cleanupRetainedWorkspace(cleanup)
    await expect(access(lockDirectory)).rejects.toMatchObject({ code: "ENOENT" })
  )

  it("aborts a retained cleanup during repository config preflight", async () =>
    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const prepared = await prepareVerificationWorkspace(adapter, "cleanup-abort")
    await prepared.implementation.lifecycle!.finalize("persisted")
    const artifact = prepared.implementation.implementationArtifact!
    const controller = new AbortController()
    mocks.execFile.mockImplementationOnce((
      _executable: string,
      _arguments: readonly string[],
      options: Readonly<{ signal?: AbortSignal }>,
      callback: (error: NodeJS.ErrnoException | null) => void,
    ) =>
      const child = Object.assign(new EventEmitter(), {
        pid: undefined
        kill: vi.fn(() => true)
      })
      const abort = (): void =>
        callback(Object.assign(new Error("aborted"), { code: "ABORT_ERR" }))
      options.signal?.addEventListener("abort", abort, { once: true })
      queueMicrotask(() => controller.abort())
      child
    )

    await expect(adapter.cleanupRetainedWorkspace({
      cwd: "darkfactory"
      recovery: {
        artifact
        changeHash: prepared.implementation.change!.changeHash
      }
      signal: controller.signal
      deadlineAtMs: Date.now() + 1_000
    })).rejects.toBeInstanceOf(OmpRequestError)
    await expect(access(prepared.workspaceDirectory)).resolves.toBeUndefined()
  )

  it("retains a durable failed verification for a later successful retry", async () =>
    const verificationRunner = vi.fn()
      .mockResolvedValueOnce(verifierRunnerResult({
        status: "failed"
        exitCode: 1
      }))
      .mockResolvedValueOnce(verifierRunnerResult())
    const adapter = createOmpCliAdapter({ repositoriesRoot, verificationRunner })
    const prepared = await prepareVerificationWorkspace(adapter, "verification-retry")
    await prepared.implementation.lifecycle!.finalize("persisted")
    callbackWith(null, "generic OMP success")
    const failed = await adapter.execute(verificationRequestFor(prepared))
    await failed.lifecycle!.finalize("persisted")
    await expect(access(prepared.workspaceDirectory)).resolves.toBeUndefined()

    callbackWith(null, "generic OMP success")
    const succeeded = await adapter.execute(
      verificationRequestFor(prepared, failed),
    )
    expect(succeeded.status).toBe("succeeded")
    await succeeded.lifecycle!.finalize("persisted")
    await expect(access(prepared.workspaceDirectory)).rejects.toMatchObject({
      code: "ENOENT"
    })
  )

  it("requires a configured verifier and retains the failed verification workspace", async () =>
    const adapter = createOmpCliAdapter({
      repositoriesRoot
      verificationRunner: null
    })
    const prepared = await prepareVerificationWorkspace(adapter, "no-verifier")
    const artifact = prepared.implementation.implementationArtifact!
    expect(createHash("sha256").update(artifact.content).digest("hex"))
      .toBe(artifact.digest)
    expect(JSON.parse(artifact.content)).toEqual({
      version: 1
      sourceHead: artifact.sourceHead
      workspaceKey: artifact.workspaceKey
      ownerNonce: artifact.ownerNonce
      changeHash: artifact.changeHash
      entries: [{
        path: "packages/jobs/representative.civet"
        kind: "file"
        mode: expect.any(Number)
        contentBase64: Buffer.from("after-no-verifier").toString("base64")
      }]
    })
    await prepared.implementation.lifecycle!.finalize("persisted")
    await expect(access(prepared.workspaceDirectory)).resolves.toBeUndefined()

    callbackWith(null, "model claims verification passed")
    const verification = await adapter.execute(verificationRequestFor(prepared))
    expect(verification).toMatchObject({
      status: "failed"
      exitCode: 0
      verification: null
    })
    await verification.lifecycle!.finalize("persisted")

    await expect(access(prepared.workspaceDirectory)).resolves.toBeUndefined()
    const baselinePrefix = `${basename(prepared.workspaceDirectory)}.baseline-`
    expect((await readdir(dirname(prepared.workspaceDirectory)))
      .some((entry) => entry.startsWith(baselinePrefix))).toBe(true)
    expect(gitCalls()).toEqual(expect.arrayContaining([
      expect.arrayContaining([
        "/usr/bin/git"
        ["worktree", "remove", "--force", prepared.workspaceDirectory]
      ])
      expect.arrayContaining([
        "/usr/bin/git"
        ["worktree", "prune"]
      ])
    ]))
  )

  it("derives bounded auditable evidence from an injected verifier", async () =>
    const verificationRunner = vi.fn(async (
      _request: Readonly<{ cwd: string; signal?: AbortSignal }>
    ) => verifierRunnerResult())
    const adapter = createOmpCliAdapter({
      repositoriesRoot
      verificationRunner
    })
    const prepared = await prepareVerificationWorkspace(adapter, "verified")
    await prepared.implementation.lifecycle!.finalize("persisted")
    callbackWith(null, "generic OMP zero")

    const result = await adapter.execute(verificationRequestFor(prepared))
    const expectedDigest = ompVerificationDigestFor({
      commandIdentity: OMP_VERIFIER_COMMAND_IDENTITY
      imageDigest: result.verification!.imageDigest
      configDigest: OMP_VERIFIER_CONFIG_DIGEST
      argvIdentity: OMP_VERIFIER_ARGV_IDENTITY
      implementationChangeDigest: result.change!.changeHash
      implementationArtifactDigest: result.implementationArtifact!.digest
      manifestDigest: result.verification!.manifestDigest
      exitCode: 0
      resultSummary: "tests: 12 passed"
    })
    expect(result).toMatchObject({
      status: "succeeded"
      exitCode: 0
      verification: {
        commandIdentity: OMP_VERIFIER_COMMAND_IDENTITY
        imageDigest: expect.stringMatching(/^injected:/u)
        configDigest: OMP_VERIFIER_CONFIG_DIGEST
        status: "succeeded"
        exitCode: 0
        resultBytes: Buffer.byteLength("tests: 12 passed")
        resultSummary: "tests: 12 passed"
        digest: expectedDigest
      }
    })
    const verifierRequest = verificationRunner.mock.calls[0]![0]
    expect(verifierRequest.signal).toBeUndefined()
    expect(verifierRequest.cwd).not.toBe(prepared.workspaceDirectory)
    expect(verifierRequest.cwd).toContain(`${prepared.workspaceDirectory}.verify-`)
    await result.lifecycle!.finalize("persisted")
  )
