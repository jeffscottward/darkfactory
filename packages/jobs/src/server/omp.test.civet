  it("fails closed for unavailable or insecure Apple Git candidates", async () =>
    const developerDirectory =
      "/Applications/Xcode-Test.app/Contents/Developer"
    const gitExecutable = join(developerDirectory, "usr", "bin", "git")
    const syntheticPaths = new Set<string>()
    let candidate = gitExecutable
    while candidate !== "/"
      syntheticPaths.add(candidate)
      candidate = dirname(candidate)
    type AppleGitTrustScenario = Readonly<{
      name: string
      selected: string | null
      escape?: boolean
      path?: string
      uid?: number
      gid?: number
      mode?: number
      file?: boolean
      directory?: boolean
    }>

    const scenarios: readonly AppleGitTrustScenario[] = [
      { name: "missing selection", selected: null }
      { name: "unapproved selection", selected: "/opt/Xcode/Developer" }
      { name: "escaped executable", selected: developerDirectory, escape: true }
      { name: "non-root executable", selected: developerDirectory, path: gitExecutable, uid: 501 }
      { name: "writable executable", selected: developerDirectory, path: gitExecutable, mode: 0o100775 }
      { name: "non-file executable", selected: developerDirectory, path: gitExecutable, file: false }
      { name: "non-executable file", selected: developerDirectory, path: gitExecutable, mode: 0o100644 }
      { name: "non-directory ancestor", selected: developerDirectory, path: developerDirectory, directory: false }
      { name: "wrong Applications group", selected: developerDirectory, path: "/Applications", gid: 81 }
      { name: "world-writable Applications", selected: developerDirectory, path: "/Applications", mode: 0o040777 }
    ]
    const platform = vi.spyOn(process, "platform", "get").mockReturnValue("darwin")
    try
      for [index, scenario] of scenarios.entries()
        resetWPFilesystemDelegates()
        mocks.WP3realpathDelegate = async (actual, path, ...arguments_) =>
          const value = String(path)
          if value === "/var/db/xcode_select_link"
            if scenario.selected === null
              throw Object.assign(new Error("selection unavailable"), {
                code: "ENOENT"
              })
            return scenario.selected
          if value === scenario.selected then return value
          if value === developerDirectory then return value
          if value === gitExecutable
            return scenario.escape === true ? "/tmp/untrusted-git" : value
          if value.startsWith("/Library/Developer/") ||
              value.startsWith("/Applications/Xcode.app/")
            throw Object.assign(new Error("candidate unavailable"), {
              code: "ENOENT"
            })
          return actual(path, ...arguments_)
        mocks.WP3accessDelegate = async (actual, path, ...arguments_) =>
          if String(path) === gitExecutable then return
          return actual(path, ...arguments_)
        mocks.WP3statDelegate = async (actual, path, ...arguments_) =>
          const value = String(path)
          if syntheticPaths.has(value)
            const isExecutable = value === gitExecutable
            return {
              uid: scenario.path === value && scenario.uid !== undefined
                ? scenario.uid
                : 0
              gid: scenario.path === value && scenario.gid !== undefined
                ? scenario.gid
                : value === "/Applications"
                  ? 80
                  : 0
              mode: scenario.path === value && scenario.mode !== undefined
                ? scenario.mode
                : isExecutable
                  ? 0o100755
                  : value === "/Applications"
                    ? 0o040775
                    : 0o040755
              isFile: () =>
                scenario.path === value && scenario.file !== undefined
                  ? scenario.file
                  : isExecutable
              isDirectory: () =>
                scenario.path === value && scenario.directory !== undefined
                  ? scenario.directory
                  : !isExecutable
            }
          return actual(path, ...arguments_)
        await expect(createOmpCliAdapter({ repositoriesRoot }).execute(
          requestFor({ workspaceId: `unsafe-apple-git-${index}` }),
        )).rejects.toMatchObject({
          name: "OmpConfigurationError"
          message: "OMP git executable is unavailable"
        })
    finally
      resetWPFilesystemDelegates()
      platform.mockRestore()
  )

  it("escalates an aborted owned process group before session and lock cleanup", async () =>
    let exited = false
    const signals: NodeJS.Signals[] = []
    const processKill = vi.spyOn(process, "kill").mockImplementation((
      _pid: number,
      signal?: string | number,
    ) =>
      if signal === 0
        if exited
          throw Object.assign(new Error("process group exited"), { code: "ESRCH" })
        return true
      signals.push(signal as NodeJS.Signals)
      if signal === "SIGKILL" then exited = true
      return true
    )
    mocks.spawn.mockImplementation(() =>
      Object.assign(new EventEmitter(), {
        pid: 424_242
        stdout: new PassThrough()
        stderr: new PassThrough()
        kill: vi.fn(() => true)
      })
    )
    const controller = new AbortController()
    const adapter = createOmpCliAdapter({
      repositoriesRoot
      shutdownTimeoutMs: 4
    })

    try
      const running = adapter.execute(requestFor({ signal: controller.signal }))
      await vi.waitFor(() => expect(sandboxCalls()).toHaveLength(1))
      const ompArguments = sandboxCalls()[0]![1] as readonly string[]
      const sessionArgument = ompArguments.find((value) =>
        value.startsWith("--session-dir=")
      )!
      const sessionDirectory = sessionArgument.slice("--session-dir=".length)
      controller.abort()

      await expect(running).resolves.toMatchObject({ status: "aborted" })
      expect(signals).toEqual(["SIGTERM", "SIGKILL"])
      expect(exited).toBe(true)
      await expect(access(sessionDirectory)).rejects.toThrow()
    finally
      processKill.mockRestore()
  )


  it("gives plan and verify exactly read, grep, and glob", async () =>
    callbackWith(null, "planned")
    const adapter = createOmpCliAdapter({
      repositoriesRoot
      verificationRunner: async () => verifierRunnerResult()
    })

    const plan = await adapter.execute(requestFor({
      workspaceId: "read-tools-plan"
      effectKind: "plan"
    }))
    await plan.lifecycle!.finalize("unpersisted")
    const prepared = await prepareVerificationWorkspace(adapter, "read-tools-verify")
    await prepared.implementation.lifecycle!.finalize("persisted")
    callbackWith(null, "verified")
    const verification = await adapter.execute(verificationRequestFor(prepared))

    expect(sandboxCalls()).toHaveLength(3)
    for call of [sandboxCalls()[0]!, sandboxCalls()[2]!]
      const arguments_ = call[1] as readonly string[]
      const profile = arguments_[1]!
      const workspaceDirectory = (call[2] as Readonly<{ cwd: string }>).cwd
      const isolatedScopedDirectory = join(workspaceDirectory, "packages", "jobs")
      expect(arguments_).toContain("--tools=read,grep,glob")
      expect(arguments_).not.toContain("--no-tools")
      for forbidden of [
        "bash"
        "edit"
        "write"
        "lsp"
        "python"
        "notebook"
        "inspect_image"
        "browser"
        "computer"
        "task"
        "todo"
        "web_search"
        "ask"
      ]
        expect(arguments_).not.toContain(`--tools=${forbidden}`)
        expect(arguments_.find((value) => value.startsWith("--tools=")))
          .not.toContain(forbidden)
      const writeSection = profile.slice(profile.indexOf("(allow file-write*"))
      const readSection = profile.slice(
        profile.indexOf("(allow file-read*"),
        profile.indexOf("(allow file-write*"),
      )
      expect(readSection).toContain(`(literal "${workspaceDirectory}")`)
      expect(readSection).toContain(`(subpath "${isolatedScopedDirectory}")`)
      expect(writeSection).not.toContain(`(literal "${workspaceDirectory}")`)
      expect(writeSection).not.toContain(`(subpath "${workspaceDirectory}")`)
      expect(readSection).not.toContain(`(subpath "${homedir()}")`)
    await verification.lifecycle!.finalize("persisted")
  )

