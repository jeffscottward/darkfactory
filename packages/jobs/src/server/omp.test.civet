  it("WP4 releases the verifier lock and preserves cleanup failure during failed preparation", async () =>
    const verificationRunner = vi.fn(async () => verifierRunnerResult())
    const adapter = createOmpCliAdapter({ repositoriesRoot, verificationRunner })
    const prepared = await prepareVerificationWorkspace(
      adapter,
      "WP4-prepare-cleanup-error",
    )
    await prepared.implementation.lifecycle!.finalize("persisted")
    let verifierCwd = ""
    mocks.WP4readFileDelegate = async (actual, path, ...arguments_) =>
      const file = String(path)
      if (
        file.includes(".verify-") &&
        file.endsWith("packages/jobs/representative.civet")
      )
        verifierCwd = dirname(dirname(dirname(file)))
        gitResponseOverrides.set(
          ["worktree", "remove", "--force", verifierCwd].join("\0"),
          WP4errno("EIO"),
        )
        return Buffer.from("WP4 reconstruction failure before cleanup")
      return actual(path, ...arguments_)
    callbackWith(null, "verification preflight")

    await expect(adapter.execute(verificationRequestFor(prepared)))
      .rejects.toBeInstanceOf(OmpWorkspaceCleanupError)
    expect(verificationRunner).not.toHaveBeenCalled()
    await expect(access(`${verifierCwd}.lock`)).rejects.toMatchObject({
      code: "ENOENT"
    })
  )

  it("WP4 rethrows process termination from failed verifier preparation after attempting its lock release", async () =>
    const verificationRunner = vi.fn(async () => verifierRunnerResult())
    const adapter = createOmpCliAdapter({ repositoriesRoot, verificationRunner })
    const prepared = await prepareVerificationWorkspace(
      adapter,
      "WP4-prepare-cleanup-termination",
    )
    await prepared.implementation.lifecycle!.finalize("persisted")
    let verifierCwd = ""
    let reconstructionMutated = false
    let termination: ReturnType<typeof WP4terminateNextGitCleanup> | undefined
    let lockReleaseAttempts = 0
    mocks.WP2rmDelegate = async (actual, path, ...arguments_) =>
      if String(path) === `${verifierCwd}.lock`
        lockReleaseAttempts += 1
        throw WP4errno("EIO")
      return actual(path, ...arguments_)
    mocks.WP4readFileDelegate = async (actual, path, ...arguments_) =>
      const file = String(path)
      if (
        !reconstructionMutated &&
        file.includes(".verify-") &&
        file.endsWith("packages/jobs/representative.civet")
      )
        reconstructionMutated = true
        verifierCwd = dirname(dirname(dirname(file)))
        termination = WP4terminateNextGitCleanup(848_484)
        return Buffer.from("WP4 reconstruction failure before terminating cleanup")
      return actual(path, ...arguments_)
    callbackWith(null, "verification preflight")

    try
      await expect(adapter.execute(verificationRequestFor(prepared)))
        .rejects.toBeInstanceOf(OmpProcessTerminationError)
    finally
      mocks.WP4readFileDelegate = undefined
      mocks.WP2rmDelegate = undefined
      termination?.dateNow.mockRestore()
      termination?.processKill.mockRestore()
    expect(reconstructionMutated).toBe(true)
    expect(verificationRunner).not.toHaveBeenCalled()
    expect(lockReleaseAttempts).toBe(1)
    await expect(access(`${verifierCwd}.lock`)).resolves.toBeUndefined()
  )

  it("WP4 normalizes an ordinary retained artifact read error during verification preflight", async () =>
    const verificationRunner = vi.fn(async () => verifierRunnerResult())
    const adapter = createOmpCliAdapter({ repositoriesRoot, verificationRunner })
    const prepared = await prepareVerificationWorkspace(
      adapter,
      "WP4-preflight-read-error",
    )
    await prepared.implementation.lifecycle!.finalize("persisted")
    const retainedFile = join(
      prepared.workspaceDirectory,
      "packages",
      "jobs",
      "representative.civet",
    )
    callbackWith(null, "verification preflight", "", async () =>
      mocks.WP4readFileDelegate = async (actual, path, ...arguments_) =>
        if String(path) === retainedFile then throw WP4errno("EIO")
        return actual(path, ...arguments_)
      return
    )

    const result = await adapter.execute(verificationRequestFor(prepared))

    expect(result).toMatchObject({
      status: "failed"
      verification: null
      change: null
      implementationArtifact: null
    })
    expect(verificationRunner).not.toHaveBeenCalled()
    await result.lifecycle!.finalize("unpersisted")
  )

