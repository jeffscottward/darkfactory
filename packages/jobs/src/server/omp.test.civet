} from "./omp.civet"
import { createLocalWayfinderExecutionAdapter } from "./wayfinder.civet"

const TEST_FILESYSTEM_SANDBOX_BACKEND = Object.freeze({
  requireAvailable: vi.fn(async () => undefined)
} satisfies OmpFilesystemSandboxBackend)

const createOmpCliAdapter = (options: OmpCliAdapterOptions) =>
  createProductionOmpCliAdapter({
    ...options,
    filesystemSandboxBackend: TEST_FILESYSTEM_SANDBOX_BACKEND,
  })

type SandboxResponse = Readonly<{
  error: NodeJS.ErrnoException | null
  stdout: string
  stderr: string
  mutate?: (cwd: string) => Promise<void>
  closeCode?: number | null
  closeSignal?: NodeJS.Signals | null
  pid?: number
  holdOpen?: boolean
  stdoutChunks?: readonly (string | Buffer)[]
  stderrChunks?: readonly (string | Buffer)[]
}>

const sandboxResponses: SandboxResponse[] = []
const workspaceDirectories: string[] = []
const workspaceStatuses = new Map<string, string>()
const trackedPaths = new Set<string>()
const repositoryProgramConfigNames: string[] = []
const gitResponseOverrides = new Map<string, string | Error>()
const SOURCE_HEAD = "a".repeat(40)
const VERIFIER_IMAGE_DIGEST = `sha256:${"b".repeat(64)}`
const VERIFY_CORE_SCRIPT =
  "bun run format:check && bun run lint && bun run auth:schema:check && bun run openapi:check && bun run civet:style:check && bun run typecheck && bun run build && bun run test:unit && bun run test:contract && bun run test:operations && bun run docs:check"

const callbackWith = (
  error: NodeJS.ErrnoException | null,
  stdout = "",
  stderr = "",
  mutate?: (cwd: string) => Promise<void>,
): void =>
  sandboxResponses.push({
    error,
    stdout,
    stderr,
    ...(mutate === undefined ? {} : { mutate }),
  })

let repositoriesRoot = ""
let repositoryDirectory = ""
let scopedDirectory = ""
let scopedFile = ""
let originalProcessPath: string | undefined

const TEST_GIT_EXECUTABLE =
  "/Library/Developer/CommandLineTools/usr/bin/git"
const isTestAppleGitExecutable = (value: unknown): value is string =>
  typeof value === "string" &&
    (
      value === TEST_GIT_EXECUTABLE ||
      /^\/Applications\/[^/]+\.app\/Contents\/Developer\/usr\/bin\/git$/u.test(value)
    )

const sandboxCalls = () => mocks.spawn.mock.calls

const gitSandboxCalls = () => mocks.execFile.mock.calls
  .filter((call) =>
    call[0] === "/usr/bin/sandbox-exec" &&
    isTestAppleGitExecutable((call[1] as readonly unknown[])[2])
  )

const gitCommandArguments = (arguments_: readonly string[]): readonly string[] =>
  let index = 3
  while arguments_[index] === "-c" then index += 2
  return arguments_.slice(index)

const gitCalls = () => gitSandboxCalls().map((call) => [
  "/usr/bin/git"
  gitCommandArguments(call[1] as readonly string[])
  call[2]
  call[3]
])

const directGitCalls = () => mocks.execFile.mock.calls
  .filter((call) => call[0] === "/usr/bin/git")

const resetWPFilesystemDelegates = (): void =>
  mocks.WP1lstatDelegate = undefined
  mocks.WP1readdirDelegate = undefined
  mocks.WP2mkdirDelegate = undefined
  mocks.WP2readFileDelegate = undefined
  mocks.WP2readdirDelegate = undefined
  mocks.WP2realpathDelegate = undefined
  mocks.WP2renameDelegate = undefined
  mocks.WP2rmDelegate = undefined
  mocks.WP2statDelegate = undefined
  mocks.WP2writeFileDelegate = undefined
  mocks.WP3accessDelegate = undefined
  mocks.WP3realpathDelegate = undefined
  mocks.WP3statDelegate = undefined
  mocks.WP4lstatDelegate = undefined
  mocks.WP4openDelegate = undefined
  mocks.WP4readFileDelegate = undefined

const removeOwnedTestArtifacts = async (): Promise<void> =>
  let firstCleanupError: unknown
  const attempt = async (operation: () => Promise<void>): Promise<void> =>
    try
      await operation()
    catch error
      if firstCleanupError === undefined then firstCleanupError = error
  if repositoriesRoot.length > 0
    await attempt(() => rm(repositoriesRoot, { recursive: true, force: true }))
  for (const workspaceDirectory of workspaceDirectories)
    await attempt(() => rm(workspaceDirectory, { recursive: true, force: true }))
    await attempt(() =>
      rm(`${workspaceDirectory}.lock`, { recursive: true, force: true })
    )
    await attempt(() => rm(`${workspaceDirectory}.owner.json`, { force: true }))
    const parent = dirname(workspaceDirectory)
    const baselinePrefix = `${basename(workspaceDirectory)}.baseline-`
    let entries: string[] = []
    await attempt(async () =>
      entries = await readdir(parent)
      return
    )
    for (const entry of entries)
      if entry.startsWith(baselinePrefix)
        await attempt(() => rm(join(parent, entry), { force: true }))
  if firstCleanupError !== undefined then throw firstCleanupError

const unsupportedMetadataFor = async (
  path: string,
): Promise<Awaited<ReturnType<typeof lstat>>> =>
  const metadata = await lstat(path)
  return Object.assign(metadata, {
    mode: 0,
    size: 0,
    isFile: () => false,
    isDirectory: () => false,
    isSymbolicLink: () => false,
  })

beforeEach(async () =>
  vi.clearAllMocks()
  resetWPFilesystemDelegates()
  sandboxResponses.length = 0
  workspaceDirectories.length = 0
  mocks.spawn.mockClear()
  workspaceStatuses.clear()
  trackedPaths.clear()
  repositoryProgramConfigNames.length = 0
  gitResponseOverrides.clear()
  repositoriesRoot = await realpath(
    await mkdtemp(join(tmpdir(), "darkfactory-omp-test-")),
  )
  originalProcessPath = process.env["PATH"]
  const executableDirectory = join(repositoriesRoot, "bin")
  await mkdir(executableDirectory)
  const executablePath = join(executableDirectory, "omp")
  await writeFile(executablePath, "#!/bin/sh\nexit 0\n")
  await chmod(executablePath, 0o700)
  process.env["PATH"] = executableDirectory
  repositoryDirectory = join(repositoriesRoot, "darkfactory")
  scopedDirectory = join(repositoryDirectory, "packages", "jobs")
  scopedFile = join(scopedDirectory, "representative.civet")
  await mkdir(scopedDirectory, { recursive: true })
  await mkdir(join(repositoryDirectory, ".git"), { recursive: true })
  await writeFile(join(repositoryDirectory, "package.json"), JSON.stringify({
    scripts: { "verify:core": VERIFY_CORE_SCRIPT }
  }))
  trackedPaths.add("package.json")
  await writeFile(
    join(scopedDirectory, "package.json"),
    JSON.stringify({ name: "@darkfactory/jobs" }),
  )
  trackedPaths.add("packages/jobs/package.json")
  const worktreesRoot = join(tmpdir(), "darkfactory-omp-worktrees")
  await mkdir(worktreesRoot, { mode: 0o700, recursive: true })
  await chmod(worktreesRoot, 0o700)
  mocks.execFile.mockImplementation((
    executable: string,
    arguments_: readonly string[],
    options: Readonly<{ cwd: string }>,
    callback: (
      error: NodeJS.ErrnoException | null,
      stdout?: string | Buffer,
      stderr?: string | Buffer,
    ) => void,
  ) =>
    if (
      executable === "/usr/bin/sandbox-exec" &&
      isTestAppleGitExecutable(arguments_[2])
    )
      const gitArguments = gitCommandArguments(arguments_)
      void (async () =>
        const override = gitResponseOverrides.get(gitArguments.join("\0"))
        if override instanceof Error then throw override
        if override !== undefined then return override
        if gitArguments[0] === "config"
          return repositoryProgramConfigNames.join("\n")
        if gitArguments[0] === "rev-parse" && gitArguments[1] === "--show-toplevel"
          return options.cwd
        if gitArguments[0] === "rev-parse" && gitArguments[1] === "--absolute-git-dir"
          return join(repositoryDirectory, ".git")
        if gitArguments[0] === "rev-parse" && gitArguments[1] === "HEAD"
          return SOURCE_HEAD
        if gitArguments[0] === "status"
          return options.cwd === repositoryDirectory
            ? ""
            : workspaceStatuses.get(options.cwd) ?? ""
        if gitArguments[0] === "worktree" && gitArguments[1] === "add"
          const workspaceDirectory = gitArguments[3]!
          await mkdir(workspaceDirectory, { recursive: true })
          for (const relativePath of trackedPaths)
            const sourcePath = join(repositoryDirectory, relativePath)
            const workspacePath = join(workspaceDirectory, relativePath)
            await mkdir(dirname(workspacePath), { recursive: true })
            if (await lstat(sourcePath)).isSymbolicLink()
              await symlink(await readlink(sourcePath), workspacePath)
            else
              await copyFile(sourcePath, workspacePath)
          workspaceDirectories.push(workspaceDirectory)
          return ""
        if gitArguments[0] === "worktree" && gitArguments[1] === "remove"
          const workspaceDirectory = gitArguments[3]!
          workspaceStatuses.delete(workspaceDirectory)
          await rm(workspaceDirectory, { recursive: true, force: true })
          return ""
        if gitArguments[0] === "worktree" && gitArguments[1] === "prune"
          return ""
        throw new Error("unexpected git invocation")
      )().then(
        (stdout) => callback(null, stdout),
        (error: NodeJS.ErrnoException) => callback(error),
      )
      return
    throw new Error("unexpected non-git execFile invocation")
  )
  mocks.spawn.mockImplementation((
    _executable: string,
    _arguments: readonly string[],
    options: Readonly<{ cwd: string }>,
  ) =>
    const response = sandboxResponses.shift()
    if response === undefined then throw new Error("missing sandbox response")
    const stdout = new PassThrough()
    const stderr = new PassThrough()
    const child = Object.assign(new EventEmitter(), {
      pid: response.pid,
      stdout,
      stderr,
      kill: vi.fn(() => true),
    })
    void (async () =>
      if response.holdOpen then return
      await response.mutate?.(options.cwd)
      if response.mutate !== undefined && !workspaceStatuses.has(options.cwd)
        workspaceStatuses.set(options.cwd, " M scoped-change")
      if response.error?.code === "ETIMEDOUT"
        return
      if response.error !== null
        child.emit("error", response.error)
        return
      for (const chunk of response.stdoutChunks ?? [response.stdout])
        stdout.write(chunk)
      for (const chunk of response.stderrChunks ?? [response.stderr])
        stderr.write(chunk)
      stdout.end()
      stderr.end()
      child.emit(
        "close",
        response.closeCode === undefined ? 0 : response.closeCode,
        response.closeSignal === undefined ? null : response.closeSignal,
      )
    )().catch((error: unknown) =>
      child.emit("error", error)
    )
    return child
  )
  return
)

afterEach(async () =>
  resetWPFilesystemDelegates()
  vi.restoreAllMocks()
  delete process.env["OPENAI_API_KEY"]
  delete process.env["UNRELATED_SECRET"]
  delete process.env["GROQ_API_KEY"]
  delete process.env["AWS_SECRET_ACCESS_KEY"]
  delete process.env["AWS_SESSION_TOKEN"]
  delete process.env["GOOGLE_API_KEY"]
  delete process.env["AWS_ACCESS_KEY_ID"]
  if originalProcessPath === undefined then delete process.env["PATH"]
  else process.env["PATH"] = originalProcessPath
  await removeOwnedTestArtifacts()
)
const requestFor = (
  overrides: Partial<OmpExecutionRequest> = {},
): OmpExecutionRequest => ({
  command: "print",
  workspaceId: "run-1",
  effectKind: "plan",
  instruction: "bounded work",
  cwd: "darkfactory",
  scopePaths: ["packages/jobs"],
  ...overrides,
})

describe("OMP CLI adapter", () =>
  it("launches sandbox-exec in a retained isolated workspace with scoped writes and session cleanup", async () =>
    const instruction = "inspect; touch /tmp/must-not-run && $(whoami)"
    await writeFile(scopedFile, "before")
    trackedPaths.add("packages/jobs/representative.civet")
    repositoryProgramConfigNames.push(
      "filter.attacker.clean",
      "filter.attacker.smudge",
      "filter.attacker.process",
      "filter.attacker.required",
      "diff.attacker.command",
      "diff.attacker.textconv",
      "diff.attacker.trustExitCode",
    )
    callbackWith(
      null,
      "done",
      "",
      async (cwd) =>
        await writeFile(join(cwd, "packages", "jobs", "representative.civet"), "after")
    )

    const adapter = createOmpCliAdapter({ repositoriesRoot })
    const result = await adapter.execute(requestFor({
      effectKind: "implement",
      instruction,
    }))
    expect(TEST_FILESYSTEM_SANDBOX_BACKEND.requireAvailable).toHaveBeenCalledOnce()

    const call = sandboxCalls()[0]!
    const arguments_ = call[1] as readonly string[]
    const profile = arguments_[1]!
    const ompExecutable = arguments_[2]!
    const options = call[2] as Readonly<{
      cwd: string
      env: NodeJS.ProcessEnv
      shell: boolean
      windowsHide: boolean
    }>
    const workspaceDirectory = options.cwd
    const isolatedScopedDirectory = join(workspaceDirectory, "packages", "jobs")
    const isolatedScopedFile = join(isolatedScopedDirectory, "representative.civet")
    const sessionArgument = arguments_.find((value) => value.startsWith("--session-dir="))
    const sessionDirectory = sessionArgument!.slice("--session-dir=".length)

    const gitArguments = gitCalls().map(
      (gitCall) => gitCall[1] as readonly string[],
    )
    expect(gitArguments).toEqual(expect.arrayContaining([
      ["rev-parse", "--show-toplevel"]
      ["rev-parse", "HEAD"]
      ["status", "--porcelain", "--untracked-files=all"]
    ]))
    const worktreeCall = gitCalls().find(
      (gitCall) => (gitCall[1] as readonly string[])[0] === "worktree",
    )
    expect(worktreeCall).toBeDefined()
    expect(worktreeCall![1]).toEqual([
      "worktree"
      "add"
      "--detach"
      workspaceDirectory
      SOURCE_HEAD
    ])
    expect(worktreeCall![2]).toMatchObject({ cwd: repositoryDirectory })
    expect(directGitCalls()).toHaveLength(0)
    for gitCall of gitSandboxCalls()
      const launcherArguments = gitCall[1] as readonly string[]
      const gitProfile = launcherArguments[1]!
      const gitExecutable = launcherArguments[2]!
      expect(isTestAppleGitExecutable(gitExecutable)).toBe(true)
      expect(launcherArguments.slice(0, 3)).toEqual([
        "-p"
        gitProfile
        gitExecutable
      ])
      expect(gitProfile).toContain("(deny default)")
      expect(gitProfile).toContain(`(literal "${gitExecutable}")`)
      const gitMetadataSection = gitProfile.slice(
        gitProfile.indexOf("(allow file-read-metadata"),
        gitProfile.indexOf("(allow file-read*"),
      )
      let ancestor = dirname(gitExecutable)
      while true
        expect(gitMetadataSection).toContain(`(literal "${ancestor}")`)
        const parent = dirname(ancestor)
        if parent === ancestor then break
        ancestor = parent
      const gitReadSection = gitProfile.slice(
        gitProfile.indexOf("(allow file-read*"),
        gitProfile.indexOf("(allow file-write*"),
      )
      const developerDirectory = dirname(dirname(dirname(gitExecutable)))
      expect(gitReadSection).toContain(`(literal "${developerDirectory}")`)
      expect(gitReadSection).toContain(`(subpath "${developerDirectory}")`)
      expect(gitReadSection).toContain(`(literal "/")`)
      const gitWriteSection = gitProfile.slice(
        gitProfile.indexOf("(allow file-write*"),
      )
      expect(gitWriteSection).toContain(`(literal "/dev/null")`)
      const commandArguments = gitCommandArguments(launcherArguments)
      expect(gitProfile.includes("(allow process-fork)")).toBe(
        commandArguments[0] === "worktree" && commandArguments[1] === "add",
      )
      expect(gitProfile).not.toContain("network")
      expect(launcherArguments).toEqual(expect.arrayContaining([
        "core.hooksPath=/dev/null"
        "core.fsmonitor=false"
        "core.attributesFile=/dev/null"
        "diff.external="
        "submodule.recurse=false"
      ]))
      if commandArguments[0] !== "config"
        expect(launcherArguments).toEqual(expect.arrayContaining([
          "filter.attacker.clean="
          "filter.attacker.smudge="
          "filter.attacker.process="
          "filter.attacker.required=false"
          "diff.attacker.command="
          "diff.attacker.textconv="
          "diff.attacker.trustExitCode=false"
        ]))
    expect(call[0]).toBe("/usr/bin/sandbox-exec")
    expect(arguments_.slice(0, 3)).toEqual(["-p", profile, ompExecutable])
    const ompArguments = arguments_.slice(3)
    expect(ompArguments).toEqual(expect.arrayContaining([
      "-p"
      "--mode=text"
      "--tools=read,grep,glob,edit,write"
      "--no-extensions"
      "--no-skills"
      "--no-session"
      `--cwd=${workspaceDirectory}`
      sessionArgument!
      instruction
    ]))
    expect(ompArguments.at(-1)).toBe(instruction)
    expect(ompArguments).not.toContain("--thinking=off")
    expect(arguments_).not.toContain("--no-tools")
    expect(arguments_.join(" ")).not.toContain("bash")
    expect(profile).toContain("(deny default)")
    expect(profile).toContain(`(literal "${ompExecutable}")`)
    const denySection = profile.slice(
      profile.indexOf("(deny file-read* file-write*"),
      profile.indexOf("(allow process-exec"),
    )
    expect(denySection).toContain(`(subpath "${join(workspaceDirectory, ".git")}")`)
    expect(denySection).toContain(`(subpath "${join(workspaceDirectory, ".env")}")`)
    const metadataSection = profile.slice(
      profile.indexOf("(allow file-read-metadata"),
      profile.indexOf("(allow file-read*"),
    )
    expect(metadataSection).not.toContain(`(literal "${join(workspaceDirectory, ".git")}")`)
    expect(metadataSection).not.toContain(`(literal "${join(workspaceDirectory, ".env")}")`)
    const writeSection = profile.slice(profile.indexOf("(allow file-write*"))
    const readSection = profile.slice(
      profile.indexOf("(allow file-read*"),
      profile.indexOf("(allow file-write*"),
    )
    expect(readSection).toContain(`(literal "${workspaceDirectory}")`)
    expect(readSection).toContain(`(subpath "${isolatedScopedDirectory}")`)
    expect(writeSection).toContain(`(subpath "${isolatedScopedDirectory}")`)
    expect(writeSection).toContain(`(literal "${isolatedScopedDirectory}")`)
    expect(writeSection).not.toContain(`(literal "${workspaceDirectory}")`)
    expect(writeSection).not.toContain(`(subpath "${workspaceDirectory}")`)
    expect(readSection).not.toContain(`(subpath "${homedir()}")`)
    expect(options).toMatchObject({
      cwd: workspaceDirectory
      shell: false
      windowsHide: true
    })
    for name of [
      "HOME"
      "OMP_HOME"
      "PI_CODING_AGENT_DIR"
      "XDG_CONFIG_HOME"
      "XDG_CACHE_HOME"
      "XDG_DATA_HOME"
      "TMPDIR"
    ]
      expect(options.env[name]).toBe(sessionDirectory)
    expect(sessionDirectory.startsWith(`${await realpath(tmpdir())}/`)).toBe(true)
    await expect(access(sessionDirectory)).rejects.toThrow()
    await expect(access(workspaceDirectory)).resolves.toBeUndefined()
    await expect(readFile(isolatedScopedFile, "utf8")).resolves.toBe("after")
    await expect(readFile(scopedFile, "utf8")).resolves.toBe("before")
    expect(result).toMatchObject({
      status: "succeeded"
      exitCode: 0
      change: {
        changeHash: expect.stringMatching(/^[a-f0-9]{64}$/u)
        changedPaths: ["packages/jobs/representative.civet"]
      }
    })
    expect(JSON.stringify(result)).not.toContain(instruction)
  )

  it("uses the root-owned Git from the selected full Xcode toolchain", async () =>
    const developerDirectory =
      "/Applications/Xcode-26.0.app/Contents/Developer"
    const gitExecutable = join(developerDirectory, "usr", "bin", "git")
    const platform = vi.spyOn(process, "platform", "get").mockReturnValue("darwin")
    const syntheticPaths = new Set<string>()
    let candidate = gitExecutable
    while candidate !== "/"
      syntheticPaths.add(candidate)
      candidate = dirname(candidate)
    mocks.WP3realpathDelegate = async (actual, path, ...arguments_) =>
      const value = String(path)
      if value === "/var/db/xcode_select_link" then return developerDirectory
      if value === developerDirectory || value === gitExecutable then return value
      return actual(path, ...arguments_)
    mocks.WP3accessDelegate = async (actual, path, ...arguments_) =>
      if String(path) === gitExecutable then return
      return actual(path, ...arguments_)
    mocks.WP3statDelegate = async (actual, path, ...arguments_) =>
      const value = String(path)
      if syntheticPaths.has(value)
        return {
          uid: 0
          gid: value === "/Applications" ? 80 : 0
          mode: value === gitExecutable
            ? 0o100755
            : value === "/Applications"
              ? 0o040775
              : 0o040755
          isFile: () => value === gitExecutable
          isDirectory: () => value !== gitExecutable
        }
      return actual(path, ...arguments_)
    try
      callbackWith(null, "planned through selected Xcode Git")
      const result = await createOmpCliAdapter({ repositoriesRoot }).execute(
        requestFor({ workspaceId: "selected-xcode-git" }),
      )
      expect(gitSandboxCalls().every((call) =>
        (call[1] as readonly string[])[2] === gitExecutable
      )).toBe(true)
      await result.lifecycle!.finalize("unpersisted")
    finally
      platform.mockRestore()
      resetWPFilesystemDelegates()
  )

