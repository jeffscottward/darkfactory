  it("rejects generic verify success and malformed trusted verifier evidence", async () =>
    const fake = fakeRepository()
    const runtime = runtimeFor(fake, {
      cleanupRetainedWorkspace,
      execute: vi.fn(async (
        request: Parameters<OmpCliAdapter["execute"]>[0],
      ): Promise<OmpExecutionResult> =>
        if request.effectKind === "implement"
          return {
            ...successfulExecution()
            change: {
              changeHash: IMPLEMENTATION_CHANGE_HASH
              changedPaths: ["packages/jobs"]
            }
            implementationArtifact: IMPLEMENTATION_ARTIFACT
          }
        return successfulExecution()
      )
    }, "worker-verifier-boundaries")
    const application = runtime.application
    await application.createRun({
      runId: RUN_ID,
      ownerId: OWNER_ID,
      event: submission(),
    })
    await runtime.runOnce()
    const awaitingApproval = (
      await application.findProjection(OWNER_ID, RUN_ID)
    )!
    const approvalId = fake.approvals[0]!.id!
    const binding = createWorkflowApprovalBindingV1(
      approvalId,
      awaitingApproval.snapshot,
    )
    await application.decideApproval({
      ownerId: OWNER_ID
      runId: RUN_ID
      approval: {
        id: approvalId
        runId: RUN_ID
        ownerId: OWNER_ID
        decidedBy: OWNER_ID
        decision: "granted"
      }
      event: {
        type: "APPROVAL_GRANTED"
        eventId: "approval-granted-verifier-boundaries"
        eventVersion: 1
        machineVersion: 1
        occurredAt: fake.now().toISOString()
        approvalId
        approvalHash: hashWorkflowApprovalV1({
          runId: RUN_ID
          approvalId
          snapshotSequence: binding.snapshotSequence
          journalHeadHash: binding.journalHeadHash
          effectHash: binding.effectHash
          effectScope: binding.effectScope
        })
        binding
      }
    })
    await runtime.runOnce()
    expect((await application.findProjection(OWNER_ID, RUN_ID))?.snapshot.state)
      .toBe("verifying")

    const metadata = {
      ownerId: OWNER_ID
      runId: RUN_ID
      effectId: "verify-1"
      effectKind: "verify" as const
      outboxId: "outbox-verify"
      leaseOwner: "worker-a"
      fence: 1
      effectScope: SCOPE
    }
    const valid = verifiedCompletion()
    const genericInvalidResults = [
      { ...valid, status: "failed" }
      { ...valid, exitCode: 1 }
      { ...valid, eventType: "PLAN_SUCCEEDED" }
    ]
    for result of genericInvalidResults
      await expect(application.completeEffect({
        ...metadata
        result: result as never
      })).rejects.toThrow("effect completion lacks trusted success evidence")

    const malformedVerifierResults = [
      { ...valid, verification: undefined }
      { ...valid, verification: null }
      { ...valid, verification: {
        ...productionDockerVerification()
        commandIdentity: "shell-check"
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        imageDigest: `sha256:${"e".repeat(64)}`
      } }
      { ...valid, verification:
        verificationForImageIdentity(`injected:${"e".repeat(64)}`)
      }
      { ...valid, verification: {
        ...productionDockerVerification()
        configDigest: "e".repeat(64)
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        argvIdentity: "a".repeat(64)
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        implementationChangeDigest: "invalid"
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        implementationArtifactDigest: "invalid"
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        manifestDigest: "invalid"
      } }
      { ...valid, changeHash: "d".repeat(64) }
      { ...valid, verification: {
        ...productionDockerVerification()
        status: "failed"
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        exitCode: 1
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        durationMs: 1.5
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        durationMs: -1
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        resultBytes: 0
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        resultBytes: 32_769
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        resultBytes: 1
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        resultSummary: " "
        resultBytes: 1
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        digest: undefined
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        digest: "invalid"
      } }
      { ...valid, verification: {
        ...productionDockerVerification()
        digest: "a".repeat(64)
      } }
    ]
    for result of malformedVerifierResults
      await expect(application.completeEffect({
        ...metadata
        result: result as never
      })).rejects.toThrow(
        "verification completion is not bound to implementation evidence",
      )
  )

