  it("reuses the durable approval event for grant and reject retries after the clock advances", async () =>
    for (const decision of ["granted", "rejected"] as const)
      const fake = fakeRepository()
      const adapter: OmpCliAdapter = {
        cleanupRetainedWorkspace,
        execute: vi.fn(async () => successfulExecution()),
      }
      const runtime = runtimeFor(fake, adapter, `worker-${decision}`)
      await runtime.application.createRun({
        ownerId: OWNER_ID,
        event: submission(),
      })
      await runtime.runOnce()
      const projection = (await runtime.application.findProjection(OWNER_ID, RUN_ID))!
      const approvalId = fake.approvals[0]!.id!
      const binding = createWorkflowApprovalBindingV1(
        approvalId,
        projection.snapshot,
      )
      const occurredAt = fake.now().toISOString()
      const event: WorkflowEventV1 = decision === "granted"
        ? {
            type: "APPROVAL_GRANTED",
            eventId: `approval-${decision}`,
            eventVersion: 1,
            machineVersion: 1,
            occurredAt,
            approvalId,
            approvalHash: hashWorkflowApprovalV1({
              runId: RUN_ID,
              approvalId,
              snapshotSequence: binding.snapshotSequence,
              journalHeadHash: binding.journalHeadHash,
              effectHash: binding.effectHash,
              effectScope: binding.effectScope,
            }),
            binding,
          }
        : {
            type: "APPROVAL_REJECTED",
            eventId: `approval-${decision}`,
            eventVersion: 1,
            machineVersion: 1,
            occurredAt,
            approvalId,
            reasonCode: "operator-rejected",
          }
      const input = {
        ownerId: OWNER_ID,
        runId: RUN_ID,
        approval: {
          id: approvalId,
          runId: RUN_ID,
          ownerId: OWNER_ID,
          decidedBy: OWNER_ID,
          decision,
        },
        event,
      }
      await runtime.application.decideApproval(input)
      fake.advance(1_000)
      await runtime.application.decideApproval({
        ...input,
        event: { ...event, occurredAt: fake.now().toISOString() },
      })

      const approvalAppends = fake.appended.filter(
        (append) => append.event.eventId === event.eventId,
      )
      expect(approvalAppends).toHaveLength(2)
      expect(approvalAppends[1]!.event.occurredAt).toBe(occurredAt)
  )

  it("exposes worker stop so active OMP execution settles before runtime shutdown", async () =>
    const fake = fakeRepository()
    let observedSignal: AbortSignal | undefined
    const adapter: OmpCliAdapter = {
      cleanupRetainedWorkspace,
      execute: vi.fn((request) => new Promise<OmpExecutionResult>((resolve) =>
        observedSignal = request.signal
        request.signal?.addEventListener(
          "abort"
          () => resolve(abortedExecution())
          Object.freeze({ once: true })
        )
      ))
    }
    const runtime = runtimeFor(fake, adapter, "worker-a")
    await runtime.application.createRun({ ownerId: OWNER_ID, event: submission() })

    const running = runtime.runOnce()
    expect(runtime.runOnce()).toBe(running)
    await vi.waitFor(() => expect(adapter.execute).toHaveBeenCalledOnce())
    await runtime.stop()

    expect(observedSignal?.aborted).toBe(true)
    await expect(running).resolves.toEqual([
      expect.objectContaining({ status: "lease-lost" })
    ])
    expect(fake.completions).toHaveLength(0)
    await expect(runtime.runOnce()).resolves.toEqual([])
  )
