  it("evicts a lost claim so another worker owns finalization without stale cache buildup", async () =>
    const fake = fakeRepository()
    const adapter: OmpCliAdapter = {
      execute: vi.fn(async () => successfulExecution())
      cleanupRetainedWorkspace
    }
    const runtime = runtimeFor(fake, adapter, "unused-worker")
    await runtime.application.createRun({ ownerId: OWNER_ID, event: submission() })
    const first = createWorkflowRepositoryOutboxAdapter({
      repository: fake.repository
      application: runtime.application
      now: fake.now
    })
    const second = createWorkflowRepositoryOutboxAdapter({
      repository: fake.repository
      application: runtime.application
      now: fake.now
    })
    const [staleClaim] = await first.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-a"
      limit: 1
      leaseMilliseconds: 1_000
    })
    fake.advance(1_001)
    const [currentClaim] = await second.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-b"
      limit: 1
      leaseMilliseconds: 1_000
    })

    await expect(first.heartbeatEffect({
      id: staleClaim!.id
      leaseOwner: staleClaim!.leaseOwner
      fenceToken: staleClaim!.fenceToken
      leaseMilliseconds: 1_000
    })).resolves.toBe(false)
    const heartbeatCount = fake.heartbeats.length
    await expect(first.completeEffect({
      id: staleClaim!.id
      leaseOwner: staleClaim!.leaseOwner
      fenceToken: staleClaim!.fenceToken
      result: completion()
    })).resolves.toBe(false)
    expect(fake.heartbeats).toHaveLength(heartbeatCount)
    await expect(second.completeEffect({
      id: currentClaim!.id
      leaseOwner: currentClaim!.leaseOwner
      fenceToken: currentClaim!.fenceToken
      result: completion()
    })).resolves.toBe(true)
    expect(fake.completions).toHaveLength(1)
    expect(fake.completions[0]).toMatchObject({
      leaseOwner: "worker-b"
      fence: currentClaim!.fenceToken
    })
  )

