import { describe, expect, it, vi } from "vitest"

import {
  GENESIS_WORKFLOW_JOURNAL_HASH,
  type OutboxEvent,
} from "@darkfactory/db/schema"
import {
  WorkflowRunNotFoundError,
  WorkflowRunTerminalError,
  type WorkflowProjection,
  type WorkflowRepository,
} from "@darkfactory/db/server/workflow"
import {
  createWorkflowApprovalBindingV1,
  hashWorkflowApprovalV1,
  sha256Hex,
  type WorkflowEventV1,
} from "@darkfactory/state/workflow"

import {
  OMP_IMPLEMENTATION_ARTIFACT_IDENTITY,
  OMP_VERIFIER_CONFIG_DIGEST,
  OMP_VERIFIER_COMMAND_IDENTITY,
  OMP_VERIFIER_ARGV_IDENTITY,
  ompVerificationDigestFor,
  redactOmpOutput,
  type OmpCliAdapter,
  type OmpExecutionResult,
  type OmpPersistenceDisposition,
  type OmpVerificationAttempt,
} from "./omp.civet"
import type { WorkflowEffectCompletion } from "./workflow-worker.civet"
import {
  createWorkflowPlanEvidenceV1,
  hashWorkflowPlanEvidenceV1,
} from "./plan-evidence.civet"
import {
  WorkflowProjectionVerificationError,
  createWorkflowApplication,
  createWorkflowRepositoryOutboxAdapter,
  createWorkflowRuntime,
  workflowApprovalIdFor,
} from "./workflow-runtime.civet"
import { WORKFLOW_EFFECT_HANDLER } from "./workflow-worker.civet"

const NOW = new Date("2026-07-29T12:00:00.000Z")
const OWNER_ID = "owner-1"
const RUN_ID = "run-1"
const TASK_HASH = "a".repeat(64)
const RAW_OUTPUT = "sk-private-sentinel-token raw CLI output"
const REDACTED_OUTPUT = redactOmpOutput(RAW_OUTPUT).value
const PLAN = createWorkflowPlanEvidenceV1({
  stdout: REDACTED_OUTPUT,
  stderr: "",
  stdoutBytes: Buffer.byteLength(REDACTED_OUTPUT),
  stderrBytes: 0,
  truncated: false,
  redacted: true,
})
const SCOPE = Object.freeze({
  repositoryId: "darkfactory",
  paths: Object.freeze(["packages/jobs"]),
})
const cleanupRetainedWorkspace = async (): Promise<void> => undefined

const IMPLEMENTATION_CHANGE_HASH = "c".repeat(64)
const IMPLEMENTATION_SOURCE_HEAD = "d".repeat(40)
const IMPLEMENTATION_WORKSPACE_KEY = "e".repeat(64)
const IMPLEMENTATION_OWNER_NONCE = "123e4567-e89b-42d3-a456-426614174000"
const VERIFIER_IMAGE_DIGEST = `sha256:${"f".repeat(64)}`
const IMPLEMENTATION_CONTENT = JSON.stringify({
  version: 1
  sourceHead: IMPLEMENTATION_SOURCE_HEAD
  workspaceKey: IMPLEMENTATION_WORKSPACE_KEY
  ownerNonce: IMPLEMENTATION_OWNER_NONCE
  changeHash: IMPLEMENTATION_CHANGE_HASH
  entries: [{ path: "packages/jobs", kind: "directory" }]
})
const IMPLEMENTATION_ARTIFACT = Object.freeze({
  identity: OMP_IMPLEMENTATION_ARTIFACT_IDENTITY
  bytes: Buffer.byteLength(IMPLEMENTATION_CONTENT)
  digest: sha256Hex(IMPLEMENTATION_CONTENT)
  content: IMPLEMENTATION_CONTENT
  sourceHead: IMPLEMENTATION_SOURCE_HEAD
  workspaceKey: IMPLEMENTATION_WORKSPACE_KEY
  ownerNonce: IMPLEMENTATION_OWNER_NONCE
  changeHash: IMPLEMENTATION_CHANGE_HASH
})
const VERIFICATION_SUMMARY = "working tree clean"
const verificationForImageIdentity = (imageDigest: string): OmpVerificationAttempt =>
  const digestPayload = {
    commandIdentity: OMP_VERIFIER_COMMAND_IDENTITY
    imageDigest
    configDigest: OMP_VERIFIER_CONFIG_DIGEST
    argvIdentity: OMP_VERIFIER_ARGV_IDENTITY
    implementationChangeDigest: IMPLEMENTATION_CHANGE_HASH
    implementationArtifactDigest: IMPLEMENTATION_ARTIFACT.digest
    manifestDigest: "d".repeat(64)
    exitCode: 0 as const
    resultSummary: VERIFICATION_SUMMARY
  } satisfies Parameters<typeof ompVerificationDigestFor>[0]
  Object.freeze({
    ...digestPayload
    status: "succeeded" as const
    durationMs: 3
    resultBytes: Buffer.byteLength(VERIFICATION_SUMMARY)
    digest: ompVerificationDigestFor(digestPayload)
  } satisfies OmpVerificationAttempt)

const productionDockerVerification = (): OmpVerificationAttempt =>
  verificationForImageIdentity(VERIFIER_IMAGE_DIGEST)

const verifiedCompletion = (): WorkflowEffectCompletion => ({
  ...completion()
  eventType: "VERIFICATION_SUCCEEDED"
  changeHash: IMPLEMENTATION_CHANGE_HASH
  verification: productionDockerVerification()
  plan: null
  implementationArtifact: null
})
const submission = (
  taskId = "task-1",
): Extract<WorkflowEventV1, { type: "RUN_SUBMITTED" }> => ({
  type: "RUN_SUBMITTED",
  eventId: "submit-1",
  eventVersion: 1,
  machineVersion: 1,
  occurredAt: NOW.toISOString(),
  taskId,
  workspaceId: "workspace-1",
  taskRevision: 7,
  taskHash: TASK_HASH,
  scope: SCOPE,
})

const successfulExecution = (): OmpExecutionResult => ({
  command: "print",
  status: "succeeded",
  exitCode: 0,
  signal: null,
  durationMs: 17,
  output: {
    stdout: RAW_OUTPUT,
    stderr: "",
    stdoutBytes: Buffer.byteLength(RAW_OUTPUT),
    stderrBytes: 0,
    truncated: false,
    redacted: false,
  },
  change: null,
  verification: null,
  implementationArtifact: null,
})

const abortedExecution = (): OmpExecutionResult => ({
  command: "print"
  status: "aborted"
  exitCode: null
  signal: null
  durationMs: 0
  output: {
    stdout: ""
    stderr: ""
    stdoutBytes: 0
    stderrBytes: 0
    truncated: false
    redacted: false
  }
  change: null
  verification: null
  implementationArtifact: null
})

const completion = () => ({
  status: "succeeded" as const,
  eventType: "PLAN_SUCCEEDED" as const,
  exitCode: 0 as const,
  durationMs: 17,
  outputBytes: Buffer.byteLength(REDACTED_OUTPUT),
  outputTruncated: false,
  outputRedacted: true,
  changeHash: null,
  changedPaths: Object.freeze([]),
  plan: PLAN,
})

const duplicate = (): Error & { code: "23505" } =>
  const error = new Error("duplicate") as Error & { code: "23505" }
  error.code = "23505"
  return error

type FakeRepository = Readonly<{
  repository: WorkflowRepository
  created: Array<Parameters<WorkflowRepository["createRun"]>[0]>
  appended: Array<Parameters<WorkflowRepository["append"]>[0]>
  evidence: Array<Parameters<WorkflowRepository["addEvidence"]>[0]>
  messages: Array<Parameters<WorkflowRepository["addMessageAndAppend"]>[0]>
  approvals: Array<Parameters<WorkflowRepository["createApproval"]>[0]>
  heartbeats: Array<Parameters<WorkflowRepository["heartbeatEffect"]>[0]>
  completions: Array<Parameters<WorkflowRepository["finalizeEffect"]>[0]>
  projection: () => WorkflowProjection | null
  outbox: () => OutboxEvent | null
  now: () => Date
  advance: (milliseconds: number) => void
  corruptProjection: () => void
  rejectNextCompletion: () => void
}>

const fakeRepository = (): FakeRepository =>
  let clock = new Date(NOW)
  let current: WorkflowProjection | null = null
  let row: OutboxEvent | null = null
  let rejectCompletion = false
  const created: Array<Parameters<WorkflowRepository["createRun"]>[0]> = []
  const appended: Array<Parameters<WorkflowRepository["append"]>[0]> = []
  const evidence: Array<Parameters<WorkflowRepository["addEvidence"]>[0]> = []
  const approvals: Array<Parameters<WorkflowRepository["createApproval"]>[0]> = []
  const messages: Array<
    Parameters<WorkflowRepository["addMessageAndAppend"]>[0]
  > = []
  const heartbeats: Array<Parameters<WorkflowRepository["heartbeatEffect"]>[0]> = []
  const completions: Array<Parameters<WorkflowRepository["finalizeEffect"]>[0]> = []

  const projectionFor = (
    input: Parameters<WorkflowRepository["createRun"]>[0] |
      Parameters<WorkflowRepository["append"]>[0],
    previous: WorkflowProjection | null,
  ): WorkflowProjection =>
    const runId = "runId" in input ? input.runId : input.id ?? RUN_ID
    const sequence = previous === null ? 1 : previous.run.headSequence + 1
    const previousHash = previous?.run.headHash ?? GENESIS_WORKFLOW_JOURNAL_HASH
    const hash = input.snapshot.journalHeadHash
    const journalEntry = Object.freeze({
      runId,
      sequence,
      eventId: input.event.eventId,
      eventType: input.event.type,
      eventVersion: input.event.eventVersion,
      event: input.event,
      occurredAt: new Date(input.event.occurredAt),
      previousHash,
      hash,
      requestHash: null,
    })
    return Object.freeze({
      run: Object.freeze({
        id: runId,
        ownerId: input.ownerId,
        machineId: input.snapshot.machineId,
        machineVersion: input.snapshot.machineVersion,
        state: input.snapshot.state,
        headSequence: sequence,
        headHash: hash,
        createdAt: previous?.run.createdAt ?? new Date(clock),
        updatedAt: new Date(clock),
      }),
      snapshot: Object.freeze({
        runId,
        sequence,
        machineId: input.snapshot.machineId,
        machineVersion: input.snapshot.machineVersion,
        state: input.snapshot.state,
        context: input.snapshot.context,
        journalHeadHash: hash,
        effectHash: input.snapshot.effectHash ?? null,
        effectScope: input.snapshot.effectScope ?? null,
        updatedAt: new Date(clock),
      }),
      journal: Object.freeze([...(previous?.journal ?? []), journalEntry]),
    })

  const storeEffect = (
    effect: NonNullable<Parameters<WorkflowRepository["createRun"]>[0]["effects"]>[number],
    replaceActive = false,
  ): void =>
    if (
      !replaceActive &&
      row !== null &&
      row.publishedAt === null &&
      row.deadAt === null
    ) then return
    row = Object.freeze({
      id: effect.id ?? "outbox-1",
      eventType: effect.eventType,
      aggregateType: "workflow_run",
      aggregateId: RUN_ID,
      payload: effect.payload,
      occurredAt: new Date(clock),
      publishedAt: null,
      attemptCount: 0,
      handler: effect.handler,
      idempotencyKey: effect.idempotencyKey,
      requestHash: "b".repeat(64),
      availableAt: effect.availableAt ?? new Date(clock),
      leaseOwner: null,
      leaseExpiresAt: null,
      fence: 0,
      lastError: null,
      deadAt: null,
    })

  const owns = (input: Readonly<{ id: string; leaseOwner: string; fence: number }>) =>
    row !== null &&
    row.id === input.id &&
    row.leaseOwner === input.leaseOwner &&
    row.fence === input.fence &&
    row.leaseExpiresAt !== null &&
    row.leaseExpiresAt.getTime() > clock.getTime() &&
    row.publishedAt === null

  const repository = Object.freeze<WorkflowRepository>({
    createRun: async (input: Parameters<WorkflowRepository["createRun"]>[0]) =>
      created.push(input)
      current = projectionFor(input, null)
      for (const effect of input.effects ?? []) storeEffect(effect)
      return current
    append: async (input: Parameters<WorkflowRepository["append"]>[0]) =>
      appended.push(input)
      if (current === null) throw new Error("missing run")
      if (current.journal.some((entry) => entry.eventId === input.event.eventId))
        return Object.freeze({ duplicate: true, projection: current })
      current = projectionFor(input, current)
      for (const effect of input.effects ?? []) storeEffect(effect)
      return Object.freeze({ duplicate: false, projection: current })
    listRunsByOwner: async (ownerId: string) =>
      current?.run.ownerId === ownerId ? [current.run] : []
    findProjectionByOwner: async (runId: string, ownerId: string) =>
      current?.run.id === runId && current.run.ownerId === ownerId ? current : null
    listProjectionsByOwner: async (ownerId: string, runIds: readonly string[]) =>
      current !== null &&
      current.run.ownerId === ownerId &&
      runIds.includes(current.run.id)
        ? [current]
        : []
    createApproval: async (input: Parameters<WorkflowRepository["createApproval"]>[0]) =>
      if (approvals.some((saved) => saved.id === input.id)) throw duplicate()
      approvals.push(input)
      return {
        ...input
        id: input.id ?? "approval-1"
        status: "pending" as const
        decidedBy: null
        decisionReason: null
        decisionRequestHash: null
        createdAt: new Date(clock)
        decidedAt: null
      }
    decideApprovalAndAppend: async (
      input: Parameters<WorkflowRepository["decideApprovalAndAppend"]>[0],
    ) =>
      if (!approvals.some((saved) =>
        (saved.id ?? "approval-1") === input.approval.id &&
        saved.runId === input.approval.runId &&
        saved.ownerId === input.approval.ownerId
      ))
        throw new Error("missing approval")
      appended.push(input.append)
      if (current === null) throw new Error("missing run")
      if (current.journal.some((entry) => entry.eventId === input.append.event.eventId))
        return Object.freeze({ duplicate: true, projection: current })
      current = projectionFor(input.append, current)
      for (const effect of input.append.effects ?? []) storeEffect(effect)
      return Object.freeze({ duplicate: false, projection: current })
    addEvidence: async (input: Parameters<WorkflowRepository["addEvidence"]>[0]) =>
      if (evidence.some((saved) => saved.id === input.id)) throw duplicate()
      evidence.push(input)
      return {
        ...input
        id: input.id ?? "evidence-1"
        requestHash: "e".repeat(64)
        createdAt: new Date(clock)
      }
    listEvidenceByOwner: async () => ({ items: [], nextCursor: null })
    findEvidenceByOwner: async (id: string, runId: string, ownerId: string) =>
      if (current?.run.id !== runId || current.run.ownerId !== ownerId) return null
      const saved = evidence.find((item) => (item.id ?? "evidence-1") === id)
      return saved === undefined ? null : {
        id,
        runId,
        kind: saved.kind,
        requestHash: "e".repeat(64),
        summary: saved.summary,
        data: saved.data,
        createdAt: new Date(clock),
      }
    addMessageAndAppend: async (
      input: Parameters<WorkflowRepository["addMessageAndAppend"]>[0],
    ) =>
      messages.push(input)
      if (current === null) throw new Error("missing run")
      if (input.append !== null)
        appended.push(input.append)
        current = projectionFor(input.append, current)
      return Object.freeze({
        duplicate: input.append === null,
        message: Object.freeze({
          id: input.id,
          runId: input.runId,
          idempotencyKey: input.idempotencyKey,
          requestHash: "a".repeat(64),
          authorId: input.authorId,
          content: input.content,
          createdAt: new Date(clock),
        }),
        projection: current,
      })
    listMessagesByOwner: async () => ({ items: [], nextCursor: null })
    claimDueEffects: async (input: Parameters<WorkflowRepository["claimDueEffects"]>[0]) =>
      if (
        row === null ||
        row.handler !== input.handler ||
        row.publishedAt !== null ||
        row.availableAt.getTime() > clock.getTime() ||
        (row.leaseExpiresAt !== null && row.leaseExpiresAt.getTime() > clock.getTime())
      ) return []
      const effectId = row.payload["effectId"]
      if (
        typeof effectId === "string" &&
        current?.journal.some(
          (entry) =>
            entry.eventId === `effect-${effectId}-succeeded` ||
              entry.eventId === `effect-${effectId}-failed`
        ) &&
        evidence.some(
          (saved) =>
            saved.id === `evidence-${effectId}-succeeded` ||
              saved.id === `evidence-${effectId}-failed`
        )
      )
        const failed = current.journal.some(
          (entry) => entry.eventId === `effect-${effectId}-failed`,
        )
        row = Object.freeze({
          ...row
          publishedAt: failed ? null : new Date(clock)
          deadAt: failed ? new Date(clock) : null
          leaseOwner: null
          leaseExpiresAt: null
        })
        return []
      row = Object.freeze({
        ...row
        leaseOwner: input.leaseOwner
        leaseExpiresAt: new Date(clock.getTime() + (input.leaseMilliseconds ?? 30_000))
        fence: row.fence + 1
      })
      if row.payload["effectKind"] !== "verify" then return [row]
      const implementationEvidenceId = (
        current?.snapshot.context as Readonly<Record<string, unknown>> | undefined
      )?.["implementationEvidenceId"]
      const implementationEvidence = evidence.find(
        (saved) => saved.id === implementationEvidenceId,
      )?.data ?? null
      const implementationChangeHash = (
        current?.snapshot.context as Readonly<Record<string, unknown>> | undefined
      )?.["changeHash"]
      return [Object.freeze({
        ...row,
        payload: Object.freeze({
          ...row.payload,
          implementationEvidence,
          implementationChangeHash: typeof implementationChangeHash === "string"
            ? implementationChangeHash
            : null,
        }),
      })]
    heartbeatEffect: async (input: Parameters<WorkflowRepository["heartbeatEffect"]>[0]) =>
      heartbeats.push(input)
      if (!owns(input)) return false
      row = Object.freeze({
        ...row!
        leaseExpiresAt: new Date(clock.getTime() + (input.leaseMilliseconds ?? 30_000))
      })
      return true
    finalizeEffect: async (
      input: Parameters<WorkflowRepository["finalizeEffect"]>[0],
    ) =>
      if (!owns(input)) return Object.freeze({ status: "stale" as const, projection: null })
      completions.push(input)
      if (rejectCompletion)
        rejectCompletion = false
        if (current === null) throw new Error("missing run")
        appended.push(input.append)
        current = projectionFor(input.append, current)
        evidence.push(input.evidence)
        if (input.approval !== undefined) approvals.push(input.approval)
        return Object.freeze({ status: "stale" as const, projection: null })
      if (current === null) throw new Error("missing run")
      const claimedRow = row!
      const duplicateEvent = current.journal.some(
        (entry) => entry.eventId === input.append.event.eventId,
      )
      appended.push(input.append)
      if (!duplicateEvent)
        current = projectionFor(input.append, current)
        for (const effect of input.append.effects ?? []) storeEffect(effect, true)
      if (!evidence.some((saved) =>
        (saved.id ?? "evidence-1") === (input.evidence.id ?? "evidence-1")
      ))
        evidence.push(input.evidence)
      if (
        input.approval !== undefined &&
        !approvals.some((saved) => (saved.id ?? "approval-1") === input.approval!.id)
      )
        approvals.push(input.approval)
      if (input.append.effects ?? []).length === 0
        row = Object.freeze({
          ...claimedRow
          publishedAt: input.terminal === "completed" ? new Date(clock) : null
          attemptCount: input.terminal === "dead"
            ? claimedRow.attemptCount + 1
            : claimedRow.attemptCount
          lastError: input.terminal === "dead" ? input.error ?? null : null
          deadAt: input.terminal === "dead" ? new Date(clock) : null
          leaseOwner: null
          leaseExpiresAt: null
        })
      return Object.freeze({
        status: duplicateEvent ? "already-applied" as const : "applied" as const
        projection: current
      })
    failEffect: async (
      input: Parameters<WorkflowRepository["failEffect"]>[0],
    ) =>
      if !owns(input) then return false
      row = Object.freeze({
        ...row!
        attemptCount: row!.attemptCount + 1
        lastError: input.error
        availableAt: input.retryAt
        leaseOwner: null
        leaseExpiresAt: null
      })
      return true
    claimRetainedResources: async () => []
    heartbeatRetainedResource: async () => true
    releaseRetainedResource: async () => true
    completeRetainedResource: async () => true
    failRetainedResource: async () => true
  })

  return Object.freeze({
    repository
    created
    appended
    evidence
    messages
    approvals
    heartbeats
    completions
    projection: () => current
    outbox: () => row
    now: () => new Date(clock)
    advance: (milliseconds) => clock = new Date(clock.getTime() + milliseconds)
    corruptProjection: () =>
      if (current === null) throw new Error("missing run")
      current = Object.freeze({
        ...current
        snapshot: Object.freeze({
          ...current.snapshot
          journalHeadHash: "f".repeat(64)
        })
      })
    rejectNextCompletion: () => rejectCompletion = true
  })

const runtimeFor = (
  fake: FakeRepository,
  adapter: OmpCliAdapter,
  leaseOwner: string,
) => createWorkflowRuntime({
  repository: fake.repository,
  adapter,
  leaseOwner,
  authorizeRepository: () => true,
  leaseMilliseconds: 1_000,
  heartbeatMilliseconds: 100,
  now: fake.now,
  generateId: () => RUN_ID,
})

describe("workflow runtime composition", () =>
  it("creates the submitted run and plan outbox atomically, and verifies replay without OMP", async () =>
    const fake = fakeRepository()
    const adapter: OmpCliAdapter = {
      execute: vi.fn(async () => successfulExecution())
      cleanupRetainedWorkspace
    }
    const runtime = runtimeFor(fake, adapter, "worker-a")

    const created = await runtime.application.createRun({ ownerId: OWNER_ID, event: submission() })
    expect((await runtime.application.findProjection(OWNER_ID, RUN_ID))?.snapshot)
      .toEqual(created.snapshot)
    expect(fake.created).toHaveLength(1)
    expect(fake.created[0]).toMatchObject({
      id: RUN_ID,
      event: { type: "RUN_SUBMITTED" },
      snapshot: { state: "planning", sequence: 1 },
      effects: [expect.objectContaining({
        handler: WORKFLOW_EFFECT_HANDLER,
        payload: expect.objectContaining({
          ownerId: OWNER_ID,
          effectKind: "plan",
          effectScope: SCOPE,
          task: expect.objectContaining({
            taskId: "task-1",
            taskRevision: 7,
            taskHash: TASK_HASH,
            sourceSequence: 1,
          }),
        }),
      })],
    })
    expect(fake.outbox()).toMatchObject({
      aggregateType: "workflow_run",
      aggregateId: RUN_ID,
      handler: WORKFLOW_EFFECT_HANDLER,
      fence: 0,
    })
    expect(adapter.execute).not.toHaveBeenCalled()

    fake.corruptProjection()
    await expect(runtime.application.findProjection(OWNER_ID, RUN_ID))
      .rejects.toBeInstanceOf(WorkflowProjectionVerificationError)
    expect(adapter.execute).not.toHaveBeenCalled()
  )

  it("recovers an already-applied completion once after restart without persisting raw CLI data", async () =>
    const fake = fakeRepository()
    const adapter: OmpCliAdapter = {
      execute: vi.fn(async () => successfulExecution())
      cleanupRetainedWorkspace
    }
    const interrupted = runtimeFor(fake, adapter, "worker-before-restart")
    await interrupted.application.createRun({ ownerId: OWNER_ID, event: submission() })
    fake.rejectNextCompletion()

    await expect(interrupted.runOnce()).resolves.toEqual([
      expect.objectContaining({ status: "lease-lost" }),
    ])
    fake.advance(1_001)
    const restarted = runtimeFor(fake, adapter, "worker-after-restart")
    await expect(restarted.runOnce()).resolves.toEqual([])
    await expect(runtimeFor(fake, adapter, "worker-third").runOnce()).resolves.toEqual([])

    const projection = await restarted.application.findProjection(OWNER_ID, RUN_ID)
    expect(projection?.journal.filter((entry) => entry.event.type === "PLAN_SUCCEEDED"))
      .toHaveLength(1)
    expect(fake.appended).toHaveLength(1)
    expect(fake.appended[0]).toMatchObject({
      expectedSequence: 1,
      event: { type: "PLAN_SUCCEEDED" },
      snapshot: { state: "awaitingApproval", sequence: 2 },
      effects: [],
    })
    expect(fake.evidence).toHaveLength(1)
    expect(fake.approvals).toHaveLength(1)
    expect(adapter.execute).toHaveBeenCalledOnce()
    expect(fake.heartbeats.map(({ fence }) => fence)).toEqual([1])
    expect(fake.completions).toMatchObject([
      { leaseOwner: "worker-before-restart", fence: 1 },
    ])

    const savedEvidence = fake.evidence[0]!
    expect(savedEvidence.data).toMatchObject({
      status: "succeeded",
      eventType: "PLAN_SUCCEEDED",
      durationMs: 17,
      outputBytes: Buffer.byteLength(REDACTED_OUTPUT),
      outputTruncated: false,
      outputRedacted: true,
    })
    const savedPlan = savedEvidence.data["plan"] as unknown as typeof PLAN
    expect(savedPlan).toEqual(PLAN)
    expect(savedPlan.digest).toBe(hashWorkflowPlanEvidenceV1(savedPlan))
    expect(fake.appended[0]!.event).toMatchObject({ planHash: PLAN.digest })
    expect(Object.keys(savedEvidence.data).sort()).toEqual([
      "changeHash", "changedPaths", "durationMs", "effectId", "effectKind",
      "effectScope", "eventType", "exitCode", "implementationArtifact",
      "outputBytes", "outputRedacted", "outputTruncated", "plan", "status",
      "verification",
    ])
    const prompt = vi.mocked(adapter.execute).mock.calls[0]![0].instruction
    const persisted = JSON.stringify({
      created: fake.created,
      appended: fake.appended,
      evidence: fake.evidence,
      outbox: fake.outbox(),
    })
    expect(persisted).not.toContain(prompt)
    expect(persisted).not.toContain(RAW_OUTPUT)
    expect(persisted).not.toContain("stdout")
    expect(persisted).not.toContain("stderr")
  )

  it("rejects PLAN_SUCCEEDED application before any digest-bound evidence exists", async () =>
    const fake = fakeRepository()
    const application = createWorkflowApplication(fake.repository, { now: fake.now })
    await application.createRun({
      runId: RUN_ID,
      ownerId: OWNER_ID,
      event: submission(),
    })

