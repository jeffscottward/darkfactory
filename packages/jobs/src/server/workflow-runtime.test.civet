  it("rejects malformed implementation artifacts before workflow finalization", async () =>
    const application = createWorkflowApplication(fakeRepository().repository)
    const metadata = {
      ownerId: OWNER_ID
      runId: RUN_ID
      effectId: "implement-artifact"
      effectKind: "implement" as const
      outboxId: "outbox-implement"
      leaseOwner: "worker-a"
      fence: 1
      effectScope: SCOPE
    }
    const artifactFor = (
      content: string,
      overrides: Readonly<Record<string, unknown>> = {},
    ) => ({
      identity: OMP_IMPLEMENTATION_ARTIFACT_IDENTITY
      bytes: Buffer.byteLength(content)
      digest: sha256Hex(content)
      content
      sourceHead: IMPLEMENTATION_SOURCE_HEAD
      workspaceKey: IMPLEMENTATION_WORKSPACE_KEY
      ownerNonce: IMPLEMENTATION_OWNER_NONCE
      changeHash: IMPLEMENTATION_CHANGE_HASH
      ...overrides
    })
    const contentFor = (entries: readonly unknown[]): string =>
      JSON.stringify({ version: 1, entries })
    const validResult = {
      ...completion()
      eventType: "IMPLEMENTATION_SUCCEEDED" as const
      changeHash: "a".repeat(64)
      changedPaths: ["packages/jobs"]
      implementationArtifact: IMPLEMENTATION_ARTIFACT
      plan: null
    }
    const invalidArtifacts = [
      undefined
      null
      { ...IMPLEMENTATION_ARTIFACT, identity: "untrusted-artifact" }
      { ...IMPLEMENTATION_ARTIFACT, bytes: 1.5 }
      { ...IMPLEMENTATION_ARTIFACT, bytes: 0 }
      { ...IMPLEMENTATION_ARTIFACT, bytes: 49_153 }
      { ...IMPLEMENTATION_ARTIFACT, bytes: IMPLEMENTATION_ARTIFACT.bytes + 1 }
      { ...IMPLEMENTATION_ARTIFACT, digest: "invalid" }
      { ...IMPLEMENTATION_ARTIFACT, digest: "a".repeat(64) }
      artifactFor("{malformed")
      artifactFor("null")
      artifactFor("[]")
      artifactFor(JSON.stringify({ version: 2, entries: [] }))
      artifactFor(JSON.stringify({ version: 1, entries: {} }))
      artifactFor(`{ "version": 1, "entries": [] }`)
      artifactFor(contentFor([]))
      artifactFor(contentFor(Array.from(
        { length: 513 },
        (_, index) => ({ path: `path-${index}`, kind: "directory" }),
      )))
      artifactFor(contentFor([
        { path: "packages/jobs", kind: "directory" }
        { path: "packages/other", kind: "directory" }
      ]))
      artifactFor(contentFor([null]))
      artifactFor(contentFor([[]]))
      artifactFor(contentFor([{ path: "../escape", kind: "directory" }]))
      artifactFor(contentFor([{
        path: "packages/jobs"
        kind: "directory"
        extra: true
      }]))
      artifactFor(contentFor([{
        path: "packages/jobs"
        kind: "symlink"
        target: 1
      }]))
      artifactFor(contentFor([{
        path: "packages/jobs"
        kind: "symlink"
        target: "x".repeat(4_097)
      }]))
      artifactFor(contentFor([{
        path: "packages/jobs"
        kind: "symlink"
        target: "bad\0target"
      }]))
      artifactFor(contentFor([{
        path: "packages/jobs"
        kind: "file"
        mode: -1
        contentBase64: ""
      }]))
      artifactFor(contentFor([{
        path: "packages/jobs"
        kind: "file"
        mode: 0o644
        contentBase64: "***"
      }]))
      artifactFor(contentFor([{
        path: "packages/jobs"
        kind: "socket"
      }]))
      artifactFor(contentFor([{
        path: "packages/other"
        kind: "directory"
      }]))
    ]
    for implementationArtifact of invalidArtifacts
      await expect(application.completeEffect({
        ...metadata
        result: {
          ...validResult
          implementationArtifact
        } as never
      })).rejects.toThrow("implementation completion lacks bounded change evidence")
    const validFileContent = contentFor([{
      path: "packages/jobs"
      kind: "file"
      mode: 0o644
      contentBase64: Buffer.from("covered").toString("base64")
    }])
    await expect(application.completeEffect({
      ...metadata
      result: {
        ...validResult
        implementationArtifact: {
          ...artifactFor(validFileContent)
          identity: OMP_IMPLEMENTATION_ARTIFACT_IDENTITY
        }
      }
    })).rejects.toBeInstanceOf(WorkflowRunNotFoundError)
  )
  it("preserves one shutdown failure and aggregates concurrent shutdown failures", async () =>
    const fake = fakeRepository()
    const allSettled = vi.spyOn(Promise, "allSettled")
    try
      const single = new Error("worker shutdown failed")
      allSettled.mockResolvedValueOnce([
        { status: "rejected", reason: single }
        { status: "fulfilled", value: undefined }
        { status: "fulfilled", value: undefined }
      ] as never)
      await expect(runtimeFor(fake, {
        execute: vi.fn(async () => successfulExecution())
        cleanupRetainedWorkspace
      }, "worker-single-error").stop()).rejects.toBe(single)

      const workerError = new Error("worker shutdown failed")
      const cleanupError = new Error("cleanup shutdown failed")
      allSettled.mockResolvedValueOnce([
        { status: "rejected", reason: workerError }
        { status: "rejected", reason: cleanupError }
        { status: "fulfilled", value: undefined }
      ] as never)
      const rejection = await runtimeFor(fake, {
        execute: vi.fn(async () => successfulExecution())
        cleanupRetainedWorkspace
      }, "worker-aggregate-error").stop().catch((error: unknown) => error)
      expect(rejection).toBeInstanceOf(AggregateError)
      expect((rejection as AggregateError).errors).toEqual([
        workerError
        cleanupError
      ])
    finally
      allSettled.mockRestore()
  )

)
