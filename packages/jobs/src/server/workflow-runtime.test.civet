  it("rejects malformed claimed outbox rows at every parser boundary", async () =>
    const fake = fakeRepository()
    const application = createWorkflowApplication(fake.repository, {
      generateId: () => RUN_ID,
    })
    await application.createRun({ ownerId: OWNER_ID, event: submission() })
    const [leased] = await fake.repository.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-a"
      limit: 1
      leaseMilliseconds: 1_000
    })
    const row = leased!
    const payload = row.payload
    const task = payload["task"] as Readonly<Record<string, unknown>>
    const malformed = [
      { ...row, handler: "other" }
      { ...row, aggregateType: "other" }
      { ...row, idempotencyKey: null }
      { ...row, leaseOwner: null }
      { ...row, fence: 0 }
      { ...row, payload: [] }
      { ...row, payload: { ...payload, task: null } }
      { ...row, payload: { ...payload, effectKind: "deploy" } }
      { ...row, payload: { ...payload, ownerId: "" } }
      { ...row, payload: { ...payload, effectScope: { repositoryId: "../escape", paths: ["packages/jobs"] } } }
      { ...row, payload: { ...payload, task: { ...task, taskId: "" } } }
      { ...row, payload: { ...payload, task: { ...task, taskId: "title\ncontrol" } } }
      { ...row, payload: { ...payload, task: { ...task, taskId: "x".repeat(1_025) } } }
      { ...row, payload: { ...payload, task: { ...task, workspaceId: "" } } }
      { ...row, payload: { ...payload, task: { ...task, taskRevision: -1 } } }
    ] as unknown as readonly OutboxEvent[]

    for malformedRow of malformed
      const repository = Object.freeze({
        ...fake.repository
        claimDueEffects: vi.fn(async () => [malformedRow])
      }) as WorkflowRepository
      const outbox = createWorkflowRepositoryOutboxAdapter({
        repository
        application
      })
      await expect(outbox.claimDueEffects({
        handler: WORKFLOW_EFFECT_HANDLER
        leaseOwner: "worker-a"
        limit: 1
        leaseMilliseconds: 1_000
      })).rejects.toBeInstanceOf(TypeError)
  )

  it("retries retryable failures with exponential delay, then dead-letters the final attempt", async () =>
    const fake = fakeRepository()
    const application = createWorkflowApplication(fake.repository, {
      generateId: () => RUN_ID,
    })
    await application.createRun({ ownerId: OWNER_ID, event: submission() })
    const [leased] = await fake.repository.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-a"
      limit: 1
      leaseMilliseconds: 1_000
    })
    const failure = {
      status: "failed" as const
      eventType: "EFFECT_FAILED" as const
      failureCode: "timed-out" as const
      exitCode: null
      durationMs: 10
      outputBytes: 0
      outputTruncated: false
      outputRedacted: false
      changeHash: null
      changedPaths: [] as readonly string[]
      retryable: true
    }
    const failEffect = vi.fn(async () => true)
    const retryRepository = Object.freeze({
      ...fake.repository
      claimDueEffects: vi.fn(async () => [leased!])
      failEffect
    }) as WorkflowRepository
    const retrying = createWorkflowRepositoryOutboxAdapter({
      repository: retryRepository
      application
      now: () => NOW
    })
    const [retryClaim] = await retrying.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-a"
      limit: 1
      leaseMilliseconds: 1_000
    })
    await expect(retrying.failEffect({
      id: retryClaim!.id
      leaseOwner: retryClaim!.leaseOwner
      fenceToken: retryClaim!.fenceToken
      result: failure
    })).resolves.toBe("retry")
    expect(failEffect).toHaveBeenCalledWith(expect.objectContaining({
      retryAt: new Date(NOW.getTime() + 1_000)
    }))
    await expect(retrying.failEffect({
      id: retryClaim!.id
      leaseOwner: retryClaim!.leaseOwner
      fenceToken: retryClaim!.fenceToken
      result: failure
    })).resolves.toBe("unpersisted")
    const declinedRetry = vi.fn(async () => false)
    const defaultClock = createWorkflowRepositoryOutboxAdapter({
      repository: Object.freeze({
        ...fake.repository
        claimDueEffects: vi.fn(async () => [leased!])
        failEffect: declinedRetry
      }) as WorkflowRepository
      application
    })
    const [declinedClaim] = await defaultClock.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-a"
      limit: 1
      leaseMilliseconds: 1_000
    })
    await expect(defaultClock.failEffect({
      id: declinedClaim!.id
      leaseOwner: declinedClaim!.leaseOwner
      fenceToken: declinedClaim!.fenceToken
      result: failure
    })).resolves.toBe("unpersisted")
    expect(declinedRetry).toHaveBeenCalledWith(expect.objectContaining({
      retryAt: expect.any(Date)
    }))


    const finalApplication = Object.freeze({
      ...application
      failEffect: vi.fn(async () => null)
    })
    const finalRow = { ...leased!, attemptCount: 2 }
    const finalizing = createWorkflowRepositoryOutboxAdapter({
      repository: Object.freeze({
        ...fake.repository
        claimDueEffects: vi.fn(async () => [finalRow])
      }) as WorkflowRepository
      application: finalApplication
    })
    const [finalClaim] = await finalizing.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-a"
      limit: 1
      leaseMilliseconds: 1_000
    })
    await expect(finalizing.failEffect({
      id: finalClaim!.id
      leaseOwner: finalClaim!.leaseOwner
      fenceToken: finalClaim!.fenceToken
      result: failure
    })).resolves.toBe("unpersisted")
    expect(finalApplication.failEffect).toHaveBeenCalledOnce()
  )

  it("evicts cached ownership when a repository heartbeat throws", async () =>
    const fake = fakeRepository()
    const application = createWorkflowApplication(fake.repository, {
      generateId: () => RUN_ID,
    })
    await application.createRun({ ownerId: OWNER_ID, event: submission() })
    const [leased] = await fake.repository.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-a"
      limit: 1
      leaseMilliseconds: 1_000
    })
    const heartbeatError = new Error("heartbeat unavailable")
    const repository = Object.freeze({
      ...fake.repository
      claimDueEffects: vi.fn(async () => [leased!])
      heartbeatEffect: vi.fn(async () =>
        throw heartbeatError
      )
    }) as WorkflowRepository
    const outbox = createWorkflowRepositoryOutboxAdapter({ repository, application })
    const [claimed] = await outbox.claimDueEffects({
      handler: WORKFLOW_EFFECT_HANDLER
      leaseOwner: "worker-a"
      limit: 1
      leaseMilliseconds: 1_000
    })
    await expect(outbox.heartbeatEffect({
      id: claimed!.id
      leaseOwner: claimed!.leaseOwner
      fenceToken: claimed!.fenceToken
      leaseMilliseconds: 1_000
    })).rejects.toBe(heartbeatError)
    await expect(outbox.completeEffect({
      id: claimed!.id
      leaseOwner: claimed!.leaseOwner
      fenceToken: claimed!.fenceToken
      result: completion()
    })).resolves.toBe(false)
  )
  it("accepts production-Docker-shaped verification through terminal success", async () =>
    const fake = fakeRepository()
    const adapter: OmpCliAdapter = {
      cleanupRetainedWorkspace,
      execute: vi.fn(async (
        request: Parameters<OmpCliAdapter["execute"]>[0],
      ): Promise<OmpExecutionResult> =>
        if request.effectKind === "implement"
          return {
            ...successfulExecution()
            change: {
              changeHash: "c".repeat(64)
              changedPaths: ["packages/jobs"]
            }
            implementationArtifact: IMPLEMENTATION_ARTIFACT
          }
        if request.effectKind === "verify"
          return {
            ...successfulExecution()
            change: {
              changeHash: "c".repeat(64)
              changedPaths: ["packages/jobs"]
            }
            verification: productionDockerVerification()
            implementationArtifact: IMPLEMENTATION_ARTIFACT
          }
        return successfulExecution()
      )
    }
    const runtime = runtimeFor(fake, adapter, "worker-a")
    await runtime.application.createRun({ ownerId: OWNER_ID, event: submission() })
    await expect(runtime.runOnce()).resolves.toEqual([
      expect.objectContaining({ status: "completed" })
    ])

    const awaitingApproval = (
      await runtime.application.findProjection(OWNER_ID, RUN_ID)
    )!
    const approvalId = fake.approvals[0]!.id!
    const binding = createWorkflowApprovalBindingV1(
      approvalId,
      awaitingApproval.snapshot,
    )
    await runtime.application.decideApproval({
      ownerId: OWNER_ID
      runId: RUN_ID
      approval: {
        id: approvalId
        runId: RUN_ID
        ownerId: OWNER_ID
        decidedBy: OWNER_ID
        decision: "granted"
      }
      event: {
        type: "APPROVAL_GRANTED"
        eventId: "approval-granted-full"
        eventVersion: 1
        machineVersion: 1
        occurredAt: fake.now().toISOString()
        approvalId
        approvalHash: hashWorkflowApprovalV1({
          runId: RUN_ID
          approvalId
          snapshotSequence: binding.snapshotSequence
          journalHeadHash: binding.journalHeadHash
          effectHash: binding.effectHash
          effectScope: binding.effectScope
        })
        binding
      }
    })

    await expect(runtime.runOnce()).resolves.toEqual([
      expect.objectContaining({ status: "completed" })
    ])
    await expect(runtime.runOnce()).resolves.toEqual([
      expect.objectContaining({ status: "completed" })
    ])
    const finished = await runtime.application.findProjection(OWNER_ID, RUN_ID)
    expect(finished?.snapshot.state).toBe("completed")
    expect(finished?.journal.map(({ event }) => event.type)).toEqual([
      "RUN_SUBMITTED"
      "PLAN_SUCCEEDED"
      "APPROVAL_GRANTED"
      "IMPLEMENTATION_SUCCEEDED"
      "VERIFICATION_SUCCEEDED"
    ])
    expect(vi.mocked(adapter.execute).mock.calls.map(
      ([request]) => request.effectKind,
    )).toEqual(["plan", "implement", "verify"])
    expect(vi.mocked(adapter.execute).mock.calls[2]).toEqual([
      expect.objectContaining({
        recovery: {
          artifact: IMPLEMENTATION_ARTIFACT,
          changeHash: IMPLEMENTATION_CHANGE_HASH,
        },
      }),
    ])
    expect(fake.evidence.find(
      ({ kind }) => kind === "implement.succeeded",
    )?.data).toMatchObject({
      implementationArtifact: IMPLEMENTATION_ARTIFACT
    })
    expect(fake.evidence.find(
      ({ kind }) => kind === "verify.succeeded",
    )?.data).toMatchObject({
      verification: productionDockerVerification()
    })
  )

  it("retries twice with backoff before dead-lettering a terminal effect failure", async () =>
    const fake = fakeRepository()
    const dispositions: string[] = []
    const failedExecution: OmpExecutionResult = {
      ...successfulExecution()
      status: "timed-out"
      exitCode: null
    }
    const runtime = runtimeFor(fake, {
      cleanupRetainedWorkspace,
      execute: vi.fn(async () => ({
        ...failedExecution
        lifecycle: {
          finalize: async (disposition: OmpPersistenceDisposition) =>
            dispositions.push(disposition)
            return
        }
      })),
    }, "worker-a")
    await runtime.application.createRun({ ownerId: OWNER_ID, event: submission() })

    await expect(runtime.runOnce()).resolves.toEqual([
      expect.objectContaining({ status: "failed" })
    ])
    expect(fake.outbox()).toMatchObject({ attemptCount: 1, deadAt: null })
    fake.advance(1_000)
    await expect(runtime.runOnce()).resolves.toEqual([
      expect.objectContaining({ status: "failed" })
    ])
    expect(fake.outbox()).toMatchObject({ attemptCount: 2, deadAt: null })
    fake.advance(2_000)
    await expect(runtime.runOnce()).resolves.toEqual([
      expect.objectContaining({ status: "failed" })
    ])

    expect(fake.outbox()).toMatchObject({
      attemptCount: 3
      deadAt: expect.any(Date)
      lastError: "timed-out"
    })
    const failed = await runtime.application.findProjection(OWNER_ID, RUN_ID)
    expect(failed?.snapshot.state).toBe("blocked")
    expect(failed?.journal.at(-1)?.event).toMatchObject({
      type: "EFFECT_FAILED"
      failure: { code: "timed-out", retryable: true }
    })
    expect(dispositions).toEqual(["retry", "retry", "persisted"])
  )
  it("retains a retryable effect before a later successful persistence", async () =>
    const fake = fakeRepository()
    const dispositions: string[] = []
    const retryable: OmpExecutionResult = {
      ...successfulExecution()
      status: "timed-out"
      exitCode: null
      lifecycle: {
        finalize: async (disposition) =>
          dispositions.push(disposition)
          return
      }
    }
    const succeeded: OmpExecutionResult = {
      ...successfulExecution()
      lifecycle: {
        finalize: async (disposition) =>
          dispositions.push(disposition)
          return
      }
    }
    const adapter: OmpCliAdapter = {
      cleanupRetainedWorkspace,
      execute: vi.fn()
        .mockResolvedValueOnce(retryable)
        .mockResolvedValueOnce(succeeded)
    }
    const runtime = runtimeFor(fake, adapter, "worker-a")
    await runtime.application.createRun({ ownerId: OWNER_ID, event: submission() })

    await expect(runtime.runOnce()).resolves.toEqual([
      { id: expect.any(String), status: "failed" }
    ])
    expect(fake.outbox()).toMatchObject({ attemptCount: 1, deadAt: null })
    fake.advance(1_000)
    await expect(runtime.runOnce()).resolves.toEqual([
      { id: expect.any(String), status: "completed" }
    ])
    expect(dispositions).toEqual(["retry", "persisted"])
    expect((await runtime.application.findProjection(OWNER_ID, RUN_ID))?.snapshot.state)
      .toBe("awaitingApproval")
  )
  it("supports generated and explicit run IDs plus a direct nonduplicate transition", async () =>
    const generatedFake = fakeRepository()
    const generatedApplication = createWorkflowApplication(generatedFake.repository)
    const generated = await generatedApplication.createRun({
      ownerId: OWNER_ID
      event: submission()
    })
    expect(generated.snapshot.context.runId).toMatch(
      /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u,
    )

    const explicitFake = fakeRepository()
    const explicitApplication = createWorkflowApplication(explicitFake.repository)
    const explicit = await explicitApplication.createRun({
      ownerId: OWNER_ID
      runId: RUN_ID
      event: submission()
    })
    expect(explicit.snapshot.context.runId).toBe(RUN_ID)
    await expect(explicitApplication.listProjections(
      OWNER_ID,
      [RUN_ID, "missing-run"],
    )).resolves.toEqual([explicit])
    await expect(explicitApplication.listProjections(
      "other-owner",
      [RUN_ID],
    )).resolves.toEqual([])
    const transitioned = await explicitApplication.transition({
      ownerId: OWNER_ID
      runId: RUN_ID
      event: {
        type: "EFFECT_FAILED"
        eventId: "effect-direct-failed"
        eventVersion: 1
        machineVersion: 1
        occurredAt: NOW.toISOString()
        effectKind: "plan"
        failure: { code: "direct-failure", retryable: false }
      }
    })
    expect(transitioned.snapshot.state).toBe("blocked")
    expect(explicitFake.appended).toHaveLength(1)
  )

