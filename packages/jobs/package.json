{
  "name": "@darkfactory/jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/server/unsupported.civet"
  ],
  "exports": {
    ".": {
      "types": "./src/index.civet.d.ts",
      "import": "./src/index.civet",
      "default": "./src/index.civet"
    },
    "./server/inline": {
      "types": "./src/server/inline.civet.d.ts",
      "workerd": "./src/server/inline.civet",
      "worker": "./src/server/inline.civet",
      "browser": "./src/server/unsupported.civet",
      "import": "./src/server/inline.civet",
      "default": "./src/server/inline.civet"
    },
    "./test": {
      "types": "./src/test.civet.d.ts",
      "import": "./src/test.civet",
      "default": "./src/test.civet"
    }
  },
  "scripts": {
    "types": "civet --emit-declaration src/index.civet && civet --emit-declaration src/server/inline.civet && civet --emit-declaration src/test.civet",
    "typecheck": "civet --config civet.typecheck.json --typecheck",
    "test": "vitest run --config ../../vitest.config.ts --project unit src/*.test.civet src/server/*.test.civet",
    "test:unit": "vitest run --config ../../vitest.config.ts --project unit src/*.test.civet src/server/*.test.civet"
  },
  "devDependencies": {
    "@danielx/civet": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
