{
  "identity": "darkfactory-verifier-checks-v1",
  "commands": [
    {
      "id": "format",
      "executable": "biome",
      "args": ["format", "."],
      "cwd": "."
    },
    {
      "id": "lint",
      "executable": "biome",
      "args": ["lint", "."],
      "cwd": "."
    },
    {
      "id": "markdown",
      "executable": "markdownlint-cli2",
      "args": ["**/*.md"],
      "cwd": "."
    },
    {
      "id": "auth-schema",
      "executable": "bun",
      "args": ["{workspace}/packages/auth/scripts/check-auth-schema.ts"],
      "cwd": "."
    },
    {
      "id": "openapi",
      "executable": "bun",
      "args": ["{workspace}/packages/api/scripts/openapi.ts"],
      "cwd": "."
    },
    {
      "id": "typecheck-ai",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/ai"
    },
    {
      "id": "typecheck-analytics",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/analytics"
    },
    {
      "id": "typecheck-api",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/api"
    },
    {
      "id": "typecheck-auth",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/auth"
    },
    {
      "id": "typecheck-db",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/db"
    },
    {
      "id": "typecheck-email",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/email"
    },
    {
      "id": "typecheck-jobs",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/jobs"
    },
    {
      "id": "typecheck-observability",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/observability"
    },
    {
      "id": "typecheck-state",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/state"
    },
    {
      "id": "typecheck-ui",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "packages/ui"
    },
    {
      "id": "typecheck-web",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tsconfig.json"],
      "cwd": "apps/web"
    },
    {
      "id": "typecheck-scripts",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "scripts/tsconfig.json"],
      "cwd": "."
    },
    {
      "id": "typecheck-tests",
      "executable": "tsc",
      "args": ["--noEmit", "-p", "tests/tsconfig.json"],
      "cwd": "."
    },
    {
      "id": "tsc",
      "executable": "tsc",
      "args": ["--project", "tsconfig.json", "--noEmit"],
      "cwd": "."
    },
    {
      "id": "build-web",
      "executable": "vinext",
      "args": ["build"],
      "cwd": "apps/web"
    },
    {
      "id": "unit",
      "executable": "vitest",
      "args": ["run", "--config", "vitest.config.ts", "--project", "unit"],
      "cwd": "."
    },
    {
      "id": "contract",
      "executable": "vitest",
      "args": ["run", "--config", "vitest.config.ts", "--project", "contract"],
      "cwd": "."
    },
    {
      "id": "operations",
      "executable": "vitest",
      "args": [
        "run",
        "--config",
        "vitest.config.ts",
        "--project",
        "operations",
        "--project",
        "e2e-helpers",
        "--maxWorkers=1",
        "--no-file-parallelism"
      ],
      "cwd": "."
    },
    {
      "id": "docs",
      "executable": "bun",
      "args": ["{workspace}/scripts/docs.ts", "check"],
      "cwd": "."
    }
  ]
}
