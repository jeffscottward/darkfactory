{
  "name": "@darkfactory/storage",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.civet.d.ts",
      "import": "./src/index.civet",
      "default": "./src/index.civet"
    },
    "./test": {
      "types": "./src/test.civet.d.ts",
      "import": "./src/test.civet",
      "default": "./src/test.civet"
    }
  },
  "scripts": {
    "types": "civet --emit-declaration src/index.civet && civet --emit-declaration src/test.civet",
    "typecheck": "civet --config civet.typecheck.json --typecheck",
    "test": "vitest run --config ../../vitest.config.ts --project unit src/*.test.civet",
    "test:unit": "vitest run --config ../../vitest.config.ts --project unit src/*.test.civet"
  },
  "devDependencies": {
    "@danielx/civet": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
