import type { SafeAuthSession, SafePrincipal } from "@darkfactory/auth/types"
import {
  DatabaseConflictError,
  InvalidRepositoryInputError,
  type AddressRepository,
  type ProfileRepository,
  type UserPreferencesRepository,
} from "@darkfactory/db/server"
import type { Address, Profile, UserPreferences } from "@darkfactory/db/schema"

import type {
  AccountProfileOutput,
  AddressCreateInput,
  AddressUpdateInput,
  PreferencesOutput,
  PreferencesUpdateInput,
  ProfileOutput,
  ProfileUpdateInput,
} from "../contract.civet"

export type AccountServiceErrorCode = "NOT_FOUND" | "CONFLICT" | "VALIDATION_ERROR" | "STORAGE_ERROR"

export class AccountServiceError extends Error {
  readonly code: AccountServiceErrorCode
  constructor(code: AccountServiceErrorCode, message: string) {
    super(message)
    this.name = "AccountServiceError"
    this.code = code
  }
}

export type AccountRepositories = Readonly<{
  profiles: ProfileRepository
  addresses: AddressRepository
  userPreferences: UserPreferencesRepository
}>
export type AddressIdInput = Readonly<{ id: string; expectedUpdatedAt: Date }>
export type RemoveAddressResult = Readonly<{ removed: true }>

const DEFAULT_PROFILE: ProfileOutput = Object.freeze({
  firstName: null, lastName: null, displayName: null, avatarUrl: null,
  phone: null, businessName: null, jobTitle: null, biography: null,
  timezone: "UTC", locale: "en", dateOfBirth: null, updatedAt: null,
})
const DEFAULT_PREFERENCES: PreferencesOutput = Object.freeze({
  themeMode: "system", palette: "neutral", emailNotifications: true,
  productUpdates: true, analyticsConsent: false,
  personalizationConsent: false, profileVisibility: "private", updatedAt: null,
})

const toProfileOutput = (profile: Profile): ProfileOutput => ({
  firstName: profile.firstName, lastName: profile.lastName,
  displayName: profile.displayName, avatarUrl: profile.avatarUrl,
  phone: profile.phone, businessName: profile.businessName,
  jobTitle: profile.jobTitle, biography: profile.biography,
  timezone: profile.timezone, locale: profile.locale,
  dateOfBirth: profile.dateOfBirth,
  updatedAt: profile.updatedAt,
})
const toPreferencesOutput = (value: UserPreferences): PreferencesOutput => ({
  themeMode: value.mode, palette: value.colorScheme,
  emailNotifications: value.emailNotifications, productUpdates: value.productUpdates,
  analyticsConsent: value.analyticsConsent,
  personalizationConsent: value.personalizationConsent,
  profileVisibility: value.profileVisibility,
  updatedAt: value.updatedAt,
})

const mapAccountRepositoryError = (error: unknown): never => {
  if (error instanceof AccountServiceError) throw error
  if (error instanceof InvalidRepositoryInputError)
    throw new AccountServiceError("VALIDATION_ERROR", "Account validation failed")
  if (error instanceof DatabaseConflictError)
    throw new AccountServiceError("CONFLICT", "Account resource conflict")
  throw new AccountServiceError("STORAGE_ERROR", "Account storage is unavailable")
}
const runRepository = async <T>(operation: () => Promise<T>): Promise<T> => {
  try {
    return await operation()
  } catch (error) {
    return mapAccountRepositoryError(error)
  }
}
const missingAddress = (): never => {
  throw new AccountServiceError("NOT_FOUND", "Address not found")
}

export type AccountService = Readonly<{
  getProfile: (session: SafeAuthSession) => Promise<AccountProfileOutput>
  updateProfile: (session: SafeAuthSession, input: ProfileUpdateInput) => Promise<AccountProfileOutput>
  listAddresses: (principal: SafePrincipal) => Promise<Address[]>
  createAddress: (principal: SafePrincipal, input: AddressCreateInput) => Promise<Address>
  updateAddress: (principal: SafePrincipal, input: AddressUpdateInput) => Promise<Address>
  removeAddress: (principal: SafePrincipal, input: AddressIdInput) => Promise<RemoveAddressResult>
  setPrimaryAddress: (principal: SafePrincipal, input: AddressIdInput) => Promise<Address>
  getPreferences: (principal: SafePrincipal) => Promise<PreferencesOutput>
  updatePreferences: (principal: SafePrincipal, input: PreferencesUpdateInput) => Promise<PreferencesOutput>
}>

export const createAccountService = (repositories: AccountRepositories): AccountService => {
  const getProfile = async (session: SafeAuthSession): Promise<AccountProfileOutput> => {
    const stored = await runRepository(() => repositories.profiles.findByUserId(session.principal.userId))
    return {
      identity: { email: session.user.email, emailVerified: session.user.emailVerified },
      profile: stored === null ? DEFAULT_PROFILE : toProfileOutput(stored),
    }
  }
  const updateProfile = async (
    session: SafeAuthSession,
    input: ProfileUpdateInput,
  ): Promise<AccountProfileOutput> => {
    const stored = await runRepository(() => repositories.profiles.findByUserId(session.principal.userId))
    const current = stored === null ? DEFAULT_PROFILE : toProfileOutput(stored)
    const updated = await runRepository(() => repositories.profiles.updateOptimistic({
      userId: session.principal.userId,
      expectedUpdatedAt: input.expectedUpdatedAt,
      firstName: input.firstName === undefined ? current.firstName : input.firstName,
      lastName: input.lastName === undefined ? current.lastName : input.lastName,
      displayName: input.displayName === undefined ? current.displayName : input.displayName,
      avatarUrl: input.avatarUrl === undefined ? current.avatarUrl : input.avatarUrl,
      phone: input.phone === undefined ? current.phone : input.phone,
      businessName: input.businessName === undefined ? current.businessName : input.businessName,
      jobTitle: input.jobTitle === undefined ? current.jobTitle : input.jobTitle,
      biography: input.biography === undefined ? current.biography : input.biography,
      timezone: input.timezone === undefined ? current.timezone : input.timezone,
      locale: input.locale === undefined ? current.locale : input.locale,
      dateOfBirth: input.dateOfBirth === undefined ? current.dateOfBirth : input.dateOfBirth,
    }))
    return {
      identity: { email: session.user.email, emailVerified: session.user.emailVerified },
      profile: toProfileOutput(updated),
    }
  }
  const listAddresses = (owner: SafePrincipal): Promise<Address[]> =>
    runRepository(() => repositories.addresses.listByUserId(owner.userId))
  const createAddress = (owner: SafePrincipal, input: AddressCreateInput): Promise<Address> =>
    runRepository(() => repositories.addresses.create({
      userId: owner.userId,
      type: input.type,
      line1: input.line1,
      ...(input.line2 === undefined ? {} : { line2: input.line2 }),
      city: input.city,
      region: input.region,
      postalCode: input.postalCode,
      country: input.country,
      ...(input.isPrimary === undefined ? {} : { isPrimary: input.isPrimary }),
    }))
  const updateAddress = async (owner: SafePrincipal, input: AddressUpdateInput): Promise<Address> => {
    const updated = await runRepository(() => repositories.addresses.updateOptimistic({
      userId: owner.userId,
      id: input.id,
      expectedUpdatedAt: input.expectedUpdatedAt,
      ...(input.type === undefined ? {} : { type: input.type }),
      ...(input.line1 === undefined ? {} : { line1: input.line1 }),
      ...(input.line2 === undefined ? {} : { line2: input.line2 }),
      ...(input.city === undefined ? {} : { city: input.city }),
      ...(input.region === undefined ? {} : { region: input.region }),
      ...(input.postalCode === undefined ? {} : { postalCode: input.postalCode }),
      ...(input.country === undefined ? {} : { country: input.country }),
    }))
    return updated === null ? missingAddress() : updated
  }
  const removeAddress = async (owner: SafePrincipal, input: AddressIdInput): Promise<RemoveAddressResult> => {
    const removed = await runRepository(() => repositories.addresses.removeOptimistic({
      id: input.id,
      userId: owner.userId,
      expectedUpdatedAt: input.expectedUpdatedAt,
    }))
    if (!removed) return missingAddress()
    return { removed: true }
  }
  const setPrimaryAddress = async (owner: SafePrincipal, input: AddressIdInput): Promise<Address> => {
    const updated = await runRepository(() => repositories.addresses.setPrimaryOptimistic({
      id: input.id,
      userId: owner.userId,
      expectedUpdatedAt: input.expectedUpdatedAt,
    }))
    return updated === null ? missingAddress() : updated
  }
  const getPreferences = async (owner: SafePrincipal): Promise<PreferencesOutput> => {
    const stored = await runRepository(() => repositories.userPreferences.findByUserId(owner.userId))
    return stored === null ? DEFAULT_PREFERENCES : toPreferencesOutput(stored)
  }
  const updatePreferences = async (
    owner: SafePrincipal,
    input: PreferencesUpdateInput,
  ): Promise<PreferencesOutput> => {
    const current = await runRepository(() =>
      repositories.userPreferences.findByUserId(owner.userId)
    )
    const base = current === null ? DEFAULT_PREFERENCES : toPreferencesOutput(current)
    const stored = await runRepository(() => repositories.userPreferences.updateOptimistic({
      userId: owner.userId,
      expectedUpdatedAt: input.expectedUpdatedAt,
      emailNotifications: input.emailNotifications === undefined
        ? base.emailNotifications
        : input.emailNotifications,
      productUpdates: input.productUpdates === undefined ? base.productUpdates : input.productUpdates,
      analyticsConsent: input.analyticsConsent === undefined
        ? base.analyticsConsent
        : input.analyticsConsent,
      personalizationConsent: input.personalizationConsent === undefined
        ? base.personalizationConsent
        : input.personalizationConsent,
      profileVisibility: input.profileVisibility === undefined
        ? base.profileVisibility
        : input.profileVisibility,
    }))
    return toPreferencesOutput(stored)
  }
  return Object.freeze({
    getProfile,
    updateProfile,
    listAddresses,
    createAddress,
    updateAddress,
    removeAddress,
    setPrimaryAddress,
    getPreferences,
    updatePreferences,
  })
}
