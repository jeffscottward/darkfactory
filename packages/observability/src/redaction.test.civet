      compoundAuth: "before betterAuthSecret=raw-better-auth-secret after",
      compoundWebhook: "before webhookSecret=raw-webhook-secret after",
      compoundHmac: "before previewHmacKey=raw-preview-hmac after",
      compoundRsa: "before rsaPrivateKey=raw-rsa-private-embedded after",
