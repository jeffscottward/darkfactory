import { describe, expect, it } from "vitest"

import type { SemanticEvent } from "./port.civet"
import {
  REDACTED,
  TRUNCATED,
  freezeSnapshot,
  redact,
  redactSemanticEvent,
} from "./redaction.civet"

const makeSemanticEvent = (
  overrides: Readonly<Record<string, unknown>> = {},
): SemanticEvent =>
  ({
    eventId: "event-1",
    name: "account.updated",
    occurredAt: "2026-01-02T03:04:05.000Z",
    correlation: { requestId: "request-1" },
    ...overrides,
  }) as unknown as SemanticEvent

const expectNoSecrets = (
  value: unknown,
  secrets: readonly string[],
): void =>
  const serialized = JSON.stringify(value)
  for (const secret of secrets)
    expect(serialized).not.toContain(secret)

const expectInvalidSemanticEvent = (
  input: unknown,
  secret: string,
): void =>
  let thrown: unknown
  try
    redactSemanticEvent(input as SemanticEvent)
  catch error
    thrown = error
  expect(thrown).toBeInstanceOf(TypeError)
  expect((thrown as TypeError).message).toBe("Invalid semantic event")
  expect(String(thrown)).not.toContain(secret)

describe "redact", ->
  it "recursively removes every prohibited observability field without mutating the input", ->
    const input = {
      safe: "kept",
      password: "password-value",
      nested: {
        access_token: "access-token-value",
        refreshToken: "refresh-token-value",
        cookie: "session=raw-cookie",
        authorization: "Bearer raw-authorization",
        emailBody: "Reset with raw-email-body",
        email: "member@domain.test",
        address: { street: "1 Private Way", postalCode: "12345" },
        dateOfBirth: "1990-01-02",
        providerPayload: { response: "raw-provider-response" },
        clientSecret: "raw-client-secret",
        apiKey: "raw-api-key",
        prompt: "raw-provider-prompt",
        completion: "raw-provider-completion",
      },
      list: [{ setCookie: "raw-set-cookie" }, { safe: true }],
    }

    const output = redact(input)

    expect(output).toEqual({
      safe: "kept",
      password: REDACTED,
      nested: {
        access_token: REDACTED,
        refreshToken: REDACTED,
        cookie: REDACTED,
        authorization: REDACTED,
        emailBody: REDACTED,
        email: REDACTED,
        address: REDACTED,
        dateOfBirth: REDACTED,
        providerPayload: REDACTED,
        clientSecret: REDACTED,
        apiKey: REDACTED,
        prompt: REDACTED,
        completion: REDACTED,
      },
      list: [{ setCookie: REDACTED }, { safe: true }],
    })
    expect("password" in input.nested).toBe(false)
    expect(input.nested.providerPayload.response).toBe("raw-provider-response")
    expect(JSON.stringify(output)).not.toMatch(
      /password-value|access-token-value|raw-cookie|member@domain|Private Way|1990|provider-response|client-secret|api-key|provider-prompt|provider-completion/
    )

  it "scrubs secret patterns even when an attacker hides them under an innocent key", ->
    const output = redact({
      note: "Authorization: Bearer abc.def.ghi token=hidden password: hunter2 contact member@domain.test",
      jwt: "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.signature",
    })

    const serialized = JSON.stringify(output)
    expect(serialized).not.toContain("abc.def.ghi")
    expect(serialized).not.toContain("hidden")
    expect(serialized).not.toContain("hunter2")
    expect(serialized).not.toContain("member@domain.test")
    expect(serialized).not.toContain("eyJhbGci")

  it "redacts only valid bounded bare Basic credentials", ->
    const standardCredential = "dXNlcjpwYXNz"
    const urlCredential = "-zpwYXNz"
    const emptyUsernameCredential = "OnBhc3M="
    const plusCredential = "+zpwYXNz"
    const slashCredential = "/zpwYXNz"
    const underscoreCredential = "_zpwYXNz"
    const paddedCredential = "YTo="
    const short = "YQ"
    const invalidRemainder = "AAAAA"
    const noncanonical = "YTp"
    const mixedAlphabet = "+zpw_XNz"
    const colonless = "Y29uY2VwdHM="
    const malformed = "YTpi="
    const longCredential = `dXNlcjp4${"YWFh".repeat(255)}`
    const raisedBoundCredential = `dXNlcjp4${"YWFh".repeat(600)}`
    const output = redact({
      standard: `before Basic ${standardCredential} after`,
      url: `before Basic ${urlCredential} after`,
      period: `before Basic ${standardCredential}. after`,
      exclamation: `before Basic ${urlCredential}! after`,
      question: `before Basic ${standardCredential}? after`,
      plus: `before Basic ${plusCredential} after`,
      slash: `before Basic ${slashCredential} after`,
      underscore: `before Basic ${underscoreCredential} after`,
      padded: `before Basic ${paddedCredential} after`,
      short: `before Basic ${short} after`,
      invalidRemainder: `before Basic ${invalidRemainder} after`,
      noncanonical: `before Basic ${noncanonical} after`,
      mixedAlphabet: `before Basic ${mixedAlphabet} after`,
      colonless: `before Basic ${colonless} after`,
      malformed: `before Basic ${malformed} after`,
      long: `before Basic ${longCredential} after`,
      nested: {
        note: `before Basic ${emptyUsernameCredential} after`,
      },
      prose: "Basic concepts remain readable.",
    })
    const raisedBoundOutput = redact(
      `before Basic ${raisedBoundCredential}! after`,
      { maxStringLength: 4_096 },
    )

    expectNoSecrets(output, [
      standardCredential,
      urlCredential,
      emptyUsernameCredential,
      plusCredential,
      slashCredential,
      underscoreCredential,
      paddedCredential,
      longCredential,
    ])
    expectNoSecrets(raisedBoundOutput, [raisedBoundCredential])
    expect(output).toEqual({
      standard: `before Basic ${REDACTED} after`,
      url: `before Basic ${REDACTED} after`,
      period: `before Basic ${REDACTED}. after`,
      exclamation: `before Basic ${REDACTED}! after`,
      question: `before Basic ${REDACTED}? after`,
      plus: `before Basic ${REDACTED} after`,
      slash: `before Basic ${REDACTED} after`,
      underscore: `before Basic ${REDACTED} after`,
      padded: `before Basic ${REDACTED} after`,
      short: `before Basic ${short} after`,
      invalidRemainder: `before Basic ${invalidRemainder} after`,
      noncanonical: `before Basic ${noncanonical} after`,
      mixedAlphabet: `before Basic ${mixedAlphabet} after`,
      colonless: `before Basic ${colonless} after`,
      malformed: `before Basic ${malformed} after`,
      long: `before Basic ${REDACTED} after`,
      nested: {
        note: `before Basic ${REDACTED} after`,
      },
      prose: "Basic concepts remain readable.",
    })
    expect(raisedBoundOutput).toBe(`before Basic ${REDACTED}! after`)


