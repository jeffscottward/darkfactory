      apiVerifyPath:
        "before /api/auth/verify-email/raw-verify-path-token?next=/portal after",
      encodedVerifyQuery:
        "before /api/auth/verify-email?token%3Draw-encoded-verify-token&next=/portal after",
      publicResetUrl:
        "before https://auth.example/reset-password/raw-public-reset-token?next=/portal after",
      publicVerifyUrl:
        "before https://auth.example/verify-email?token=raw-public-verify-token&next=/portal after",
      rsaPrivateKey: "raw-rsa-private-direct",
