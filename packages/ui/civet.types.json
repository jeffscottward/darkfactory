{
  "tsConfig": {
    "rootDir": ".",
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
      "jsx": "react-jsx",
      "lib": ["ES2023", "DOM", "DOM.Iterable"],
      "types": ["node", "react", "react-dom"],
      "declaration": true,
      "emitDeclarationOnly": true,
      "declarationDir": "src",
      "rootDir": "src",
      "forceConsistentCasingInFileNames": false,
      "noCheck": true
    },
    "include": ["src/**/*.civet"],
    "exclude": ["src/**/*.test.civet"]
  }
}
