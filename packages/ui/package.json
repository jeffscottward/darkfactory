    },
    "./empty-state": {
      "import": "./src/empty-state.tsx",
      "default": "./src/empty-state.tsx"
    },
    "./headings": {
      "import": "./src/headings.tsx",
      "default": "./src/headings.tsx"
    },
    "./icon-button": {
      "import": "./src/icon-button.tsx",
      "default": "./src/icon-button.tsx"
    },
    "./input": {
      "import": "./src/input.tsx",
      "default": "./src/input.tsx"
    },
    "./label": {
      "import": "./src/label.tsx",
      "default": "./src/label.tsx"
    },
    "./palettes": {
      "import": "./src/palettes.ts",
      "default": "./src/palettes.ts"
    },
    "./separator": {
      "import": "./src/separator.tsx",
      "default": "./src/separator.tsx"
    },
    "./skeleton": {
      "import": "./src/skeleton.tsx",
      "default": "./src/skeleton.tsx"
    },
    "./stat-card": {
      "import": "./src/stat-card.tsx",
      "default": "./src/stat-card.tsx"
    },
    "./status-badge": {
      "import": "./src/status-badge.tsx",
      "default": "./src/status-badge.tsx"
    },
    "./textarea": {
      "import": "./src/textarea.tsx",
      "default": "./src/textarea.tsx"
    },
    "./utilities": {
      "import": "./src/utilities.ts",
      "default": "./src/utilities.ts"
    },
    "./client/dialog": {
      "import": "./src/client/dialog.ts",
      "default": "./src/client/dialog.ts"
    },
    "./client/dropdown-menu": {
      "import": "./src/client/dropdown-menu.ts",
      "default": "./src/client/dropdown-menu.ts"
    },
    "./client/tabs": {
      "import": "./src/client/tabs.ts",
      "default": "./src/client/tabs.ts"
    },
    "./client/theme": {
      "import": "./src/client/theme.ts",
      "default": "./src/client/theme.ts"
    },
    "./client/toaster": {
      "import": "./src/client/toaster.ts",
      "default": "./src/client/toaster.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm exec vitest run --config ../../vitest.config.ts --project unit src --exclude \"**/*contract.test.ts\"",
    "test:unit": "pnpm exec vitest run --config ../../vitest.config.ts --project unit ."
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "catalog:",
    "@fontsource-variable/public-sans": "catalog:",
