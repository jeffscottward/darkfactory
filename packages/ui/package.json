  "scripts": {
    "types": "bunx --bun --no-install civet --config civet.types.json --emit-declaration src/index.ts src/avatar.tsx src/badge.tsx src/button.tsx src/card.tsx src/empty-state.tsx src/headings.tsx src/icon-button.tsx src/input.tsx src/label.tsx src/palettes.ts src/separator.tsx src/skeleton.tsx src/stat-card.tsx src/status-badge.tsx src/textarea.tsx src/utilities.ts src/client/dialog.ts src/client/dropdown-menu.ts src/client/tabs.ts src/client/theme.ts src/client/toaster.ts",
    "typecheck": "bunx --bun --no-install civet --config civet.typecheck.json --typecheck",
    "test": "bun run types && corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit src --exclude \"**/*contract.test.ts\"",
