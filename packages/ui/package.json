  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./avatar": {
      "import": "./src/avatar.tsx",
      "default": "./src/avatar.tsx"
    },
    "./badge": {
      "import": "./src/badge.tsx",
      "default": "./src/badge.tsx"
    },
    "./button": {
      "import": "./src/button.tsx",
