{
  "name": "@darkfactory/db",
  "brick": "product",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/server/unsupported.ts"
  ],
  "exports": {
    "./schema": {
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./server": {
      "workerd": "./src/server/index.ts",
      "worker": "./src/server/index.ts",
      "browser": "./src/server/unsupported.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./server/migration": {
      "import": "./src/server/migration.ts",
      "default": "./src/server/migration.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm exec vitest run --config ../../vitest.config.ts --project unit src/server/boundary.test.ts src/server/server-bundle.test.ts src/server/client.test.ts src/server/repositories.test.ts --exclude \"**/*contract.test.ts\"",
    "test:unit": "pnpm exec vitest run --config ../../vitest.config.ts --project unit .",
    "db:generate": "bunx --bun --no-install drizzle-kit generate --config drizzle.config.ts",
    "db:check": "bunx --bun --no-install drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "bunx --bun --no-install drizzle-kit migrate --config drizzle.config.ts"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@darkfactory/observability": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
