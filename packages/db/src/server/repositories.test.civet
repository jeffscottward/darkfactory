    expect(queryParameters(staleDouble.operations[0]!)).toEqual([
      "address_home",
      "user_alice",
      PREVIOUS_VERSION,
    ])
    expect(queryParameters(staleDouble.operations[1]!)).toEqual([
      "address_home",
      "user_alice",
    ])

  it "returns null when primary selection cannot find the owner's address", async ->
