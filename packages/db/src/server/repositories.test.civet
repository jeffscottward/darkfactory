    const staleDouble = createQueryDatabaseDouble({
      delete: [[]],
      select: [[ADDRESS_ROW]],
    })
    const staleRepository = createAddressRepository(staleDouble.database)
    await expect(
      staleRepository.removeOptimistic({
        id: "address_home",
        userId: "user_alice",
        expectedUpdatedAt: PREVIOUS_VERSION,
      }),
