  and as andWhere,
  asc,
  desc,
  eq,
  ilike,
  or as orWhere,
  sql,
} from "drizzle-orm"
import {
  COLOR_SCHEMES,
  PREFERENCE_MODES,
  addresses,
  auditRecords,
  featureItems,
  outboxEvents,
  profiles,
  userPreferences,
  type Address,
  type AddressType,
  type ColorScheme,
  type FeatureItem,
  type FeatureItemMetadata,
  type JsonValue,
  type FeatureItemStatus,
  type PreferenceMode,
  type Profile,
  type ProfileVisibility,
  type UserPreferences,
} from "../schema/index.civet"
