{
  "name": "@darkfactory/operator",
  "brick": "agent-sdlc",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/server/unsupported.ts"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "import": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./client": {
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./server": {
      "workerd": "./src/server/unsupported.ts",
      "worker": "./src/server/unsupported.ts",
      "browser": "./src/server/unsupported.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm exec vitest run --config ../../vitest.config.ts --project unit src/ --exclude \"**/*contract.test.ts\"",
    "test:unit": "pnpm exec vitest run --config ../../vitest.config.ts --project unit ."
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@darkfactory/auth": "workspace:*",
    "@darkfactory/jobs": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
