{
  "name": "@darkfactory/analytics",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/server/unsupported.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.civet.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server/posthog": {
      "types": "./src/server/posthog.civet.d.ts",
      "workerd": "./src/server/posthog.ts",
      "worker": "./src/server/posthog.ts",
      "browser": "./src/server/unsupported.js",
      "import": "./src/server/posthog.ts",
      "default": "./src/server/posthog.ts"
    },
    "./test": {
      "types": "./src/test.civet.d.ts",
      "import": "./src/test.ts",
      "default": "./src/test.ts"
    }
  },
  "scripts": {
    "types": "bunx --bun --no-install civet --emit-declaration src/index.ts && bunx --bun --no-install civet --emit-declaration src/server/posthog.ts && bunx --bun --no-install civet --emit-declaration src/test.ts",
    "typecheck": "bunx --bun --no-install civet --config civet.typecheck.json --typecheck",
    "test": "corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit src/ --exclude \"**/*contract.test.ts\"",
    "test:unit": "corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit ."
  },
  "devDependencies": {
    "@danielx/civet": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
