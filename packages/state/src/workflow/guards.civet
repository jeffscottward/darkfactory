import {
  WORKFLOW_EFFECT_KINDS,
  WORKFLOW_EVENT_TYPES,
  WORKFLOW_EVENT_VERSION,
  MAX_WORKFLOW_STAGE_ATTEMPTS_V1,
  MAX_WORKFLOW_HUMAN_REQUEST_BYTES_V1,
  WORKFLOW_MACHINE_ID,
  WORKFLOW_MACHINE_VERSION,
  WORKFLOW_STATES,
  type WorkflowApprovalBindingV1,
  type WorkflowContextV1,
  type WorkflowEffectScopeV1,
  type WorkflowEventV1,
  type WorkflowSnapshotV1,
  type WorkflowStateV1,
} from "./types.civet"

const stateNames: ReadonlySet<string> = new Set(WORKFLOW_STATES)
const eventTypeNames: ReadonlySet<string> = new Set(WORKFLOW_EVENT_TYPES)
const effectKindNames: ReadonlySet<string> = new Set(WORKFLOW_EFFECT_KINDS)
const sha256Pattern = /^[a-f0-9]{64}$/

export const MAX_WORKFLOW_REPOSITORY_ID_BYTES = 64
export const MAX_WORKFLOW_SCOPE_PATHS = 128
export const MAX_WORKFLOW_SCOPE_PATH_BYTES = 256
export const MAX_WORKFLOW_SCOPE_BYTES = 4_096

const repositorySlugPattern =
  /^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$/u
const windowsAbsolutePathPattern = /^[A-Za-z]:[/\\]/u
const utf8Bytes = (value: string): number =>
  let bytes = 0
  for (const character of value)
    const codePoint = character.codePointAt(0)!
    bytes += codePoint <= 0x7f
      ? 1
      : codePoint <= 0x7ff
        ? 2
        : codePoint <= 0xffff
          ? 3
          : 4
  return bytes

export const isWorkflowRepositoryIdV1 = (value: unknown): value is string =>
  typeof value === "string" &&
    utf8Bytes(value) <= MAX_WORKFLOW_REPOSITORY_ID_BYTES &&
    repositorySlugPattern.test(value)

export const isWorkflowRelativePathV1 = (value: unknown): value is string =>
  if (
    typeof value !== "string" ||
    value.length === 0 ||
    utf8Bytes(value) > MAX_WORKFLOW_SCOPE_PATH_BYTES ||
    value.startsWith("/") ||
    value.includes("\\") ||
    windowsAbsolutePathPattern.test(value) ||
    /[\u0000-\u001F\u007F]/u.test(value)
  )
    return false
  if value === "." then return true
  const segments = value.split("/")
  return segments.every((segment) =>
    segment.length > 0 && segment !== "." && segment !== ".."
  )

const isRecord = (value: unknown): value is Record<string, unknown> =>
  typeof value === "object" && value !== null && !Array.isArray(value)

const isNonEmptyString = (value: unknown): value is string =>
  typeof value === "string" && value.length > 0

const isNonNegativeInteger = (value: unknown): value is number =>
  Number.isInteger(value) && (value as number) >= 0
const isWorkflowStageAttempt = (value: unknown): value is number =>
  isNonNegativeInteger(value) && value <= MAX_WORKFLOW_STAGE_ATTEMPTS_V1

const isHash = (value: unknown): value is string =>
  typeof value === "string" && sha256Pattern.test(value)

const isWorkflowExecutionMetadataV1 = (
  executionMode: unknown,
  humanRequest: unknown,
): boolean =>
  if executionMode === undefined
    return humanRequest === undefined
  if executionMode === "pilot"
    return humanRequest === undefined
  return executionMode === "wayfinder" &&
    typeof humanRequest === "string" &&
    humanRequest.length > 0 &&
    utf8Bytes(humanRequest) <= MAX_WORKFLOW_HUMAN_REQUEST_BYTES_V1 &&
    !/[\u0000-\u001F\u007F]/u.test(humanRequest)

export const isWorkflowStateV1 = (value: unknown): value is WorkflowStateV1 =>
  typeof value === "string" && stateNames.has(value)

export const isWorkflowEffectScopeV1 = (
  value: unknown
): value is WorkflowEffectScopeV1 =>
  if !isRecord(value) ||
      Object.keys(value).length !== 2 ||
      !isWorkflowRepositoryIdV1(value["repositoryId"]) ||
      !Array.isArray(value["paths"]) ||
      value["paths"].length === 0 ||
      value["paths"].length > MAX_WORKFLOW_SCOPE_PATHS ||
      !value["paths"].every(isWorkflowRelativePathV1)
    return false
  return utf8Bytes(JSON.stringify(value)) <= MAX_WORKFLOW_SCOPE_BYTES

export const parseWorkflowEffectScopeV1 = (
  value: unknown
): WorkflowEffectScopeV1 =>
  if !isWorkflowEffectScopeV1(value)
    throw new TypeError("Invalid workflow effect scope")
  return Object.freeze({
    repositoryId: value.repositoryId
    paths: Object.freeze([...value.paths])
  })

const isWorkflowFailureV1 = (value: unknown): boolean =>
  isRecord(value) &&
    isNonEmptyString(value["code"]) &&
    typeof value["retryable"] === "boolean" &&
    (value["evidenceId"] === undefined || isNonEmptyString(value["evidenceId"]))

export const isWorkflowApprovalBindingV1 = (
  value: unknown
): value is WorkflowApprovalBindingV1 =>
  isRecord(value) &&
    isNonEmptyString(value["approvalId"]) &&
    value["machineId"] === WORKFLOW_MACHINE_ID &&
    value["machineVersion"] === WORKFLOW_MACHINE_VERSION &&
    value["eventVersion"] === WORKFLOW_EVENT_VERSION &&
    isNonNegativeInteger(value["snapshotSequence"]) &&
    isHash(value["journalHeadHash"]) &&
    value["action"] === "implement" &&
    isHash(value["effectHash"]) &&
    isWorkflowEffectScopeV1(value["effectScope"])

export const isWorkflowEventV1 = (value: unknown): value is WorkflowEventV1 =>
  if !isRecord(value) ||
      !isNonEmptyString(value["eventId"]) ||
      value["eventVersion"] !== WORKFLOW_EVENT_VERSION ||
      value["machineVersion"] !== WORKFLOW_MACHINE_VERSION ||
      !isNonEmptyString(value["occurredAt"]) ||
      typeof value["type"] !== "string" ||
      !eventTypeNames.has(value["type"])
    return false

  switch value["type"]
    when "RUN_SUBMITTED"
      return isNonEmptyString(value["taskId"]) &&
        isNonEmptyString(value["workspaceId"]) &&
        isNonNegativeInteger(value["taskRevision"]) &&
        isHash(value["taskHash"]) &&
        isWorkflowEffectScopeV1(value["scope"]) &&
        isWorkflowExecutionMetadataV1(
          value["executionMode"],
          value["humanRequest"],
        )
    when "PLAN_SUCCEEDED"
      return isNonEmptyString(value["planEvidenceId"]) &&
        isHash(value["planHash"]) &&
        isWorkflowEffectScopeV1(value["implementationScope"])
    when "APPROVAL_GRANTED"
      return isNonEmptyString(value["approvalId"]) &&
        isHash(value["approvalHash"]) &&
        isWorkflowApprovalBindingV1(value["binding"])
    when "APPROVAL_REJECTED"
      return isNonEmptyString(value["approvalId"]) && isNonEmptyString(value["reasonCode"])
    when "IMPLEMENTATION_SUCCEEDED"
      return isNonEmptyString(value["implementationEvidenceId"]) &&
        isHash(value["changeHash"]) &&
        isWorkflowEffectScopeV1(value["verificationScope"])
    when "VERIFICATION_SUCCEEDED"
      return isNonEmptyString(value["verificationEvidenceId"])
    when "VERIFICATION_FAILED"
      return isWorkflowFailureV1(value["failure"])
    when "EFFECT_FAILED"
      return typeof value["effectKind"] === "string" &&
        effectKindNames.has(value["effectKind"]) &&
        isWorkflowFailureV1(value["failure"])
    when "RETRY_REQUESTED", "CANCEL_REQUESTED"
      return isNonEmptyString(value["reasonCode"])
    when "OPERATOR_MESSAGE_ADDED"
      return isNonEmptyString(value["messageId"])
  return false

const isNullableString = (value: unknown): boolean =>
  value === null || isNonEmptyString(value)

const isWorkflowEffectProposalV1 = (value: unknown): boolean =>
  if value === null then return true
  if !isRecord(value) ||
      typeof value["kind"] !== "string" ||
      !effectKindNames.has(value["kind"]) ||
      value["handler"] !== `coding-agent.${value["kind"]}` ||
      !isWorkflowEffectScopeV1(value["scope"]) ||
      !isRecord(value["payload"])
    return false
  const payload = value["payload"]
  return isNonEmptyString(payload["taskId"]) &&
    isNonEmptyString(payload["workspaceId"]) &&
    isNonNegativeInteger(payload["taskRevision"]) &&
    isHash(payload["taskHash"]) &&
    isNonNegativeInteger(payload["sourceSequence"]) &&
    Array.isArray(payload["evidenceIds"]) &&
    payload["evidenceIds"].every(isNonEmptyString) &&
    isWorkflowExecutionMetadataV1(
      payload["executionMode"],
      payload["humanRequest"],
    )

const isWorkflowContextV1 = (value: unknown): value is WorkflowContextV1 =>
  if !isRecord(value) ||
      !isNonEmptyString(value["runId"]) ||
      !isNonEmptyString(value["ownerId"]) ||
      !isNullableString(value["taskId"]) ||
      !isNullableString(value["workspaceId"]) ||
      !(value["taskRevision"] === null || isNonNegativeInteger(value["taskRevision"])) ||
      !(value["taskHash"] === null || isHash(value["taskHash"])) ||
      !(value["scope"] === null || isWorkflowEffectScopeV1(value["scope"])) ||
      !isWorkflowExecutionMetadataV1(
        value["executionMode"],
        value["humanRequest"],
      ) ||
      !isRecord(value["attempts"]) ||
      !isWorkflowStageAttempt(value["attempts"]["plan"]) ||
      !isWorkflowStageAttempt(value["attempts"]["implement"]) ||
      !isWorkflowStageAttempt(value["attempts"]["verify"]) ||
      !isWorkflowEffectProposalV1(value["pendingEffect"]) ||
      !isNullableString(value["planEvidenceId"]) ||
      !(value["planHash"] === null || isHash(value["planHash"])) ||
      !isNullableString(value["approvalId"]) ||
      !(value["approvalHash"] === null || isHash(value["approvalHash"])) ||
      !isNullableString(value["implementationEvidenceId"]) ||
      !(value["changeHash"] === null || isHash(value["changeHash"])) ||
      !isNullableString(value["verificationEvidenceId"]) ||
      !isNullableString(value["lastErrorCode"]) ||
      !isNonNegativeInteger(value["messageCount"])
    return false

  return value["failedStage"] === null ||
    value["failedStage"] === "planning" ||
    value["failedStage"] === "implementing" ||
    value["failedStage"] === "verifying"

export const isWorkflowSnapshotV1 = (
  value: unknown
): value is WorkflowSnapshotV1 =>
  isRecord(value) &&
    value["machineId"] === WORKFLOW_MACHINE_ID &&
    value["machineVersion"] === WORKFLOW_MACHINE_VERSION &&
    isWorkflowStateV1(value["state"]) &&
    isNonNegativeInteger(value["sequence"]) &&
    isHash(value["journalHeadHash"]) &&
    isWorkflowContextV1(value["context"])

type AssertWorkflowEventV1 = (
  value: unknown
) => asserts value is WorkflowEventV1

export const assertWorkflowEventV1: AssertWorkflowEventV1 = (
  value
): void =>
  if isRecord(value) && value["machineVersion"] !== WORKFLOW_MACHINE_VERSION
    throw new TypeError("Unsupported workflow machine version")
  if isRecord(value) && value["eventVersion"] !== WORKFLOW_EVENT_VERSION
    throw new TypeError("Unsupported workflow event version")
  if !isWorkflowEventV1(value)
    throw new TypeError("Invalid workflow event")

type AssertWorkflowSnapshotV1 = (
  value: unknown
) => asserts value is WorkflowSnapshotV1

export const assertWorkflowSnapshotV1: AssertWorkflowSnapshotV1 = (
  value
): void =>
  if isRecord(value) && value["machineVersion"] !== WORKFLOW_MACHINE_VERSION
    throw new TypeError("Unsupported workflow machine version")
  if isRecord(value) && !isWorkflowStateV1(value["state"])
    throw new TypeError("Invalid workflow state")
  if !isWorkflowSnapshotV1(value)
    throw new TypeError("Invalid workflow snapshot")
