{
  "name": "@darkfactory/state",
  "brick": "product",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./flow": {
      "import": "./src/setup-flow.ts",
      "default": "./src/setup-flow.ts"
    },
    "./workflow": {
      "import": "./src/workflow/index.ts",
      "default": "./src/workflow/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm exec vitest run --config ../../vitest.config.ts --project unit src/**/*.test.ts",
    "test:unit": "pnpm exec vitest run --config ../../vitest.config.ts --project unit ."
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "xstate": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
