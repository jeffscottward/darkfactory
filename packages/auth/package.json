{
  "name": "@darkfactory/auth",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/server/unsupported.js"
  ],
  "exports": {
    "./server": {
      "types": "./src/server.civet.d.ts",
      "workerd": "./src/server.ts",
      "worker": "./src/server.ts",
      "browser": "./src/server/unsupported.js",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./db": {
      "types": "./src/db.civet.d.ts",
      "workerd": "./src/db.ts",
      "worker": "./src/db.ts",
      "browser": "./src/server/unsupported.js",
      "import": "./src/db.ts",
      "default": "./src/db.ts"
    },
    "./client": {
      "types": "./src/client.civet.d.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./types": {
      "types": "./src/types.civet.d.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "auth:schema:generate": "bun scripts/check-auth-schema.ts --write",
    "auth:schema:check": "bun scripts/check-auth-schema.ts",
    "types": "bunx --bun --no-install civet --config civet.types.json --emit-declaration src/types.ts src/server.ts src/rate-limit-storage.ts src/client.ts src/db.ts",
    "typecheck": "bunx --bun --no-install civet --config civet.typecheck.json --typecheck",
    "test": "corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit src/boundary.test.ts src/db.test.ts src/server-bundle.test.ts src/verification-config.test.ts",
    "test:unit": "corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@darkfactory/db": "workspace:*",
    "@darkfactory/email": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@danielx/civet": "catalog:",
    "@types/node": "catalog:",
    "auth": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
