import type { CSSProperties } from "react"
import {
  Body,
  Button,
  Container,
  Head,
  Html,
  Preview,
} from "react-email"

import type { PasswordResetEmailInput } from "../index.civet"

const bodyStyle: CSSProperties = {
  backgroundColor: "#f4f4f5",
  color: "#18181b",
  fontFamily:
    "Public Sans, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
  margin: "0",
  padding: "32px 12px",
}

const containerStyle: CSSProperties = {
  backgroundColor: "#ffffff",
  border: "1px solid #e4e4e7",
  borderRadius: "12px",
  boxSizing: "border-box",
  margin: "0 auto",
  maxWidth: "560px",
  padding: "40px",
}

const headingStyle: CSSProperties = {
  color: "#18181b",
  fontSize: "28px",
  fontWeight: "700",
  letterSpacing: "-0.02em",
  lineHeight: "1.2",
  margin: "0 0 24px",
}

const textStyle: CSSProperties = {
  color: "#3f3f46",
  fontSize: "16px",
  lineHeight: "1.6",
  margin: "0 0 20px",
}

const buttonStyle: CSSProperties = {
  backgroundColor: "#18181b",
  borderRadius: "8px",
  color: "#ffffff",
  display: "inline-block",
  fontSize: "16px",
  fontWeight: "600",
  lineHeight: "1",
  margin: "8px 0 28px",
  padding: "14px 20px",
  textDecoration: "none",
}

const footerStyle: CSSProperties = {
  color: "#71717a",
  fontSize: "14px",
  lineHeight: "1.5",
  margin: "28px 0 0",
}

export const PasswordResetEmail = ({
  recipientName,
  resetUrl,
  expiresInMinutes,
}: PasswordResetEmailInput) => {
  const greeting = recipientName ? `Hello ${recipientName},` : "Hello,"
  const expiryUnit = expiresInMinutes === 1 ? "minute" : "minutes"

  return (
    <Html dir="ltr" lang="en">
      <Head>
        <title>Reset your DarkFactory password</title>
      </Head>
      <Preview>Reset your DarkFactory password</Preview>
      <Body dir="ltr" lang="en" style={bodyStyle}>
        <Container style={containerStyle}>
          <main aria-labelledby="password-reset-heading">
            <h1 id="password-reset-heading" style={headingStyle}>
              Reset your password
            </h1>
            <p style={textStyle}>{greeting}</p>
            <p style={textStyle}>
              We received a request to reset your DarkFactory password.
            </p>
            <Button
              aria-label="Reset your DarkFactory password"
              href={resetUrl}
              style={buttonStyle}
            >
              Reset your password
            </Button>
            <p style={textStyle}>
              This link expires in {expiresInMinutes} {expiryUnit} and can be
              used only once.
            </p>
            <p style={footerStyle}>
              If you did not request a password reset, you can ignore this
              email.
            </p>
          </main>
        </Container>
      </Body>
    </Html>
  )
}
