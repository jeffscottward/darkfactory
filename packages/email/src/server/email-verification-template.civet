import type { CSSProperties } from "react"
import {
  Body,
  Button,
  Container,
  Head,
  Html,
  Preview,
} from "react-email"

import type { EmailVerificationEmailInput } from "../index.civet"

const bodyStyle: CSSProperties = {
  backgroundColor: "#f6f2ea",
  color: "#211f1b",
  fontFamily:
    "Public Sans, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
  margin: "0",
  padding: "32px 12px",
}

const containerStyle: CSSProperties = {
  backgroundColor: "#fbf9f4",
  border: "1px solid #d6d0c4",
  borderRadius: "12px",
  boxSizing: "border-box",
  margin: "0 auto",
  maxWidth: "560px",
  padding: "40px",
}

const headingStyle: CSSProperties = {
  color: "#211f1b",
  fontFamily:
    "Manrope, Public Sans, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
  fontSize: "28px",
  fontWeight: "700",
  letterSpacing: "-0.02em",
  lineHeight: "1.2",
  margin: "0 0 24px",
}

const textStyle: CSSProperties = {
  color: "#4e4941",
  fontSize: "16px",
  lineHeight: "1.6",
  margin: "0 0 20px",
}

const buttonStyle: CSSProperties = {
  backgroundColor: "#3d3933",
  borderRadius: "8px",
  color: "#faf7f0",
  display: "inline-block",
  fontSize: "16px",
  fontWeight: "600",
  lineHeight: "1",
  margin: "8px 0 28px",
  padding: "14px 20px",
  textDecoration: "none",
}

const footerStyle: CSSProperties = {
  color: "#615d55",
  fontSize: "14px",
  lineHeight: "1.5",
  margin: "28px 0 0",
}

export const EmailVerificationEmail = ({
  recipientName,
  verificationUrl,
  expiresInMinutes,
}: EmailVerificationEmailInput) => {
  const greeting = recipientName ? `Hello ${recipientName},` : "Hello,"
  const expiryUnit = expiresInMinutes === 1 ? "minute" : "minutes"

  return (
    <Html dir="ltr" lang="en">
      <Head>
        <title>Verify your DarkFactory email</title>
      </Head>
      <Preview>Verify your DarkFactory email</Preview>
      <Body dir="ltr" lang="en" style={bodyStyle}>
        <Container style={containerStyle}>
          <main aria-labelledby="email-verification-heading">
            <h1 id="email-verification-heading" style={headingStyle}>
              Verify your email
            </h1>
            <p style={textStyle}>{greeting}</p>
            <p style={textStyle}>
              Confirm this email address to finish setting up your DarkFactory
              account.
            </p>
            <Button
              aria-label="Verify your DarkFactory email"
              href={verificationUrl}
              style={buttonStyle}
            >
              Verify email
            </Button>
            <p style={textStyle}>
              This link expires in {expiresInMinutes} {expiryUnit} and can be
              used only once.
            </p>
            <p style={footerStyle}>
              If you did not create or request access to this account, you can
              ignore this email.
            </p>
          </main>
        </Container>
      </Body>
    </Html>
  )
}
