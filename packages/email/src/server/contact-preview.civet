import { randomUUID } from "node:crypto"
import {
  chmod,
  lstat,
  mkdir,
  open,
  readdir,
  realpath,
  rm,
  type FileHandle,
} from "node:fs/promises"
import { fileURLToPath } from "node:url"
import { dirname, join, parse } from "node:path"

import type {
  ContactEmailDeliveryResult,
  ContactEmailInput,
  ContactEmailPort,
} from "../index.civet"
import { renderContactEmail } from "./render-contact.civet"

const DEFAULT_MAX_ARTIFACTS = 20
const DEFAULT_PREVIEW_DIRECTORY = fileURLToPath(
  new URL("../../previews/", import.meta.url),
)

export type PreviewContactEmailPortOptions = Readonly<{
  environment: "development" | "test" | "production"
  directory?: string | undefined
  maxArtifacts?: number | undefined
}>

const previewFailure = (
  code: "CONTACT_RENDER_FAILED" | "CONTACT_PREVIEW_WRITE_FAILED",
): ContactEmailDeliveryResult => ({
  status: "not-delivered",
  provider: "preview",
  code,
  retryable: false,
})

const assertCanonicalDirectory = async (directory: string): Promise<string> => {
  await mkdir(directory, { recursive: true, mode: 0o700 })
  const requestedDirectory = await lstat(directory)
  if (requestedDirectory.isSymbolicLink() || !requestedDirectory.isDirectory()) {
    throw new Error("Unsafe preview directory")
  }

  const canonicalDirectory = await realpath(directory)
  const root = parse(canonicalDirectory).root
  let currentDirectory = canonicalDirectory
  while (currentDirectory !== root) {
    const current = await lstat(currentDirectory)
    if (current.isSymbolicLink() || !current.isDirectory()) {
      throw new Error("Unsafe preview directory ancestry")
    }
    currentDirectory = dirname(currentDirectory)
  }

  await chmod(canonicalDirectory, 0o700)
  return canonicalDirectory
}

const closeHandles = async (handles: readonly FileHandle[]): Promise<void> => {
  await Promise.allSettled(handles.map((handle) => handle.close()))
}

const trimArtifacts = async (
  directory: string,
  currentHtmlName: string,
  maxArtifacts: number,
): Promise<void> => {
  const artifacts = await Promise.all(
    (await readdir(directory))
      .filter((fileName) => fileName.endsWith(".html"))
      .map(async (fileName) => ({
        fileName,
        modifiedAt: (await lstat(join(directory, fileName))).mtimeMs,
      })),
  )
  const excess = Math.max(0, artifacts.length - maxArtifacts)
  const expired = artifacts
    .filter(({ fileName }) => fileName !== currentHtmlName)
    .sort((left, right) =>
      left.modifiedAt - right.modifiedAt || left.fileName.localeCompare(right.fileName)
    )
    .slice(0, excess)

  await Promise.all(expired.flatMap(({ fileName }) => {
    const artifactName = fileName.slice(0, -".html".length)
    return [
      rm(join(directory, `${artifactName}.html`), { force: true }),
      rm(join(directory, `${artifactName}.txt`), { force: true }),
    ]
  }))
}

export const createPreviewContactEmailPort = (
  options: PreviewContactEmailPortOptions,
): ContactEmailPort => {
  if (options.environment === "production") {
    throw new Error("Preview contact email transport is unavailable in production")
  }

  const directory = options.directory ?? DEFAULT_PREVIEW_DIRECTORY
  const maxArtifacts = options.maxArtifacts ?? DEFAULT_MAX_ARTIFACTS
  if (!Number.isInteger(maxArtifacts) || maxArtifacts <= 0) {
    throw new RangeError("maxArtifacts must be a positive integer")
  }

  return Object.freeze({
    sendContact: async (
      input: ContactEmailInput,
    ): Promise<ContactEmailDeliveryResult> => {
      let rendered
      try {
        rendered = await renderContactEmail(input)
      } catch {
        return previewFailure("CONTACT_RENDER_FAILED")
      }

      let canonicalDirectory: string
      try {
        canonicalDirectory = await assertCanonicalDirectory(directory)
      } catch {
        return previewFailure("CONTACT_PREVIEW_WRITE_FAILED")
      }

      const artifactName = `contact-${randomUUID()}`
      const htmlPath = join(canonicalDirectory, `${artifactName}.html`)
      const textPath = join(canonicalDirectory, `${artifactName}.txt`)
      const handles: FileHandle[] = []

      try {
        const htmlHandle = await open(htmlPath, "wx", 0o600)
        handles.push(htmlHandle)
        const textHandle = await open(textPath, "wx", 0o600)
        handles.push(textHandle)
        await Promise.all([
          htmlHandle.writeFile(rendered.html, "utf8"),
          textHandle.writeFile(rendered.text, "utf8"),
        ])
        await closeHandles(handles)
        handles.length = 0
        await trimArtifacts(canonicalDirectory, `${artifactName}.html`, maxArtifacts)
      } catch {
        await closeHandles(handles)
        await Promise.allSettled([
          rm(htmlPath, { force: true }),
          rm(textPath, { force: true }),
        ])
        return previewFailure("CONTACT_PREVIEW_WRITE_FAILED")
      }

      return {
        status: "previewed",
        provider: "preview",
        artifactPath: htmlPath,
      }
    },
  })
}
