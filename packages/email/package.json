{
  "name": "@darkfactory/email",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/server/unsupported.civet"
  ],
  "exports": {
    ".": {
      "types": "./src/index.civet.d.ts",
      "import": "./src/index.civet",
      "default": "./src/index.civet"
    },
    "./server": {
      "types": "./src/server-types.civet.d.ts",
      "workerd": "./src/server.civet",
      "worker": "./src/server.civet",
      "browser": "./src/server/unsupported.civet",
      "import": "./src/server.civet",
      "default": "./src/server.civet"
    },
    "./recipient": {
      "types": "./src/recipient.ts",
      "import": "./src/recipient.ts",
      "default": "./src/recipient.ts"
    },
    "./test": {
      "types": "./src/test.civet.d.ts",
      "import": "./src/test.civet",
      "default": "./src/test.civet"
    }
  },
  "scripts": {
    "types": "bunx --bun --no-install civet --config civet.types.json --emit-declaration src/index.civet src/server-types.civet src/test.civet",
    "typecheck": "bunx --bun --no-install civet --config civet.typecheck.json --typecheck",
    "test": "corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit src/server/",
    "test:unit": "corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit src/server/"
  },
  "dependencies": {
    "resend": "catalog:"
  },
  "devDependencies": {
    "@danielx/civet": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
