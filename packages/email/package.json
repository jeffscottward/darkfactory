{
  "name": "@darkfactory/email",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/server/unsupported.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.civet.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server-types.civet.d.ts",
      "workerd": "./src/server.ts",
      "worker": "./src/server.ts",
      "browser": "./src/server/unsupported.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./recipient": {
      "types": "./src/recipient.ts",
      "import": "./src/recipient.ts",
      "default": "./src/recipient.ts"
    },
    "./test": {
      "types": "./src/test.civet.d.ts",
      "import": "./src/test.ts",
      "default": "./src/test.ts"
    }
  },
  "scripts": {
    "types": "bunx --bun --no-install civet --config civet.types.json --emit-declaration src/index.ts src/server-types.ts src/test.ts",
    "typecheck": "bunx --bun --no-install civet --config civet.typecheck.json --typecheck",
    "test": "corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit src/server/",
    "test:unit": "corepack pnpm exec vitest run --config ../../vitest.config.ts --project unit ."
  },
  "dependencies": {
    "resend": "catalog:"
  },
  "devDependencies": {
    "@danielx/civet": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
