{
  "name": "@darkfactory/ai",
  "brick": "capability",
  "description": "AI text port with a Groq adapter.",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/server/unsupported.ts"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./adapters": {
      "import": "./src/adapters.ts",
      "default": "./src/adapters.ts"
    },
    "./server/groq": {
      "workerd": "./src/server/groq.ts",
      "worker": "./src/server/groq.ts",
      "browser": "./src/server/unsupported.ts",
      "import": "./src/server/groq.ts",
      "default": "./src/server/groq.ts"
    },
    "./test": {
      "import": "./src/test.ts",
      "default": "./src/test.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "pnpm exec vitest run --config ../../vitest.config.ts --project unit ."
  },
  "dependencies": {
    "groq-sdk": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
