  it "keeps one wall-clock deadline across lifecycle changes and restarts it manually", async ->
    vi.useFakeTimers()
    const blockedOutput = detail(
      { state: "blocked", blockedReason: "Implementation stopped." },
      { approval: null, implementationPlan: null, canRequestPlanRevision: false },
    )
    const load = vi.fn()
      .mockResolvedValueOnce(detail(
        { state: "planning" },
        { approval: null, implementationPlan: null, canRequestPlanRevision: false },
      ))
      .mockResolvedValueOnce(blockedOutput)
      .mockImplementation(async () => blockedOutput)
    render(<OperatorRunDetail gateway={gatewayWith({ detail: load })} id="run-1" />)
    await act(async () =>
      await Promise.resolve()
      await Promise.resolve()
    )

    await act(async () => await vi.advanceTimersByTimeAsync(10_000))
    await act(async () => await vi.advanceTimersByTimeAsync(290_000))
    expect(screen.getByText(
      "Automatic updates are paused. Select Refresh run to start another five-minute session.",
    )).toBeDefined()
    const callsAtDeadline = load.mock.calls.length
    await act(async () => await vi.advanceTimersByTimeAsync(20_000))
    expect(load).toHaveBeenCalledTimes(callsAtDeadline)

    fireEvent.click(screen.getByRole("button", { name: "Refresh run" }))
    await act(async () =>
      await Promise.resolve()
      await Promise.resolve()
    )
    expect(load).toHaveBeenCalledTimes(callsAtDeadline + 1)
    expect(screen.getByText(
      "Automatic updates are active for five minutes. You can refresh this run at any time.",
    )).toBeDefined()
    await act(async () => await vi.advanceTimersByTimeAsync(10_000))
    expect(load).toHaveBeenCalledTimes(callsAtDeadline + 2)

  it "ignores a cleared deadline callback from an older refresh session", async ->
    vi.useFakeTimers()
    const timeout = vi.spyOn(window, "setTimeout")
    const load = vi.fn(async () => detail({ state: "planning" }))
    render(<OperatorRunDetail gateway={gatewayWith({ detail: load })} id="run-1" />)
    await act(async () =>
      await Promise.resolve()
      await Promise.resolve()
    )
    const staleDeadline = timeout.mock.calls.find(
      ([, delay]) => delay === 300_000,
    )?.[0]
    if staleDeadline === undefined then throw new Error("missing refresh deadline")

    fireEvent.click(screen.getByRole("button", { name: "Refresh run" }))
    await act(async () =>
      await Promise.resolve()
      await Promise.resolve()
    )
    act(() => staleDeadline())

    expect(screen.getByText(
      "Automatic updates are active for five minutes. You can refresh this run at any time.",
    )).toBeDefined()

  it "drops queued focus work when unmounted after a successful action", async ->
    const callbacks: Array<() => void> = []
    const focus = vi.spyOn(HTMLElement.prototype, "focus")
    render(<OperatorRunDetail
      gateway={gatewayWith({
        detail: vi.fn(async () => detail({ state: "blocked" })),
        retry: vi.fn(async () => detail({ state: "planning" })),
      })}
      id="run-1"
    />)
    await screen.findByRole("heading", { name: "Release recovery" })
    vi.stubGlobal("queueMicrotask", vi.fn((callback: () => void) =>
      callbacks.push(callback)
    ))
    fireEvent.click(screen.getByRole("button", { name: "Retry run" }))
    expect(await screen.findByText("Retry requested.")).toBeDefined()
    cleanup()
    focus.mockClear()

    for (const callback of callbacks) callback()
    expect(focus).not.toHaveBeenCalled()

