    const messageRequest = deferred<OperatorRunDetailOutput>()
    const focus = vi.spyOn(HTMLElement.prototype, "focus")
    const mounted = render(<OperatorRunDetail
      gateway={gatewayWith({
        detail: vi.fn(async () => detail()),
        message: vi.fn(() => messageRequest.promise),
      })}
      id="run-1"
    />)
    await screen.findByRole("heading", { name: "Release recovery" })
    fireEvent.change(screen.getByLabelText("Add operator message"), {
      target: { value: "Late message" },
    })
    fireEvent.click(screen.getByRole("button", { name: "Add note" }))
    mounted.unmount()
    focus.mockClear()

    await act(async () =>
      messageRequest.reject({ code: "FORBIDDEN" })
      await Promise.resolve()
    )
    expect(focus).not.toHaveBeenCalled()
    expect(screen.queryByText("You do not have access to this workflow run.")).toBeNull()

  it "ignores successful and failed detail loads after unmount", async ->
    const lateSuccess = deferred<OperatorRunDetailOutput>()
    const first = render(<OperatorRunDetail
      gateway={gatewayWith({ detail: vi.fn(() => lateSuccess.promise) })}
      id="run-1"
    />)
    first.unmount()
    await act(async () =>
      lateSuccess.resolve(detail({ title: "Late detail" }))
      await Promise.resolve()
    )
    expect(screen.queryByText("Late detail")).toBeNull()

    const lateFailure = deferred<OperatorRunDetailOutput>()
    const second = render(<OperatorRunDetail
      gateway={gatewayWith({ detail: vi.fn(() => lateFailure.promise) })}
      id="run-1"
    />)
    second.unmount()
    await act(async () =>
      lateFailure.reject({ code: "NOT_FOUND" })
      await Promise.resolve()
    )
    expect(screen.queryByText("Workflow run unavailable")).toBeNull()

describe "approval panel behavior", ->
  it "forwards fresh decisions and restricts stale conflicts to reload", ->
    const onApprove = vi.fn()
    const onReject = vi.fn()
    const onReload = vi.fn()
    const onRequestChanges = vi.fn(async () => true)
    const mounted = render(<ApprovalPanel
      approval={approval}
      implementationPlan={implementationPlan}
      busyAction={null}
      canRequestChanges
      onApprove={onApprove}
      onReject={onReject}
      onReload={onReload}
      onRequestChanges={onRequestChanges}
    />)
    fireEvent.click(screen.getByRole("button", { name: "Approve this plan" }))
    fireEvent.click(screen.getByRole("button", { name: "Reject plan" }))
    expect(onApprove).toHaveBeenCalledOnce()
    expect(onReject).toHaveBeenCalledOnce()
    fireEvent.change(screen.getByLabelText("What should change?"), {
      target: { value: "Clarify the rollout" },
    })
    expect((screen.getByRole("button", { name: "Request changes" }) as HTMLButtonElement).disabled).toBe(false)

    mounted.rerender(<ApprovalPanel
      approval={{ ...approval, stale: true }}
      implementationPlan={implementationPlan}
      busyAction={null}
      canRequestChanges
      onApprove={onApprove}
      onReject={onReject}
      onReload={onReload}
      onRequestChanges={onRequestChanges}
    />)
    expect((screen.getByRole("button", { name: "Approve this plan" }) as HTMLButtonElement).disabled).toBe(true)
    expect((screen.getByRole("button", { name: "Reject plan" }) as HTMLButtonElement).disabled).toBe(true)
    expect((screen.getByRole("button", { name: "Request changes" }) as HTMLButtonElement).disabled).toBe(true)
    fireEvent.click(screen.getByRole("button", { name: "Reload plan" }))
    expect(onReload).toHaveBeenCalledOnce()

  it "rejects a revision above the UTF-8 byte limit before the request callback", ->
    const onRequestChanges = vi.fn(async () => true)
    render(<ApprovalPanel
      approval={approval}
      implementationPlan={implementationPlan}
      busyAction={null}
      canRequestChanges
      onApprove={vi.fn()}
      onReject={vi.fn()}
      onReload={vi.fn()}
      onRequestChanges={onRequestChanges}
    />)
    const input = screen.getByLabelText("What should change?")
    fireEvent.change(input, { target: { value: "é".repeat(600) } })

    expect(input.getAttribute("maxlength")).toBeNull()
    expect(screen.getByText("1,200 / 1,024 bytes")).toBeDefined()
    expect(screen.getByRole("alert").textContent).toContain("1,024 UTF-8 bytes or fewer")
    expect((screen.getByRole("button", { name: "Request changes" }) as HTMLButtonElement).disabled).toBe(true)
    fireEvent.submit(input.closest("form")!)
    expect(onRequestChanges).not.toHaveBeenCalled()
    fireEvent.change(input, { target: { value: "é".repeat(512) } })
    expect(screen.getByText("1,024 / 1,024 bytes")).toBeDefined()
    expect(screen.queryByRole("alert")).toBeNull()
    expect((screen.getByRole("button", { name: "Request changes" }) as HTMLButtonElement).disabled).toBe(false)
    fireEvent.submit(input.closest("form")!)
    expect(onRequestChanges).toHaveBeenCalledWith("é".repeat(512))

  it "rejects a multiline revision before the request callback", ->
    const onRequestChanges = vi.fn(async () => true)
    render(<ApprovalPanel
      approval={approval}
      implementationPlan={implementationPlan}
      busyAction={null}
      canRequestChanges
      onApprove={vi.fn()}
      onReject={vi.fn()}
      onReload={vi.fn()}
      onRequestChanges={onRequestChanges}
    />)
    const input = screen.getByLabelText("What should change?")
    fireEvent.change(input, { target: { value: "Clarify the bounded\nrelease" } })

    expect(input.getAttribute("aria-invalid")).toBe("true")
    expect(input.getAttribute("aria-describedby")).toContain("plan-revision-error")
    expect(screen.getByRole("alert").textContent).toBe(
      "Use one line without control characters.",
    )
    expect((screen.getByRole("button", { name: "Request changes" }) as HTMLButtonElement).disabled).toBe(true)
    fireEvent.submit(input.closest("form")!)
    expect(onRequestChanges).not.toHaveBeenCalled()
    fireEvent.change(input, { target: { value: " Clarify safely\n" } })
    expect(input.getAttribute("aria-invalid")).toBeNull()
    expect(screen.queryByRole("alert")).toBeNull()
    expect((screen.getByRole("button", { name: "Request changes" }) as HTMLButtonElement).disabled).toBe(false)
    fireEvent.submit(input.closest("form")!)
    expect(onRequestChanges).toHaveBeenCalledWith("Clarify safely")


describe "operator conversation behavior", ->
  it "renders empty, populated, busy, and failure states", ->
    const mounted = render(<ConversationPanel busy={false} implementationPlan={null} messages={[]} onSend={vi.fn(async () => true)} originalRequest="Plan safely" planRevisions={[]} runState="draft" />)
    expect(screen.getByText(/No notes have been added/)).toBeDefined()
    expect((screen.getByRole("button", { name: "Add note" }) as HTMLButtonElement).disabled).toBe(true)
    expect(screen.getByLabelText("Add operator message").getAttribute("maxlength")).toBe("2000")
    expect(screen.getByLabelText("Add operator message").getAttribute("aria-describedby")).toBe("operator-message-hint")

    mounted.rerender(<ConversationPanel
      busy
      failureMessage="Message could not be stored."
      implementationPlan={implementationPlan}
      runState="awaitingApproval"
      planRevisions={[]}
      messages={[{
        id: "message-1",
        authorLabel: "Operator Jane",
        body: "Bounded\ncontext",
        createdAt: new Date("2026-07-29T12:30:00.000Z"),
      }]}
      onSend={vi.fn(async () => true)}
      originalRequest="Plan safely"
    />)
    expect(screen.getByText("Operator Jane")).toBeDefined()
    expect(screen.getByText(/Bounded/).textContent?.replace(/\s+/gu, " ")).toContain("Bounded context")
    expect(screen.getByRole("alert").textContent).toContain("Message could not be stored.")
    expect((screen.getByRole("button", { name: /Adding operator note/ }) as HTMLButtonElement).disabled).toBe(true)

  it "ignores whitespace and busy submissions and prevents an in-flight duplicate", async ->
    const request = deferred<boolean>()
    const onSend = vi.fn(() => request.promise)
    const mounted = render(<ConversationPanel busy={false} implementationPlan={null} messages={[]} onSend={onSend} originalRequest="Plan safely" planRevisions={[]} runState="planning" />)
    const input = screen.getByLabelText("Add operator message")
    fireEvent.change(input, { target: { value: "   " } })
    fireEvent.submit(input.closest("form")!)
    expect(onSend).not.toHaveBeenCalled()

    fireEvent.change(input, { target: { value: "  Context  " } })
    fireEvent.submit(input.closest("form")!)
    fireEvent.submit(input.closest("form")!)
    expect(onSend).toHaveBeenCalledOnce()
    await act(async () =>
      request.resolve(false)
      await Promise.resolve()
    )
    expect((input as HTMLTextAreaElement).value).toBe("  Context  ")

    mounted.rerender(<ConversationPanel busy implementationPlan={null} messages={[]} onSend={onSend} originalRequest="Plan safely" planRevisions={[]} runState="planning" />)
    fireEvent.submit(input.closest("form")!)
    expect(onSend).toHaveBeenCalledOnce()

  it "reuses a failed-send key, rotates it after editing, and clears successful text", async ->
    const onSend = vi.fn()
      .mockResolvedValueOnce(false)
      .mockResolvedValueOnce(true)
      .mockResolvedValueOnce(true)
    const randomUUID = vi.fn()
      .mockReturnValueOnce("message-retry-key")
      .mockReturnValueOnce("message-changed-key")
    vi.stubGlobal("crypto", { randomUUID })
    render(<ConversationPanel busy={false} implementationPlan={null} messages={[]} onSend={onSend} originalRequest="Plan safely" planRevisions={[]} runState="planning" />)
    const input = screen.getByLabelText("Add operator message")

    fireEvent.change(input, { target: { value: " First message " } })
    fireEvent.submit(input.closest("form")!)
    await waitFor(() => expect(onSend).toHaveBeenCalledTimes(1))
    expect((input as HTMLTextAreaElement).value).toBe(" First message ")

    fireEvent.submit(input.closest("form")!)
    await waitFor(() => expect((input as HTMLTextAreaElement).value).toBe(""))
    expect(onSend.mock.calls[0]).toEqual(["First message", "message-retry-key"])
    expect(onSend.mock.calls[1]).toEqual(["First message", "message-retry-key"])

    fireEvent.change(input, { target: { value: "Changed payload" } })
    fireEvent.submit(input.closest("form")!)
    await waitFor(() => expect(onSend).toHaveBeenCalledTimes(3))
    expect(onSend.mock.calls[2]).toEqual(["Changed payload", "message-changed-key"])


  it "does not clear a late successful message after unmount", async ->
    const request = deferred<boolean>()
    const onSend = vi.fn(() => request.promise)
    const mounted = render(<ConversationPanel busy={false} implementationPlan={null} messages={[]} onSend={onSend} originalRequest="Plan safely" planRevisions={[]} runState="planning" />)
    const input = screen.getByLabelText("Add operator message")
    fireEvent.change(input, { target: { value: "Late success" } })
    fireEvent.submit(input.closest("form")!)
    mounted.unmount()

    await act(async () =>
      request.resolve(true)
      await Promise.resolve()
    )
    expect(onSend).toHaveBeenCalledWith("Late success", expect.any(String))
    expect(screen.queryByDisplayValue("Late success")).toBeNull()
