  it "keeps a stale approval conflict fenced until an authoritative reload succeeds", async ->
    const reload = deferred<OperatorRunDetailOutput>()
    const load = vi.fn()
      .mockResolvedValueOnce(detail())
      .mockImplementationOnce(() => reload.promise)
    const message = vi.fn(async () =>
      throw { code: "FORBIDDEN" }
    )
    const staleGateway = gatewayWith({
      detail: load,
      approve: vi.fn(async () =>
        throw { code: "STALE_APPROVAL" }
      ),
      message,
    })
    render(<OperatorRunDetail gateway={staleGateway} id="run-1" />)
    await screen.findByRole("heading", { name: "Release recovery" })

    fireEvent.click(screen.getByRole("button", { name: "Approve this plan" }))
    const staleAlert = await screen.findByRole("alert")
    expect(staleAlert.textContent).toContain("The plan changed.")
    expect(screen.getAllByRole("alert")).toHaveLength(1)
    await waitFor(() => expect(document.activeElement).toBe(staleAlert))

    const note = screen.getByLabelText("Add operator message") as HTMLTextAreaElement
    const addNote = screen.getByRole("button", { name: "Add note" }) as HTMLButtonElement
    expect(note.disabled).toBe(true)
    expect(addNote.disabled).toBe(true)
    fireEvent.click(addNote)
    expect(message).not.toHaveBeenCalled()
    expect(screen.getByText("Plan changed")).toBeDefined()
    expect((screen.getByRole("button", { name: "Approve this plan" }) as HTMLButtonElement).disabled).toBe(true)
    expect((screen.getByRole("button", { name: "Reject plan" }) as HTMLButtonElement).disabled).toBe(true)
    expect((screen.getByLabelText("What should change?") as HTMLTextAreaElement).disabled).toBe(true)
    expect((screen.getByRole("button", { name: "Request changes" }) as HTMLButtonElement).disabled).toBe(true)

    const reloadPlan = screen.getByRole("button", { name: "Reload plan" }) as HTMLButtonElement
    expect(reloadPlan.disabled).toBe(false)
    fireEvent.click(reloadPlan)
    await waitFor(() => expect(load).toHaveBeenCalledTimes(2))
    expect(screen.queryByRole("button", { name: "Approve this plan" })).toBeNull()

    await act(async () =>
      reload.resolve(detail(
        { sequence: 8, title: "Reloaded recovery" },
        {
          approval: {
            ...approval,
            snapshotSequence: 8,
            journalHeadHash: "reloaded-journal-head",
          },
        },
      ))
      await Promise.resolve()
    )
    await screen.findByRole("heading", { name: "Reloaded recovery" })
    expect(screen.queryByRole("alert")).toBeNull()
    expect((screen.getByRole("button", { name: "Approve this plan" }) as HTMLButtonElement).disabled).toBe(false)
    expect((screen.getByRole("button", { name: "Reject plan" }) as HTMLButtonElement).disabled).toBe(false)
    expect((screen.getByLabelText("Add operator message") as HTMLTextAreaElement).disabled).toBe(false)
    const revision = screen.getByLabelText("What should change?") as HTMLTextAreaElement
    expect(revision.disabled).toBe(false)
    fireEvent.change(revision, { target: { value: "Clarify the rollout" } })
    expect((screen.getByRole("button", { name: "Request changes" }) as HTMLButtonElement).disabled).toBe(false)


  it "renders and focuses each mutation failure once without polite feedback duplication", async ->
    const staleGateway = gatewayWith({
      detail: vi.fn(async () => detail()),
      approve: vi.fn(async () =>
        throw { code: "STALE_APPROVAL" }
      ),
      message: vi.fn(async () =>
        throw { code: "FORBIDDEN" }
      ),
    })
    const stale = render(<OperatorRunDetail gateway={staleGateway} id="run-1" />)
    await screen.findByRole("heading", { name: "Release recovery" })
    fireEvent.click(screen.getByRole("button", { name: "Approve this plan" }))
    const staleAlert = await screen.findByRole("alert")
    expect(staleAlert.textContent).toContain("The plan changed.")
    expect(screen.getAllByRole("alert")).toHaveLength(1)
    await waitFor(() => expect(document.activeElement).toBe(staleAlert))
    expect(Array.from(document.querySelectorAll('[aria-live="polite"]')).some(
      (region) => region.textContent === "The plan changed. Reload the run before you take action.",
    )).toBe(false)

    stale.unmount()
    const failureMessage = "You do not have access to this workflow run."
    const failureGateway = gatewayWith({
      detail: vi.fn(async () => detail()),
      cancel: vi.fn(async () =>
        throw { code: "FORBIDDEN" }
      ),
    })
    const nonMessage = render(<OperatorRunDetail gateway={failureGateway} id="run-1" />)
    await screen.findByRole("heading", { name: "Release recovery" })
    fireEvent.click(screen.getByRole("button", { name: "Cancel run" }))
    const globalAlert = await screen.findByRole("alert")
    expect(globalAlert.textContent).toBe(failureMessage)
    expect(screen.getAllByText(failureMessage)).toHaveLength(1)
    expect(screen.getAllByRole("alert")).toHaveLength(1)
    await waitFor(() => expect(document.activeElement).toBe(globalAlert))
    expect(Array.from(document.querySelectorAll('[aria-live="polite"]')).some(
      (region) => region.textContent === failureMessage,
    )).toBe(false)
    expect(screen.getByLabelText("Add operator message").getAttribute("aria-describedby"))
      .toBe("operator-message-hint")

    nonMessage.unmount()
    const messageGateway = gatewayWith({
      detail: vi.fn(async () => detail()),
      message: vi.fn(async () =>
        throw { code: "FORBIDDEN" }
      ),
    })
    render(<OperatorRunDetail gateway={messageGateway} id="run-1" />)
    await screen.findByRole("heading", { name: "Release recovery" })
    fireEvent.change(screen.getByLabelText("Add operator message"), {
      target: { value: "Bounded context" },
    })
    fireEvent.click(screen.getByRole("button", { name: "Add note" }))
    const inlineAlert = await screen.findByRole("alert")
    expect(inlineAlert.textContent).toBe(failureMessage)
    expect(screen.getAllByText(failureMessage)).toHaveLength(1)
    expect(screen.getAllByRole("alert")).toHaveLength(1)
    await waitFor(() => expect(document.activeElement).toBe(inlineAlert))
    expect(Array.from(document.querySelectorAll('[aria-live="polite"]')).some(
      (region) => region.textContent === failureMessage,
    )).toBe(false)

  it "routes generic conflicts to the single alert owned by the failed action", async ->
    const conflictMessage = "The plan changed. Reload the run before you take action."
    const retryGateway = gatewayWith({
