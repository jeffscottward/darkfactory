    expect(revisionAlert.textContent).toBe(conflictMessage)
    expect(screen.getAllByRole("alert")).toHaveLength(1)
    await waitFor(() => expect(document.activeElement).toBe(revisionAlert))

  it "fences a late run A action from run B by id and request generation", async ->
    const retryRequest = deferred<OperatorRunDetailOutput>()
    const runA = detail({ id: "run-a", title: "Run A", state: "blocked" })
    const runB = detail({ id: "run-b", title: "Run B", state: "completed" })
    const gateway = gatewayWith({
      detail: vi.fn(async (id) => id === "run-a" ? runA : runB),
      retry: vi.fn(() => retryRequest.promise),
    })
    const mounted = render(<OperatorRunDetail gateway={gateway} id="run-a" />)
    expect(await screen.findByRole("heading", { name: "Run A" })).toBeDefined()
    fireEvent.click(screen.getByRole("button", { name: "Retry run" }))

    mounted.rerender(<OperatorRunDetail gateway={gateway} id="run-b" />)
    expect(await screen.findByRole("heading", { name: "Run B" })).toBeDefined()
    await act(async () =>
      retryRequest.resolve(detail({ id: "run-a", title: "Stale action result", state: "planning" }))
      await Promise.resolve()
    )

    expect(screen.getByRole("heading", { name: "Run B" })).toBeDefined()
    expect(screen.queryByText("Stale action result")).toBeNull()
    expect(screen.queryByText("Retry requested.")).toBeNull()
    expect((screen.getByRole("button", { name: "Cancel run" }) as HTMLButtonElement).disabled).toBe(true)


  it "serializes automatic reads and ignores a poll superseded by a mutation", async ->
    vi.useFakeTimers()
    const pollResponse = deferred<OperatorRunDetailOutput>()
    const mutationResponse = deferred<OperatorRunDetailOutput>()
    const load = vi.fn()
      .mockResolvedValueOnce(detail({ state: "blocked" }))
      .mockImplementationOnce(() => pollResponse.promise)
    const retry = vi.fn(() => mutationResponse.promise)
