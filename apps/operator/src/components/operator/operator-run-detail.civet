"use client"

import { Button, Skeleton, SkeletonGroup } from "@darkfactory/ui"
import { RefreshCw, RotateCcw, XCircle } from "lucide-react"
import { useCallback, useEffect, useRef, useState } from "react"

import { ApprovalPanel } from "./approval-panel.civet"
import { ChatPanel } from "./chat-panel.civet"
import { EvidencePanel } from "./evidence-panel.civet"
import {
  classifyOperatorFailure,
  createBrowserOperatorGateway,
  type OperatorFailure,
  type OperatorGateway,
  type OperatorRunDetailOutput,
} from "./operator-client.civet"
import { abbreviatedHash, formatOperatorDate, operatorRunTitle } from "./operator-format.civet"
import { RunTimeline } from "./run-timeline.civet"
import { WorkflowStatus } from "./workflow-status.civet"

type DetailState =
  | Readonly<{ type: "loading" }>
  | Readonly<{ type: "ready"; output: OperatorRunDetailOutput }>
  | Readonly<{ type: "error"; failure: OperatorFailure }>

type DetailAction = "approve" | "reject" | "cancel" | "retry" | "message"

export interface OperatorRunDetailProps {
  readonly gateway?: OperatorGateway
  readonly id: string
}

const DetailLoading = () => (
  <SkeletonGroup className="grid gap-6 xl:grid-cols-5" label="Loading workflow run">
    <div className="space-y-4 xl:col-span-3">
      <Skeleton className="h-24 w-full" />
      <Skeleton className="h-64 w-full" />
    <div className="space-y-4 xl:col-span-2">
      <Skeleton className="h-52 w-full" />
      <Skeleton className="h-52 w-full" />
)

export const OperatorRunDetail = ({ gateway: suppliedGateway, id }: OperatorRunDetailProps) =>
  const [gateway] = useState(() => suppliedGateway ?? createBrowserOperatorGateway())
  const [state, setState] = useState<DetailState>({ type: "loading" })
  const [busyAction, setBusyAction] = useState<DetailAction | null>(null)
  const [failure, setFailure] = useState<OperatorFailure | null>(null)
  const [failureAction, setFailureAction] = useState<DetailAction | null>(null)
  const [feedback, setFeedback] = useState("")
  const requestRevision = useRef(0)
  const activeRunId = useRef(id)
  const mounted = useRef(false)
  const feedbackRef = useRef<HTMLDivElement>(null)

  const load = useCallback(async () =>
    const revision = requestRevision.current + 1
    requestRevision.current = revision
    setState({ type: "loading" })
    setBusyAction(null)
    setFeedback("")
    setFailureAction(null)
    setFailure(null)
    try
      const output = await gateway.detail(id)
      if (requestRevision.current === revision) setState({ type: "ready", output })
    catch error
      if (requestRevision.current === revision)
        setState({ type: "error", failure: classifyOperatorFailure(error) })
  , [gateway, id])

  useEffect(() =>
    activeRunId.current = id
    mounted.current = true
    void load()
    return () =>
      mounted.current = false
      requestRevision.current += 1
      return undefined
  , [id, load])

  const perform = async (
    action: DetailAction,
    operation: () => Promise<OperatorRunDetailOutput>,
    successMessage: string,
  ): Promise<boolean> =>
    if (busyAction !== null) return false
    const actionRunId = id
    const revision = requestRevision.current
    const isCurrent = (): boolean => (
      mounted.current
      && activeRunId.current === actionRunId
      && requestRevision.current === revision
    )
    setBusyAction(action)
    setFailure(null)
    setFailureAction(null)
    setFeedback("")
    try
      const output = await operation()
      if (!isCurrent()) return false
      setState({ type: "ready", output })
      setFeedback(successMessage)
      queueMicrotask(() =>
        if (isCurrent()) feedbackRef.current?.focus()
      )
      return true
    catch error
      if (!isCurrent()) return false
      const nextFailure = classifyOperatorFailure(error)
      setFailure(nextFailure)
      setFailureAction(action)
      setFeedback(nextFailure.message)
      queueMicrotask(() =>
        if (isCurrent()) feedbackRef.current?.focus()
      )
      return false
    finally
      if (isCurrent()) setBusyAction(null)

  if (state.type === "loading") return <DetailLoading />
  if (state.type === "error")
    return (
      <section className="border-y border-destructive-border bg-destructive-subtle px-4 py-6" role="alert">
        <h2 className="font-heading text-lg font-semibold text-foreground">Workflow run unavailable
        <p className="mt-2 text-sm leading-6 text-muted-foreground">{state.failure.message}
        <Button className="mt-4" onClick={load} variant="secondary">
          <RefreshCw aria-hidden="true" className="size-4" />Retry loading
    )

  const { output } = state
  const blocked = output.run.state === "blocked"
  const terminal = output.run.state === "completed" || output.run.state === "cancelled"
  return (
    <div className="space-y-6">
      <section aria-labelledby="run-summary-title" className="min-w-0 border-y border-border bg-surface px-4 py-5 sm:px-6">
        <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div className="min-w-0">
            <h2 className="break-words font-heading text-xl font-semibold text-foreground" id="run-summary-title">
              {operatorRunTitle(output.run)}
            <p className="mt-2 break-all font-mono text-xs text-muted-foreground">{output.run.id}
          <WorkflowStatus state={output.run.state} />
        <dl className="mt-5 grid min-w-0 gap-4 sm:grid-cols-3">
          <div>
            <dt className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Updated
            <dd className="text-sm text-foreground">
              <time dateTime={output.run.updatedAt.toISOString()}>
                {formatOperatorDate(output.run.updatedAt)}
          <div>
            <dt className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Sequence
            <dd className="font-mono text-xs text-foreground">
              {output.run.sequence}
          <div className="min-w-0">
            <dt className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Journal head
            <dd className="break-all font-mono text-xs text-foreground" title={output.run.headHash}>
              {abbreviatedHash(output.run.headHash)}
        <div className="mt-5 flex flex-wrap gap-2 border-t border-border pt-4">
          <Button
            disabled={!blocked || busyAction !== null}
            loading={busyAction === "retry"}
            loadingLabel="Requesting retry"
            onClick={() => void perform("retry", () => gateway.retry(id), "Retry requested.")}
            size="compact"
            variant="secondary"
          >
            <RotateCcw aria-hidden="true" className="size-4" />Retry run
          <Button
            disabled={terminal || busyAction !== null}
            loading={busyAction === "cancel"}
            loadingLabel="Cancelling run"
            onClick={() => void perform("cancel", () => gateway.cancel(id), "Cancellation requested.")}
            size="compact"
            variant="destructive"
          >
            <XCircle aria-hidden="true" className="size-4" />Cancel run
      <div
        aria-atomic="true"
        aria-live="polite"
        className="min-h-6 text-sm text-muted-foreground outline-none"
        ref={feedbackRef}
        tabIndex={-1}
      >
        {feedback}
      {failure === null || failure.kind === "stale" ? null : (
        <p className="border-y border-destructive-border bg-destructive-subtle px-4 py-3 text-sm text-destructive" role="alert">
          {failure.message}
      )}
      <div className="grid min-w-0 gap-6 xl:grid-cols-5">
        <div className="min-w-0 space-y-6 xl:col-span-3">
          <RunTimeline entries={output.timeline} />
          <EvidencePanel evidence={output.evidence} />
        <aside className="min-w-0 space-y-6 xl:col-span-2" aria-label="Run actions and discussion">
          <ApprovalPanel
            approval={output.approval}
            implementationPlan={output.implementationPlan}
            busyAction={busyAction === "approve" || busyAction === "reject" ? busyAction : null}
            conflictMessage={failure?.kind === "stale" ? failure.message : undefined}
            onApprove={() =>
              if (output.approval !== null)
                void perform("approve", () => gateway.approve(id, output.approval!), "Approval committed.")
            }
            onReject={() => void perform("reject", () => gateway.reject(id), "Approval rejected.")}
            onReload={() => void load()}
          />
          <ChatPanel
            busy={busyAction === "message"}
            failureMessage={failureAction === "message" && failure?.kind !== "stale" ? failure?.message : undefined}
            messages={output.messages}
            onSend={(body, idempotencyKey) =>
              perform(
                "message",
                () => gateway.message(id, body, idempotencyKey),
                "Operator message added.",
              )
            }
          />
)
