import type {
  AnalyticsConsent,
  SpanHandle,
  SpanInput,
  TelemetryRuntime,
  WaitUntil,
} from "@darkfactory/observability/port"

const canonicalConsent = (value: string): AnalyticsConsent | undefined =>
  value === "granted" || value === "denied" ? value : undefined

const consentCookie = (
  cookieHeader: string | null,
): Readonly<{ present: boolean; value?: AnalyticsConsent; malformed: boolean }> => {
  if (cookieHeader === null) return { present: false, malformed: false }

  const values: string[] = []
  for (const segment of cookieHeader.split(";")) {
    const separator = segment.indexOf("=")
    if (separator < 0) continue
    const name = segment.slice(0, separator).trim()
    if (name !== "analytics_consent") continue
    values.push(segment.slice(separator + 1))
  }
  if (values.length === 0) return { present: false, malformed: false }
  if (values.length !== 1)
    return { present: true, malformed: true }

  const value = canonicalConsent(values[0]!)
  return value === undefined
    ? { present: true, malformed: true }
    : { present: true, value, malformed: false }
}

export const resolveAnalyticsConsent = (request: Request): AnalyticsConsent => {
  const headerValue = request.headers.get("x-analytics-consent")
  const headerConsent =
    headerValue === null ? undefined : canonicalConsent(headerValue)
  const cookie = consentCookie(request.headers.get("cookie"))

  if (
    (headerValue !== null && headerConsent === undefined) ||
    cookie.malformed
  ) return "unknown"
  if (
    headerConsent !== undefined &&
    cookie.value !== undefined &&
    headerConsent !== cookie.value
  ) return "unknown"

  return headerConsent ?? cookie.value ?? "unknown"
}

export const configuredOtlpAllowedHosts = (
  endpoint: string | undefined,
): readonly string[] => {
  if (endpoint === undefined) return []
  try {
    const hostname = new URL(endpoint).hostname.toLowerCase()
    return hostname.length === 0 ? [] : [hostname]
  } catch {
    return []
  }
}

export const runWithRequestTelemetry = async <T>(
  telemetry: TelemetryRuntime,
  input: SpanInput,
  waitUntil: WaitUntil,
  run: (span: SpanHandle) => T | Promise<T>,
): Promise<T> => {
  let operation: Promise<T> | undefined
  const execute = (span: SpanHandle): Promise<T> => {
    operation ??= Promise.resolve().then(() => run(span))
    return operation
  }
  try {
    try {
      await telemetry.withSpan(input, execute)
    } catch {
      // The application result below remains authoritative over telemetry.
    }
    if (operation === undefined) {
      const fallbackSpan: SpanHandle = Object.freeze({
        correlation: Object.freeze({ ...input.correlation }),
        addEvent: () => undefined,
        recordMetric: () => undefined,
      })
      return await execute(fallbackSpan)
    }
    return await operation
  } finally {
    try {
      waitUntil(telemetry.forceFlush().catch(() => undefined))
    } catch {
      // Request completion and domain results never depend on provider flushing.
    }
  }
}
