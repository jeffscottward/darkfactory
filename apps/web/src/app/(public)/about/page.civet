import { PublicLink, PublicPage } from "../_components/public-content.civet"

const principles = [
  {
    title: "Infrastructure minimalism",
    body: "PostgreSQL is the default home for durable and data-adjacent behavior. Another system earns its place only when a measured requirement cannot be met safely by the core or a proven PostgreSQL pattern.",
  },
  {
    title: "Stable core, replaceable edges",
    body: "Contracts, application services, and domain rules point inward. Drizzle, Better Auth, analytics, AI, email, storage, and deployment details stay at explicit adapter or composition boundaries.",
  },
  {
    title: "AI-native context",
    body: "Repository policy, architecture records, generated contracts, capability declarations, tests, and the code graph give agents inspectable context. The goal is reliable collaboration, not autonomous theater.",
  },
] as const

export const metadata = {
  title: "About",
  description: "Why DarkFactory favors infrastructure minimalism, AI-native context, and a stable core with replaceable adapters.",
}

export default function AboutPage()
  return (
