import { PublicLink, PublicPage } from "../_components/public-content.civet"

const coreCapabilities = [
  {
    title: "Contracts that stay shared",
    body: "oRPC procedures, input schemas, typed errors, and generated OpenAPI describe one boundary for browser, server, and external consumers.",
  },
  {
    title: "PostgreSQL as durable authority",
    body: "Drizzle repositories keep relational state, JSONB, transactions, and ownership rules behind explicit application interfaces.",
  },
  {
    title: "Authentication with a real boundary",
    body: "Better Auth owns identity and sessions while application services retain responsibility for feature authorization and account-scoped data.",
  },
] as const

const operationalCapabilities = [
  {
    title: "Observable by construction",
    body: "Semantic application events, request context, OpenTelemetry, and an analytics port separate technical diagnosis from product learning.",
  },
  {
    title: "Providers stay replaceable",
    body: "Email, AI inference, storage, and other external systems enter through small ports. Missing optional credentials disable a capability or select an explicit safe local mode.",
  },
  {
    title: "State has one clear owner",
    body: "PostgreSQL owns durable records, URLs own navigable state, query tooling owns server cache, and local stores stay limited to ephemeral view concerns.",
  },
] as const

export const metadata = {
  title: "Features",
  description: "The implemented contracts, persistence, authentication, observability, providers, and generation boundaries in DarkFactory.",
}

export default function FeaturesPage() {
  return (
    <PublicPage
      actions={<PublicLink href="/resources" variant="secondary">Inspect source artifacts</PublicLink>}
      description="DarkFactory is a connected baseline, not a bag of packages. Each layer has a narrow responsibility, an observable contract, and a documented replacement boundary."
      eyebrow="Features"
      title="Production structure you can follow end to end."
    >
      <section aria-labelledby="core-capabilities-title" className="grid gap-12 py-16 md:grid-cols-12 md:py-20">
        <div className="md:col-span-4">
          <h2 className="font-heading text-3xl font-semibold tracking-tight text-foreground" id="core-capabilities-title">
            The stable application core
          </h2>
          <p className="mt-4 text-base leading-7 text-muted-foreground">
            Framework glue points inward. Product behavior stays in application and domain code rather than route handlers or adapters.
          </p>
        </div>
        <dl className="divide-y divide-border border-y border-border md:col-span-7 md:col-start-6">
          {coreCapabilities.map((capability) => (
            <div className="grid gap-3 py-8 sm:grid-cols-5" key={capability.title}>
              <dt className="font-heading text-xl font-semibold tracking-tight text-foreground sm:col-span-2">
                {capability.title}
              </dt>
              <dd className="text-base leading-7 text-muted-foreground sm:col-span-3">
                {capability.body}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="operations-title" className="border-y border-border bg-surface py-16 md:py-20">
        <div className="grid gap-10 md:grid-cols-12">
          <div className="md:col-span-5">
            <p className="text-sm font-semibold tracking-wide text-primary">Operational confidence</p>
            <h2 className="mt-4 font-heading text-3xl font-semibold tracking-tight text-foreground" id="operations-title">
              Evidence without provider lock-in.
            </h2>
          </div>
          <div className="grid gap-8 md:col-span-6 md:col-start-7">
            {operationalCapabilities.map((capability) => (
              <article key={capability.title}>
                <h3 className="font-heading text-xl font-semibold tracking-tight text-foreground">
                  {capability.title}
                </h3>
                <p className="mt-3 text-base leading-7 text-muted-foreground">
                  {capability.body}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section aria-labelledby="generator-title" className="grid gap-12 py-16 md:grid-cols-12 md:py-20">
        <div className="md:col-span-5">
          <p className="text-sm font-semibold tracking-wide text-primary">Feature generation</p>
          <h2 className="mt-4 font-heading text-3xl font-semibold tracking-tight text-foreground" id="generator-title">
            A safe workflow, not a string-replacement shortcut.
          </h2>
          <p className="mt-5 text-base leading-7 text-muted-foreground">
            The generator contract updates the feature name, contracts, routes, database plan, tests, exports, documentation, and repository graph together. Existing targets are never silently overwritten.
          </p>
        </div>
        <div className="md:col-span-6 md:col-start-7">
          <ol aria-label="Feature generator stages" className="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-3">
            {["Parse", "Validate", "Plan", "Apply", "Verify", "Report"].map((stage, index) => (
              <li className="min-h-24 bg-background p-4" key={stage}>
                <span className="text-sm font-semibold text-muted-foreground">0{index + 1}</span>
                <p className="mt-2 font-heading text-lg font-semibold text-foreground">{stage}</p>
              </li>
            ))}
          </ol>
          <p className="mt-5 text-sm leading-6 text-muted-foreground">
            The CLI delegates to these composed stages; business and filesystem rules do not accumulate in the command handler.
          </p>
        </div>
      </section>

      <section aria-labelledby="features-next-title" className="grid gap-8 border-t border-border pt-12 md:grid-cols-12 md:items-end">
        <div className="md:col-span-7">
          <h2 className="font-heading text-3xl font-semibold tracking-tight text-foreground" id="features-next-title">
            See how the same foundation adapts.
          </h2>
          <p className="mt-4 max-w-reading text-base leading-7 text-muted-foreground">
            The solution archetypes are explicitly examples. They show possible compositions without claiming that DarkFactory ships a finished vertical product.
          </p>
        </div>
        <div className="md:col-span-4 md:col-start-9 md:text-right">
          <PublicLink href="/solutions">Explore example archetypes</PublicLink>
        </div>
      </section>
    </PublicPage>
  )
