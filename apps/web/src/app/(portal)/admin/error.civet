"use client"

import { Button, EmptyState } from "@darkfactory/ui"
import { RotateCcw } from "lucide-react"

export default function AdminError({ reset }: { readonly error: Error; readonly reset: () => void })
  return (
    <div className="mx-auto w-full max-w-portal">
      <EmptyState
        action={<Button onClick={reset} variant="secondary"><RotateCcw aria-hidden="true" className="size-4" />Try again}
        description="The read-only administration view could not be displayed."
        icon={<RotateCcw />}
        title="Administration unavailable"
      />
  )
