import { afterEach, describe, expect, it, vi } from "vitest"

vi.mock("next/headers", () => ({ headers: vi.fn() }))
vi.mock("next/navigation", () => ({ redirect: vi.fn() }))
vi.mock("../../../lib/server-session.civet", () => ({
  getPortalSession: vi.fn(),
  portalSignInHref: vi.fn(() => "/sign-in?callbackURL=%2Fdashboard"),
  resolvePortalAppUrl: vi.fn(() => new URL("https://darkfactory.localhost")),
}))

import { loadDashboardSummaryState } from "./page.civet"

afterEach ->
  vi.useRealTimers()

describe "dashboard summary loader", ->
  it "fails closed to an unavailable state when the internal oRPC request stalls", async ->
    vi.useFakeTimers()
    const fetcher = vi.fn((request: Request) => new Promise<Response>((resolve) =>
      request.signal.addEventListener("abort", () => resolve(new Response(null, { status: 504 })), { once: true })
    ))

    const result = loadDashboardSummaryState("better-auth.session_token=opaque", fetcher, 5)
    await vi.advanceTimersByTimeAsync(6)

    await expect(result).resolves.toEqual({ type: "error" })

  it "fails closed to an unavailable state when a chunked oRPC response exceeds the byte cap", async ->
    const oversized = new ReadableStream<Uint8Array>({
      start: (controller) =>
        controller.enqueue(new Uint8Array(40_000))
        controller.enqueue(new Uint8Array(40_000))
      cancel: vi.fn(),
    })
    const fetcher = vi.fn(async () =>
      new Response(oversized, { headers: { "content-type": "application/json" } })
    )

    await expect(
      loadDashboardSummaryState("better-auth.session_token=opaque", fetcher),
    ).resolves.toEqual({ type: "error" })
