import { renderToStaticMarkup } from "react-dom/server"
import { describe, expect, it, vi } from "vitest"

vi.mock("../../../components/operator/operator-workspace.civet", () => ({
  OperatorWorkspace: () => (
    <section data-testid="operator-workspace">Workspace client
  ),
}))

vi.mock("../../../components/operator/operator-run-detail.civet", () => ({
  OperatorRunDetail: ({ id }: { readonly id: string }) => (
    <section data-run-id={id}>Run detail client
  ),
}))

import OperatorPage, { metadata as operatorMetadata } from "./page.civet"
import OperatorRunPage, { metadata as runMetadata } from "./runs/[id]/page.civet"

describe "operator portal pages", ->
  it "composes the authenticated operator workspace route", ->
    const markup = renderToStaticMarkup(<OperatorPage />)
    expect(operatorMetadata).toEqual({ title: "Operator" })
    expect(markup).toContain("Operator workspace")
    expect(markup).toContain("Control plane")
    expect(markup).toContain("Submit a bounded workflow run")
    expect(markup).toContain('data-testid="operator-workspace"')

  it "keeps a reload-stable run id in the detail route", async ->
    const page = await OperatorRunPage({ params: Promise.resolve({ id: "run/deep-link" }) })
    const markup = renderToStaticMarkup(page)
    expect(runMetadata).toEqual({ title: "Workflow run" })
    expect(markup).toContain('href="/operator"')
    expect(markup).toContain('data-run-id="run/deep-link"')
    expect(markup).toContain("Review the journal")
