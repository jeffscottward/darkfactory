// @vitest-environment jsdom

import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react"
import { afterEach, describe, expect, it, vi } from "vitest"

const browserTransport = vi.hoisted(() => ({ createApiClient: vi.fn() }))


vi.mock("@darkfactory/api", async (importOriginal) =>
  const actual = await importOriginal<typeof import("@darkfactory/api")>()
  return { ...actual, createApiClient: browserTransport.createApiClient }
)

import { ApprovalPanel } from "./approval-panel.civet"
import { ChatPanel } from "./chat-panel.civet"
import type {
  OperatorApprovalBinding,
  OperatorGateway,
  OperatorRunDetailOutput,
  OperatorRunSummary,
  OperatorWorkspaceOutput,
} from "./operator-client.civet"
import { OperatorRunDetail } from "./operator-run-detail.civet"
import { OperatorWorkspace } from "./operator-workspace.civet"

const approval: OperatorApprovalBinding = {
  machineId: "darkfactory-pilot",
  machineVersion: 2,
  eventVersion: 3,
  snapshotSequence: 7,
  journalHeadHash: "journal-head-0123456789abcdef",
  effectHash: "effect-hash-fedcba9876543210",
  effectScope: "repository:darkfactory/run:run-1",
  stale: false,
}
const implementationPlan = {
  summary: "1. Update the bounded worker contract\n2. Verify replay integrity",
  digest: "d".repeat(64),
  truncated: false,
  redacted: true,
} as const

const summary = (overrides: Partial<OperatorRunSummary> = {}): OperatorRunSummary => ({
  id: "run-1",
  title: "Release recovery",
  state: "awaitingApproval",
  sequence: 7,
  updatedAt: new Date("2026-07-29T12:00:00.000Z"),
  headHash: "journal-head-0123456789abcdef",
  ...overrides,
})

const detail = (
  runOverrides: Partial<OperatorRunSummary> = {},
  overrides: Partial<OperatorRunDetailOutput> = {},
): OperatorRunDetailOutput => ({
  run: {
    ...summary(runOverrides),
    machineId: "darkfactory-pilot",
    machineVersion: 2,
  },
  timeline: [],
  approval,
  implementationPlan,
  evidence: [],
  messages: [],
  ...overrides,
})

const workspace = (runs: readonly OperatorRunSummary[] = []): OperatorWorkspaceOutput => ({ runs })

const gatewayWith = (overrides: Partial<OperatorGateway> = {}): OperatorGateway => ({
  submit: vi.fn(async () => detail()),
  workspace: vi.fn(async () => workspace()),
  detail: vi.fn(async (id) => detail({ id })),
  approve: vi.fn(async () => detail()),
  reject: vi.fn(async () => detail()),
  cancel: vi.fn(async () => detail()),
  retry: vi.fn(async () => detail()),
  message: vi.fn(async () => detail()),
  ...overrides,
})

const deferred = <Value>() =>
  let resolvePromise = (_value: Value): void =>
    throw new Error("Deferred promise was not initialized")
  let rejectPromise = (_reason: unknown): void =>
    throw new Error("Deferred promise was not initialized")
  const promise = new Promise<Value>((resolve, reject) =>
    resolvePromise = resolve
    rejectPromise = reject
  )
  return { promise, reject: rejectPromise, resolve: resolvePromise }

const fillSubmission = async (
  values = { title: "Pilot run", repositoryId: "DarkFactory", scopePaths: "apps/web" },
): Promise<HTMLButtonElement> =>
  const title = await screen.findByLabelText("Run title")
  fireEvent.change(title, { target: { value: values.title } })
  fireEvent.change(screen.getByLabelText("Repository ID"), {
    target: { value: values.repositoryId },
  })
  fireEvent.change(screen.getByLabelText("Relative scope paths, one per line"), {
    target: { value: values.scopePaths },
  })
  return screen.getByRole("button", { name: "Submit run" })

afterEach ->
  cleanup()
  browserTransport.createApiClient.mockReset()
  vi.unstubAllGlobals()
  vi.restoreAllMocks()

describe "operator workspace behavior", ->
  it "renders loading, empty, populated, and retryable error states", async ->
    const initial = deferred<OperatorWorkspaceOutput>()
    const load = vi.fn(() => initial.promise)
    render(<OperatorWorkspace gateway={gatewayWith({ workspace: load })} />)

    expect(screen.getByRole("status", { name: "Loading operator workspace" })).toBeDefined()
    await act(async () =>
      initial.resolve(workspace())
      await Promise.resolve()
    )
    expect(await screen.findByText("No workflow runs yet")).toBeDefined()

    cleanup()
    const recovered = workspace([summary()])
    const retryLoad = vi.fn()
      .mockRejectedValueOnce({ code: "SERVICE_UNAVAILABLE" })
      .mockResolvedValueOnce(recovered)
    render(<OperatorWorkspace gateway={gatewayWith({ workspace: retryLoad })} />)
    expect((await screen.findByRole("alert")).textContent).toContain("Operator data is temporarily unavailable")

    fireEvent.click(screen.getByRole("button", { name: "Retry loading" }))
    expect(screen.getByRole("status", { name: "Loading operator workspace" })).toBeDefined()
    expect(await screen.findByRole("button", { name: "Refresh workspace" })).toBeDefined()
    expect(screen.getAllByText("Release recovery").length).toBeGreaterThan(0)
    expect(retryLoad).toHaveBeenCalledTimes(2)

  it "refreshes empty and populated boards from their visible controls", async ->
    const emptyLoad = vi.fn(async () => workspace())
    const { unmount } = render(<OperatorWorkspace gateway={gatewayWith({ workspace: emptyLoad })} />)
    expect(await screen.findByText("No workflow runs yet")).toBeDefined()
    fireEvent.click(screen.getByRole("button", { name: "Refresh runs" }))
    expect(await screen.findByText("No workflow runs yet")).toBeDefined()
    expect(emptyLoad).toHaveBeenCalledTimes(2)

    unmount()
    const populated = workspace([summary()])
    const populatedLoad = vi.fn(async () => populated)
    render(<OperatorWorkspace gateway={gatewayWith({ workspace: populatedLoad })} />)
    const refresh = await screen.findByRole("button", { name: "Refresh workspace" })
    fireEvent.click(refresh)
    expect((await screen.findAllByText("Release recovery")).length).toBeGreaterThan(0)
    expect(populatedLoad).toHaveBeenCalledTimes(2)

  it "uses the browser transport when no gateway is supplied", async ->
    const operator = {
      submit: vi.fn(async () => detail()),
      workspace: vi.fn(async () => workspace()),
      detail: vi.fn(async ({ id }: { id: string }) => detail({ id })),
      approve: vi.fn(async () => detail()),
      reject: vi.fn(async () => detail()),
      cancel: vi.fn(async () => detail()),
      retry: vi.fn(async () => detail()),
      message: vi.fn(async () => detail()),
    }
    browserTransport.createApiClient.mockReturnValue({ operator })

    const { unmount } = render(<OperatorWorkspace />)
    expect(await screen.findByText("No workflow runs yet")).toBeDefined()
    unmount()
    render(<OperatorRunDetail id="run-1" />)
    expect(await screen.findByText("Release recovery")).toBeDefined()

    expect(browserTransport.createApiClient).toHaveBeenCalledTimes(2)
    expect(operator.workspace).toHaveBeenCalledWith({ limit: 100 })
    expect(operator.detail).toHaveBeenCalledWith({ id: "run-1" })

  it "selects a submitted run and replaces the board after refresh", async ->
    const selected = detail({ id: "selected", title: "Selected run" })
    const refreshed = workspace([selected.run])
    const gateway = gatewayWith({
      submit: vi.fn(async () => selected),
      workspace: vi.fn()
        .mockResolvedValueOnce(workspace())
        .mockResolvedValueOnce(refreshed),
      detail: vi.fn(async () => selected),
    })
    render(<OperatorWorkspace gateway={gateway} />)

    fireEvent.click(await fillSubmission())
    const feedback = await screen.findByText("Run “Selected run” was submitted and selected.")
    await waitFor(() => expect(document.activeElement).toBe(feedback))
    expect(screen.getByText("Selected run: Selected run")).toBeDefined()
    expect(screen.getAllByText("Selected run").length).toBeGreaterThan(0)
    expect(gateway.submit).toHaveBeenCalledWith(
      "Pilot run",
      { repositoryId: "darkfactory", paths: ["apps/web"] },
      expect.any(String),
    )

  it "retains selection and warns when the board refresh fails", async ->
    const selected = detail({ id: "selected-warning", title: undefined })
    const gateway = gatewayWith({
      submit: vi.fn(async () => selected),
      workspace: vi.fn()
        .mockResolvedValueOnce(workspace())
        .mockRejectedValueOnce({ code: "STORAGE_ERROR" }),
      detail: vi.fn(async () => selected),
    })
    render(<OperatorWorkspace gateway={gateway} />)

    fireEvent.click(await fillSubmission())
    expect(await screen.findByText(/was submitted and selected, but the run board could not refresh/)).toBeDefined()
    expect(screen.getByText("Selected run: selected-warning")).toBeDefined()
    expect(screen.getByText("No workflow runs yet")).toBeDefined()

  it "blocks duplicate submissions and exposes pending state", async ->
    const request = deferred<OperatorRunDetailOutput>()
    const submit = vi.fn(() => request.promise)
    const selected = detail({ title: "Pilot run" })
    const gateway = gatewayWith({
      submit,
      workspace: vi.fn()
        .mockResolvedValueOnce(workspace())
        .mockResolvedValueOnce(workspace([selected.run])),
      detail: vi.fn(async () => selected),
    })
    render(<OperatorWorkspace gateway={gateway} />)

    const submitButton = await fillSubmission()
    fireEvent.click(submitButton)
    fireEvent.submit(submitButton.closest("form")!)
    expect(submit).toHaveBeenCalledOnce()
    expect((screen.getByRole("button", { name: /Submitting workflow run/ }) as HTMLButtonElement).disabled).toBe(true)

    await act(async () =>
      request.resolve(selected)
      await Promise.resolve()
    )
    expect(await screen.findByText("Run “Pilot run” was submitted and selected.")).toBeDefined()

  it "reuses a failed retry key, invalidates it after editing, and reports validation safely", async ->
    const selected = detail({ title: "Retry run" })
    const submit = vi.fn()
      .mockRejectedValueOnce({ code: "VALIDATION_ERROR" })
      .mockResolvedValueOnce(selected)
      .mockResolvedValueOnce(selected)
    const gateway = gatewayWith({
      submit,
      workspace: vi.fn()
        .mockResolvedValueOnce(workspace())
        .mockResolvedValueOnce(workspace([selected.run]))
        .mockResolvedValueOnce(workspace([selected.run])),
      detail: vi.fn(async () => selected),
    })
    const randomUUID = vi.fn()
      .mockReturnValueOnce("retry-key")
      .mockReturnValueOnce("changed-key")
    vi.stubGlobal("crypto", { randomUUID })
    render(<OperatorWorkspace gateway={gateway} />)

    fireEvent.click(await fillSubmission({
      title: "Retry run",
      repositoryId: "DARKFACTORY",
      scopePaths: "apps/web",
    }))
    expect((await screen.findByRole("alert")).textContent).toContain("Check the run title")

    fireEvent.click(screen.getByRole("button", { name: "Submit run" }))
    expect(await screen.findByText("Run “Retry run” was submitted and selected.")).toBeDefined()
    expect(submit.mock.calls[0]?.[2]).toBe("retry-key")
    expect(submit.mock.calls[1]?.[2]).toBe("retry-key")

    fireEvent.change(screen.getByLabelText("Run title"), { target: { value: "Changed retry" } })
    fireEvent.click(screen.getByRole("button", { name: "Submit run" }))
    await waitFor(() => expect(submit).toHaveBeenCalledTimes(3))
    expect(submit.mock.calls[2]?.[2]).toBe("changed-key")

  it "does not apply late workspace responses after unmount", async ->
    const lateSuccess = deferred<OperatorWorkspaceOutput>()
    const successLoad = vi.fn(() => lateSuccess.promise)
    const first = render(<OperatorWorkspace gateway={gatewayWith({ workspace: successLoad })} />)
    first.unmount()
    await act(async () =>
      lateSuccess.resolve(workspace([summary({ title: "Late workspace" })]))
      await Promise.resolve()
    )
    expect(screen.queryByText("Late workspace")).toBeNull()

    const lateFailure = deferred<OperatorWorkspaceOutput>()
    const second = render(<OperatorWorkspace gateway={gatewayWith({
      workspace: vi.fn(() => lateFailure.promise),
    })} />)
    second.unmount()
    await act(async () =>
      lateFailure.reject({ code: "SERVICE_UNAVAILABLE" })
      await Promise.resolve()
    )
    expect(screen.queryByText("Operator workspace unavailable")).toBeNull()

  it "does not publish submission state or schedule focus after unmount", async ->
    const selected = detail({ title: "Late submission" })
    const request = deferred<OperatorRunDetailOutput>()
    const focus = vi.spyOn(HTMLElement.prototype, "focus")
    const lookup = vi.spyOn(document, "getElementById")
    const gateway = gatewayWith({
      submit: vi.fn(() => request.promise),
      workspace: vi.fn()
        .mockResolvedValueOnce(workspace())
        .mockResolvedValueOnce(workspace([selected.run])),
    })
    const mounted = render(<OperatorWorkspace gateway={gateway} />)
    fireEvent.click(await fillSubmission())
    mounted.unmount()
    focus.mockClear()
    lookup.mockClear()

    await act(async () =>
      request.resolve(selected)
      await Promise.resolve()
    )
    expect(focus).not.toHaveBeenCalled()
    expect(lookup).not.toHaveBeenCalledWith("operator-submit-status")

  it "drops a rejected submission after unmount", async ->
    const request = deferred<OperatorRunDetailOutput>()
    const lookup = vi.spyOn(document, "getElementById")
    const gateway = gatewayWith({
      submit: vi.fn(() => request.promise),
      workspace: vi.fn(async () => workspace()),
    })
    const mounted = render(<OperatorWorkspace gateway={gateway} />)
    fireEvent.click(await fillSubmission())
    mounted.unmount()
    lookup.mockClear()

    await act(async () =>
      request.reject({ code: "VALIDATION_ERROR" })
      await Promise.resolve()
    )
    expect(lookup).not.toHaveBeenCalledWith("operator-submit-status")
    expect(screen.queryByText("Check the run title, repository ID, and relative scope paths, then try again.")).toBeNull()

  it "drops a scheduled submission focus after unmount", async ->
    const selected = detail({ title: "Scheduled focus" })
    const focus = vi.spyOn(HTMLElement.prototype, "focus")
    const gateway = gatewayWith({
      submit: vi.fn(async () => selected),
      workspace: vi.fn()
        .mockResolvedValueOnce(workspace())
        .mockResolvedValueOnce(workspace([selected.run])),
      detail: vi.fn(async () => selected),
    })
    const mounted = render(<OperatorWorkspace gateway={gateway} />)
    const submit = await fillSubmission()
    let scheduled: (() => void) | undefined
    vi.spyOn(window, "setTimeout").mockImplementation((callback, _delay?) =>
      scheduled = callback as () => void
      return 1 as unknown as NodeJS.Timeout
    )
    fireEvent.click(submit)
    await act(async () =>
      await Promise.resolve()
      await Promise.resolve()
      await Promise.resolve()
      await Promise.resolve()
    )
    expect(scheduled).toBeDefined()
    mounted.unmount()
    focus.mockClear()
    scheduled!()
    expect(focus).not.toHaveBeenCalled()

describe "operator run detail behavior", ->
  it "loads a blocked run and enables only valid actions", async ->
    const output = detail({ state: "blocked" })
    render(<OperatorRunDetail gateway={gatewayWith({ detail: vi.fn(async () => output) })} id="run-1" />)

    expect(screen.getByRole("status", { name: "Loading workflow run" })).toBeDefined()
    expect(await screen.findByText("Release recovery")).toBeDefined()
    expect((screen.getByRole("button", { name: "Retry run" }) as HTMLButtonElement).disabled).toBe(false)
    expect((screen.getByRole("button", { name: "Cancel run" }) as HTMLButtonElement).disabled).toBe(false)
    expect((screen.getByRole("button", { name: "Approve exact binding" }) as HTMLButtonElement).disabled).toBe(false)

  it "retries a failed load and disables actions at both terminal boundaries", async ->
    const load = vi.fn()
      .mockRejectedValueOnce({ code: "NOT_FOUND" })
      .mockResolvedValueOnce(detail({ state: "completed" }))
    const { unmount } = render(<OperatorRunDetail gateway={gatewayWith({ detail: load })} id="run-1" />)
    expect((await screen.findByRole("alert")).textContent).toContain("no longer available")

    fireEvent.click(screen.getByRole("button", { name: "Retry loading" }))
    expect(await screen.findByText("Release recovery")).toBeDefined()
    expect((screen.getByRole("button", { name: "Retry run" }) as HTMLButtonElement).disabled).toBe(true)
    expect((screen.getByRole("button", { name: "Cancel run" }) as HTMLButtonElement).disabled).toBe(true)

    unmount()
    render(<OperatorRunDetail
      gateway={gatewayWith({ detail: vi.fn(async () => detail({ state: "cancelled" })) })}
      id="run-1"
    />)
    expect(await screen.findByText("Release recovery")).toBeDefined()
    expect((screen.getByRole("button", { name: "Cancel run" }) as HTMLButtonElement).disabled).toBe(true)

  it "performs retry and cancel with pending and success feedback", async ->
    const retryRequest = deferred<OperatorRunDetailOutput>()
    const cancelRequest = deferred<OperatorRunDetailOutput>()
    const retry = vi.fn(() => retryRequest.promise)
    const cancel = vi.fn(() => cancelRequest.promise)
    const approve = vi.fn(async () => detail())
    render(<OperatorRunDetail
      gateway={gatewayWith({
        detail: vi.fn(async () => detail({ state: "blocked" })),
        retry,
        cancel,
        approve,
      })}
      id="run-1"
    />)
    await screen.findByText("Release recovery")

    fireEvent.click(screen.getByRole("button", { name: "Retry run" }))
    expect((screen.getByRole("button", { name: /Requesting retry/ }) as HTMLButtonElement).disabled).toBe(true)
    fireEvent.click(screen.getByRole("button", { name: /Requesting retry/ }))
    expect(retry).toHaveBeenCalledOnce()
    fireEvent.click(screen.getByRole("button", { name: "Approve exact binding" }))
    expect(approve).not.toHaveBeenCalled()
    await act(async () =>
      retryRequest.resolve(detail({ state: "planning" }))
      await Promise.resolve()
    )
    expect(document.activeElement).toBe(await screen.findByText("Retry requested."))

    fireEvent.click(screen.getByRole("button", { name: "Cancel run" }))
    expect((screen.getByRole("button", { name: /Cancelling run/ }) as HTMLButtonElement).disabled).toBe(true)
    await act(async () =>
      cancelRequest.resolve(detail({ state: "cancelled" }))
      await Promise.resolve()
    )
    expect(document.activeElement).toBe(await screen.findByText("Cancellation requested."))

  it "approves, rejects, and sends bounded chat actions", async ->
    const approve = vi.fn(async () => detail())
    const reject = vi.fn(async () => detail())
    const message = vi.fn(async () => detail())
    render(<OperatorRunDetail
      gateway={gatewayWith({ detail: vi.fn(async () => detail()), approve, reject, message })}
      id="run-1"
    />)
    await screen.findByText("Release recovery")

    expect(screen.getByRole("heading", { name: "Implementation plan" })).toBeDefined()
    expect(screen.getByText((_content, element) =>
      element?.tagName === "PRE" &&
      element.textContent === implementationPlan.summary
    )).toBeDefined()
    expect(screen.getByText(implementationPlan.digest)).toBeDefined()
    expect(screen.getByText("Sensitive values were redacted.")).toBeDefined()
    expect(screen.queryByText(/incomplete|truncated/i)).toBeNull()
    fireEvent.click(screen.getByRole("button", { name: "Approve exact binding" }))
    expect(await screen.findByText("Approval committed.")).toBeDefined()
    expect(approve).toHaveBeenCalledWith("run-1", approval)

    fireEvent.click(screen.getByRole("button", { name: "Reject approval" }))
    expect(await screen.findByText("Approval rejected.")).toBeDefined()
    expect(reject).toHaveBeenCalledWith("run-1")

    fireEvent.change(screen.getByLabelText("Add operator message"), {
      target: { value: " Bounded context " },
    })
    fireEvent.click(screen.getByRole("button", { name: "Send message" }))
    expect(await screen.findByText("Operator message added.")).toBeDefined()
    expect(message).toHaveBeenCalledWith("run-1", "Bounded context", expect.any(String))

  it "does not invoke approval without a binding", async ->
    const approve = vi.fn(async () => detail())
    render(<OperatorRunDetail
      gateway={gatewayWith({
        detail: vi.fn(async () => detail({}, { approval: null })),
        approve,
      })}
      id="run-1"
    />)
    expect(await screen.findByText("This run has no approval awaiting an explicit operator decision.")).toBeDefined()
    expect(screen.queryByRole("button", { name: "Approve exact binding" })).toBeNull()
    expect(approve).not.toHaveBeenCalled()

  it "fails closed when an approval binding has no reviewable implementation plan", async ->
    const approve = vi.fn(async () => detail())
    render(<OperatorRunDetail
      gateway={gatewayWith({
        detail: vi.fn(async () => detail({}, { implementationPlan: null })),
        approve,
      })}
      id="run-1"
    />)

    expect(await screen.findByText(
      "Implementation plan evidence is unavailable. Approval is disabled."
    )).toBeDefined()
    const button = screen.getByRole("button", { name: "Approve exact binding" })
    expect((button as HTMLButtonElement).disabled).toBe(true)
    fireEvent.click(button)
    expect(approve).not.toHaveBeenCalled()

  it "fails closed when implementation plan evidence is truncated", async ->
    const approve = vi.fn(async () => detail())
    render(<OperatorRunDetail
      gateway={gatewayWith({
        detail: vi.fn(async () => detail({}, {
          implementationPlan: { ...implementationPlan, truncated: true },
        })),
        approve,
      })}
      id="run-1"
    />)

    expect(await screen.findByText(
      "This plan is incomplete and cannot be approved. Regenerate a bounded plan."
    )).toBeDefined()
    const button = screen.getByRole("button", { name: "Approve exact binding" })
    expect((button as HTMLButtonElement).disabled).toBe(true)
    fireEvent.click(button)
    expect(approve).not.toHaveBeenCalled()

  it "routes stale conflicts to approval reload and other failures to chat and alert feedback", async ->
    const staleGateway = gatewayWith({
      detail: vi.fn(async () => detail()),
      approve: vi.fn(async () =>
        throw { code: "STALE_APPROVAL" }
      ),
    })
    const stale = render(<OperatorRunDetail gateway={staleGateway} id="run-1" />)
    await screen.findByText("Release recovery")
    fireEvent.click(screen.getByRole("button", { name: "Approve exact binding" }))
    expect(await screen.findByText("Stale approval conflict")).toBeDefined()
    expect(screen.queryByText("You do not have access to this workflow run.")).toBeNull()
    fireEvent.click(screen.getByRole("button", { name: "Reload binding" }))
    await waitFor(() => expect(staleGateway.detail).toHaveBeenCalledTimes(2))

    stale.unmount()
    const failureGateway = gatewayWith({
      detail: vi.fn(async () => detail()),
      cancel: vi.fn(async () =>
        throw { code: "FORBIDDEN" }
      ),
    })
    const nonMessage = render(<OperatorRunDetail gateway={failureGateway} id="run-1" />)
    await screen.findByText("Release recovery")
    fireEvent.click(screen.getByRole("button", { name: "Cancel run" }))
    expect(await screen.findAllByText("You do not have access to this workflow run.")).toHaveLength(2)
    expect(screen.getByLabelText("Add operator message").getAttribute("aria-describedby"))
      .toBe("operator-message-hint")
    expect(screen.getAllByRole("alert")).toHaveLength(1)

    nonMessage.unmount()
    const messageGateway = gatewayWith({
      detail: vi.fn(async () => detail()),
      message: vi.fn(async () =>
        throw { code: "FORBIDDEN" }
      ),
    })
    render(<OperatorRunDetail gateway={messageGateway} id="run-1" />)
    await screen.findByText("Release recovery")
    fireEvent.change(screen.getByLabelText("Add operator message"), {
      target: { value: "Bounded context" },
    })
    fireEvent.click(screen.getByRole("button", { name: "Send message" }))
    expect(await screen.findAllByText("You do not have access to this workflow run.")).toHaveLength(3)
    expect(screen.getAllByRole("alert")).toHaveLength(2)

  it "fences a late run A action from run B by id and request generation", async ->
    const retryRequest = deferred<OperatorRunDetailOutput>()
    const runA = detail({ id: "run-a", title: "Run A", state: "blocked" })
    const runB = detail({ id: "run-b", title: "Run B", state: "completed" })
    const gateway = gatewayWith({
      detail: vi.fn(async (id) => id === "run-a" ? runA : runB),
      retry: vi.fn(() => retryRequest.promise),
    })
    const mounted = render(<OperatorRunDetail gateway={gateway} id="run-a" />)
    expect(await screen.findByText("Run A")).toBeDefined()
    fireEvent.click(screen.getByRole("button", { name: "Retry run" }))

    mounted.rerender(<OperatorRunDetail gateway={gateway} id="run-b" />)
    expect(await screen.findByText("Run B")).toBeDefined()
    await act(async () =>
      retryRequest.resolve(detail({ id: "run-a", title: "Stale action result", state: "planning" }))
      await Promise.resolve()
    )

    expect(screen.getByText("Run B")).toBeDefined()
    expect(screen.queryByText("Stale action result")).toBeNull()
    expect(screen.queryByText("Retry requested.")).toBeNull()
    expect((screen.getByRole("button", { name: "Cancel run" }) as HTMLButtonElement).disabled).toBe(true)

  it "fences an action when the same run is reloaded to a newer request generation", async ->
    const retryRequest = deferred<OperatorRunDetailOutput>()
    const staleApproval = { ...approval, stale: true }
    const current = detail(
      { id: "run-1", title: "Current generation", state: "blocked" },
      { approval: staleApproval },
    )
    const load = vi.fn(async () => current)
    const gateway = gatewayWith({
      detail: load,
      retry: vi.fn(() => retryRequest.promise),
    })
    render(<OperatorRunDetail gateway={gateway} id="run-1" />)
    expect(await screen.findByText("Current generation")).toBeDefined()
    fireEvent.click(screen.getByRole("button", { name: "Retry run" }))
    fireEvent.click(screen.getByRole("button", { name: "Reload binding" }))
    await waitFor(() => expect(load).toHaveBeenCalledTimes(2))

    await act(async () =>
      retryRequest.resolve(detail({ title: "Obsolete generation", state: "planning" }))
      await Promise.resolve()
    )
    expect(screen.getByText("Current generation")).toBeDefined()
    expect(screen.queryByText("Obsolete generation")).toBeNull()
    expect(screen.queryByText("Retry requested.")).toBeNull()

  it "drops queued focus work when unmounted after a successful action", async ->
    const callbacks: Array<() => void> = []
    const focus = vi.spyOn(HTMLElement.prototype, "focus")
    render(<OperatorRunDetail
      gateway={gatewayWith({
        detail: vi.fn(async () => detail({ state: "blocked" })),
        retry: vi.fn(async () => detail({ state: "planning" })),
      })}
      id="run-1"
    />)
    await screen.findByText("Release recovery")
    vi.stubGlobal("queueMicrotask", vi.fn((callback: () => void) =>
      callbacks.push(callback)
    ))
    fireEvent.click(screen.getByRole("button", { name: "Retry run" }))
    expect(await screen.findByText("Retry requested.")).toBeDefined()
    cleanup()
    focus.mockClear()

    for (const callback of callbacks) callback()
    expect(focus).not.toHaveBeenCalled()

  it "drops late action errors and focus work after unmount", async ->
    const messageRequest = deferred<OperatorRunDetailOutput>()
    const focus = vi.spyOn(HTMLElement.prototype, "focus")
    const mounted = render(<OperatorRunDetail
      gateway={gatewayWith({
        detail: vi.fn(async () => detail()),
        message: vi.fn(() => messageRequest.promise),
      })}
      id="run-1"
    />)
    await screen.findByText("Release recovery")
    fireEvent.change(screen.getByLabelText("Add operator message"), {
      target: { value: "Late message" },
    })
    fireEvent.click(screen.getByRole("button", { name: "Send message" }))
    mounted.unmount()
    focus.mockClear()

    await act(async () =>
      messageRequest.reject({ code: "FORBIDDEN" })
      await Promise.resolve()
    )
    expect(focus).not.toHaveBeenCalled()
    expect(screen.queryByText("You do not have access to this workflow run.")).toBeNull()

  it "ignores successful and failed detail loads after unmount", async ->
    const lateSuccess = deferred<OperatorRunDetailOutput>()
    const first = render(<OperatorRunDetail
      gateway={gatewayWith({ detail: vi.fn(() => lateSuccess.promise) })}
      id="run-1"
    />)
    first.unmount()
    await act(async () =>
      lateSuccess.resolve(detail({ title: "Late detail" }))
      await Promise.resolve()
    )
    expect(screen.queryByText("Late detail")).toBeNull()

    const lateFailure = deferred<OperatorRunDetailOutput>()
    const second = render(<OperatorRunDetail
      gateway={gatewayWith({ detail: vi.fn(() => lateFailure.promise) })}
      id="run-1"
    />)
    second.unmount()
    await act(async () =>
      lateFailure.reject({ code: "NOT_FOUND" })
      await Promise.resolve()
    )
    expect(screen.queryByText("Workflow run unavailable")).toBeNull()

describe "approval panel behavior", ->
  it "forwards fresh decisions and restricts stale conflicts to reload", ->
    const onApprove = vi.fn()
    const onReject = vi.fn()
    const onReload = vi.fn()
    const mounted = render(<ApprovalPanel
      approval={approval}
      implementationPlan={implementationPlan}
      busyAction={null}
      onApprove={onApprove}
      onReject={onReject}
      onReload={onReload}
    />)
    fireEvent.click(screen.getByRole("button", { name: "Approve exact binding" }))
    fireEvent.click(screen.getByRole("button", { name: "Reject approval" }))
    expect(onApprove).toHaveBeenCalledOnce()
    expect(onReject).toHaveBeenCalledOnce()

    mounted.rerender(<ApprovalPanel
      approval={{ ...approval, stale: true }}
      implementationPlan={implementationPlan}
      busyAction={null}
      onApprove={onApprove}
      onReject={onReject}
      onReload={onReload}
    />)
    expect((screen.getByRole("button", { name: "Approve exact binding" }) as HTMLButtonElement).disabled).toBe(true)
    expect((screen.getByRole("button", { name: "Reject approval" }) as HTMLButtonElement).disabled).toBe(true)
    fireEvent.click(screen.getByRole("button", { name: "Reload binding" }))
    expect(onReload).toHaveBeenCalledOnce()

describe "operator chat behavior", ->
  it "renders empty, populated, busy, and failure states", ->
    const mounted = render(<ChatPanel busy={false} messages={[]} onSend={vi.fn(async () => true)} />)
    expect(screen.getByText(/No operator messages yet/)).toBeDefined()
    expect((screen.getByRole("button", { name: "Send message" }) as HTMLButtonElement).disabled).toBe(true)
    expect(screen.getByLabelText("Add operator message").getAttribute("maxlength")).toBe("2000")
    expect(screen.getByLabelText("Add operator message").getAttribute("aria-describedby")).toBe("operator-message-hint")

    mounted.rerender(<ChatPanel
      busy
      failureMessage="Message could not be stored."
      messages={[{
        id: "message-1",
        authorLabel: "Operator Jane",
        body: "Bounded\ncontext",
        createdAt: new Date("2026-07-29T12:30:00.000Z"),
      }]}
      onSend={vi.fn(async () => true)}
    />)
    expect(screen.getByText("Operator Jane")).toBeDefined()
    expect(screen.getByText(/Bounded/).textContent?.replace(/\s+/gu, " ")).toContain("Bounded context")
    expect(screen.getByRole("alert").textContent).toContain("Message could not be stored.")
    expect((screen.getByRole("button", { name: /Sending operator message/ }) as HTMLButtonElement).disabled).toBe(true)

  it "ignores whitespace and busy submissions and prevents an in-flight duplicate", async ->
    const request = deferred<boolean>()
    const onSend = vi.fn(() => request.promise)
    const mounted = render(<ChatPanel busy={false} messages={[]} onSend={onSend} />)
    const input = screen.getByLabelText("Add operator message")
    fireEvent.change(input, { target: { value: "   " } })
    fireEvent.submit(input.closest("form")!)
    expect(onSend).not.toHaveBeenCalled()

    fireEvent.change(input, { target: { value: "  Context  " } })
    fireEvent.submit(input.closest("form")!)
    fireEvent.submit(input.closest("form")!)
    expect(onSend).toHaveBeenCalledOnce()
    await act(async () =>
      request.resolve(false)
      await Promise.resolve()
    )
    expect((input as HTMLTextAreaElement).value).toBe("  Context  ")

    mounted.rerender(<ChatPanel busy messages={[]} onSend={onSend} />)
    fireEvent.submit(input.closest("form")!)
    expect(onSend).toHaveBeenCalledOnce()

  it "reuses a failed-send key, rotates it after editing, and clears successful text", async ->
    const onSend = vi.fn()
      .mockResolvedValueOnce(false)
      .mockResolvedValueOnce(true)
      .mockResolvedValueOnce(true)
    const randomUUID = vi.fn()
      .mockReturnValueOnce("message-retry-key")
      .mockReturnValueOnce("message-changed-key")
    vi.stubGlobal("crypto", { randomUUID })
    render(<ChatPanel busy={false} messages={[]} onSend={onSend} />)
    const input = screen.getByLabelText("Add operator message")

    fireEvent.change(input, { target: { value: " First message " } })
    fireEvent.submit(input.closest("form")!)
    await waitFor(() => expect(onSend).toHaveBeenCalledTimes(1))
    expect((input as HTMLTextAreaElement).value).toBe(" First message ")

    fireEvent.submit(input.closest("form")!)
    await waitFor(() => expect((input as HTMLTextAreaElement).value).toBe(""))
    expect(onSend.mock.calls[0]).toEqual(["First message", "message-retry-key"])
    expect(onSend.mock.calls[1]).toEqual(["First message", "message-retry-key"])

    fireEvent.change(input, { target: { value: "Changed payload" } })
    fireEvent.submit(input.closest("form")!)
    await waitFor(() => expect(onSend).toHaveBeenCalledTimes(3))
    expect(onSend.mock.calls[2]).toEqual(["Changed payload", "message-changed-key"])


  it "does not clear a late successful message after unmount", async ->
    const request = deferred<boolean>()
    const onSend = vi.fn(() => request.promise)
    const mounted = render(<ChatPanel busy={false} messages={[]} onSend={onSend} />)
    const input = screen.getByLabelText("Add operator message")
    fireEvent.change(input, { target: { value: "Late success" } })
    fireEvent.submit(input.closest("form")!)
    mounted.unmount()

    await act(async () =>
      request.resolve(true)
      await Promise.resolve()
    )
    expect(onSend).toHaveBeenCalledWith("Late success", expect.any(String))
    expect(screen.queryByDisplayValue("Late success")).toBeNull()
