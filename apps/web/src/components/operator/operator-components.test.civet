import type { ComponentProps } from "react"
import { renderToStaticMarkup } from "react-dom/server"
import { describe, expect, it, vi } from "vitest"

vi.mock("next/link", () => ({
  default: ({ children, href, ...props }: ComponentProps<"a">) => (
    <a href={href} {...props}>
      {children}
  ),
}))

import { ApprovalPanel } from "./approval-panel.civet"
import { ChatPanel } from "./chat-panel.civet"
import { EvidencePanel } from "./evidence-panel.civet"
import type {
  OperatorApprovalBinding,
  OperatorEvidenceItem,
  OperatorRunSummary,
} from "./operator-client.civet"
import { abbreviatedHash, formatOperatorDate, operatorRunTitle } from "./operator-format.civet"
import {
  OperatorSubmitFormView,
  type OperatorSubmitFeedback,
} from "./operator-workspace.civet"
import { RunKanban, runsByWorkflowState } from "./run-kanban.civet"
import { RunTimeline } from "./run-timeline.civet"
import { WorkflowGraph, workflowStateCounts } from "./workflow-graph.civet"

const run = (overrides: Partial<OperatorRunSummary> = {}): OperatorRunSummary => ({
  id: "run-1",
  title: "Release login recovery",
  state: "awaitingApproval",
  sequence: 7,
  updatedAt: new Date("2026-07-29T12:00:00.000Z"),
  headHash: "journal-head-0123456789abcdef",
  ...overrides,
})

const approval: OperatorApprovalBinding = {
  machineId: "darkfactory-pilot",
  machineVersion: 1,
  eventVersion: 1,
  snapshotSequence: 7,
  journalHeadHash: "journal-head-0123456789abcdef",
  effectHash: "effect-hash-fedcba9876543210",
  effectScope: "repository:darkfactory/run:run-1",
  stale: false,
}
const implementationPlan = {
  summary: "1. Apply the bounded contract\n2. Preserve owner scope",
  digest: "d".repeat(64),
  truncated: false,
  redacted: true,
} as const

describe "operator workflow components", ->
  it "groups and orders the responsive run board without horizontal scrolling", ->
    const runs = [
      run({ id: "older", updatedAt: new Date("2026-07-28T12:00:00.000Z") }),
      run({ id: "newer", title: undefined, updatedAt: new Date("2026-07-29T12:00:00.000Z") }),
      run({ id: "blocked", state: "blocked", blockedReason: "Verification failed safely." }),
    ]
    expect(runsByWorkflowState(runs).awaitingApproval.map((item) => item.id)).toEqual(["newer", "older"])
    expect(workflowStateCounts(runs)).toMatchObject({ awaitingApproval: 2, blocked: 1, completed: 0 })

    const markup = renderToStaticMarkup(
      <>
        <WorkflowGraph runs={runs} />
        <RunKanban runs={runs} selectedRunId="newer" />
    )
    expect(markup).toContain("Workflow graph")
    expect(markup).toContain("Run board")
    expect(markup).toContain("xl:grid-cols-4")
    expect(markup).not.toContain("overflow-x-auto")
    expect(markup).toContain('aria-label="Open newer, Awaiting approval"')
    expect(markup).toContain("seq 7")
    expect(markup).toContain('aria-current="true"')
    expect(markup).toContain("bg-accent")

  it "shows the exact approval binding and fails closed for a stale conflict", ->
    const markup = renderToStaticMarkup(
      <ApprovalPanel
        approval={{ ...approval, stale: true }}
        implementationPlan={implementationPlan}
        busyAction={null}
        onApprove={vi.fn()}
        onReject={vi.fn()}
        onReload={vi.fn()}
      />,
    )
    expect(markup).toContain("Stale approval conflict")
    expect(markup).toContain(approval.journalHeadHash)
    expect(markup).toContain(approval.effectHash)
    expect(markup).toContain(approval.effectScope)
    expect(markup).toContain(implementationPlan.summary)
    expect(markup).toContain(implementationPlan.digest)
    expect(markup).toContain("Approve exact binding")
    expect(markup.match(/disabled=""/g)).toHaveLength(2)
    expect(markup).toContain("Reload binding")

  it "renders only the bounded redacted evidence projection and exact journal metadata", ->
    const evidence = [{
      id: "evidence-1",
      kind: "verification",
      label: "Focused verification",
      redactedContent: "[REDACTED] command completed",
      redacted: true,
      createdAt: new Date("2026-07-29T12:01:00.000Z"),
      rawContent: "SECRET_RAW_VALUE",
    }] as unknown as readonly OperatorEvidenceItem[]
    const markup = renderToStaticMarkup(
      <>
        <EvidencePanel evidence={evidence} />
        <RunTimeline entries={[{
          sequence: 7,
          eventType: "VERIFICATION_SUCCEEDED",
          summary: "Bounded verification summary.",
          hash: "event-hash-0123456789abcdef",
          createdAt: new Date("2026-07-29T12:02:00.000Z"),
        }]} />
    )
    expect(markup).toContain("[REDACTED] command completed")
    expect(markup).not.toContain("SECRET_RAW_VALUE")
    expect(markup).toContain("event-hash-0123456789abcdef")
    expect(markup).toContain("seq 7")
    expect(markup).toContain("Redacted")

  it "keeps the bounded submission form labelled, stackable, and disabled while pending", ->
    const feedback: OperatorSubmitFeedback = {
      tone: "error",
      message: "The operator request could not be completed. Try again.",
    }
    const markup = renderToStaticMarkup(
      <OperatorSubmitFormView
        feedback={feedback}
        onChange={vi.fn()}
        onSubmit={vi.fn()}
        pending
        values={{
          title: "Pilot run",
          repositoryId: "darkfactory",
          scopePaths: "packages/state",
        }}
      />,
    )

    expect(markup).toContain('for="operator-run-title"')
    expect(markup).toContain('for="operator-repository-id"')
    expect(markup).toContain('for="operator-scope-paths"')
    expect(markup).toContain('aria-describedby="operator-scope-paths-hint"')
    expect(markup).toContain('role="alert"')
    expect(markup).toContain("The operator request could not be completed. Try again.")
    expect(markup).toContain('disabled=""')
    expect(markup).toContain('aria-busy="true"')
    expect(markup).toContain("sm:grid-cols-2")
    expect(markup).toContain("A human operator must review the exact approval binding")

  it "labels chat input and disables an empty message action", ->
    const markup = renderToStaticMarkup(
      <ChatPanel busy={false} messages={[]} onSend={vi.fn(async () => true)} />,
    )
    expect(markup).toContain('for="operator-message"')
    expect(markup).toContain('id="operator-message"')
    expect(markup).toContain("Do not paste secrets")
    expect(markup).toContain('disabled=""')
    expect(markup).toContain("Send message")

  it "renders absent, fresh, conflicted, and busy approval checkpoints", ->
    const absent = renderToStaticMarkup(
      <ApprovalPanel
        approval={null}
        implementationPlan={null}
        busyAction={null}
        onApprove={vi.fn()}
        onReject={vi.fn()}
        onReload={vi.fn()}
      />,
    )
    expect(absent).toContain("no approval awaiting")
    expect(absent).not.toContain("Approve exact binding")

    const fresh = renderToStaticMarkup(
      <ApprovalPanel
        approval={approval}
        implementationPlan={implementationPlan}
        busyAction={null}
        onApprove={vi.fn()}
        onReject={vi.fn()}
        onReload={vi.fn()}
      />,
    )
    expect(fresh).toContain("darkfactory-pilot v1")
    expect(fresh).toContain(">1</dd>")
    expect(fresh).not.toContain("Stale approval conflict")
    expect(fresh).not.toContain('disabled=""')

    const truncatedPlan = renderToStaticMarkup(
      <ApprovalPanel
        approval={approval}
        implementationPlan={{ ...implementationPlan, truncated: true }}
        busyAction={null}
        onApprove={vi.fn()}
        onReject={vi.fn()}
        onReload={vi.fn()}
      />,
    )
    expect(truncatedPlan).toContain("incomplete and cannot be approved")
    expect(truncatedPlan.match(/disabled=""/g)).toHaveLength(1)

    const conflicted = renderToStaticMarkup(
      <ApprovalPanel
        approval={approval}
        implementationPlan={implementationPlan}
        busyAction={null}
        conflictMessage="A newer journal head is available."
        onApprove={vi.fn()}
        onReject={vi.fn()}
        onReload={vi.fn()}
      />,
    )
    expect(conflicted).toContain("A newer journal head is available.")
    expect(conflicted.match(/disabled=""/g)).toHaveLength(2)

    const approving = renderToStaticMarkup(
      <ApprovalPanel
        approval={approval}
        implementationPlan={implementationPlan}
        busyAction="approve"
        onApprove={vi.fn()}
        onReject={vi.fn()}
        onReload={vi.fn()}
      />,
    )
    const rejecting = renderToStaticMarkup(
      <ApprovalPanel
        approval={approval}
        implementationPlan={implementationPlan}
        busyAction="reject"
        onApprove={vi.fn()}
        onReject={vi.fn()}
        onReload={vi.fn()}
      />,
    )
    expect(approving).toContain("Approving exact binding")
    expect(rejecting).toContain("Rejecting approval")

  it "renders evidence empty, storage-safe, redacted, and policy-removed projections", ->
    const safeEvidence: readonly OperatorEvidenceItem[] = [{
      id: "safe",
      kind: "summary",
      label: "Safe summary",
      redactedContent: "Bounded content",
      redacted: false,
      createdAt: new Date("2026-07-29T12:03:00.000Z"),
    }, {
      id: "removed",
      kind: "command",
      label: "Removed command",
      redactedContent: "",
      redacted: true,
      createdAt: new Date("2026-07-29T12:04:00.000Z"),
    }]
    const empty = renderToStaticMarkup(<EvidencePanel evidence={[]} />)
    const populated = renderToStaticMarkup(<EvidencePanel evidence={safeEvidence} />)

    expect(empty).toContain("No stored evidence is available")
    expect(populated).toContain("Storage-safe")
    expect(populated).toContain("Redacted")
    expect(populated).toContain("Bounded content")
    expect(populated).toContain("Content removed by storage policy.")
    expect(populated).toContain("Safe summary")
    expect(populated).toContain("summary")

  it "renders an empty timeline and normalizes event labels including empty segments", ->
    const empty = renderToStaticMarkup(<RunTimeline entries={[]} />)
    const populated = renderToStaticMarkup(<RunTimeline entries={[{
      sequence: 8,
      eventType: "BUILD__DONE",
      summary: "Build completed.",
      hash: "event-hash",
      createdAt: new Date("2026-07-29T12:05:00.000Z"),
    }]} />)

    expect(empty).toContain("No journal events have been recorded.")
    expect(populated).toContain("Build  Done")
    expect(populated).toContain("Build completed.")
    expect(populated).toContain("seq 8 · event-hash")

  it "formats run titles, UTC dates, and short and long journal hashes", ->
    const timestamp = new Date("2026-07-29T12:00:00.000Z")
    expect(operatorRunTitle({ id: "fallback", title: undefined })).toBe("fallback")
    expect(operatorRunTitle({ id: "blank", title: "   " })).toBe("blank")
    expect(operatorRunTitle({ id: "named", title: "  Bounded run  " })).toBe("Bounded run")
    expect(formatOperatorDate(timestamp)).toContain("2026")
    expect(formatOperatorDate(timestamp)).toContain("12:00")
    expect(abbreviatedHash("short-hash")).toBe("short-hash")
    expect(abbreviatedHash("0123456789abcdef")).toBe("0123456789abcdef")
    expect(abbreviatedHash("0123456789abcdefg")).toBe("01234567…9abcdefg")
    expect(abbreviatedHash("0123456789abcdef0123456789abcdef")).toBe("01234567…89abcdef")

  it "renders warning, success, and absent submission feedback without an error role", ->
    const values = { title: "Pilot run", repositoryId: "darkfactory", scopePaths: "apps/web" }
    const renderFeedback = (feedback: OperatorSubmitFeedback | null): string => renderToStaticMarkup(
      <OperatorSubmitFormView
        feedback={feedback}
        onChange={vi.fn()}
        onSubmit={vi.fn()}
        pending={false}
        values={values}
      />,
    )
    const warning = renderFeedback({ tone: "warning", message: "Board refresh deferred." })
    const success = renderFeedback({ tone: "success", message: "Run selected." })
    const absent = renderFeedback(null)

    expect(warning).toContain("Board refresh deferred.")
    expect(warning).toContain('role="status"')
    expect(warning).toContain("bg-warning-subtle")
    expect(success).toContain("Run selected.")
    expect(success).toContain("bg-success-subtle")
    expect(absent).not.toContain("operator-submit-status")
    expect(absent).not.toContain('aria-busy="true"')
