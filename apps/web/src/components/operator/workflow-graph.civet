import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@darkfactory/ui"
import { ArrowDown, ArrowRight } from "lucide-react"
import { Fragment } from "react"

import {
  WORKFLOW_STATES,
  type OperatorRunSummary,
  type WorkflowState,
} from "./operator-client.civet"
import { workflowStateLabel } from "./workflow-status.civet"

const PRIMARY_FLOW: readonly WorkflowState[] = Object.freeze([
  "draft",
  "planning",
  "awaitingApproval",
  "implementing",
  "verifying",
  "completed",
])

const EXCEPTION_STATES: readonly WorkflowState[] = Object.freeze(["blocked", "cancelled"])

export const workflowStateCounts = (
  runs: readonly OperatorRunSummary[],
): Readonly<Record<WorkflowState, number>> =>
  const counts = Object.fromEntries(WORKFLOW_STATES.map((state) => [state, 0])) as Record<WorkflowState, number>
  for (const run of runs) counts[run.state] += 1
  return counts

const GraphNode = ({ count, state }: { readonly count: number; readonly state: WorkflowState }) => (
  <li className="min-w-0 rounded-md border border-border bg-surface-raised px-3 py-3">
    <span className="block text-xs font-semibold uppercase tracking-wide text-muted-foreground">
      {workflowStateLabel(state)}
    <span className="mt-1 block font-heading text-xl font-semibold text-foreground">
      {count}{" "}
      <span className="text-sm font-normal text-muted-foreground">runs
)

export const WorkflowGraph = ({ runs }: { readonly runs: readonly OperatorRunSummary[] }) =>
  const counts = workflowStateCounts(runs)
  return (
    <Card aria-labelledby="workflow-graph-title">
      <CardHeader>
        <CardTitle id="workflow-graph-title" headingLevel={2}>Workflow graph
        <CardDescription>
          Live distribution across the version 1 state machine. Blocked and cancelled are terminal exception paths.
      <CardContent className="space-y-4">
        <ol className="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] xl:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)]" aria-label="Primary workflow path">
          {PRIMARY_FLOW.map((state, index) => (
            <Fragment key={state}>
              <GraphNode count={counts[state]} state={state} />
              {index === PRIMARY_FLOW.length - 1 ? null : (
                <li aria-hidden="true" className="flex min-h-11 items-center justify-center text-muted-foreground">
                  <ArrowDown className="size-4 sm:hidden" />
                  <ArrowRight className="hidden size-4 sm:block" />
              )}
          ))}
        <div className="grid gap-2 border-t border-border pt-4 sm:grid-cols-2" aria-label="Exception workflow states" role="list">
          {EXCEPTION_STATES.map((state) => (
            <GraphNode count={counts[state]} key={state} state={state} />
          ))}
)
