"use client"

import type { AccountProfileOutput, ProfileUpdateInput } from "@darkfactory/api"
import { Button, EmptyState, Skeleton, buttonVariants } from "@darkfactory/ui"
import { RotateCcw } from "lucide-react"
import { useCallback, useEffect, useState } from "react"

import {
  accountFailureKind,
  createBrowserAccountGateway,
  safeAccountFeedback,
  type AccountFailureKind,
} from "./account-client.civet"
import type { AccountFeedback } from "./account-feedback.civet"
import { ProfileForm } from "./profile-form.civet"

type ProfileState =
  | Readonly<{ type: "loading" }>
  | Readonly<{ type: "error"; kind: AccountFailureKind }>
  | Readonly<{ type: "ready"; account: AccountProfileOutput; version: number }>

export const ProfilePageClient = () => {
  const [gateway] = useState(createBrowserAccountGateway)
  const [state, setState] = useState<ProfileState>({ type: "loading" })
  const [feedback, setFeedback] = useState<AccountFeedback | null>(null)

  const load = useCallback(async () => {
    setFeedback(null)
    setState({ type: "loading" })
    try {
      const account = await gateway.getProfile()
      setState({ type: "ready", account, version: 0 })
    } catch (error) {
      setState({ type: "error", kind: accountFailureKind(error) })
    }
  }, [gateway])

  useEffect(() => {
    void load()
    return undefined
  }, [load])

  if (state.type === "loading") {
    return (
      <div aria-busy="true" aria-live="polite" className="grid gap-5 sm:grid-cols-2" role="status">
        <span className="sr-only">Loading profile</span>
        {["one", "two", "three", "four", "five", "six"].map((key) => <Skeleton className="h-11 w-full" key={key} />)}
      </div>
    )
  }
  if (state.type === "error") {
    const action = state.kind === "unauthorized"
      ? <a className={buttonVariants()} href="/sign-in?callbackURL=%2Faccount%2Fprofile">Sign in</a>
      : state.kind === "forbidden"
        ? <a className={buttonVariants({ variant: "secondary" })} href="/dashboard">Back to dashboard</a>
        : state.kind === "not-found"
          ? <a className={buttonVariants({ variant: "secondary" })} href="/account">Back to account</a>
          : <Button onClick={() => void load()} variant="secondary"><RotateCcw aria-hidden="true" className="size-4" />Try again</Button>
    return (
      <div aria-live="assertive" role="alert">
        <EmptyState
          action={action}
          description={state.kind === "unauthorized" ? "Sign in again to load your profile." : state.kind === "forbidden" ? "This account cannot open that profile." : state.kind === "not-found" ? "The profile is no longer available." : "Your profile could not be loaded. No fields were changed."}
          icon={<RotateCcw />}
          title="Profile unavailable"
        />
      </div>
    )
  }

  const save = async (input: ProfileUpdateInput): Promise<void> => {
    setFeedback(null)
    try {
      const account = await gateway.updateProfile(input)
      setState((current) => current.type === "ready"
        ? { type: "ready", account, version: current.version + 1 }
        : current)
      setFeedback({ tone: "success", message: "Profile saved." })
    } catch (error) {
      if (accountFailureKind(error) === "conflict") {
        try {
          const account = await gateway.getProfile()
          setState((current) => current.type === "ready" ? { ...current, account } : current)
        } catch {
          // The current form stays mounted with its unsaved values.
        }
        setFeedback({ tone: "error", message: "This profile changed elsewhere. Your entries are preserved; review them and save again." })
      } else {
        setFeedback({ tone: "error", message: safeAccountFeedback(error) })
      }
    }
  }

  return (
    <ProfileForm
      feedback={feedback}
      initialProfile={state.account.profile}
      key={state.version}
      onSave={save}
    />
  )
}
