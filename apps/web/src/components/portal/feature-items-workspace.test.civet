import type { FeatureItemOutput } from "@darkfactory/api"
import type { ReactElement } from "react"
import { renderToStaticMarkup } from "react-dom/server"
import { afterEach, describe, expect, it, vi } from "vitest"

const hookRuntime = vi.hoisted(() =>
  type Effect = () => void | (() => void)
  type DependencySlot<Value> = Readonly<{
    deps: readonly unknown[] | undefined
    value: Value
  }>
  type PendingEffect = Readonly<{
    deps: readonly unknown[] | undefined
    effect: Effect
    index: number
  }>

  const stateSlots: Array<{ value: unknown }> = []
  const refSlots: Array<{ current: unknown }> = []
  const callbackSlots: Array<DependencySlot<unknown>> = []
  const effectSlots: Array<DependencySlot<(() => void) | undefined>> = []
  const pendingEffects: PendingEffect[] = []
  const focusHistory: string[] = []
  let stateCursor = 0
  let refCursor = 0
  let callbackCursor = 0
  let effectCursor = 0
  let assignRenderedRefs = true

  const dependenciesChanged = (
    previous: readonly unknown[] | undefined,
    next: readonly unknown[] | undefined,
  ): boolean => (
    previous === undefined
    || next === undefined
    || previous.length !== next.length
    || previous.some((value, index) => !Object.is(value, next[index]))
  )

  const textOf = (node: unknown): string =>
    if (typeof node === "string" || typeof node === "number") return String(node)
    if (Array.isArray(node)) return node.map(textOf).join("")
    if (typeof node !== "object" || node === null) return ""
    const props = Reflect.get(node, "props")
    if (typeof props !== "object" || props === null) return ""
    return textOf(Reflect.get(props, "children"))

  const visitElements = (
    node: unknown,
    visit: (element: Readonly<{ props: Record<string, unknown> }>) => void,
    seen = new WeakSet<object>(),
  ): void =>
    if (Array.isArray(node))
      for (const child of node) visitElements(child, visit, seen)
      return undefined
    if (typeof node !== "object" || node === null || seen.has(node)) return
    seen.add(node)
    const props = Reflect.get(node, "props")
    if (typeof props !== "object" || props === null) return
    const element = node as Readonly<{ props: Record<string, unknown> }>
    visit(element)
    for (const value of Object.values(element.props)) visitElements(value, visit, seen)

  const assignRefs = (tree: unknown): void =>
    if (!assignRenderedRefs) return
    visitElements(tree, (element) =>
      const ref = element.props["ref"]
      if (typeof ref !== "object" || ref === null || !("current" in ref)) return
      const label = typeof element.props["id"] === "string"
        ? element.props["id"]
        : element.props["aria-live"] === "polite"
          ? "feedback"
          : textOf(element).replace(/\s+/gu, " ").trim() || "unlabeled"
      Reflect.set(ref, "current", {
        focus: () => focusHistory.push(label),
      })
    )

  const cleanup = (): void =>
    for (const slot of effectSlots) slot.value?.()

  return {
    begin: (): void =>
      stateCursor = 0
      refCursor = 0
      callbackCursor = 0
      effectCursor = 0
      pendingEffects.length = 0
    cleanup,
    commit: (tree: unknown): void =>
      assignRefs(tree)
      for (const pending of pendingEffects.splice(0))
        effectSlots[pending.index]?.value?.()
        const effectCleanup = pending.effect()
        effectSlots[pending.index] = {
          deps: pending.deps,
          value: typeof effectCleanup === "function" ? effectCleanup : undefined,
        }
    lastFocus: (): string | undefined => focusHistory.at(-1),
    setAssignRenderedRefs: (value: boolean) =>
      assignRenderedRefs = value
    reset: (): void =>
      cleanup()
      stateSlots.length = 0
      refSlots.length = 0
      callbackSlots.length = 0
      effectSlots.length = 0
      pendingEffects.length = 0
      focusHistory.length = 0
      stateCursor = 0
      refCursor = 0
      callbackCursor = 0
      effectCursor = 0
      assignRenderedRefs = true
    useCallback: <Callback>(callback: Callback, deps?: readonly unknown[]): Callback =>
      const index = callbackCursor++
      const previous = callbackSlots[index]
      if (previous !== undefined && !dependenciesChanged(previous.deps, deps))
        return previous.value as Callback
      callbackSlots[index] = { deps, value: callback }
      return callback
    useEffect: (effect: Effect, deps?: readonly unknown[]): void =>
      const index = effectCursor++
      const previous = effectSlots[index]
      if (previous === undefined || dependenciesChanged(previous.deps, deps))
        pendingEffects.push({ deps, effect, index })
    useRef: <Value>(initialValue: Value): { current: Value } =>
      const index = refCursor++
      refSlots[index] ??= { current: initialValue }
      return refSlots[index] as { current: Value }
    useState: <Value>(
      initializer: Value | (() => Value),
    ): readonly [Value, (next: Value | ((current: Value) => Value)) => void] =>
      const index = stateCursor++
      stateSlots[index] ??= {
        value: typeof initializer === "function"
          ? (initializer as () => Value)()
          : initializer,
      }
      const slot = stateSlots[index]!
      return [
        slot.value as Value,
        (next) =>
          slot.value = typeof next === "function"
            ? (next as (current: Value) => Value)(slot.value as Value)
            : next
      ]
  }
)

vi.mock("react", async (importOriginal) =>
  const actual = await importOriginal<typeof import("react")>()
  return {
    ...actual,
    useCallback: hookRuntime.useCallback,
    useEffect: hookRuntime.useEffect,
    useRef: hookRuntime.useRef,
    useState: hookRuntime.useState,
  }
)

import { FeatureItemsCollection } from "./feature-items-collection.civet"
import type {
  FeatureItemGateway,
  FeatureItemListInput,
} from "./feature-items-client.civet"
import { FeatureRecoveryAction } from "./feature-recovery-action.civet"
import { FeatureItemsWorkspace } from "./feature-items-workspace.civet"

type ElementRecord = Readonly<{ props: Record<string, unknown>; type: unknown }>

const item = (overrides: Partial<FeatureItemOutput> = {}): FeatureItemOutput => ({
  id: "item-1",
  name: "Starter checklist",
  description: "A clearly labeled example feature item.",
  status: "draft",
  metadata: {},
  ownerId: "user-1",
  createdAt: new Date("2026-01-01T00:00:00.000Z"),
  updatedAt: new Date("2026-01-02T00:00:00.000Z"),
  ...overrides,
})

const gatewayWith = (overrides: Partial<FeatureItemGateway> = {}): FeatureItemGateway => ({
  list: vi.fn(async () => []),
  get: vi.fn(async () => item()),
  create: vi.fn(async (input) => item({ name: input.name, description: input.description })),
  update: vi.fn(async (_id, input) => item(input)),
  changeStatus: vi.fn(async (_id, status) => item({ status })),
  archive: vi.fn(async () => item({ status: "archived" })),
  ...overrides,
})

const deferred = <Value>() =>
  let resolvePromise = (_value: Value): void =>
    throw new Error("Deferred promise was not initialized")
  let rejectPromise = (_reason: unknown): void =>
    throw new Error("Deferred promise was not initialized")
  const promise = new Promise<Value>((resolve, reject) =>
    resolvePromise = resolve
    rejectPromise = reject
  )
  return { promise, reject: rejectPromise, resolve: resolvePromise }

const textOf = (node: unknown): string =>
  if (typeof node === "string" || typeof node === "number") return String(node)
  if (Array.isArray(node)) return node.map(textOf).join("")
  if (typeof node !== "object" || node === null) return ""
  const props = Reflect.get(node, "props")
  if (typeof props !== "object" || props === null) return ""
  return textOf(Reflect.get(props, "children"))

const findElement = (
  tree: unknown,
  predicate: (element: ElementRecord) => boolean,
): ElementRecord | undefined =>
  const seen = new WeakSet<object>()
  const visit = (node: unknown): ElementRecord | undefined =>
    if (Array.isArray(node))
      for (const child of node)
        const found = visit(child)
        if (found !== undefined) return found
      return undefined
    if (typeof node !== "object" || node === null || seen.has(node)) return undefined
    seen.add(node)
    const props = Reflect.get(node, "props")
    if (typeof props !== "object" || props === null) return undefined
    const element = node as ElementRecord
    if (predicate(element)) return element
    for (const value of Object.values(element.props))
      const found = visit(value)
      if (found !== undefined) return found
    return undefined
  return visit(tree)

const component = (tree: unknown, type: unknown): ElementRecord =>
  const element = findElement(tree, (candidate) => candidate.type === type)
  expect(element, "Expected rendered component").toBeDefined()
  return element!

const elementById = (tree: unknown, id: string): ElementRecord =>
  const element = findElement(tree, (candidate) => candidate.props["id"] === id)
  expect(element, `Expected control #${id}`).toBeDefined()
  return element!

const controlByText = (tree: unknown, label: string): ElementRecord =>
  const control = findElement(tree, (candidate) => (
    typeof candidate.props["onClick"] === "function"
    && textOf(candidate).replace(/\s+/gu, " ").trim() === label
  ))
  expect(control, `Expected control named ${label}`).toBeDefined()
  return control!

const click = (tree: unknown, label: string): unknown => (
  controlByText(tree, label).props["onClick"] as () => unknown
)()

const changeValue = (tree: unknown, id: string, value: string): void =>
  const control = elementById(tree, id)
  expect(control.props["onChange"], `Expected #${id} to accept input`).toBeTypeOf("function")
  ;(control.props["onChange"] as (event: { currentTarget: { value: string } }) => void)({
    currentTarget: { value },
  })

const submitSearch = (tree: unknown): void =>
  const form = findElement(tree, (candidate) => candidate.props["role"] === "search")
  expect(form, "Expected the feature search form").toBeDefined()
  const preventDefault = vi.fn()
  ;(form!.props["onSubmit"] as (event: { preventDefault: () => void }) => void)({ preventDefault })
  expect(preventDefault).toHaveBeenCalledOnce()

const collection = (tree: unknown): ElementRecord => component(tree, FeatureItemsCollection)
const markup = (tree: unknown): string => renderToStaticMarkup(tree as ReactElement)

const mountWorkspace = (gateway: FeatureItemGateway) => ({
  render: (): ReactElement =>
    hookRuntime.begin()
    const tree = FeatureItemsWorkspace({ gateway })
    hookRuntime.commit(tree)
    return tree
  unmount: hookRuntime.cleanup,
})

const flushMicrotasks = async (): Promise<void> ->
  await Promise.resolve()
  await Promise.resolve()
  await Promise.resolve()

afterEach(() =>
  hookRuntime.reset()
)

describe "feature item workspace", ->
  it "applies bounded filters, ignores an obsolete load, and resets every filter", async ->
    const initialRequest = deferred<FeatureItemOutput[]>()
    const filteredRequest = deferred<FeatureItemOutput[]>()
    const list = vi.fn<(input?: FeatureItemListInput) => Promise<FeatureItemOutput[]>>()
      .mockImplementationOnce(() => initialRequest.promise)
      .mockImplementationOnce(() => filteredRequest.promise)
      .mockResolvedValueOnce([item({ id: "reset-item", name: "Reset result" })])
      .mockResolvedValueOnce([item({ id: "archived-item", name: "Archived result", status: "archived" })])
    const mount = mountWorkspace(gatewayWith({ list }))
    let tree = mount.render()

    expect(collection(tree).props["state"]).toEqual({ type: "loading" })
    expect(list).toHaveBeenCalledWith({ limit: 50 })

    changeValue(tree, "feature-items-query", "  onboarding  ")
    tree = mount.render()
    changeValue(tree, "feature-items-status", "active")
    tree = mount.render()
    submitSearch(tree)
    tree = mount.render()

    expect(list).toHaveBeenNthCalledWith(2, {
      limit: 50,
      query: "onboarding",
      status: "active",
    })
    expect(collection(tree).props["state"]).toEqual({ type: "loading" })

    filteredRequest.resolve([item({ id: "current-item", name: "Current filtered result", status: "active" })])
    await flushMicrotasks()
    tree = mount.render()
    expect(markup(tree)).toContain("Current filtered result")
    expect(controlByText(tree, "Reset")).toBeDefined()

    initialRequest.resolve([item({ id: "stale-item", name: "Obsolete result" })])
    await flushMicrotasks()
    tree = mount.render()
    expect(markup(tree)).toContain("Current filtered result")
    expect(markup(tree)).not.toContain("Obsolete result")

    click(tree, "Reset")
    tree = mount.render()
    await flushMicrotasks()
    tree = mount.render()
    expect(list).toHaveBeenNthCalledWith(3, { limit: 50 })
    expect(elementById(tree, "feature-items-query").props["value"]).toBe("")
    expect(elementById(tree, "feature-items-status").props["value"]).toBe("")
    expect(collection(tree).props["isFiltered"]).toBe(false)
    expect(markup(tree)).toContain("Reset result")

    changeValue(tree, "feature-items-status", "archived")
    tree = mount.render()
    submitSearch(tree)
    tree = mount.render()
    await flushMicrotasks()
    tree = mount.render()
    expect(list).toHaveBeenNthCalledWith(4, { limit: 50, status: "archived" })
    expect(collection(tree).props["isFiltered"]).toBe(true)
    expect(markup(tree)).toContain("Archived result")

  it "renders a safe load error and retries into a ready collection", async ->
    const list = vi.fn()
      .mockRejectedValueOnce({ code: "STORAGE_ERROR" })
      .mockResolvedValueOnce([item({ name: "Recovered result" })])
    const mount = mountWorkspace(gatewayWith({ list }))
    mount.render()
    await flushMicrotasks()
    let tree = mount.render()

    expect(collection(tree).props["state"]).toEqual({
      type: "error",
      kind: "transient",
      message: "Feature item storage is temporarily unavailable. Try again.",
    })
    expect(markup(tree)).toContain("Feature items could not be loaded")

    const retry = collection(tree).props["onRetry"] as () => Promise<void>
    const retrying = retry()
    tree = mount.render()
    expect(collection(tree).props["state"]).toEqual({ type: "loading" })
    await retrying
    tree = mount.render()
    expect(markup(tree)).toContain("Recovered result")
    expect(list).toHaveBeenCalledTimes(2)

  it "suppresses a rejected load after the workspace unmounts", async ->
    const request = deferred<FeatureItemOutput[]>()
    const mount = mountWorkspace(gatewayWith({ list: vi.fn(() => request.promise) }))
    let tree = mount.render()
    expect(collection(tree).props["state"]).toEqual({ type: "loading" })

    mount.unmount()
    request.reject({ code: "STORAGE_ERROR" })
    await flushMicrotasks()
    tree = mount.render()

    expect(collection(tree).props["state"]).toEqual({ type: "loading" })
    expect(markup(tree)).not.toContain("Feature items could not be loaded")

  it "focuses archive confirmation and restores the initiating control on escape and cancel", async ->
    const record = item()
    const mount = mountWorkspace(gatewayWith({ list: vi.fn(async () => [record]) }))
    mount.render()
    await flushMicrotasks()
    let tree = mount.render()
    const trigger = { focus: vi.fn() } as unknown as HTMLButtonElement
    const requestArchive = collection(tree).props["onArchive"] as (
      candidate: FeatureItemOutput,
      initiatingControl: HTMLButtonElement,
    ) => void

    requestArchive(record, trigger)
    tree = mount.render()
    expect(markup(tree)).toContain("Archive Starter checklist?")
    expect(hookRuntime.lastFocus()).toBe("Archive item")

    const region = findElement(tree, (candidate) => (
      candidate.props["role"] === "region"
      && typeof candidate.props["onKeyDown"] === "function"
    ))
    expect(region).toBeDefined()
    const onKeyDown = region!.props["onKeyDown"] as (event: { key: string }) => void
    onKeyDown({ key: "Enter" })
    tree = mount.render()
    expect(markup(tree)).toContain("Archive Starter checklist?")

    onKeyDown({ key: "Escape" })
    tree = mount.render()
    await flushMicrotasks()
    expect(markup(tree)).not.toContain("Archive Starter checklist?")
    expect(trigger.focus).toHaveBeenCalledOnce()

    requestArchive(record, trigger)
    tree = mount.render()
    click(tree, "Cancel")
    tree = mount.render()
    await flushMicrotasks()
    expect(markup(tree)).not.toContain("Archive Starter checklist?")
    expect(trigger.focus).toHaveBeenCalledTimes(2)

  it "completes archive feedback when transient DOM refs are unavailable", async ->
    hookRuntime.setAssignRenderedRefs(false)
    const record = item()
    const list = vi.fn()
      .mockResolvedValueOnce([record])
      .mockResolvedValueOnce([])
    const archive = vi.fn(async () => item({ status: "archived" }))
    const mount = mountWorkspace(gatewayWith({ archive, list }))
    mount.render()
    await flushMicrotasks()
    let tree = mount.render()
    const trigger = { focus: vi.fn() } as unknown as HTMLButtonElement

    ;(collection(tree).props["onArchive"] as (
      candidate: FeatureItemOutput,
      initiatingControl: HTMLButtonElement,
    ) => void)(record, trigger)
    tree = mount.render()
    expect(markup(tree)).toContain("Archive Starter checklist?")
    expect(hookRuntime.lastFocus()).toBeUndefined()

    await (click(tree, "Archive item") as Promise<void>)
    await flushMicrotasks()
    tree = mount.render()
    expect(markup(tree)).toContain("Starter checklist was archived.")
    expect(hookRuntime.lastFocus()).toBeUndefined()

  it "locks filters and archive requests while archiving, then preserves the newest reload", async ->
    const first = item()
    const second = item({ id: "item-2", name: "Second item" })
    const manualRefresh = deferred<FeatureItemOutput[]>()
    const archiveReload = deferred<FeatureItemOutput[]>()
    const list = vi.fn()
      .mockResolvedValueOnce([first, second])
      .mockImplementationOnce(() => manualRefresh.promise)
      .mockImplementationOnce(() => archiveReload.promise)
    const archiveRequest = deferred<FeatureItemOutput>()
    const archive = vi.fn(() => archiveRequest.promise)
    const mount = mountWorkspace(gatewayWith({ archive, list }))
    mount.render()
    await flushMicrotasks()
    let tree = mount.render()

    changeValue(tree, "feature-items-query", "preserve this input")
    tree = mount.render()
    const firstTrigger = { focus: vi.fn() } as unknown as HTMLButtonElement
    const requestArchive = collection(tree).props["onArchive"] as (
      candidate: FeatureItemOutput,
      initiatingControl: HTMLButtonElement,
    ) => void
    requestArchive(first, firstTrigger)
    tree = mount.render()
    const archiving = click(tree, "Archive item") as Promise<void>
    tree = mount.render()

    expect(elementById(tree, "feature-items-query").props["disabled"]).toBe(true)
    expect(elementById(tree, "feature-items-status").props["disabled"]).toBe(true)
    expect(collection(tree).props["archiveBusy"]).toBe(true)
    expect(collection(tree).props["archivingId"]).toBe("item-1")

    const secondTrigger = { focus: vi.fn() } as unknown as HTMLButtonElement
    ;(collection(tree).props["onArchive"] as (
      candidate: FeatureItemOutput,
      initiatingControl: HTMLButtonElement,
    ) => void)(second, secondTrigger)
    ;(collection(tree).props["onResetFilters"] as () => void)()
    submitSearch(tree)
    const listCallsBeforeRefresh = list.mock.calls.length
    tree = mount.render()
    expect(elementById(tree, "feature-items-query").props["value"]).toBe("preserve this input")
    expect(markup(tree)).not.toContain("Archive Second item?")
    expect(list).toHaveBeenCalledTimes(listCallsBeforeRefresh)

    requestArchive(second, secondTrigger)
    tree = mount.render()
    expect(markup(tree)).toContain("Archive Second item?")
    await (click(tree, "Archive item") as Promise<void>)
    expect(archive).toHaveBeenCalledOnce()
    click(tree, "Cancel")
    tree = mount.render()
    expect(markup(tree)).not.toContain("Archive Second item?")

    const refresh = (collection(tree).props["onRetry"] as () => Promise<void>)()
    tree = mount.render()
    expect(collection(tree).props["state"]).toEqual({ type: "loading" })

    archiveRequest.resolve(item({ status: "archived" }))
    await archiving
    expect(archive).toHaveBeenCalledOnce()
    archiveReload.resolve([second])
    await flushMicrotasks()
    manualRefresh.resolve([first, second])
    await refresh
    await flushMicrotasks()
    tree = mount.render()

    expect(markup(tree)).toContain("Second item")
    expect((
      collection(tree).props["state"] as Readonly<{
        items: readonly FeatureItemOutput[]
        type: "ready"
      }>
    ).items.map((entry) => entry.id)).toEqual(["item-2"])
    expect(markup(tree)).toContain("Starter checklist was archived.")
    expect(hookRuntime.lastFocus()).toBe("feedback")

  it "offers retry after an archive failure and removes the item after recovery", async ->
    const record = item()
    const list = vi.fn()
      .mockResolvedValueOnce([record])
      .mockResolvedValueOnce([])
    const archive = vi.fn()
      .mockRejectedValueOnce({ code: "STORAGE_ERROR" })
      .mockResolvedValueOnce(item({ status: "archived" }))
    const mount = mountWorkspace(gatewayWith({ archive, list }))
    mount.render()
    await flushMicrotasks()
    let tree = mount.render()
    const trigger = { focus: vi.fn() } as unknown as HTMLButtonElement

    ;(collection(tree).props["onArchive"] as (
      candidate: FeatureItemOutput,
      initiatingControl: HTMLButtonElement,
    ) => void)(record, trigger)
    tree = mount.render()
    await (click(tree, "Archive item") as Promise<void>)
    await flushMicrotasks()
    tree = mount.render()

    expect(markup(tree)).toContain("Feature item storage is temporarily unavailable. Try again.")
    expect(markup(tree)).toContain("Try again")
    expect(trigger.focus).toHaveBeenCalledOnce()
    const recovery = component(tree, FeatureRecoveryAction)
    expect(recovery.props["kind"]).toBe("transient")
    const retry = recovery.props["onRetry"] as () => void
    retry()
    tree = mount.render()
    expect(markup(tree)).toContain("Archive Starter checklist?")

    await (click(tree, "Archive item") as Promise<void>)
    await flushMicrotasks()
    tree = mount.render()
    expect(archive).toHaveBeenCalledTimes(2)
    expect(markup(tree)).toContain("Starter checklist was archived.")
    expect(collection(tree).props["state"]).toEqual({ type: "ready", items: [] })
