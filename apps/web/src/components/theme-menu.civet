"use client"

import { useRef, useState } from "react"
import { createApiClient } from "@darkfactory/api"

import { Palette as PaletteIcon } from "lucide-react"
import { PALETTES, THEME_MODES, type Palette, type ThemeMode } from "@darkfactory/state"
import { IconButton } from "@darkfactory/ui"
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuLabel,
  DropdownMenuRadioGroup,
  DropdownMenuRadioItem,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from "@darkfactory/ui/client/dropdown-menu"

import { useThemeAuthority } from "./theme-controller.civet"
import { PALETTE_LABELS, THEME_MODE_LABELS } from "../lib/theme.civet"
import { fetchThemeApiRequest } from "../lib/theme-api-timeout.civet"
import { updateTrustedThemePreference } from "../lib/theme-update.civet"
import { useUiState, useUiStoreApi } from "../lib/ui-store.civet"

export const ThemeMenu = () => {
  const store = useUiStoreApi()
  const authority = useThemeAuthority()
  const authorityRef = useRef(authority)
  const requestSequence = useRef(0)
  const [error, setError] = useState<string | null>(null)
  const [pending, setPending] = useState(false)
  const palette = useUiState((state) => state.palette)
  const themeMode = useUiState((state) => state.themeMode)
  authorityRef.current = authority
  const controlsEnabled = authority !== "indeterminate" && !pending

  const selectPreference = async (
    nextPreference: Readonly<{ themeMode: ThemeMode; palette: Palette }>,
  ): Promise<void> => {
    if (authority === "indeterminate") return
    if (authority === "anonymous") {
      store.setState(nextPreference)
      return
    }

    setError(null)
    setPending(true)
    const result = await updateTrustedThemePreference({
      authority: () => authorityRef.current,
      preference: nextPreference,
      sequence: requestSequence,
      store,
      update: async (preference) => (
        createApiClient({
          baseUrl: window.location.origin,
          fetch: async (request) => fetchThemeApiRequest({
            fetchRequest: globalThis.fetch,
            request,
          }),
        }).preferences.theme.update(preference)
      ),
    })
    if (result === "failed") {
      setError("Could not save theme settings. Your previous preference is still active.")
    }
    if (result !== "superseded" || authorityRef.current !== "trusted") {
      setPending(false)
    }
  }

  const selectThemeMode = (value: string): void => {
    void selectPreference({ themeMode: value as ThemeMode, palette })
  }
  const selectPalette = (value: string): void => {
    void selectPreference({ themeMode, palette: value as Palette })
  }

  const triggerLabel = authority === "indeterminate"
    ? "Theme settings unavailable"
    : pending
      ? "Saving theme settings"
      : "Theme settings"
  const ownershipMessage = authority === "trusted"
    ? pending
      ? "Saving this preference to your account."
      : "These preferences are saved to your account."
    : authority === "indeterminate"
      ? "Theme preferences are temporarily unavailable. Changes are disabled."
      : null

  return (
    <DropdownMenu>
      <DropdownMenuTrigger asChild>
        <IconButton aria-label={triggerLabel} variant="ghost">
          <PaletteIcon aria-hidden="true" />
        </IconButton>
      </DropdownMenuTrigger>
      <DropdownMenuContent
        align="end"
        className="max-h-[calc(100dvh-var(--space-8))] w-64 overflow-y-auto overscroll-contain"
      >
        <DropdownMenuLabel>Appearance</DropdownMenuLabel>
        {ownershipMessage === null ? null : (
          <p aria-live="polite" className="px-2 pb-2 text-xs leading-5 text-muted-foreground">
            {ownershipMessage}
          </p>
        )}
        {error === null ? null : (
          <p className="px-2 pb-2 text-xs leading-5 text-destructive" role="alert">
            {error}
          </p>
        )}
        <DropdownMenuRadioGroup
          aria-label="Color mode"
          onValueChange={selectThemeMode}
          value={themeMode}
        >
          {THEME_MODES.map((mode) => (
            <DropdownMenuRadioItem
              disabled={!controlsEnabled}
              key={mode}
              value={mode}
            >
              {THEME_MODE_LABELS[mode]}
            </DropdownMenuRadioItem>
          ))}
        </DropdownMenuRadioGroup>
        <DropdownMenuSeparator />
        <DropdownMenuLabel>Palette</DropdownMenuLabel>
        <DropdownMenuRadioGroup
          aria-label="Color palette"
          onValueChange={selectPalette}
          value={palette}
        >
          {PALETTES.map((paletteName) => (
            <DropdownMenuRadioItem
              disabled={!controlsEnabled}
              key={paletteName}
              value={paletteName}
            >
              <span
                aria-hidden="true"
                className="theme-palette-swatch size-3 rounded-pill"
                data-palette={paletteName}
              />
              <span>{PALETTE_LABELS[paletteName]}</span>
            </DropdownMenuRadioItem>
          ))}
        </DropdownMenuRadioGroup>
      </DropdownMenuContent>
    </DropdownMenu>
  )
}
