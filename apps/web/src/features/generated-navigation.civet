export type GeneratedNavigationItem = Readonly<{
  label: string
  href: `/${string}`
}>

// Generator-owned. Edit through `pnpm generate:feature` only.
export const GENERATED_FEATURE_NAVIGATION: readonly GeneratedNavigationItem[] = Object.freeze([])
export const GENERATED_FEATURE_ROUTE_PATHS: readonly `/${string}`[] = Object.freeze([])
export const GENERATED_FEATURE_ROUTE_PAGE_FILES: Readonly<Record<string, string>> = Object.freeze({})
