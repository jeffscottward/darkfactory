{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      // Civet owns parsing and type checks for authored .civet source.
      "!!**/*.civet",
      "!!.markdownlint-cli2.jsonc",
      // Generated deterministically by @darkfactory/api; stale-check owns its exact bytes.
      "!!packages/api/openapi.json",
      "!!**/node_modules",
      "!!**/.turbo",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results"
    ]
  }
}
