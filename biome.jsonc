{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!!.markdownlint-cli2.jsonc",
      // Generated by @darkfactory/api; the stale check owns its exact bytes.
      "!!packages/api/openapi.json",
      "!!**/node_modules",
      "!!**/.turbo",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        // Conflicts with tsconfig's noPropertyAccessFromIndexSignature, which requires bracket access.
        "useLiteralKeys": "off",
        // Explicit constructors keep TypeScript signature narrowing on subclasses.
        "noUselessConstructor": "off",
        // `void promise` is the explicit fire-and-forget marker.
        "noVoid": "off",
        // Tightened: error with autofix so function expressions stay arrows.
        "useArrowFunction": {
          "level": "error",
          "fix": "unsafe"
        },
        // Warn, not error: surfaces hotspots without blocking fail-closed validators.
        "noExcessiveCognitiveComplexity": "warn"
      },
      "performance": {
        // Regexes stay beside the bounded parser or invariant they prove; none run in hot loops.
        "useTopLevelRegex": "off"
      },
      "style": {
        // Style-only; the formatter owns layout.
        "useBlockStatements": "off",
        // Style-only; readability is judged in review.
        "noNestedTernary": "off",
        // A default clause would hide TypeScript `never` exhaustiveness checks.
        "useDefaultSwitchClause": "off"
      },
      "suspicious": {
        // Security parsers and redaction must match raw control bytes.
        "noControlCharactersInRegex": "off"
      },
      "a11y": {
        // shadcn/Radix primitives set ARIA roles on composed elements deliberately.
        "useSemanticElements": "off",
        // Same as above: explicit roles are part of the shadcn/Radix primitive contract.
        "noRedundantRoles": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/wrangler.jsonc"],
      "json": {
        "parser": {
          // wrangler.jsonc documents deployment bindings inline.
          "allowComments": true
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "tests/**",
        "playwright.config.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            // Test idiom: fixtures are known-present; a failed `!` fails the test.
            "noNonNullAssertion": "off",
            // Test idiom: proves non-Error throw values are handled.
            "useThrowOnlyError": "off"
          },
          "suspicious": {
            // Test idiom: async doubles satisfy promise-returning contracts.
            "useAwait": "off",
            // Test idiom: assertions inside injected lifecycle callbacks are the contract.
            "noMisplacedAssertion": "off",
            // Test idiom: terse fixture mutation in arrow callbacks.
            "noAssignInExpressions": "off",
            // Test idiom: thenable doubles probe promise handling.
            "noThenProperty": "off",
            // Test idiom: message-less errors exercise fallback paths.
            "useErrorMessage": "off",
            // Test idiom: literal `${...}` text is asserted verbatim.
            "noTemplateCurlyInString": "off"
          },
          "performance": {
            // Test idiom: restores env/global state exactly.
            "noDelete": "off",
            // Test idiom: `import * as` enables vi.spyOn on module namespaces.
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/jobs/src/server/omp.ts",
        "packages/jobs/src/server/wayfinder.ts",
        "packages/jobs/src/server/wayfinder.test.ts",
        "packages/jobs/src/server/workflow-recovery-regression.test.ts",
        "packages/email/src/server/preview.test.ts",
        "packages/observability/src/redaction.ts",
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            // File modes, inode identities, checksums and PNG bytes need exact bit math.
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/api/src/contract.ts",
        "packages/api/src/index.ts",
        "packages/api/src/server/index.ts",
        "packages/auth/src/db.ts",
        "packages/auth/src/server.ts",
        "packages/config/src/server/capabilities.ts",
        "packages/db/src/schema/index.ts",
        "packages/db/src/server/index.ts",
        "packages/email/src/server.ts",
        "packages/observability/src/index.ts",
        "packages/operator/src/index.ts",
        "packages/operator/src/server/index.ts",
        "packages/state/src/workflow/index.ts",
        "packages/ui/src/client/toaster.ts",
        "packages/ui/src/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            // Package entry points are intentional public barrels.
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tests/e2e/helpers/browser-errors.ts",
        "tests/e2e/helpers/preview-email.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            // Fail-closed E2E helpers keep ordered ownership/cleanup checks in one auditable place.
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/jobs/verifier/runner.ts"],
      "javascript": {
        // The verifier runner executes under Bun.
        "globals": ["Bun"]
      }
    }
  ]
}
