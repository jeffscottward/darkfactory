# DarkFactory environment template. `bun run setup` copies it to the ignored
# `.env` (mode 0600), generates the empty local secrets, and sets the local
# DATABASE_URL; it never overwrites a value you already set.
# The single validated contract is the Zod schema in
# packages/config/src/server.ts (parseServerEnv). Empty optional values keep
# their capabilities disabled. Keep real secrets out of Git; 1Password users can
# wrap commands with `op run --env-file=.env --`.

# --- Application
# development | test | production
APP_ENV=development
# Clean HTTPS origin without a trailing slash; must equal BETTER_AUTH_URL.
APP_URL=https://darkfactory.localhost
APP_NAME=DarkFactory

# --- Database
# postgres (default) | planetscale | hyperdrive
# Production: postgres needs sslmode=verify-full and a non-local host;
# planetscale needs the *.pg.psdb.cloud PgBouncer URL on port 6432 with
# sslmode=verify-full; hyperdrive takes the connection from the Worker's
# HYPERDRIVE binding and rejects DATABASE_URL (docs/deploy.md#hyperdrive).
DATABASE_PROVIDER=postgres
# Required for local runs. Secret. Setup fills the local compose app role:
# postgresql://darkfactory_app:darkfactory-app-local-only@127.0.0.1:5432/darkfactory_dev
DATABASE_URL=
# The test suites (`bun run test`, test:integration, the browser lane) ignore
# DATABASE_URL: they run with APP_ENV=test against this local maintenance
# database. Empty means the compose test role (bun run db:test:up):
# postgresql://darkfactory_test_runner:darkfactory-test-only@127.0.0.1:5432/darkfactory_test_maintenance
TEST_DATABASE_URL=

# --- Authentication
# Secret, at least 32 characters. Setup generates a local value when empty.
BETTER_AUTH_SECRET=
# Independent secret (at least 32 characters) for HMAC contact abuse buckets.
# Do not reuse the authentication secret. Setup generates a local value.
CONTACT_THROTTLE_SECRET=
BETTER_AUTH_URL=https://darkfactory.localhost

# --- Operator workflow pilot
# Exact owner-to-repository grants: ownerId=repositoryId pairs separated by
# commas. Required by the operator API and worker; no wildcards. Secret.
WORKFLOW_REPOSITORY_GRANTS=
# Approved Docker verification contract; free-form commands are not accepted.
WORKFLOW_VERIFIER_ID=darkfactory-verify-core-v2
# 71-character content digest printed by
# `pnpm --filter @darkfactory/jobs verifier:image:setup`; production workers
# require it.
WORKFLOW_VERIFIER_IMAGE_DIGEST=
# Rootless Docker (or any local daemon) for the verifier: set its unix socket,
# for example DOCKER_HOST=unix:///run/user/1000/docker.sock. Only local unix
# sockets are accepted.
# Worker-only tuning. WORKFLOW_REPOSITORIES_ROOT must be an absolute path.
WORKFLOW_REPOSITORIES_ROOT=
WORKFLOW_LEASE_OWNER=
WORKFLOW_POLL_INTERVAL_MS=
WORKFLOW_SHUTDOWN_TIMEOUT_MS=

# --- AI provider (disabled until both values are configured)
AI_PROVIDER=groq
# Secret.
GROQ_API_KEY=
GROQ_MODEL=

# --- Email provider (preview is the safe local transport)
# resend | disabled
EMAIL_PROVIDER=resend
# preview | resend | disabled
EMAIL_TRANSPORT=preview
# Secret.
RESEND_API_KEY=
EMAIL_FROM=DarkFactory <noreply@domain.test>
# Optional recipient for public contact submissions. Empty disables delivery.
CONTACT_EMAIL_TO=

# --- Analytics provider (disabled until key and host are configured)
ANALYTICS_PROVIDER=posthog
# Secret.
POSTHOG_KEY=
POSTHOG_HOST=

# --- Telemetry (instrumentation is core; remote export is optional)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=darkfactory-web
# Secret (may embed credentials).
OTEL_EXPORTER_OTLP_ENDPOINT=

