{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!!.markdownlint-cli2.jsonc",
      "!!packages/api/openapi.json",
      "!!**/node_modules",
      "!!**/.turbo",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        "useLiteralKeys": "off",
        "noUselessConstructor": "off",
        "noVoid": "off",
        "useArrowFunction": {
          "level": "error",
          "fix": "unsafe"
        },
        "noExcessiveCognitiveComplexity": "warn"
      },
      "performance": {
        "useTopLevelRegex": "off"
      },
      "style": {
        "useBlockStatements": "off",
        "noNestedTernary": "off",
        "useDefaultSwitchClause": "off"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "noRedundantRoles": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "tests/**",
        "playwright.config.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off",
            "useThrowOnlyError": "off"
          },
          "suspicious": {
            "useAwait": "off",
            "noMisplacedAssertion": "off",
            "noAssignInExpressions": "off",
            "noThenProperty": "off",
            "useErrorMessage": "off",
            "noTemplateCurlyInString": "off"
          },
          "performance": {
            "noDelete": "off",
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/jobs/src/server/omp.ts",
        "packages/jobs/src/server/wayfinder.ts",
        "packages/jobs/src/server/wayfinder.test.ts",
        "packages/jobs/src/server/workflow-recovery-regression.test.ts",
        "packages/email/src/server/preview.test.ts",
        "packages/observability/src/redaction.ts",
        "scripts/**",
        "tests/e2e/helpers/artifacts.ts",
        "tests/e2e/helpers/dev-vars.ts",
        "tests/e2e/helpers/dev-vars.test.ts",
        "tests/e2e/helpers/lifecycle-state.test.ts",
        "tests/e2e/helpers/run-artifacts.ts",
        "tests/e2e/helpers/run-artifacts.test.ts",
        "tests/e2e/helpers/structured-evidence.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/api/src/contract.ts",
        "packages/api/src/index.ts",
        "packages/api/src/server/index.ts",
        "packages/auth/src/db.ts",
        "packages/auth/src/server.ts",
        "packages/config/src/server/capabilities.ts",
        "packages/db/src/schema/index.ts",
        "packages/db/src/server/index.ts",
        "packages/email/src/server.ts",
        "packages/observability/src/index.ts",
        "packages/operator/src/index.ts",
        "packages/operator/src/server/index.ts",
        "packages/state/src/workflow/index.ts",
        "packages/ui/src/client/toaster.ts",
        "packages/ui/src/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tests/e2e/helpers/browser-errors.ts",
        "tests/e2e/helpers/dev-vars.ts",
        "tests/e2e/helpers/optimizer-cache.ts",
        "tests/e2e/helpers/preview-email.ts",
        "tests/e2e/helpers/run-artifacts.ts",
        "tests/e2e/helpers/server-readiness.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["infra/docker/verifier/runner.ts"],
      "javascript": {
        "globals": ["Bun"]
      }
    }
  ]
}
