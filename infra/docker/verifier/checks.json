    {
      "id": "typecheck-email",
      "executable": "civet",
      "args": ["--config", "civet.typecheck.json", "--typecheck"],
      "cwd": "packages/email"
    },
    {
      "id": "typecheck-jobs",
      "executable": "civet",
      "args": ["--config", "civet.typecheck.json", "--typecheck"],
      "cwd": "packages/jobs"
    },
    {
      "id": "typecheck-observability",
      "executable": "civet",
      "args": ["--config", "civet.typecheck.json", "--typecheck"],
