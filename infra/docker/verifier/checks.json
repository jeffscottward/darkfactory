    {
      "id": "typecheck-ui",
      "executable": "civet",
      "args": ["--config", "civet.typecheck.json", "--typecheck"],
      "cwd": "packages/ui"
    },
    {
      "id": "typecheck-web",
      "executable": "civet",
      "args": ["--config", "civet.typecheck.json", "--typecheck"],
      "cwd": "apps/web"
    },
    {
      "id": "typecheck-e2e",
      "executable": "civet",
      "args": ["--config", "scripts/e2e/civet.typecheck.json", "--typecheck"],
      "cwd": "."
    },
    {
      "id": "typecheck-integration",
      "executable": "civet",
      "args": ["--config", "civet.integration.json", "--typecheck"],
      "cwd": "."
    },
    {
      "id": "tsc",
      "executable": "tsc",
      "args": ["--project", "tsconfig.json", "--noEmit"],
      "cwd": "."
    },
    {
      "id": "build-web",
      "executable": "vinext",
      "args": ["build"],
      "cwd": "apps/web"
    },
    {
      "id": "unit",
      "executable": "vitest",
      "args": ["run", "--config", "vitest.config.ts", "--project", "unit"],
      "cwd": "."
    },
    {
      "id": "contract",
      "executable": "vitest",
      "args": ["run", "--config", "vitest.config.ts", "--project", "contract"],
      "cwd": "."
    },
    {
      "id": "operations",
      "executable": "vitest",
      "args": [
        "run",
        "--config",
        "vitest.config.ts",
        "--project",
        "operations",
        "--project",
        "e2e-helpers",
        "--maxWorkers=1",
        "--no-file-parallelism"
      ],
      "cwd": "."
    },
    {
      "id": "docs",
      "executable": "bun",
      "args": [
        "--preload",
        "@danielx/civet/bun-civet",
        "{workspace}/scripts/docs.civet",
