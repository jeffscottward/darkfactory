{
  "identity": "darkfactory-verifier-checks-v1",
  "commands": [
    {
      "id": "format",
      "executable": "biome",
      "args": ["format", "."],
      "cwd": "."
    },
    { "id": "lint", "executable": "biome", "args": ["lint", "."], "cwd": "." },
    {
      "id": "markdown",
      "executable": "markdownlint-cli2",
      "args": ["**/*.md"],
      "cwd": "."
    },
    {
      "id": "auth-schema",
      "executable": "bun",
      "args": ["{workspace}/packages/auth/scripts/check-auth-schema.ts"],
      "cwd": "."
    },
    {
      "id": "openapi",
      "executable": "bun",
      "args": [
        "--preload",
        "@danielx/civet/bun-civet",
        "{workspace}/packages/api/scripts/openapi.civet"
      ],
      "cwd": "."
    },
    {
      "id": "civet-style",
      "executable": "bun",
      "args": [
        "--preload",
        "@danielx/civet/bun-civet",
        "{workspace}/scripts/civet-style.civet"
      ],
      "cwd": "."
    },
    {
      "id": "type-exports",
      "executable": "bun",
      "args": [
        "--preload",
        "@danielx/civet/bun-civet",
        "{workspace}/scripts/type-exports.civet"
      ],
      "cwd": "."
    },
    {
      "id": "types-auth",
      "executable": "civet",
      "args": ["--config", "civet.types.json", "--emit-declaration"],
      "cwd": "packages/auth"
    },
    {
      "id": "types-api",
      "executable": "civet",
      "args": ["--config", "civet.types.json", "--emit-declaration"],
      "cwd": "packages/api"
    },
    {
      "id": "types-db",
      "executable": "civet",
      "args": ["--config", "civet.types.json", "--emit-declaration"],
      "cwd": "packages/db"
    },
    {
      "id": "types-email",
      "executable": "civet",
      "args": ["--config", "civet.types.json", "--emit-declaration"],
      "cwd": "packages/email"
    },
    {
      "id": "types-jobs",
      "executable": "civet",
      "args": ["--config", "civet.types.json", "--emit-declaration"],
      "cwd": "packages/jobs"
    },
    {
      "id": "types-observability",
      "executable": "civet",
      "args": ["--config", "civet.types.json", "--emit-declaration"],
      "cwd": "packages/observability"
