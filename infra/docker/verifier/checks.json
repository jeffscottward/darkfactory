      "id": "types-ui",
      "executable": "civet",
      "args": ["--config", "civet.types.json", "--emit-declaration"],
      "cwd": "packages/ui"
    },
    {
      "id": "typecheck-ai",
      "executable": "civet",
      "args": ["--config", "civet.typecheck.json", "--typecheck"],
      "cwd": "packages/ai"
    },
    {
      "id": "typecheck-analytics",
      "executable": "civet",
      "args": ["--config", "civet.typecheck.json", "--typecheck"],
      "cwd": "packages/analytics"
